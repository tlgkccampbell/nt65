; What LOAD and RUN need: the PRG's load address, and the BASIC line `10 SYS2061`, whose
; address is the first byte after the program.
.module stub

.cpu r65c02

.const LOAD  = $0801                ; where BASIC programs start
.const ENTRY = LOAD + 12            ; where `main::start` is, after the 12 bytes of `basic`

; Returns the digit of n in the given place, in decimal.
.func digit(n, place) = '0' + (n / place) .mod 10

.segment LOADADDR
.data load_address: .word LOAD

.segment EXEHDR
.data basic {
    .word @end                      ; the next line
    .word 10                        ; this line's number
    .byte $9E                       ; SYS
    .byte digit(ENTRY, 1000), digit(ENTRY, 100), digit(ENTRY, 10), digit(ENTRY, 1)
    .byte 0                         ; the end of the line
@end:
    .word 0                         ; the end of the program
}

.assert .sizeof(basic) == ENTRY - LOAD, "`ENTRY` is out of step with the BASIC line"
.assert main::start == ENTRY, "`main::start` must come straight after the BASIC line"
