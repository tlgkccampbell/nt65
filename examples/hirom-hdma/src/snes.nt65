; This module names the Super NES's ports that the demo uses, with the names Fullsnes gives them,
; and the bits it sets in them. Only banks $00 to $3F and $80 to $BF see the ports, so code that
; writes them has B in one of those banks or uses a long address.
.module snes

.cpu 65816

; The S-PPU's ports, which are written in the page at $2100.
.export .const INIDISP = $2100      ; brightness, and forced blank
.export .const BGMODE  = $2105
.export .const BG1SC   = $2107      ; where BG1's tilemap is, and its size
.export .const BG12NBA = $210B      ; where BG1's and BG2's tiles are
.export .const BG1HOFS = $210D      ; written twice, low byte first
.export .const BG1VOFS = $210E      ; written twice, low byte first
.export .const VMAIN   = $2115      ; how the VRAM address steps
.export .const VMADDL  = $2116      ; the VRAM address, in words
.export .const VMDATAL = $2118      ; the low byte of a VRAM word
.export .const CGADD   = $2121      ; the palette entry CGDATA writes next
.export .const CGDATA  = $2122      ; written twice, low byte first
.export .const TM      = $212C      ; the layers the main screen shows

; The S-CPU's ports.
.export .const NMITIMEN = $4200     ; which interrupts are on, and reading the joypads
.export .const MDMAEN   = $420B     ; starts a DMA on each channel whose bit is set
.export .const HDMAEN   = $420C     ; runs HDMA on each channel whose bit is set, every frame
.export .const MEMSEL   = $420D     ; FastROM, in banks $80 to $FF, when bit 0 is set
.export .const RDNMI    = $4210     ; read to acknowledge an NMI

.export .const FORCED_BLANK = $80   ; INIDISP: the screen shows nothing, and VRAM may be written
.export .const FULL_BRIGHT  = $0F   ; INIDISP: the screen shows, at full brightness
.export .const BG1          = $01   ; TM: the layer the demo shows
.export .const VBLANK_NMI   = $80   ; NMITIMEN: an NMI at the start of each vblank
.export .const FASTROM      = $01   ; MEMSEL: banks $80 to $FF take 6 cycles a byte, not 8
.export .const STEP_HIGH    = $80   ; VMAIN: the address steps after each write of the high byte

; The registers of a DMA channel, in their order from $43n0. HDMA reads its table from `address`
; in `bank`, and in indirect mode reads the bytes the table points at from `indirect`. It keeps
; the rest of the registers as its own.
.export .struct Channel {
    mode:     .byte                 ; how the bytes are written, as the DMA_ and HDMA_ constants say
    port:     .byte                 ; the port they are written to, as its offset from $2100
    address:  .addr
    bank:     .byte
    length:   .word                 ; in bytes, where 0 is 65,536
    indirect: .byte
    unused:   .res 8
}

.assert .sizeof(Channel) == $10, "each channel's registers take sixteen bytes"

; The eight DMA channels, from $4300.
.export .mmio channels: .type Channel[8] = $4300

.export .const DMA_ONE_PORT  = $00  ; each byte to the port
.export .const DMA_TWO_PORTS = $01  ; the bytes to the port and the one after it, in turn
.export .const DMA_TWICE     = $02  ; two bytes to the port, which takes a low and a high byte
.export .const DMA_TWICE_TWO = $03  ; two bytes to the port, then two to the one after it

; An HDMA table is a run of entries, each a count of lines and the bytes for them, and ends with
; a count of 0. With HDMA_REPEAT in the count, the entry has bytes for each of its lines; without
; it, the entry has bytes for its first line, and the port keeps them for the rest. In indirect
; mode, an entry holds the address of its bytes in place of the bytes.
.export .const HDMA_REPEAT   = $80
.export .const HDMA_MOST     = $7F  ; the most lines an entry with HDMA_REPEAT can have
.export .const HDMA_INDIRECT = $40  ; a mode: each entry holds the address of its bytes

; Returns a color, from five bits each of red, green and blue.
.export .func rgb(r, g, b) = r | (g << 5) | (b << 10)
