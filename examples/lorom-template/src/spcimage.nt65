; The sound driver, S-Pently, for the S-SMP: the SPC700 sound CPU and the S-DSP it drives.
; It is SPC700 code, which nt65 writes as data: each routine is a data block of the
; instruction macros in spc700, and its segment is in the sound CPU's address space.
; spc_boot_apu copies the image to the sound CPU's RAM, where it runs.
.module spcimage

.cpu 65816

.use spc700::*
.use pently::*
.use musicseq::{music_inst_table, pently_songs, pently_patterns}

.export spc_entry as "spc_entry"

; MMIO at $00F0-$00FF
TIMEREN     = $00F1     ; 0-2: enable timer; 7: enable ROM in $FFC0-$FFFF
DSPADDR     = $00F2
DSPDATA     = $00F3
TIMERPERIOD = $00FA     ; Divisors for timers (0, 1: 8 kHz base; 2: 64 kHz base)
TIMERVAL    = $00FD     ; Number of times timer incremented (bits 3-0; cleared on read)

; A voice's registers are at its number times 16 plus these.
.enum Voice {
    lvol    = $00
    rvol    = $01
    freqlo  = $02               ; Playback frequency in 7.8125 Hz units
    freqhi  = $03
    sampnum = $04
    attack  = $05               ; 7: set; 6-4: decay rate; 3-0: attack rate
    sustain = $06               ; 7-5: sustain level; 4-0: sustain decay rate
    gain    = $07               ; Used only when attack is disabled
}

; The S-DSP's global registers.
.enum Dsp {
    lvol     = $0C
    rvol     = $1C
    lechovol = $2C
    rechovol = $3C
    keyon    = $4C
    keyoff   = $5C
    flags    = $6C              ; 5: disable echo; 4-0: set LFSR rate
    fmch     = $2D              ; Modulate these channels' frequency by the amplitude before it
    noisech  = $3D              ; Replace these channels with LFSR noise
    echoch   = $4D              ; Echo comes from these channels
    sampdir  = $5D              ; High byte of base address of sample table
}

TIMER_HZ = 125

.segment SPCZEROPAGE
; Writing to KON or KOFF twice within a 64-cycle (2 sample) window
; is unreliable.  We want to KOFF the notes, wait a bit for them to be
; faded out, and KON the new notes a little later.
.data ready_notes:    .byte[NUM_CHANNELS]
.data noteInstrument: .byte[NUM_CHANNELS]

.data patternptrlo:     .byte[NUM_CHANNELS]
.data patternptrhi:     .byte[NUM_CHANNELS]
.data noteRowsLeft:     .byte[NUM_CHANNELS]
.data musicPattern:     .byte[NUM_CHANNELS]
.data patternTranspose: .byte[NUM_CHANNELS]
.data noteLegato:       .byte[NUM_CHANNELS]

; Effects remaining to implement
.data channelVolume:    .byte[NUM_CHANNELS]
.data graceTime:        .byte[NUM_CHANNELS]
.data defaultGraceTime: .byte[NUM_CHANNELS]

.data music_tempoLo:     .byte
.data music_tempoHi:     .byte
.data tempo_counter:     .byte[2]
.data conductorPos:      .byte[2]
.data conductorSegnoLo:  .byte
.data conductorSegnoHi:  .byte
.data conductorWaitRows: .byte

.segment SPCIMAGE
.align 256
.data sample_dir {
    ; each directory entry is 4 bytes:
    ; a start address then a loop address
    .addr pulse_8_brr, pulse_8_brr
    .addr pulse_4_brr, pulse_4_brr
    .addr pulse_2_brr, pulse_2_brr
    .addr triangle_brr, triangle_brr
    .addr karplusbassloop_brr, karplusbass_loop
    .addr hat_brr, hat_brr
    .addr kick_brr, kick_brr
    .addr snare_brr, snare_brr

    nop!()                      ; resync debugger's disassembly
}

.align 256
.data spc_entry {
    jsr!(pently_init)
    lda!({#0})
    jsr!(pently_start_music)

@nexttick:
    lda!({TIMERVAL})
    beq!(@nexttick)
    jsr!(pently_update)
    jmp!(@nexttick)
}

; CONDUCTOR TRACK ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.data pently_init {
    ldy!({#$7F})
    lda!({#Dsp::lvol})          ; overall output volume left
    stya!(DSPADDR)
    lda!({#Dsp::rvol})          ; overall output volume right
    stya!(DSPADDR)

    ; Disable the APU features we're not using
    ldy!({#%00100000})          ; mute off, echo write off, LFSR noise stop
    lda!({#Dsp::flags})
    stya!(DSPADDR)
    ldy!({#$00})
    sty!({music_tempoLo})
    sty!({music_tempoHi})
    lda!({#Dsp::keyon})         ; Clear key on
    stya!(DSPADDR)
    lda!({#Dsp::fmch})          ; Clear frequency modulation
    stya!(DSPADDR)

    dey!()
    lda!({#Dsp::keyoff})        ; Key off everything
    stya!(DSPADDR)
    sty!({tempo_counter})
    sty!({tempo_counter+1})
    iny!()

    lda!({#Dsp::noisech})       ; LFSR noise on no channels
    stya!(DSPADDR)
    lda!({#Dsp::echoch})        ; Echo on no channels
    stya!(DSPADDR)
    lda!({#Dsp::lechovol})      ; Left echo volume = 0
    stya!(DSPADDR)
    lda!({#Dsp::rechovol})      ; Right echo volume = 0
    stya!(DSPADDR)

    ; The DSP acts on KON and KOFF only once every two samples (1/16000
    ; seconds or 64 cycles).  A key on or key off request must remain
    ; set for at least 64 cycles, but key off must be cleared before
    ; key on can be set again.  If key on is set while key off is set,
    ; it'll immediately cut the note and possibly cause a pop.
    ldx!({#NUM_CHANNELS - 1})
    lda!({#$FF})
@clear:
    sta!({ready_notes,x})
    dex!()
    bpl!(@clear)

    lda!({#Dsp::keyoff})
    stya!(DSPADDR)

    lda!({#Dsp::sampdir})       ; set sample directory start address
    ldy!({#>sample_dir})
    stya!(DSPADDR)

    lda!({#8000/TIMER_HZ})      ; S-Pently will use 125 Hz
    sta!({TIMERPERIOD})
    lda!({#%10000001})
    sta!({TIMEREN})
    lda!({TIMERVAL})
    rts!()
}

.data pently_start_music {
    pha!()
    ; Start the song
    lda!({#<300})
    ldy!({#>300})
    stya!(music_tempoLo)
    lda!({#0})
    sta!({conductorWaitRows})

    pla!()
    asl!({a})
    tax!()
    lda!({pently_songs,x})
    sta!({conductorPos})
    sta!({conductorSegnoLo})
    lda!({pently_songs+1,x})
    sta!({conductorPos+1})
    sta!({conductorSegnoHi})
    ; falls through
}

.data pently_stop_all_tracks {
    ldx!({#NUM_CHANNELS - 1})
@initpatternloop:
    lda!({#<silentPattern})
    sta!({patternptrlo,x})
    lda!({#>silentPattern})
    sta!({patternptrhi,x})
    lda!({#$FF})
    sta!({musicPattern,x})
    lda!({#0})
    sta!({noteRowsLeft,x})
    sta!({noteLegato,x})
    txa!()
    and!({#$01})
    sta!({defaultGraceTime,x})
    sta!({graceTime,x})
    lda!({#MAX_CHANNEL_VOLUME})
    sta!({channelVolume,x})
    dex!()
    bpl!(@initpatternloop)
    rts!()
}

.data pently_update {
    jsr!(keyon_ready_notes)

    ; TODO: figure out something for sound effects

    ; TODO: figure out something for grace time

    ; Bresenham accumulator for next row
    clc!()
    lda!({music_tempoLo})
    adc!({tempo_counter})
    sta!({tempo_counter})
    lda!({music_tempoHi})
    adc!({tempo_counter+1})
    sta!({tempo_counter+1})
    bcc!(@between_rows)

    ; New row time!
    lda!({tempo_counter})
    sec!()
    sbc!({#<(60 * TIMER_HZ)})
    sta!({tempo_counter})
    lda!({tempo_counter+1})
    sec!()
    sbc!({#>(60 * TIMER_HZ)})
    sta!({tempo_counter+1})

    jsr!(play_conductor)
    ldx!({#NUM_CHANNELS - 1})
@nr_channel:
    lda!({defaultGraceTime,x})
    sta!({graceTime,x})
    bne!(@nr_notGraceTime)
    jsr!(processTrackPattern)
@nr_notGraceTime:
    dex!()
    bpl!(@nr_channel)
    jmp!(keyoff_ready_notes)

@between_rows:
    ldx!({#NUM_CHANNELS - 1})
@br_channel:
    lda!({graceTime,x})
    beq!(@br_notGraceTime)
    sec!()
    sbc!({#1})
    sta!({graceTime,x})
    bne!(@br_notGraceTime)
    jsr!(processTrackPattern)
@br_notGraceTime:
    dex!()
    bpl!(@br_channel)
    jmp!(keyoff_ready_notes)
}

.data play_conductor {
    lda!({conductorWaitRows})
    beq!(@doConductor)
    dec!({conductorWaitRows})
    rts!()
@doConductor:

    ldy!({#0})
    lda!({(conductorPos),y})
    inc!({conductorPos})
    bne!(@read_command)
    inc!({conductorPos+1})
@read_command:
    cmp!({#CON_SETTEMPO})
    bcc!(@notTempoChange)
    ; Removed: BPM math
    and!({#%00000111})
    sta!({music_tempoHi})

    lda!({(conductorPos),y})
    inc!({conductorPos})
    bne!(@read_tempo)
    inc!({conductorPos+1})
@read_tempo:
    sta!({music_tempoLo})
    jmp!(@doConductor)
@notTempoChange:
    cmp!({#CON_WAITROWS})
    bcc!(@conductorPlayPattern)
    bne!(@notWaitRows)
    jmp!(@conductorDoWaitRows)
@notWaitRows:

    ; Removed: attack track
    ; Removed for now: note on
    ; TODO: Restore note on

    cmp!({#CON_FINE})
    bne!(@notFine)
    lda!({#0})
    sta!({music_tempoHi})
    sta!({music_tempoLo})
    ; Removed: dal segno callback
    jmp!(pently_stop_all_tracks)
@notFine:

    cmp!({#CON_SEGNO})
    bne!(@notSegno)
    lda!({conductorPos})
    sta!({conductorSegnoLo})
    lda!({conductorPos+1})
    sta!({conductorSegnoHi})
    jmp!(@doConductor)
@notSegno:

    cmp!({#CON_DALSEGNO})
    bne!(@notDalSegno)
    lda!({conductorSegnoLo})
    sta!({conductorPos})
    lda!({conductorSegnoHi})
    sta!({conductorPos+1})
    ; Removed: dal segno callback
    jmp!(@doConductor)
@notDalSegno:
    rts!()

@conductorPlayPattern:
    ; Fortunately we can store channels' fields adjacently because
    ; they're 16 bytes apart in the DSP, and the SPC700 has a nibble
    ; swap instruction.
    and!({#$07})
    tax!()

    ; Removed handling for attack track, as S-DSP doesn't really
    ; support restarting a note already in progress.  One can switch
    ; to the other note's sample, but that doesn't take effect until
    ; the current sample's loop point, unlike pitch that takes effect
    ; immediately, and ADSR that I haven't really researched yet.
    lda!({#0})
    sta!({noteLegato,x})        ; start all patterns with legato off
    lda!({(conductorPos),y})
    sta!({musicPattern,x})
    iny!()
    lda!({(conductorPos),y})
    sta!({patternTranspose,x})
    iny!()
    lda!({(conductorPos),y})
    sta!({noteInstrument,x})
    tya!()
    sec!()
    adc!({conductorPos})
    sta!({conductorPos})
    bcc!(@skipped)
    inc!({conductorPos+1})
@skipped:
    jsr!(startPattern)
    jmp!(@doConductor)

    ; this should be last so it can fall into skipConductor
@conductorDoWaitRows:
    lda!({(conductorPos),y})
    inc!({conductorPos})
    bne!(@read_rows)
    inc!({conductorPos+1})
@read_rows:
    sta!({conductorWaitRows})
    rts!()
}

; PLAYING PATTERNS ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.data durations: .byte 1, 2, 3, 4, 6, 8, 12, 16

.data startPattern {
    lda!({defaultGraceTime,x})
    sta!({graceTime,x})
    lda!({#0})
    sta!({noteRowsLeft,x})
    lda!({musicPattern,x})
    cmp!({#$FF})
    bcc!(@notSilentPattern)
    lda!({#<silentPattern})
    sta!({patternptrlo,x})
    lda!({#>silentPattern})
    sta!({patternptrhi,x})
    rts!()
@notSilentPattern:
    asl!({a})
    tay!()
    bcc!(@isLoPattern)
    lda!({pently_patterns+256,y})
    sta!({patternptrhi,x})
    lda!({pently_patterns+257,y})
    sta!({patternptrhi,x})
    rts!()
@isLoPattern:
    lda!({pently_patterns,y})
    sta!({patternptrlo,x})
    lda!({pently_patterns+1,y})
    sta!({patternptrhi,x})
    rts!()
}

.data processTrackPattern {
    patternptr = $00

    lda!({noteRowsLeft,x})
    beq!(@notWaitingRows)
    sec!()
    sbc!({#1})
    sta!({noteRowsLeft,x})
    rts!()
@notWaitingRows:

    lda!({patternptrlo,x})
    sta!({patternptr})
    lda!({patternptrhi,x})
    sta!({patternptr+1})

@anotherPatternByte:
    ldy!({#0})
    lda!({(patternptr),y})
    cmp!({#$FF})
    bcc!(@notStartPatternOver)
    jsr!(startPattern)
    lda!({#0})
    sta!({graceTime,x})
    bra!(@notWaitingRows)
@notStartPatternOver:
    inc!({patternptr})
    bne!(@read_command)
    inc!({patternptr+1})
@read_command:

    cmp!({#INSTRUMENT})
    bcs!(@isEffectCmd)

    ; Set the note's duration
    pha!()
    and!({#$07})
    tay!()
    lda!({durations,y})
    sta!({noteRowsLeft,x})
    pla!()
    lsr!({a})
    lsr!({a})
    lsr!({a})
    cmp!({#25})
    bcc!(@isTransposedNote)
    beq!(@skipNote)
    ; $7F: Note off
    lda!({#$7F})
    sta!({ready_notes,x})
    bra!(@skipNote)
@isTransposedNote:

    ldy!({patternTranspose,x})
    bpl!(@noteOnNotDrum)

    ; Drum mode: play a middle C with instrument X
    sta!({noteInstrument,x})
    lda!({#2*12+0})
    bra!(@have_notenum)
@noteOnNotDrum:
    clc!()
    adc!({patternTranspose,x})
@have_notenum:
    sta!({ready_notes,x})       ; Using previous instrument

@skipNote:
    lda!({noteRowsLeft,x})
    sec!()
    sbc!({#1})
    sta!({noteRowsLeft,x})
    lda!({patternptr})
    sta!({patternptrlo,x})
    lda!({patternptr+1})
    sta!({patternptrhi,x})
    rts!()

@isEffectCmd:
    sbc!({#INSTRUMENT})
    cmp!({#.countof(patcmdhandlers)})
    bcs!(@anotherPatternByte)
    asl!({a})
    tay!()
    lda!({patcmdhandlers+1,y})
    pha!()
    lda!({patcmdhandlers,y})
    pha!()
    rts!()

    ; An authentic 6502 adds 2 to PC in JSR and 1 in RTS.
    ; The SPC700 instead adds 3 in JSR and 0 in RTS.
    ; This means we push without -1.
    ; Each effect is called with carry clear and the effect number
    ; times 2 in Y.  The effects that don't exist yet in S-Pently go on
    ; to the next byte.
    .data patcmdhandlers: .addr[] {
        @set_fx_instrument
        @nextPatternByte        ; arpeggio
        @set_fx_legato
        @set_fx_legato
        @set_fx_transpose
        @set_fx_grace
        @anotherPatternByte     ; vibrato
        @set_fx_ch_volume

        @anotherPatternByte     ; portamento
        @anotherPatternByte     ; Reserved for future use
        @anotherPatternByte     ; fast arpeggio
        @anotherPatternByte     ; slow arpeggio
    }

@set_fx_instrument:
    ldy!({#0})
    lda!({(patternptr),y})
    sta!({noteInstrument,x})

@nextPatternByte:
    inc!({patternptr})
    bne!(@next_command)
    inc!({patternptr+1})
@next_command:
    jmp!(@anotherPatternByte)

@set_fx_legato:
    tya!()
    and!({#$02})
    sta!({noteLegato,x})
    jmp!(@anotherPatternByte)

@set_fx_grace:
    ldy!({#0})
    lda!({(patternptr),y})
    asl!({a})
    sta!({graceTime,x})
    jmp!(@nextPatternByte)

@set_fx_transpose:
    lda!({patternTranspose,x})
    ldy!({#0})
    adc!({(patternptr),y})
    sta!({patternTranspose,x})
    jmp!(@nextPatternByte)

@set_fx_ch_volume:
    ldy!({#0})
    lda!({(patternptr),y})
    sta!({channelVolume,x})
    jmp!(@nextPatternByte)
}

.data silentPattern: .byte $D7, $FF

; S-Pently alignment audit 2018-03-20: Down to pentlymusic.s line 724

; PLAYING NOTES ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Sets the frequency of channel X to A times the frequency for note Y.
; Frequency 0 represents 2093 Hz, which when used with a 32-sample
; wave represents a C two octaves below middle C.
; If A * 2^(Y/12) >= 64, the playback frequency is unspecified.
; @param X voice ID (0-7)
; @param A pitch scale (BRR blocks per period)
; @param Y semitone number
; @return A, Y, $00 trashed; X preserved
.data ch_set_pitch {
    pitchhi = $00

    sta!({pitchhi})
    txa!()
    xcn!()
    ora!({#Voice::freqlo})
    sta!({DSPADDR})
    tya!()
@octave_loop:
    cmp!({#12})
    bcc!(@octave_done)
    sbc!({#12})
    asl!({pitchhi})
    jmp!(@octave_loop)
@octave_done:
    tay!()
    lda!({notefreqs_lowbyte,y})
    ldy!({pitchhi})
    mul!()
    sta!({DSPDATA})
    inc!({DSPADDR})
    ;clc  ; octave_loop always ends with carry clear
    tya!()
    adc!({pitchhi})
    sta!({DSPDATA})
    rts!()
}

; Sets volume, sample ID, and envelope of channel X to instrument A.
; @param X channel number (0-7)
; @param A instrument number
; @return $02: pointer to instrument; $04: channel volume;
; A: instrument's pitch scale; Y trashed; X preserved
.data ch_set_inst {
    instptr = $02

    ldy!({#8})
    mul!()
    clc!()
    adc!({#<music_inst_table})
    sta!({instptr})
    tya!()
    adc!({#>music_inst_table})
    sta!({instptr+1})
    txa!()
    xcn!()
    sta!({DSPADDR})

    ; Set left channel volume
    ldy!({#0})
    lda!({(instptr),y})
    pha!()
    xcn!()
    and!({#$0F})                ; 0 to 15
    ldy!({channelVolume,x})     ; 0 to 4
    mul!()
    asl!({a})
    sta!({DSPDATA})

    ; Set right channel volume
    inc!({DSPADDR})
    pla!()
    and!({#$0F})
    ldy!({channelVolume,x})
    mul!()
    asl!({a})
    sta!({DSPDATA})

    ; Set sample ID and envelope
    lda!({DSPADDR})
    eor!({#Voice::sampnum ^ Voice::rvol})
    sta!({DSPADDR})
    ldy!({#2})
    lda!({(instptr),y})
    sta!({DSPDATA})
    inc!({DSPADDR})
    iny!()
    lda!({(instptr),y})
    sta!({DSPDATA})
    inc!({DSPADDR})
    iny!()
    lda!({(instptr),y})
    sta!({DSPDATA})

    ; Return the frequency scale
    ldy!({#1})
    lda!({(instptr),y})
    rts!()
}

; Calculate which notes are ready to be keyed off.
; Sending a key off command takes 2 samples (64 cycles), which
; starts a fade-out process that takes up to 256 samples (8 ms).
; So find which voices are ready for key off and on, and do so.
.data keyoff_ready_notes {
    unready_chs = $07

    ldx!({#NUM_CHANNELS - 1})
@loop:
    ; Bit 7 of ready_notes is 1 for no keyoff or 0 for keyoff.
    lda!({ready_notes,x})
    asl!({a})
    rol!({unready_chs})
    dex!()
    bpl!(@loop)
    lda!({#Dsp::keyoff})
    sta!({DSPADDR})
    lda!({unready_chs})
    eor!({#$FF})
    sta!({DSPDATA})
    rts!()
}

.data keyon_ready_notes {
    unready_chs = $07

    ldx!({#NUM_CHANNELS - 1})
@loop:
    ; Bit 7 of ready_notes is 1 for no keyon or 0 for keyon.
    ; $78-$7F are invalid notes used to key off without keying on.
    lda!({ready_notes,x})
    cmp!({#$78})
    bcs!(@not_ready)
    lda!({noteInstrument,x})
    jsr!(ch_set_inst)
    pha!()
    lda!({ready_notes,x})
    tay!()
    pla!()
    jsr!(ch_set_pitch)

    clc!()
@not_ready:
    rol!({unready_chs})

    ; Acknowledge key on
    lda!({#$FF})
    sta!({ready_notes,x})
    dex!()
    bpl!(@loop)
    lda!({#Dsp::keyoff})
    ldy!({#0})
    stya!(DSPADDR)
    lda!({#Dsp::keyon})
    sta!({DSPADDR})
    lda!({unready_chs})
    eor!({#$FF})
    sta!({DSPDATA})
    rts!()
}

; Sample data ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.data pulse_2_brr {
    .byte $B0,$9B,$BB,$BB,$BB,$BB,$BB,$BB,$B9
    .byte $B3,$75,$55,$55,$55,$55,$55,$55,$57
}
.data pulse_4_brr {
    .byte $B0,$9B,$BB,$BB,$B9,$75,$55,$55,$55
    .byte $B3,$55,$55,$55,$55,$55,$55,$55,$57
}
.data pulse_8_brr {
    .byte $B0,$9B,$B9,$75,$55,$55,$55,$55,$55
    .byte $B3,$55,$55,$55,$55,$55,$55,$55,$57
}
; The triangle wave is intentionally distorted slightly because the
; SPC700's Gaussian interpolator has a glitch with three
; consecutive 8<<12 samples.
.data triangle_brr {
    .byte $C0,$00,$11,$22,$33,$44,$55,$66,$76
    .byte $C0,$77,$66,$55,$44,$33,$22,$11,$00
    .byte $C0,$FF,$EE,$DD,$CC,$BB,$AA,$99,$89
    .byte $C3,$88,$99,$AA,$BB,$CC,$DD,$EE,$FF
}
.data karplusbassloop_brr: .incbin "../build/assets/karplusbassloop.brr"
karplusbass_loop = .endof(karplusbassloop_brr) - 36     ; period 64 samples (36 bytes)
.data hat_brr:   .incbin "../build/assets/hat.brr"
.data kick_brr:  .incbin "../build/assets/kickgen.brr"
.data snare_brr: .incbin "../build/assets/decentsnare.brr"

; $ python3
; [round(261.625 * 8 / 7.8125 * 2**(i / 12)) - 256 for i in range(12)]
.data notefreqs_lowbyte: .byte 12, 28, 45, 63, 82, 102, 123, 145, 169, 195, 221, 250
.data one_shl_x:         .byte[] {
    .repeat 8, i {
        1 << i
    }
}
