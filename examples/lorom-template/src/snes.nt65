; S-CPU and S-PPU MMIO port definitions for the Super NES.
;
; Copyright 2014-2015 Damian Yerrick
;
; Copying and distribution of this file, with or without modification, are permitted in any
; medium without royalty provided the copyright notice and this notice are preserved in all
; source code copies.  This file is offered as-is, without any warranty.
;
; This module summarizes some of the Super NES MMIO ports.  For more details, see:
; http://wiki.superfamicom.org/
; http://problemkaputt.de/fullsnes.htm
;
; Names of MMIO ports here may differ from purported official names for two reasons: to
; avoid the appearance of misappropriation, and because sometimes these make more sense.
; The names Fullsnes uses are at the end, as aliases.
.module snes

.cpu 65816

; Every program bank of a small LoROM can reach low RAM, the PPU ports and the DMA ports, so
; a routine that reaches only those runs with the data bank at any of them, and is checked
; against every one.
.export .signature io = dbr = [$00..$3f, $80..$bf]

; S-PPU configuration ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export PPUBRIGHT = $2100
; 76543210
; |   ++++- brightness (F: max)
; +-------- 1: disable rendering
;
; Rendering on when bit 7 is false is the opposite sense from bit 7 of LCDC on Game Boy,
; but the same sense as bit 7 of DISPCNT on GBA.  Think of it as two's complement:
; rendering is on when brightness is positive or off when brightness is negative.
; "Is the PPU on?"
; "Negative."
.export FORCEBLANK = $80

.export PPURES = $2133
; 76543210
; ||  |||+- Screen interlace
; ||  ||+-- Shrink sprites vertically during interlace
; ||  |+--- 0: show lines 1-224; 1: show lines 1-239
; ||  +---- Show subscreen in left half of each pixel
; ||        (modes 012347; forced on in modes 56)
; |+------- In mode 7, use bit 7 of pixel color as priority
; +-------- External genlock, intended for SFC Titler. Use 0 on SNES.
.export INTERLACE    = $01
.export INTERLACEOBJ = $02
.export BG_TALL      = $04
.export SUB_HIRES    = $08
.export M7_EXTBG     = $40

.export PPUSTATUS1 = $213E
; 76543210  PPU address generator status
; ||  ++++- PPU1 version (always 1)
; |+------- 1: sprite overflow (>32 on a line) since the last vblank end
; +-------- 1: sliver overflow (>34 on a line) since the last vblank end
; this parallels bit 5 of $2002 on NES

.export PPUSTATUS2 = $213F
; 76543210  PPU compositor status
; || |++++- PPU2 version (1-3, not counting minor versions of 3)
; || +----- 1: PPU is configured for 50 Hz (PAL)
; |+------- 1: GETXY has happened since last PPUSTATUS2 read
; +-------- Toggles every vblank; reflects top/bottom interlace field

; S-PPU sprites ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export OBSEL = $2101
; 76543210
; ||||| ++- Sprite main pattern table (0=$0000, 1=$2000, 2=$4000, 3=$6000)
; |||++---- Alt pattern table offset (0=$1000, 1=$2000, 2=$3000, 3=$4000)
; +++------ 0: 8/16; 1: 8/32; 2: 8/64; 3: 16/32; 4: 16/32; 5: 32/64
;           (all sprites are square and 2D-mapped)
.export OBSIZE_8_16  = $00
.export OBSIZE_8_32  = $20
.export OBSIZE_8_64  = $40
.export OBSIZE_16_32 = $60
.export OBSIZE_16_64 = $80
.export OBSIZE_32_64 = $A0

.export OAMADDR   = $2102       ; 16-bit, 128 sprites followed by high-X/size table
.export OAMDATA   = $2104
.export OAMDATARD = $2138
; Parallels NES $2003, except apparently word-addressed.
; OAM random access is working here, unlike on NES.
; If bit 15 is set, value at start of frame apparently also
; controls which sprites are in front

; S-PPU background configuration ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export BGMODE = $2105
; 76543210
; |||||+++- 0: 4 planes 2 bpp
; |||||     1: 2 planes 4 bpp, 1 plane 2 bpp
; |||||     2: 2 planes 4 bpp, OPT
; |||||     3: 1 plane 8 bpp, 1 plane 4 bpp
; |||||     4: 1 plane 8 bpp, 1 plane 2 bpp, OPT
; |||||     5: 1 plane 4 bpp, 1 plane 2 bpp, hires
; |||||     6: 1 plane 4 bpp, OPT, hires
; |||||     7: 1 plane rot/scale
; ||||+---- In mode 1, set plane 2 high-prio in front of all others
; |||+----- Plane 0 tile size (0: 8x8, 1: 16x16)
; ||+------ Plane 1 tile size (0: 8x8, 1: 16x16)
; |+------- Plane 2 tile size (0: 8x8, 1: 16x16)
; +-------- Plane 3 tile size (0: 8x8, 1: 16x16)
;           Modes 5 and 6 use 16x8 instead of 8x8
;           Mode 7 always uses 8x8

.export MOSAIC = $2106
; 76543210
; |||||||+- Apply mosaic to plane 0 (or mode 7 high-prio horizontal)
; ||||||+-- Apply mosaic to plane 1 (or mode 7 high-prio vertical)
; |||||+--- Apply mosaic to plane 2
; ||||+---- Apply mosaic to plane 3
; ++++----- Pixel size minus 1 (0=1x1, 15=16x16)

.export NTADDR = $2107          ; through $210A
; 76543210
;  ||||||+- Nametable width (0: 1 screen, 1: 2 screens)
;  |||||+-- Nametable height (0: 1 screen, 1: 2 screens)
;  +++++--- Nametable base address in $400 units
; Each nametable in modes 0-6 is 32 rows, each 32 spaces long.
.export .func NTXY(xc, yc) = xc | (yc << 5)

.export BGCHRADDR = $210B
; FEDCBA98 76543210
;  ||| |||  ||| +++- Pattern table base address for plane 0
;  ||| |||  +++----- Same for plane 1
;  ||| +++---------- Same for plane 2
;  +++-------------- Same for plane 3

.export M7SEL = $211A
; 76543210
; ||    ||
; ||    |+- Flip screen horizontally
; ||    +-- Flip screen vertically
; ++------- 0: repeat entire mode 7 plane
;           2: transparent outside; 3: tile $00 repeating outside
.export M7_HFLIP    = $01
.export M7_VFLIP    = $02
.export M7_WRAP     = $00
.export M7_NOWRAP   = $80
.export M7_BORDER00 = $C0

; S-PPU scrolling ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export BGSCROLLX = $210D       ; double write low then high (000-3FF m0-6, 000-7FF m7)
.export BGSCROLLY = $210E       ; similar. reg 210F-2114 are same for other planes
; Hi-res scrolling in modes 5-6 moves by whole (sub+main) pixels in X
; but half scanlines in Y.
; The top visible line is the line below the value written here.
; For example, in 224-line mode, if 12 is written, lines 13 through
; 237 of the background are visible.  This differs from the NES.
;
; Mode 7 uses this value as the center of rotation.  This differs
; from the GBA, which fixes the center of rotation at the top left.

; 211B-2120 control mode 7 matrix; to be documented later

; S-PPU VRAM data port ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export PPUCTRL = $2115
; 76543210
; |   ||++- VRAM address increment (1, 32, 128, 128)
; |   ++--- Rotate low bits of address left by 3 (off, 8, 9, or 10)
; +-------- 0: Increment after low data port access; 1: after high
; Corresponds to bit 2 of $2000 on NES
.export VRAM_DOWN   = $01
.export VRAM_M7DOWN = $02
.export INC_DATAHI  = $80

.export PPUADDR     = $2116     ; Word address, not double-write anymore
.export PPUDATA     = $2118
.export PPUDATAHI   = $2119
.export PPUDATARD   = $2139     ; Same dummy read as on NES is needed
.export PPUDATARDHI = $213A

; S-PPU palette ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export CGADDR   = $2121
.export CGDATA   = $2122        ; 5-bit BGR, write twice, low byte first
.export CGDATARD = $213B        ; 5-bit BGR, read twice, low byte first
.export .func RGB(r, g, b) = r | (g << 5) | (b << 10)

; S-PPU window ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export BG12WINDOW = $2123
.export BG34WINDOW = $2124
.export OBJWINDOW  = $2125
; 76543210
; ||||||++- 0: disable window 1 on BG1/BG3/OBJ; 2: enable; 3: enable outside
; ||||++--- 0: disable window 2 on BG1/BG3/OBJ; 2: enable; 3: enable outside
; ||++----- 0: disable window 1 on BG2/BG4; 2: enable; 3: enable outside
; ++------- 0: disable window 2 on BG2/BG4; 2: enable; 3: enable outside

.export WINDOW1L = $2126
.export WINDOW1R = $2127
.export WINDOW2L = $2128
.export WINDOW2R = $2129

.export BGWINDOP  = $212A       ; Window op is how windows are combined when both
.export OBJWINDOP = $212B       ; windows 1 and 2 are enabled.
; 76543210
; ||||||++- Window op for plane 0 or sprites (0: or, 1: and, 2: xor, 3: xnor)
; ||||++--- Window op for plane 1 or color window
; ||++----- Window op for plane 2
; ++------- Window op for plane 3

; S-PPU blending (or "color math") ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The main layer enable reg, corresponding to PPUMASK on the NES,
; is BLENDMAIN.
.export BLENDMAIN  = $212C      ; Layers enabled for main input of blending
.export BLENDSUB   = $212D      ; Layers enabled for sub input of blending
.export WINDOWMAIN = $212E      ; Windows enabled for main input of blending
.export WINDOWSUB  = $212F      ; Windows enabled for sub input of blending
; 76543210
;    ||||+- plane 0
;    |||+-- plane 1
;    ||+--- plane 2
;    |+---- plane 3
;    +----- sprites
; BLENDMAIN roughly parallels NES $2001 bits 4-3,
; except that turning off both bits doesn't disable rendering.
; (Use PPUBRIGHT for that.)

; PPU1 appears to generate a stream of (main, sub) pairs, which
; PPU2 combines to form output colors.

; Blending parameters not documented yet.  Wait for a future demo.

; When BGMODE is 0-6 (or during vblank in mode 7), a fast 16x8
; signed multiply is available, finishing by the next CPU cycle.
.export M7MCAND    = $211B      ; write low then high
.export M7MUL      = $211C      ; 8-bit factor
.export M7PRODLO   = $2134
.export M7PRODHI   = $2135
.export M7PRODBANK = $2136

.export GETXY  = $2137          ; read while $4201 D7 is set: populate x and y coords
.export XCOORD = $213C          ; used with light guns, read twice
.export YCOORD = $213D          ; also read twice

; SPC700 communication ports ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export APU0 = $2140
.export APU1 = $2141
.export APU2 = $2142
.export APU3 = $2143

; S-CPU interrupt control ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export PPUNMI = $4200
; 76543210
; | ||   +- Automatically read controllers in first 4 lines of vblank
; | ++----- 0: no IRQ (and acknowledge any pending); 1: IRQs at HTIME;
; |         2: one IRQ at (0, VTIME); 3: one IRQ at (HTIME, VTIME)
; +-------- 1: Enable NMI at start of vblank
.export VBLANK_NMI = $80
.export HTIME_IRQ  = $10
.export VTIME_IRQ  = $20
.export HVTIME_IRQ = $30
.export AUTOREAD   = $01

.export HTIME   = $4207
.export HTIMEHI = $4208
.export VTIME   = $4209
.export VTIMEHI = $420A

.export NMISTATUS = $4210       ; read to acknowledge NMI
; 76543210
; |   ||||
; |   ++++- DMA controller version (1, 2) where v1 has an HDMA glitch
; +-------- 1: Vblank has started since last read (like $2002.d7 on NES)

; bit 7: htime/vtime IRQ occurred since last read; read to acknowledge
.export TIMESTATUS = $4211

.export VBLSTATUS = $4212
; 76543210
; ||     +- 0: Controller reading finished; 1: busy
; |+------- 1: In hblank (including hblank of vblank)
; +-------- 1: In vblank

; 0: slow ROM everywhere; 1: fast ROM in banks 80-FF (requires 120ns or faster PRG ROM)
.export ROMSPEED = $420D

; S-CPU controller I/O ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Manual controller reading behaves almost exactly as on Famicom.
; For games using up to 2 standard controllers, these aren't needed,
; as you can enable controller autoreading along with vblank NMIs.
; But for games using (multitap, mouse, etc.), you will need to
; read the extra bits separately after the autoreader finishes.
.export JOY0 = $4016
.export JOY1 = $4017

; In addition to the common strobe, each controller port has an
; additional output bit that can be used as, say, a chip select
; for SPI peripherals.
.export JOYOUT = $4201
; 76543210
; |+------- Controller 1 pin 6 output
; +-------- Controller 2 pin 6 output

; Results of the autoreader
.export JOY1CUR   = $4218       ; Bit 0: used by standard controllers
.export JOY2CUR   = $421A
.export JOY1B1CUR = $421C       ; Bit 1: used by multitap and a few oddball
.export JOY2B1CUR = $421E       ; input devices
; FEDCBA98 76543210
; BYSRUDLR AXLRTTTT
; |||||||| ||||++++- controller type (0: controller, 1: mouse)
; |||||||| ||++----- shoulder buttons
; ++-------++------- right face buttons
;   ||++++---------- Control Pad
;   ++-------------- center face buttons
.export .enum Key {
    B      = $8000
    Y      = $4000
    select = $2000
    start  = $1000
    up     = $0800
    down   = $0400
    left   = $0200
    right  = $0100
    A      = $0080
    X      = $0040
    L      = $0020
    R      = $0010
}

; It is also possible to read the controller by reading only the
; upper 8 bits in 8-bit mode (m=1).  This may be the path of least
; resistance for porting NES software to the Super NES.  Be careful
; not to mix _HI addresses with whole `Key` values or vice versa:
; the high byte of a key is `>Key::right`.
; A, X, L, and R cannot be read this way.
.export JOY1CUR_HI = JOY1CUR + 1
.export JOY2CUR_HI = JOY2CUR + 1

; S-CPU multiply and divide ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Multiply unit.  Also good for shifting pixels when drawing
; text in a proportional font.
.export CPUMCAND  = $4202       ; unchanged by multiplications
.export CPUMUL    = $4203       ; write here to fill CPUPROD 8 cycles later
.export CPUPROD   = $4216
.export CPUPRODHI = $4217

; Divide unit
.export CPUNUM    = $4204
.export CPUNUMHI  = $4205
.export CPUDEN    = $4206       ; write divisor to fill CPUQUOT/CPUREM 16 cycles later
.export CPUQUOT   = $4214
.export CPUQUOTHI = $4215
.export CPUREM    = CPUPROD
.export CPUREMHI  = CPUPRODHI

; S-CPU DMA ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export COPYSTART = $420B       ; writes of 1 << n start a DMA copy on channel n
.export HDMASTART = $420C       ; writes of 1 << n start HDMA on channel n
; Don't run a DMA copy while HDMA is enabled, or you might run into
; a defect in revision 1 of the S-CPU that causes crashing.

; There are 8 DMA channels.
; Registers for channels 1-7 start at $4310, $4320, ...
.export DMAMODE = $4300
; 76543210
; || ||+++- PPU address offset pattern
; || ||     0: 0     1: 01    2: 00    3: 0011  4: 0123  5: 0101
; || ++---- Memcpy only: 0: increment; 1: fixed; 2: decrement
; |+------- HDMA only: 1: Table contains pointers
; +-------- Direction (0: read CPU write PPU; 1: read PPU write CPU)
.export DMA_LINEAR   = $00
.export DMA_01       = $01
.export DMA_00       = $02      ; For HDMA to double write ports; copies can use linear
.export DMA_0011     = $03      ; For HDMA to scroll positions and mode 7 matrices
.export DMA_0123     = $04      ; For HDMA to window registers
.export DMA_0101     = $05      ; Not sure how this would be useful for HDMA
.export DMA_FORWARD  = $00
.export DMA_CONST    = $08
.export DMA_BACKWARD = $10
.export DMA_INDIRECT = $40
.export DMA_READPPU  = $80

.export DMAPPUREG   = $4301
.export DMAADDR     = $4302
.export DMAADDRHI   = $4303
.export DMAADDRBANK = $4304
.export DMALEN      = $4305     ; number of bytes, not number of transfers; 0 means 65536
.export DMALENHI    = $4306

; A future demo that includes HDMA effects would include port definitions.
;HDMAINDBANK = $4307
;HDMATABLELO = $4308
;HDMATABLEHI = $4309
;HDMALINE    = $430A

; composite values for use with 16-bit writes to DMAMODE
.export DMAMODE_PPULOFILL = ((<PPUDATA) << 8)       | DMA_LINEAR | DMA_CONST
.export DMAMODE_PPUHIFILL = ((<(PPUDATA + 1)) << 8) | DMA_LINEAR | DMA_CONST
.export DMAMODE_PPUFILL   = ((<PPUDATA) << 8)       | DMA_01     | DMA_CONST
.export DMAMODE_PPULODATA = ((<PPUDATA) << 8)       | DMA_LINEAR | DMA_FORWARD
.export DMAMODE_PPUHIDATA = ((<(PPUDATA + 1)) << 8) | DMA_LINEAR | DMA_FORWARD
.export DMAMODE_PPUDATA   = ((<PPUDATA) << 8)       | DMA_01     | DMA_FORWARD
.export DMAMODE_CGDATA    = ((<CGDATA) << 8)        | DMA_00     | DMA_FORWARD
.export DMAMODE_OAMDATA   = ((<OAMDATA) << 8)       | DMA_00     | DMA_FORWARD

; FULLSNES NAMES ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
; These aliases match the names presented in Fullsnes.

; S-PPU write
.export INIDISP = PPUBRIGHT
.export OAMADDL = OAMADDR + 0
.export OAMADDH = OAMADDR + 1
.export BG1SC   = NTADDR + 0
.export BG2SC   = NTADDR + 1
.export BG3SC   = NTADDR + 2
.export BG4SC   = NTADDR + 3
.export BG12NBA = BGCHRADDR + 0 ; Welcome to...
.export BG34NBA = BGCHRADDR + 1 ; BG34NBA JAM!!!
.export BG1HOFS = BGSCROLLX + 0
.export BG1VOFS = BGSCROLLY + 0
.export BG2HOFS = BGSCROLLX + 2
.export BG2VOFS = BGSCROLLY + 2
.export BG3HOFS = BGSCROLLX + 4
.export BG3VOFS = BGSCROLLY + 4
.export BG4HOFS = BGSCROLLX + 6
.export BG4VOFS = BGSCROLLY + 6
.export VMAIN   = PPUCTRL
.export VMADDL  = PPUADDR + 0
.export VMADDH  = PPUADDR + 1
.export VMDATAL = PPUDATA + 0
.export VMDATAH = PPUDATA + 1
.export M7A     = $211B
.export M7B     = $211C
.export M7C     = $211D
.export M7D     = $211E
.export M7X     = $211F
.export M7Y     = $2120
.export CGADD   = CGADDR
.export W12SEL  = BG12WINDOW
.export W34SEL  = BG34WINDOW
.export WOBJSEL = OBJWINDOW
.export WH0     = WINDOW1L
.export WH1     = WINDOW1R
.export WH2     = WINDOW2L
.export WH3     = WINDOW2R
.export WBGLOG  = BGWINDOP
.export WOBJLOG = OBJWINDOP
.export TM      = BLENDMAIN
.export TS      = BLENDSUB
.export TMW     = WINDOWMAIN
.export TSW     = WINDOWSUB
.export CGWSEL  = $2130
.export CGADSUB = $2131
.export COLDATA = $2132
.export SETINI  = PPURES

; S-PPU read
.export MPYL    = M7PRODLO
.export MPYM    = M7PRODHI
.export MPYH    = M7PRODBANK
.export SLHV    = GETXY
.export RDOAM   = OAMDATARD
.export RDVRAML = PPUDATARD
.export RDVRAMH = PPUDATARDHI
.export RDCGRAM = CGDATARD
.export OPHCT   = XCOORD
.export OPVCT   = YCOORD
.export STAT77  = PPUSTATUS1
.export STAT78  = PPUSTATUS2

; other B bus devices
.export APUIO0 = APU0           ; didn't want to use capital O with digit 0
.export APUIO1 = APU1
.export APUIO2 = APU2
.export APUIO3 = APU3
.export WMDATA = $2180
.export WMADDL = $2181
.export WMADDM = $2182
.export WMADDH = $2183

; S-CPU I/O write
.export NMITIMEN = $4200
.export WRIO     = $4201
.export WRMPYA   = CPUMCAND
.export WRMPYB   = CPUMUL
.export WRDIVL   = CPUNUM
.export WRDIVH   = CPUNUMHI
.export WRDIVB   = CPUDEN
.export HTIMEL   = HTIME
.export HTIMEH   = HTIMEHI
.export VTIMEL   = VTIME
.export VTIMEH   = VTIMEHI
.export MDMAEN   = COPYSTART    ; where I come from MDMA is a drug
.export HDMAEN   = HDMASTART
.export MEMSEL   = ROMSPEED

; S-CPU I/O read
.export RDNMI  = NMISTATUS
.export TIMEUP = TIMESTATUS
.export HVBJOY = VBLSTATUS
.export RDIO   = $4213
.export RDDIVL = CPUQUOT
.export RDDIVH = CPUQUOT + 1
.export RDMPYL = CPUPROD
.export RDMPYH = CPUPROD + 1
.export JOY1L  = JOY1CUR + 0
.export JOY1H  = JOY1CUR + 1
.export JOY2L  = JOY2CUR + 0
.export JOY2H  = JOY2CUR + 1
.export JOY3L  = JOY1B1CUR + 0
.export JOY3H  = JOY1B1CUR + 1
.export JOY4L  = JOY2B1CUR + 0
.export JOY4H  = JOY2B1CUR + 1
