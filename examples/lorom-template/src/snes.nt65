; S-CPU and S-PPU MMIO port definitions for the Super NES.
;
; Copyright 2014-2015 Damian Yerrick
;
; Copying and distribution of this file, with or without modification, are permitted in any
; medium without royalty provided the copyright notice and this notice are preserved in all
; source code copies.  This file is offered as-is, without any warranty.
;
; This module summarizes some of the Super NES MMIO ports.  For more details, see:
; http://wiki.superfamicom.org/
; http://problemkaputt.de/fullsnes.htm
;
; Names of MMIO ports here may differ from purported official names for two reasons: to
; avoid the appearance of misappropriation, and because sometimes these make more sense.
; The names Fullsnes uses are at the end, as aliases.
.module snes

.cpu 65816

; Every program bank of a small LoROM can reach low RAM, the PPU ports and the DMA ports, so
; a routine that reaches only those runs with the data bank at any of them, and is checked
; against every one.
.export .signature io = dbr = [$00..$3f, $80..$bf]

; S-PPU configuration ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export .mmio PPUBRIGHT: .byte = $2100
; 76543210
; |   ++++- brightness (F: max)
; +-------- 1: disable rendering
;
; Rendering on when bit 7 is false is the opposite sense from bit 7 of LCDC on Game Boy,
; but the same sense as bit 7 of DISPCNT on GBA.  Think of it as two's complement:
; rendering is on when brightness is positive or off when brightness is negative.
; "Is the PPU on?"
; "Negative."
.export .const FORCEBLANK = $80

.export .mmio PPURES: .byte = $2133
; 76543210
; ||  |||+- Screen interlace
; ||  ||+-- Shrink sprites vertically during interlace
; ||  |+--- 0: show lines 1-224; 1: show lines 1-239
; ||  +---- Show subscreen in left half of each pixel
; ||        (modes 012347; forced on in modes 56)
; |+------- In mode 7, use bit 7 of pixel color as priority
; +-------- External genlock, intended for SFC Titler. Use 0 on SNES.
.export .const INTERLACE    = $01
.export .const INTERLACEOBJ = $02
.export .const BG_TALL      = $04
.export .const SUB_HIRES    = $08
.export .const M7_EXTBG     = $40

.export .mmio PPUSTATUS1: .byte = $213E
; 76543210  PPU address generator status
; ||  ++++- PPU1 version (always 1)
; |+------- 1: sprite overflow (>32 on a line) since the last vblank end
; +-------- 1: sliver overflow (>34 on a line) since the last vblank end
; this parallels bit 5 of $2002 on NES

.export .mmio PPUSTATUS2: .byte = $213F
; 76543210  PPU compositor status
; || |++++- PPU2 version (1-3, not counting minor versions of 3)
; || +----- 1: PPU is configured for 50 Hz (PAL)
; |+------- 1: GETXY has happened since last PPUSTATUS2 read
; +-------- Toggles every vblank; reflects top/bottom interlace field

; S-PPU sprites ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export .mmio OBSEL: .byte = $2101
; 76543210
; ||||| ++- Sprite main pattern table (0=$0000, 1=$2000, 2=$4000, 3=$6000)
; |||++---- Alt pattern table offset (0=$1000, 1=$2000, 2=$3000, 3=$4000)
; +++------ 0: 8/16; 1: 8/32; 2: 8/64; 3: 16/32; 4: 16/32; 5: 32/64
;           (all sprites are square and 2D-mapped)
.export .const OBSIZE_8_16  = $00
.export .const OBSIZE_8_32  = $20
.export .const OBSIZE_8_64  = $40
.export .const OBSIZE_16_32 = $60
.export .const OBSIZE_16_64 = $80
.export .const OBSIZE_32_64 = $A0

.export .mmio OAMADDR:   .word = $2102  ; 16-bit, 128 sprites followed by high-X/size table
.export .mmio OAMDATA:   .byte = $2104
.export .mmio OAMDATARD: .byte = $2138
; Parallels NES $2003, except apparently word-addressed.
; OAM random access is working here, unlike on NES.
; If bit 15 is set, value at start of frame apparently also
; controls which sprites are in front

; S-PPU background configuration ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export .mmio BGMODE: .byte = $2105
; 76543210
; |||||+++- 0: 4 planes 2 bpp
; |||||     1: 2 planes 4 bpp, 1 plane 2 bpp
; |||||     2: 2 planes 4 bpp, OPT
; |||||     3: 1 plane 8 bpp, 1 plane 4 bpp
; |||||     4: 1 plane 8 bpp, 1 plane 2 bpp, OPT
; |||||     5: 1 plane 4 bpp, 1 plane 2 bpp, hires
; |||||     6: 1 plane 4 bpp, OPT, hires
; |||||     7: 1 plane rot/scale
; ||||+---- In mode 1, set plane 2 high-prio in front of all others
; |||+----- Plane 0 tile size (0: 8x8, 1: 16x16)
; ||+------ Plane 1 tile size (0: 8x8, 1: 16x16)
; |+------- Plane 2 tile size (0: 8x8, 1: 16x16)
; +-------- Plane 3 tile size (0: 8x8, 1: 16x16)
;           Modes 5 and 6 use 16x8 instead of 8x8
;           Mode 7 always uses 8x8

.export .mmio MOSAIC: .byte = $2106
; 76543210
; |||||||+- Apply mosaic to plane 0 (or mode 7 high-prio horizontal)
; ||||||+-- Apply mosaic to plane 1 (or mode 7 high-prio vertical)
; |||||+--- Apply mosaic to plane 2
; ||||+---- Apply mosaic to plane 3
; ++++----- Pixel size minus 1 (0=1x1, 15=16x16)

.export .mmio NTADDR: .byte[4] = $2107  ; through $210A
; 76543210
;  ||||||+- Nametable width (0: 1 screen, 1: 2 screens)
;  |||||+-- Nametable height (0: 1 screen, 1: 2 screens)
;  +++++--- Nametable base address in $400 units
; Each nametable in modes 0-6 is 32 rows, each 32 spaces long.
.export .func NTXY(xc, yc) = xc | (yc << 5)

.export .mmio BGCHRADDR: .byte[2] = $210B
; FEDCBA98 76543210
;  ||| |||  ||| +++- Pattern table base address for plane 0
;  ||| |||  +++----- Same for plane 1
;  ||| +++---------- Same for plane 2
;  +++-------------- Same for plane 3

.export .mmio M7SEL: .byte = $211A
; 76543210
; ||    ||
; ||    |+- Flip screen horizontally
; ||    +-- Flip screen vertically
; ++------- 0: repeat entire mode 7 plane
;           2: transparent outside; 3: tile $00 repeating outside
.export .const M7_HFLIP    = $01
.export .const M7_VFLIP    = $02
.export .const M7_WRAP     = $00
.export .const M7_NOWRAP   = $80
.export .const M7_BORDER00 = $C0

; S-PPU scrolling ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export .mmio BGSCROLLX: .byte[7] = $210D  ; double write low then high (000-3FF m0-6, 000-7FF m7)
.export .mmio BGSCROLLY: .byte[7] = $210E  ; similar. reg 210F-2114 are same for other planes
; Hi-res scrolling in modes 5-6 moves by whole (sub+main) pixels in X
; but half scanlines in Y.
; The top visible line is the line below the value written here.
; For example, in 224-line mode, if 12 is written, lines 13 through
; 237 of the background are visible.  This differs from the NES.
;
; Mode 7 uses this value as the center of rotation.  This differs
; from the GBA, which fixes the center of rotation at the top left.

; 211B-2120 control mode 7 matrix; to be documented later

; S-PPU VRAM data port ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export .mmio PPUCTRL: .byte = $2115
; 76543210
; |   ||++- VRAM address increment (1, 32, 128, 128)
; |   ++--- Rotate low bits of address left by 3 (off, 8, 9, or 10)
; +-------- 0: Increment after low data port access; 1: after high
; Corresponds to bit 2 of $2000 on NES
.export .const VRAM_DOWN   = $01
.export .const VRAM_M7DOWN = $02
.export .const INC_DATAHI  = $80

.export .mmio PPUADDR:     .word = $2116  ; Word address, not double-write anymore
.export .mmio PPUDATA:     .word = $2118
.export .mmio PPUDATAHI:   .byte = $2119
.export .mmio PPUDATARD:   .byte = $2139  ; Same dummy read as on NES is needed
.export .mmio PPUDATARDHI: .byte = $213A

; S-PPU palette ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export .mmio CGADDR:   .byte = $2121
.export .mmio CGDATA:   .byte = $2122  ; 5-bit BGR, write twice, low byte first
.export .mmio CGDATARD: .byte = $213B  ; 5-bit BGR, read twice, low byte first
.export .func RGB(r, g, b) = r | (g << 5) | (b << 10)

; S-PPU window ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export .mmio BG12WINDOW: .byte = $2123
.export .mmio BG34WINDOW: .byte = $2124
.export .mmio OBJWINDOW:  .byte = $2125
; 76543210
; ||||||++- 0: disable window 1 on BG1/BG3/OBJ; 2: enable; 3: enable outside
; ||||++--- 0: disable window 2 on BG1/BG3/OBJ; 2: enable; 3: enable outside
; ||++----- 0: disable window 1 on BG2/BG4; 2: enable; 3: enable outside
; ++------- 0: disable window 2 on BG2/BG4; 2: enable; 3: enable outside

.export .mmio WINDOW1L: .byte = $2126
.export .mmio WINDOW1R: .byte = $2127
.export .mmio WINDOW2L: .byte = $2128
.export .mmio WINDOW2R: .byte = $2129

.export .mmio BGWINDOP:  .byte = $212A  ; Window op is how windows are combined when both
.export .mmio OBJWINDOP: .byte = $212B  ; windows 1 and 2 are enabled.
; 76543210
; ||||||++- Window op for plane 0 or sprites (0: or, 1: and, 2: xor, 3: xnor)
; ||||++--- Window op for plane 1 or color window
; ||++----- Window op for plane 2
; ++------- Window op for plane 3

; S-PPU blending (or "color math") ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The main layer enable reg, corresponding to PPUMASK on the NES,
; is BLENDMAIN.
.export .mmio BLENDMAIN:  .byte = $212C  ; Layers enabled for main input of blending
.export .mmio BLENDSUB:   .byte = $212D  ; Layers enabled for sub input of blending
.export .mmio WINDOWMAIN: .byte = $212E  ; Windows enabled for main input of blending
.export .mmio WINDOWSUB:  .byte = $212F  ; Windows enabled for sub input of blending
; 76543210
;    ||||+- plane 0
;    |||+-- plane 1
;    ||+--- plane 2
;    |+---- plane 3
;    +----- sprites
; BLENDMAIN roughly parallels NES $2001 bits 4-3,
; except that turning off both bits doesn't disable rendering.
; (Use PPUBRIGHT for that.)

; PPU1 appears to generate a stream of (main, sub) pairs, which
; PPU2 combines to form output colors.

; Blending parameters not documented yet.  Wait for a future demo.

; When BGMODE is 0-6 (or during vblank in mode 7), a fast 16x8
; signed multiply is available, finishing by the next CPU cycle.
.export .mmio M7MCAND:    .byte = $211B  ; write low then high
.export .mmio M7MUL:      .byte = $211C  ; 8-bit factor
.export .mmio M7PRODLO:   .byte = $2134
.export .mmio M7PRODHI:   .byte = $2135
.export .mmio M7PRODBANK: .byte = $2136

.export .mmio GETXY:  .byte = $2137  ; read while $4201 D7 is set: populate x and y coords
.export .mmio XCOORD: .byte = $213C  ; used with light guns, read twice
.export .mmio YCOORD: .byte = $213D  ; also read twice

; SPC700 communication ports ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export .mmio APU0: .byte = $2140
.export .mmio APU1: .byte = $2141
.export .mmio APU2: .byte = $2142
.export .mmio APU3: .byte = $2143

; S-CPU interrupt control ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export .mmio PPUNMI: .byte = $4200
; 76543210
; | ||   +- Automatically read controllers in first 4 lines of vblank
; | ++----- 0: no IRQ (and acknowledge any pending); 1: IRQs at HTIME;
; |         2: one IRQ at (0, VTIME); 3: one IRQ at (HTIME, VTIME)
; +-------- 1: Enable NMI at start of vblank
.export .const VBLANK_NMI = $80
.export .const HTIME_IRQ  = $10
.export .const VTIME_IRQ  = $20
.export .const HVTIME_IRQ = $30
.export .const AUTOREAD   = $01

.export .mmio HTIME:   .byte = $4207
.export .mmio HTIMEHI: .byte = $4208
.export .mmio VTIME:   .byte = $4209
.export .mmio VTIMEHI: .byte = $420A

.export .mmio NMISTATUS: .byte = $4210  ; read to acknowledge NMI
; 76543210
; |   ||||
; |   ++++- DMA controller version (1, 2) where v1 has an HDMA glitch
; +-------- 1: Vblank has started since last read (like $2002.d7 on NES)

; bit 7: htime/vtime IRQ occurred since last read; read to acknowledge
.export .mmio TIMESTATUS: .byte = $4211

.export .mmio VBLSTATUS: .byte = $4212
; 76543210
; ||     +- 0: Controller reading finished; 1: busy
; |+------- 1: In hblank (including hblank of vblank)
; +-------- 1: In vblank

; 0: slow ROM everywhere; 1: fast ROM in banks 80-FF (requires 120ns or faster PRG ROM)
.export .mmio ROMSPEED: .byte = $420D

; S-CPU controller I/O ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Manual controller reading behaves almost exactly as on Famicom.
; For games using up to 2 standard controllers, these aren't needed,
; as you can enable controller autoreading along with vblank NMIs.
; But for games using (multitap, mouse, etc.), you will need to
; read the extra bits separately after the autoreader finishes.
.export .mmio JOY0: .byte = $4016
.export .mmio JOY1: .byte = $4017

; In addition to the common strobe, each controller port has an
; additional output bit that can be used as, say, a chip select
; for SPI peripherals.
.export .mmio JOYOUT: .byte = $4201
; 76543210
; |+------- Controller 1 pin 6 output
; +-------- Controller 2 pin 6 output

; Results of the autoreader
.export .mmio JOY1CUR:   .word = $4218  ; Bit 0: used by standard controllers
.export .mmio JOY2CUR:   .word = $421A
.export .mmio JOY1B1CUR: .word = $421C  ; Bit 1: used by multitap and a few oddball
.export .mmio JOY2B1CUR: .word = $421E  ; input devices
; FEDCBA98 76543210
; BYSRUDLR AXLRTTTT
; |||||||| ||||++++- controller type (0: controller, 1: mouse)
; |||||||| ||++----- shoulder buttons
; ++-------++------- right face buttons
;   ||++++---------- Control Pad
;   ++-------------- center face buttons
.export .enum Key {
    B      = $8000
    Y      = $4000
    select = $2000
    start  = $1000
    up     = $0800
    down   = $0400
    left   = $0200
    right  = $0100
    A      = $0080
    X      = $0040
    L      = $0020
    R      = $0010
}

; It is also possible to read the controller by reading only the
; upper 8 bits in 8-bit mode (m=1).  This may be the path of least
; resistance for porting NES software to the Super NES.  Be careful
; not to mix _HI addresses with whole `Key` values or vice versa:
; the high byte of a key is `>Key::right`.
; A, X, L, and R cannot be read this way.
.export .mmio JOY1CUR_HI: .byte = JOY1CUR + 1
.export .mmio JOY2CUR_HI: .byte = JOY2CUR + 1

; S-CPU multiply and divide ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Multiply unit.  Also good for shifting pixels when drawing
; text in a proportional font.
.export .mmio CPUMCAND:  .byte = $4202  ; unchanged by multiplications
.export .mmio CPUMUL:    .byte = $4203  ; write here to fill CPUPROD 8 cycles later
.export .mmio CPUPROD:   .word = $4216
.export .mmio CPUPRODHI: .byte = $4217

; Divide unit
.export .mmio CPUNUM:    .byte = $4204
.export .mmio CPUNUMHI:  .byte = $4205
.export .mmio CPUDEN:    .byte = $4206  ; write divisor to fill CPUQUOT/CPUREM 16 cycles later
.export .mmio CPUQUOT:   .word = $4214
.export .mmio CPUQUOTHI: .byte = $4215
.export .mmio CPUREM:    .byte = CPUPROD
.export .mmio CPUREMHI:  .byte = CPUPRODHI

; S-CPU DMA ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.export .mmio COPYSTART: .byte = $420B  ; writes of 1 << n start a DMA copy on channel n
.export .mmio HDMASTART: .byte = $420C  ; writes of 1 << n start HDMA on channel n
; Don't run a DMA copy while HDMA is enabled, or you might run into
; a defect in revision 1 of the S-CPU that causes crashing.

; There are 8 DMA channels.
; Registers for channels 1-7 start at $4310, $4320, ...
.export .mmio DMAMODE: .byte = $4300
; 76543210
; || ||+++- PPU address offset pattern
; || ||     0: 0     1: 01    2: 00    3: 0011  4: 0123  5: 0101
; || ++---- Memcpy only: 0: increment; 1: fixed; 2: decrement
; |+------- HDMA only: 1: Table contains pointers
; +-------- Direction (0: read CPU write PPU; 1: read PPU write CPU)
.export .const DMA_LINEAR   = $00
.export .const DMA_01       = $01
.export .const DMA_00       = $02   ; For HDMA to double write ports; copies can use linear
.export .const DMA_0011     = $03   ; For HDMA to scroll positions and mode 7 matrices
.export .const DMA_0123     = $04   ; For HDMA to window registers
.export .const DMA_0101     = $05   ; Not sure how this would be useful for HDMA
.export .const DMA_FORWARD  = $00
.export .const DMA_CONST    = $08
.export .const DMA_BACKWARD = $10
.export .const DMA_INDIRECT = $40
.export .const DMA_READPPU  = $80

.export .mmio DMAPPUREG:   .byte = $4301
.export .mmio DMAADDR:     .byte = $4302
.export .mmio DMAADDRHI:   .byte = $4303
.export .mmio DMAADDRBANK: .byte = $4304
.export .mmio DMALEN:      .byte = $4305  ; number of bytes, not number of transfers; 0 means 65536
.export .mmio DMALENHI:    .byte = $4306

; A future demo that includes HDMA effects would include port definitions.
;HDMAINDBANK = $4307
;HDMATABLELO = $4308
;HDMATABLEHI = $4309
;HDMALINE    = $430A

; composite values for use with 16-bit writes to DMAMODE
.export .const DMAMODE_PPULOFILL = ((<PPUDATA) << 8)       | DMA_LINEAR | DMA_CONST
.export .const DMAMODE_PPUHIFILL = ((<(PPUDATA + 1)) << 8) | DMA_LINEAR | DMA_CONST
.export .const DMAMODE_PPUFILL   = ((<PPUDATA) << 8)       | DMA_01     | DMA_CONST
.export .const DMAMODE_PPULODATA = ((<PPUDATA) << 8)       | DMA_LINEAR | DMA_FORWARD
.export .const DMAMODE_PPUHIDATA = ((<(PPUDATA + 1)) << 8) | DMA_LINEAR | DMA_FORWARD
.export .const DMAMODE_PPUDATA   = ((<PPUDATA) << 8)       | DMA_01     | DMA_FORWARD
.export .const DMAMODE_CGDATA    = ((<CGDATA) << 8)        | DMA_00     | DMA_FORWARD
.export .const DMAMODE_OAMDATA   = ((<OAMDATA) << 8)       | DMA_00     | DMA_FORWARD

; FULLSNES NAMES ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;
; These aliases match the names presented in Fullsnes.

; S-PPU write
.export .mmio INIDISP: .byte = PPUBRIGHT
.export .mmio OAMADDL: .byte = OAMADDR + 0
.export .mmio OAMADDH: .byte = OAMADDR + 1
.export .mmio BG1SC:   .byte = NTADDR + 0
.export .mmio BG2SC:   .byte = NTADDR + 1
.export .mmio BG3SC:   .byte = NTADDR + 2
.export .mmio BG4SC:   .byte = NTADDR + 3
.export .mmio BG12NBA: .byte = BGCHRADDR + 0  ; Welcome to...
.export .mmio BG34NBA: .byte = BGCHRADDR + 1  ; BG34NBA JAM!!!
.export .mmio BG1HOFS: .byte = BGSCROLLX + 0
.export .mmio BG1VOFS: .byte = BGSCROLLY + 0
.export .mmio BG2HOFS: .byte = BGSCROLLX + 2
.export .mmio BG2VOFS: .byte = BGSCROLLY + 2
.export .mmio BG3HOFS: .byte = BGSCROLLX + 4
.export .mmio BG3VOFS: .byte = BGSCROLLY + 4
.export .mmio BG4HOFS: .byte = BGSCROLLX + 6
.export .mmio BG4VOFS: .byte = BGSCROLLY + 6
.export .mmio VMAIN:   .byte = PPUCTRL
.export .mmio VMADDL:  .byte = PPUADDR + 0
.export .mmio VMADDH:  .byte = PPUADDR + 1
.export .mmio VMDATAL: .byte = PPUDATA + 0
.export .mmio VMDATAH: .byte = PPUDATA + 1
.export .mmio M7A:     .byte = $211B
.export .mmio M7B:     .byte = $211C
.export .mmio M7C:     .byte = $211D
.export .mmio M7D:     .byte = $211E
.export .mmio M7X:     .byte = $211F
.export .mmio M7Y:     .byte = $2120
.export .mmio CGADD:   .byte = CGADDR
.export .mmio W12SEL:  .byte = BG12WINDOW
.export .mmio W34SEL:  .byte = BG34WINDOW
.export .mmio WOBJSEL: .byte = OBJWINDOW
.export .mmio WH0:     .byte = WINDOW1L
.export .mmio WH1:     .byte = WINDOW1R
.export .mmio WH2:     .byte = WINDOW2L
.export .mmio WH3:     .byte = WINDOW2R
.export .mmio WBGLOG:  .byte = BGWINDOP
.export .mmio WOBJLOG: .byte = OBJWINDOP
.export .mmio TM:      .byte = BLENDMAIN
.export .mmio TS:      .byte = BLENDSUB
.export .mmio TMW:     .byte = WINDOWMAIN
.export .mmio TSW:     .byte = WINDOWSUB
.export .mmio CGWSEL:  .byte = $2130
.export .mmio CGADSUB: .byte = $2131
.export .mmio COLDATA: .byte = $2132
.export .mmio SETINI:  .byte = PPURES

; S-PPU read
.export .mmio MPYL:    .byte = M7PRODLO
.export .mmio MPYM:    .byte = M7PRODHI
.export .mmio MPYH:    .byte = M7PRODBANK
.export .mmio SLHV:    .byte = GETXY
.export .mmio RDOAM:   .byte = OAMDATARD
.export .mmio RDVRAML: .byte = PPUDATARD
.export .mmio RDVRAMH: .byte = PPUDATARDHI
.export .mmio RDCGRAM: .byte = CGDATARD
.export .mmio OPHCT:   .byte = XCOORD
.export .mmio OPVCT:   .byte = YCOORD
.export .mmio STAT77:  .byte = PPUSTATUS1
.export .mmio STAT78:  .byte = PPUSTATUS2

; other B bus devices
.export .mmio APUIO0: .byte = APU0  ; didn't want to use capital O with digit 0
.export .mmio APUIO1: .byte = APU1
.export .mmio APUIO2: .byte = APU2
.export .mmio APUIO3: .byte = APU3
.export .mmio WMDATA: .byte = $2180
.export .mmio WMADDL: .byte = $2181
.export .mmio WMADDM: .byte = $2182
.export .mmio WMADDH: .byte = $2183

; S-CPU I/O write
.export .mmio NMITIMEN: .byte = $4200
.export .mmio WRIO:     .byte = $4201
.export .mmio WRMPYA:   .byte = CPUMCAND
.export .mmio WRMPYB:   .byte = CPUMUL
.export .mmio WRDIVL:   .byte = CPUNUM
.export .mmio WRDIVH:   .byte = CPUNUMHI
.export .mmio WRDIVB:   .byte = CPUDEN
.export .mmio HTIMEL:   .byte = HTIME
.export .mmio HTIMEH:   .byte = HTIMEHI
.export .mmio VTIMEL:   .byte = VTIME
.export .mmio VTIMEH:   .byte = VTIMEHI
.export .mmio MDMAEN:   .byte = COPYSTART  ; where I come from MDMA is a drug
.export .mmio HDMAEN:   .byte = HDMASTART
.export .mmio MEMSEL:   .byte = ROMSPEED

; S-CPU I/O read
.export .mmio RDNMI:  .byte = NMISTATUS
.export .mmio TIMEUP: .byte = TIMESTATUS
.export .mmio HVBJOY: .byte = VBLSTATUS
.export .mmio RDIO:   .byte = $4213
.export .mmio RDDIVL: .byte = CPUQUOT
.export .mmio RDDIVH: .byte = CPUQUOT + 1
.export .mmio RDMPYL: .byte = CPUPROD
.export .mmio RDMPYH: .byte = CPUPROD + 1
.export .mmio JOY1L:  .byte = JOY1CUR + 0
.export .mmio JOY1H:  .byte = JOY1CUR + 1
.export .mmio JOY2L:  .byte = JOY2CUR + 0
.export .mmio JOY2H:  .byte = JOY2CUR + 1
.export .mmio JOY3L:  .byte = JOY1B1CUR + 0
.export .mmio JOY3H:  .byte = JOY1B1CUR + 1
