.module init: placed

.use defines::*
.use text::*
.use array::*
.use chrget::*
.use eval::*
.use extra::*
.use float::*
.use input::*
.use memory::*
.use misc1::*
.use misc2::*
.use print::*
.use program::*
.use rnd::*
.use token::*
.use trig::*
.use zeropage::*

.segment INIT

.if KBD {
    .export .proc FNDLIN2 {
        php
        jmp FNDLIN
    }
}

; ----------------------------------------------------------------------------
.export .proc PR_WRITTEN_BY {
    .if !KBD {
        .if !CONFIG_CBM_ALL {
            .if !AIM65 {
                .if !SYM1 {
                    lda #<QT_WRITTEN_BY
                    ldy #>QT_WRITTEN_BY
                    jsr STROUT
                }
            }
        }
    }
    .fallthrough COLD_START
}
.export .proc COLD_START {
    .if SYM1 {
        jsr ACCESS
    }
    .if KBD {
        lda #<LFD81
        sta $03A0
        lda #>LFD81
        sta $03A1
        lda #$20
        sta $0480
        lda $0352
        sta $04
        lda $0353
        sta $05
    } .else {
        .if !CBM2 {
            ldx #$FF
            stx CURLIN+1
        }
        .if CONFIG_NO_INPUTBUFFER_ZP {
            ldx #$FB
        } .elseif AIM65 {
            ldx #$FE
        }
        txs
        .if !CONFIG_CBM_ALL {
            lda #<COLD_START
            ldy #>COLD_START
            sta GORESTART+1
            sty GORESTART+2
            .if !AIM65 {
                sta GOSTROUT+1
                sty GOSTROUT+2
                lda #<AYINT
                ldy #>AYINT
                sta GOAYINT
                sty GOAYINT+1
                lda #<GIVAYF
                ldy #>GIVAYF
                sta GOGIVEAYF
                sty GOGIVEAYF+1
            }
        }
        lda #$4C
        .if CONFIG_CBM_ALL {
            sta JMPADRS
        }
        sta GORESTART
        .if AIM65 {
            sta JMPADRS
            sta ATN
            sta GOSTROUT
        } .else {
            .if !CONFIG_CBM_ALL {
                sta GOSTROUT
                sta JMPADRS
            }
            .if SYM1 {
                sta USR1
                sta USR3
                sta USR2
            }
            .if (!CONFIG_RAM) && (!CONFIG_CBM_ALL) {
                sta USR
            }
        }

        .if !CONFIG_RAM {
            .if APPLE {
                lda #<USR_FUNC
                ldy #>USR_FUNC
            } .else {
                lda #<IQERR
                ldy #>IQERR
            }
            .if AIM65 {
                sta ATN+1
                sty ATN+2
                sta GOSTROUT+1
                sty GOSTROUT+2
            } .else {
                sta USR+1
                sty USR+2
                .if SYM1 {
                    sta USR1+1
                    sty USR1+2
                    lda #<DUMPT
                    ldy #>DUMPT
                    sta USR2+1
                    sty USR2+2
                    lda #<L8C78
                    ldy #>L8C78
                    sta USR3+1
                    sty USR3+2
                }
            }
        }
        .if !CBM1 {
            lda #WIDTH
            sta Z17
            lda #WIDTH2
            sta Z18
        }
    }

    ; All non-CONFIG_SMALL versions of BASIC have
    ; the same bug here: While the number of bytes
    ; to be copied is correct for CONFIG_SMALL,
    ; it is one byte short on non-CONFIG_SMALL:
    ; It seems the "ldx" value below has been
    ; hardcoded. So on these configurations,
    ; the last byte of RNDSEED, which
    ; is 5 bytes instead of 4, does not get copied -
    ; which is nothing major, because it is just
    ; the least significant 8 bits of the mantissa
    ; of the random number seed.
    ; KBD added three bytes to CHRGET and removed
    ; the random number seed, but only adjusted
    ; the number of bytes by adding 3 - this
    ; copies four bytes too many, which is no
    ; problem.
    .if CONFIG_SMALL {
        .if KBD {
            ldx #RNDSEED - CHRGET + 4
        } .else {
            ldx #.endof(RNDSEED) - CHRGET
        }
    } .else {
        ldx #.endof(RNDSEED) - CHRGET - 1  ; XXX
    }
    L4098:
    lda .loadof(CHRGET)-1,x
    sta CHRGET-1,x
    dex
    bne L4098
    .if CONFIG_2 {
        lda #$03
        sta DSCLEN
    }
    .if KBD {
        .fallthrough LFD69
    } .else {
        txa
        sta SHIFTSIGNEXT
        .if CONFIG_CBM_ALL {
            sta CURDVC
        }
        sta LASTPT+1
        .if !AIM65 {
            .if CONFIG_NULL || CONFIG_PRINTNULLS {
                sta Z15
            }
        }
        .if !CONFIG_11 {
            sta POSX
        }
        pha
        sta Z14
        .if !CBM2 {
            .if !AIM65 {
                .if !SYM1 {
                    .if !MICROTAN {
                        lda #$03
                        sta DSCLEN
                    }
                }
            }
            .if !CONFIG_11 {
                lda #$2C
                sta LINNUM+1
            }
            jsr CRDO
        }
        .if CBM2 {
            inx
            stx INPUTBUFFER-3
            stx INPUTBUFFER-4
        }
        .if APPLE {
            lda #$01
            sta INPUTBUFFER-3
            sta INPUTBUFFER-4
        }
        ldx #TEMPST
        stx TEMPPT
        .if !CONFIG_CBM_ALL {
            lda #<QT_MEMORY_SIZE
            ldy #>QT_MEMORY_SIZE
            jsr STROUT
            .if APPLE {
                jsr INLINX
            } .else {
                jsr NXIN
            }
            stx TXTPTR
            sty TXTPTR+1
            jsr CHRGET
            .if !AIM65 {
                .if !SYM1 {
                    cmp #$41
                    beq PR_WRITTEN_BY
                }
            }
            tay
            bne L40EE
        }
        .if !CBM2 {
            lda #<RAMSTART2
        }
        ldy #>RAMSTART2
        .if CONFIG_2 {
            sta TXTTAB
            sty TXTTAB+1
        }
        sta LINNUM
        sty LINNUM+1
        .if CBM2 {
            tay
        } .else {
            ldy #$00
        }
        L40D7:
        inc LINNUM
        bne L40DD
        inc LINNUM+1
        .if CBM1 {
            ; CBM: hard RAM top limit is $8000
            lda LINNUM+1
            cmp #$80
            beq L40FA
        }
        .if CBM2 {
            ; optimized version of the CBM1 code
            bmi L40FA
        }
        .if AIM65 {
            ; AIM65: hard RAM top limit is $A000
            lda LINNUM+1
            cmp #$A0
            beq L40FA
        }
        L40DD:
        .if CONFIG_2 {
            lda #$55  ; 01010101 / 10101010
        } .else {
            lda #$92  ; 10010010 / 00100100
        }
        sta (LINNUM),y
        cmp (LINNUM),y
        bne L40FA
        asl a
        sta (LINNUM),y
        cmp (LINNUM),y
        .if CONFIG_CBM_ALL {
            beq L40D7
        } .else {
            .if !CONFIG_11 {
                beq L40D7  ; old: faster
                bne L40FA
            } .else {
                bne L40FA  ; new: slower
                beq L40D7
            }
            L40EE:
            jsr CHRGOT
            jsr LINGET
            tay
            beq L40FA
            jmp SYNERR
        }
        L40FA:
        lda LINNUM
        ldy LINNUM+1
        sta MEMSIZ
        sty MEMSIZ+1
        .if !(MICROTAN || AIM65 || SYM1) {
            sta FRETOP
            sty FRETOP+1
        }
        L4106:
        .if !CONFIG_CBM_ALL {
            .if APPLE {
                lda #$FF
                jmp L2829
                .word STROUT  ; PATCH!
                jsr NXIN
            } .else {
                lda #<QT_TERMINAL_WIDTH
                ldy #>QT_TERMINAL_WIDTH
                jsr STROUT
                jsr NXIN
            }
            stx TXTPTR
            sty TXTPTR+1
            jsr CHRGET
            tay
            beq L4136
            jsr LINGET
            lda LINNUM+1
            bne L4106
            lda LINNUM
            cmp #$10
            bcc L4106
            L2829:
            sta Z17
            L4129:
            .if AIM65 {
                sbc #$0A
            } .else {
                sbc #$0E
            }
            bcs L4129
            eor #$FF
            .if AIM65 {
                sbc #$08
            } .else {
                sbc #$0C
            }
            clc
            adc Z17
            sta Z18
        }
        L4136:
        .if CONFIG_RAM {
            lda #<QT_WANT
            ldy #>QT_WANT
            jsr STROUT
            jsr NXIN
            stx TXTPTR
            sty TXTPTR+1
            jsr CHRGET
            ldx #<.loadof(CHRGET)
            ldy #>.loadof(CHRGET)
            cmp #'Y'
            beq L4183
            cmp #'A'
            beq L4157
            cmp #'N'
            bne L4136
            L4157:
            ldx #<IQERR
            ldy #>IQERR
            stx UNFNC::atn
            sty UNFNC::atn+1
            ldx #<ATN  ; overwrite starting
            ldy #>ATN  ; with ATN
            cmp #'A'
            beq L4183
            ldx #<IQERR
            ldy #>IQERR
            stx UNFNC::cos
            sty UNFNC::cos+1
            stx UNFNC::tan
            sty UNFNC::tan+1
            stx UNFNC::sin
            sty UNFNC::sin+1
            ldx #<SIN_COS_TAN_ATN  ; overwrite
            ldy #>SIN_COS_TAN_ATN  ; all of trig.s
            L4183:
        } .else {
            ldx #<RAMSTART2
            ldy #>RAMSTART2
        }
        stx TXTTAB
        sty TXTTAB+1
        ldy #$00
        tya
        sta (TXTTAB),y
        inc TXTTAB
        .if !CBM2 {
            bne L4192
            inc TXTTAB+1
            L4192:
        }
        .if CONFIG_SCRTCH_ORDER == 1 {
            jsr SCRTCH
        }
        lda TXTTAB
        ldy TXTTAB+1
        jsr REASON
        .if CBM2 {
            lda #<QT_BASIC
            ldy #>QT_BASIC
            jsr STROUT
        } .else {
            jsr CRDO
        }
        lda MEMSIZ
        sec
        sbc TXTTAB
        tax
        lda MEMSIZ+1
        sbc TXTTAB+1
        jsr LINPRT
        lda #<QT_BYTES_FREE
        ldy #>QT_BYTES_FREE
        jsr STROUT
        .if CONFIG_SCRTCH_ORDER == 2 {
            jsr SCRTCH
        }
        .if CONFIG_CBM_ALL {
            jmp RESTART
        } .elseif AIM65 {
            lda #<CRDO
            ldy #>CRDO
            sta GORESTART+1
            sty GORESTART+2
            jmp RESTART
        } .else {
            lda #<STROUT
            ldy #>STROUT
            sta GOSTROUT+1
            sty GOSTROUT+2
            .if CONFIG_SCRTCH_ORDER == 3 {
                jsr SCRTCH
            }
            lda #<RESTART
            ldy #>RESTART
            sta GORESTART+1
            sty GORESTART+2
            jmp (GORESTART+1)
        }
    }
}

.if KBD {
    ; The end of the cold start. Upstream kept it with the extras, which every linker
    ; configuration puts straight after INIT, and the cold start ran on into it there.
    .export .proc LFD69 {
        stx SHIFTSIGNEXT
        stx $0800
        inx
        stx Z17
        stx Z18
        stx TXTTAB
        lda #$08
        sta TXTTAB+1
        jsr SCRTCH
        sta STACK+255
        .fallthrough LFD81
    }

    .export .proc LFD81 {
        jsr PRIMM
        .strz .strcat($1B, $06, $01, $0C, "INTELLIVISION BASIC", $0D, $0A, $0A, "Copyright Microsoft, Mattel  1980", $0D, $0A)
        sta $0435
        sta $8F
        ldy #$0F
        lda #$FF
        sta ($04),y
        jsr LDE8C
        .byte $0C                       ; NOP $xxxx
        .next @restart
    @restart:
        jmp RESTART
    }
}

.if !KBD {
    .if CONFIG_RAM || OSI {
        ; OSI is compiled for ROM, but includes this unused string
        .data QT_WANT: .strz "WANT SIN-COS-TAN-ATN"
    }
    .if !CONFIG_CBM_ALL {
        .if !(AIM65 || SYM1) {
            .data QT_WRITTEN_BY {
                .if APPLE {
                    .byte high("COPYRIGHT 1977 BY MICROSOFT CO")
                    .byte CR, 0
                } .else {
                    .byte CR, LF, $0C               ; FORM FEED
                    .if !CONFIG_11 {
                        .byte "WRITTEN BY RICHARD W. WEILAND."
                    } .else {
                        .byte "WRITTEN BY WEILAND & GATES"
                    }
                    .byte CR, LF, 0
                }
            }
        }
        .data QT_MEMORY_SIZE: .strz "MEMORY SIZE"
        .data QT_TERMINAL_WIDTH {
            .if !(AIM65 || SYM1) {
                .byte "TERMINAL "
            }
            .byte "WIDTH"
            .byte 0
        }
    }
    .data QT_BYTES_FREE {
        .byte " BYTES FREE"
        .if CBM1 {
            ; no end: it runs on into QT_BASIC
        } .elseif CBM2 {
            .byte CR, 0
        } .elseif APPLE {
            .byte 0
        } .else {
            .byte CR, LF, CR, LF
        }
    }
    .data QT_BASIC {
        .if OSI {
            .byte "OSI 6502 BASIC VERSION 1.0 REV 3.2"
        }
        .if KIM {
            .byte "MOS TECH 6502 BASIC V1.1"
        }
        .if MICROTAN {
            .byte "MICROTAN BASIC"
        }
        .if AIM65 {
            .byte "  AIM 65 BASIC V1.1"
        }
        .if SYM1 {
            .byte "BASIC V1.1"
        }
        .if CBM1 {
            .byte $13                       ; HOME
            .byte "*** COMMODORE BASIC ***"
            .byte $11, $11, $11, 0          ; DOWN/DOWN/DOWN
        }
        .if CBM2 {
            .byte "### COMMODORE BASIC ###"
            .byte CR, CR, 0
        }
        .if APPLE {
            .byte LF, CR, LF
            .byte "APPLE BASIC V1.1"
        }
        .if !CONFIG_CBM_ALL {
            .byte CR, LF
            .if MICROTAN {
                .byte "(C) 1980 MICROSOFT"
            } .elseif AIM65 {
                .byte 0
                .byte "(C) 1978 MICROSOFT"
            } .elseif SYM1 {
                .byte "COPYRIGHT 1978 SYNERTEK SYSTEMS CORP."
            } .else {
                .byte "COPYRIGHT 1977 BY MICROSOFT CO."
            }
            .byte CR, LF
            .if !AIM65 {
                .byte 0
            }
        }
    }
}
