.module aim65::loadsave: placed

.use defines::*
.use print::*
.use program::*

.segment CODE
.if AIM65 {

    .export .proc SAVE {
        pha
        jsr WHEREO
        jsr OUTSP
        lda #$ff
        jmp LIST::LB4BF
    }

    .export .proc MONRDKEY {
        lda INFLG
        jsr COUT5
        bne LOAD2
        jmp INALL
        LOAD2:
        jmp CUREAD
    }

    .export .proc MONCOUT {
        pha
        lda OUTFLG
        jsr COUT5
        bne COUT3
        pla
        jmp OUTALL

        COUT3:
        pla
        cmp #LF
        beq COUT5::COUT6
        cmp #CR
        beq COUT4
        jmp OUTPUT
        COUT4:
        jsr CRCK
        lda #CR
        rts
    }

    .proc COUT5 {
        cmp #$54
        beq COUT6
        cmp #$55
        beq COUT6
        cmp #$4C
        COUT6:
        rts
    }

    .export .proc MONRDKEY2 {
        jsr ROONEK
        tya
        beq COUT5
        jmp GETKY
    }
}
