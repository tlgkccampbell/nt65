; Global messages: "error", "in", "ready", "break".
.module message: placed

.use defines::*

.segment CODE
.export .data QT_ERROR {
    .if KBD {
        .byte " err"
    } .elseif APPLE {
        .byte " ERR", $07, $07
    } .else {
        .byte " ERROR"
    }
    .byte 0
}

.if !KBD {
    .export .data QT_IN: .strz " IN "
}

.if KBD {
    .data UNKNOWN: .byte $54, $D2   ; ???

    .export .proc OKPRT {
        jsr PRIMM
        .strz .strcat(CR, CR, ">>", CR, LF)
        rts
        nop
    }
} .elseif !AIM65 {
    .export .data QT_OK {
        .if CONFIG_CBM_ALL {
            .byte CR, LF, "READY.", CR, LF
        } .elseif APPLE {
            .byte CR, 0, 0, "K", CR, LF         ; a binary patch
        } .else {
            .byte CR, LF, "OK", CR, LF
        }
        .byte 0
    }
}

.export .data QT_BREAK {
    .if KBD {
        .byte CR, LF, " Brk"
        .byte 0
        .byte $54, $D0                  ; ???
    } .elseif MICROTAN || AIM65 {
        .byte CR, LF, " BREAK"
        .byte 0
    } .else {
        .byte CR, LF, "BREAK"
        .byte 0
    }
}
