.module kbd::extra: placed

.use defines::*
.use inline::*
.use chrget::*
.use eval::*
.use float::*
.use kbd::loadsave::*
.use memory::*
.use misc3::*
.use print::*
.use program::*
.use string::*
.use zeropage::*

.segment EXTRA
.if KBD {
    .export .proc OUTQUESSP {
        jsr OUTQUES
        jmp OUTSP
    }
    .export .proc INLIN {
        ldy #$FF
        LFDDC:
        iny
        LFDDD:
        jsr GETLN
        cmp #$03  ; CTRL+C
        beq LFDF7
        cmp #$20
        bcs LFDEC  ; no control char
        sbc #$09
        bne LFDDD
        LFDEC:
        sta INPUTBUFFER,y
        tax
        bne LFDDC
        jsr CRDO2
        ldy #$06
        LFDF7:
        tax
        clc
        rts
    }
    .export .proc LFDFA {
        bit $8F
        bmi LFE01
        jsr LDE48
        LFE01:
        bit $8F
        bvc LFE0B::LFE10
        jmp LDE53
        LFE08:
        jsr LFDFA
        .fallthrough LFE0B
    }
    .export .proc LFE0B: inline .strz {
        jsr LDE24
        bne LFDFA::LFE08
        LFE10:
        rts
    }
    .export .proc VSAV {
        jsr GARBAG
        lda FRETOP
        sta $00
        lda FRETOP+1
        sta $01
        lda $2F
        sta $02
        lda STREND+1
        sta $03
        ldy #$00
        LFE26:
        lda ($00),y
        sta ($02),y
        inc $02
        bne LFE30
        inc $03
        LFE30:
        inc $00
        bne LFE26
        inc $01
        bit $01
        bvc LFE26
        ldx VARTAB
        ldy VARTAB+1
        lda #$01
        bne PSAV::LFE50
        .fallthrough PSAV
    }
    .export .proc PSAV {
        lda VARTAB
        sta $02
        lda VARTAB+1
        sta $03
        ldx #$01
        ldy #$08
        lda #$02
        LFE50:
        sta $0513
        stx $0503
        stx $00
        sty $0504
        sty $01
        ldy #$0D
        lda #$00
        LFE61:
        sta $0504,y
        dey
        bne LFE61
        sty $0500
        lda #$40
        sta $0505
        lda $02
        sec
        sbc $00
        sta $00
        lda $03
        sbc $01
        sta $01
        lsr a
        lsr a
        lsr a
        sta $03
        jsr LE870
        sta $02
        jsr CHRGOT
        beq L40FA::LFEA6
        cmp #$2C
        beq L40FA
        jmp SYNERR
    }
    .proc L40FA {
        jsr CHRGET
        jsr LE870
        sec
        sbc $02
        cmp $03
        bpl LFEBF
        lda #$27
        sta JMPADRS
        jmp LFF64::LFFBD
        LFEA6:
        lda $02
        clc
        adc $03
        jsr LE874
        pha
        jsr LFE0B
        .strz " thru"
        pla
        tax
        lda #$00
        jsr LINPRT
        LFEBF:
        ldx #$07
        LBF83:
        dex
        lda VARTAB,x
        sec
        sbc TXTTAB,x
        sta $051B,x
        lda VARTAB+1,x
        sbc TXTTAB+1,x
        sta $051C,x
        dex
        bpl LBF83
        txa
        sbc FRETOP
        sta $0521
        lda #>CONST_MEMSIZ
        sbc FRETOP+1
        sta $0522
        lda FRETOP
        sta $0523
        lda FRETOP+1
        sta $0524
        ldx $02
        jsr LFFDD
        jsr LFFD1
        lda $01
        ldx #$05
        LFEF7:
        stx $0511
        ldy #$E4
        sec
        sbc #$08
        sta $01
        bpl LFF15
        adc #$08
        asl $00
        rol a
        asl $00
        rol a
        asl $00
        rol a
        adc #$01
        sta $0505
        ldy #$00
        LFF15:
        sty $0512
        jsr LE4C0
        ldx #$00
        lda $01
        bpl LFEF7
        LFF21:
        rts
    }
    .export .proc VLOD {
        jsr LFFD1
        stx JMPADRS
        lda VARTAB
        ldy VARTAB+1
        ldx #$01
        jsr LFF64
        ldx #$00
        ldy #$02
        LFF34:
        jsr LE39A
        iny
        iny
        inx
        inx
        cpx #$05
        bmi LFF34
        lda STREND
        sta LOWTR
        lda STREND+1
        sta LOWTR+1
        lda FRETOP
        sta HIGHTR
        lda FRETOP+1
        sta HIGHTR+1
        lda #<CONST_MEMSIZ
        sta HIGHDS
        lda #>CONST_MEMSIZ
        sta HIGHDS+1
        lda $0523
        sta FRETOP
        lda $0524
        sta FRETOP+1
        jmp BLTU2
    }
    .export .proc LFF64 {
        sta $9A
        sty $9B
        stx $00
        jsr LE870
        jsr LFFDD
        lda JMPADRS
        beq LFF7F
        lda #$01
        sta $9A
        lda #$08
        sta $9B
        jsr STXTPT
        LFF7F:
        lda $9A
        sta $0503
        lda $9B
        sta $0504
        lda #$ED
        sta $0512
        lda #$05
        sta $01
        LFF92:
        ldx $0512
        beq L40FA::LFF21
        ldy #$04
        jsr LE4C4
        lda $01
        cmp $0511
        bne LFFB2
        lda #$00
        sta $01
        lda $00
        cmp $0513
        beq LFF92
        lda #$18
        bne LFFB8
        LFFB2:
        lda #$27
        bne LFFB8
        LFFB6:
        lda #$3C
        LFFB8:
        sta JMPADRS
        jsr CLEARC
        LFFBD:
        jsr VARTAB_MINUS_2_TO_AY
        sta $9A
        sty $9B
        lda #$00
        tay
        sta ($9A),y
        iny
        sta ($9A),y
        ldx JMPADRS
        jmp ERROR
    }
    .proc LFFD1 {
        ldx #$00
        .fallthrough LFFD3
    }
    .export .proc LFFD3 {
        lda #$02
        .byte $2C
        .next LFFD6::LFFD62
    }
    .export .proc LFFD6 {
        lda #$03
        LFFD62:
        jsr LDE8C
        asl FACSIGN
        .fallthrough LFFDD
    }
    .proc LFFDD {
        jsr CHRGOT
        beq LFFE5
        jmp SYNERR
        LFFE5:
        lda #$0D
        ldy #$00
        jsr LDE8C
        .byte $06
        .next LFFED
    }
    .export .proc LFFED {
        lda $034C
        bmi LFFED
        ldy #$01
        lda ($04),y
        bne LFF64::LFFB6
        rts
    }

    .res 1, $FF
    ; the 6502's vectors, at the top of the address space
    .data CPU_VECTORS {
        .addr LC000                     ; NMI
        .addr LC000                     ; RESET
        .addr LC009                     ; IRQ
    }
}
