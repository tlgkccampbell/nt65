; The error messages. An error's number is where its message starts in the table.
.module error: placed

.use defines::*
.use text::*

; A message, in two characters or in words.
.func message(short, long) = htasc(.select(CONFIG_SMALL_ERROR, short, long))

.segment ERROR
.export .data ERROR_MESSAGES {
    .data NOFOR:   .byte message("NF", "NEXT WITHOUT FOR")
    .data SYNTAX:  .byte message("SN", "SYNTAX")
    .data NOGOSUB: .byte message("RG", "RETURN WITHOUT GOSUB")
    .data NODATA:  .byte message("OD", "OUT OF DATA")
    .data ILLQTY:  .byte message("FC", "ILLEGAL QUANTITY")
    .if CBM1 {
        .byte 0, 0, 0, 0, 0
    }
    .data OVERFLOW:  .byte message("OV", "OVERFLOW")
    .data MEMFULL:   .byte message("OM", "OUT OF MEMORY")
    .data UNDEFSTAT: .byte message("US", "UNDEF'D STATEMENT")
    .data BADSUBS:   .byte message("BS", "BAD SUBSCRIPT")
    .data REDIMD:    .byte message("DD", "REDIM'D ARRAY")
    .data ZERODIV:   .byte message("/0", "DIVISION BY ZERO")
    .data ILLDIR:    .byte message("ID", "ILLEGAL DIRECT")
    .data BADTYPE:   .byte message("TM", "TYPE MISMATCH")
    .data STRLONG:   .byte message("LS", "STRING TOO LONG")
    .if CONFIG_FILE {
        .if CBM1 {
            .data BADDATA: .byte htasc("BAD DATA")
        } .else {
            .data BADDATA: .byte htasc("FILE DATA")
        }
    }
    .data FRMCPX:   .byte message("ST", "FORMULA TOO COMPLEX")
    .data CANTCONT: .byte message("CN", "CAN'T CONTINUE")
    .data UNDEFFN:  .byte message("UF", "UNDEF'D FUNCTION")
}

.export ERR_NOFOR = ERROR_MESSAGES::NOFOR - ERROR_MESSAGES
.export ERR_SYNTAX = ERROR_MESSAGES::SYNTAX - ERROR_MESSAGES
.export ERR_NOGOSUB = ERROR_MESSAGES::NOGOSUB - ERROR_MESSAGES
.export ERR_NODATA = ERROR_MESSAGES::NODATA - ERROR_MESSAGES
.export ERR_ILLQTY = ERROR_MESSAGES::ILLQTY - ERROR_MESSAGES
.export ERR_OVERFLOW = ERROR_MESSAGES::OVERFLOW - ERROR_MESSAGES
.export ERR_MEMFULL = ERROR_MESSAGES::MEMFULL - ERROR_MESSAGES
.export ERR_UNDEFSTAT = ERROR_MESSAGES::UNDEFSTAT - ERROR_MESSAGES
.export ERR_BADSUBS = ERROR_MESSAGES::BADSUBS - ERROR_MESSAGES
.export ERR_REDIMD = ERROR_MESSAGES::REDIMD - ERROR_MESSAGES
.export ERR_ZERODIV = ERROR_MESSAGES::ZERODIV - ERROR_MESSAGES
.export ERR_ILLDIR = ERROR_MESSAGES::ILLDIR - ERROR_MESSAGES
.export ERR_BADTYPE = ERROR_MESSAGES::BADTYPE - ERROR_MESSAGES
.export ERR_STRLONG = ERROR_MESSAGES::STRLONG - ERROR_MESSAGES
.if CONFIG_FILE {
    .export ERR_BADDATA = ERROR_MESSAGES::BADDATA - ERROR_MESSAGES
}
.export ERR_FRMCPX = ERROR_MESSAGES::FRMCPX - ERROR_MESSAGES
.export ERR_CANTCONT = ERROR_MESSAGES::CANTCONT - ERROR_MESSAGES
.export ERR_UNDEFFN = ERROR_MESSAGES::UNDEFFN - ERROR_MESSAGES
