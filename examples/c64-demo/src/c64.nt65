; The parts of the Commodore 64 the demo uses: the VIC-II, the SID, the CIAs and the KERNAL's
; interrupt entry, with a scope for each chip.
.module c64

.cpu 6502

.export .const SCREEN = $0400       ; screen memory, 40 by 25 screen codes
.export .data COLORS:   .byte = $D800           ; color memory, a color for each place on the screen
.export .data POINTERS: .byte = SCREEN + $03F8  ; the eight sprites' shape pointers, after the screen

; The cycles in a raster line of the PAL machine, which the demo is timed for, and which VICE's
; x64sc emulates unless told otherwise.
.export .const CYCLES = 63

.export .scope vic {
    .mmio SPRITE_X:     .byte = $D000  ; sprite 0's X, then its Y, then sprite 1's, two bytes apart
    .mmio SPRITE_Y:     .byte = $D001
    .mmio X_HIGH:       .byte = $D010  ; bit n is the ninth bit of sprite n's X
    .mmio CONTROL:      .byte = $D011  ; bit 7 is the ninth bit of RASTER
    .mmio RASTER:       .byte = $D012  ; the line being drawn, and the line that raises the interrupt
    .mmio ENABLE:       .byte = $D015
    .mmio IRQ_FLAG:     .byte = $D019  ; a 1 written to a bit acknowledges that interrupt
    .mmio IRQ_MASK:     .byte = $D01A
    .mmio BORDER:       .byte = $D020
    .mmio PAPER:        .byte = $D021
    .mmio SPRITE_COLOR: .byte = $D027  ; sprite 0's color, then sprite 1's
}

.export .scope cia1 {
    .mmio ICR: .byte = $DC0D        ; a write sets the bits it gives if bit 7 is set, or clears them
}

.export .scope cia2 {
    .mmio ICR: .byte = $DD0D
}

; One voice of the SID, as its seven registers lie.
.export .struct Voice {
    frequency: .word
    pulse:     .word
    control:   .byte                ; the waveform in bits 4 to 7, and the gate in bit 0
    attack:    .byte                ; attack in the high nibble, decay in the low
    sustain:   .byte                ; sustain level in the high nibble, release in the low
}

.export .scope sid {
    .mmio voices: .type Voice[3] = $D400
    .mmio VOLUME: .byte = $D418     ; the volume in the low nibble
}

; The KERNAL's interrupt entry saves A, X and Y and jumps through CINV, which a program points
; at its own handler. The KERNAL's handler, which reads the keyboard and counts the jiffy clock,
; is where CINV points to start with, and ends at the KERNAL's exit, which puts the registers
; back and returns from the interrupt.
.export .scope kernal {
    .data CINV: .addr = $0314
    .proc IRQ = $EA31: interrupt
    .proc EXIT = $EA81: interrupt
}

.export .enum Color {
    black
    white
    red
    cyan
    purple
    green
    blue
    yellow
    orange
    brown
    light_red
    dark_gray
    gray
    light_green
    light_blue
    light_gray
}
