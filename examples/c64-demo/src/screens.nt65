; The screen and its colors, packed by tools/pack.ps1 from screens/title.txt and
; screens/colors.txt, which build.ps1 runs before nt65 reads the files' sizes.
.module screens

.cpu 6502

.export title, colors

.segment RODATA
.data title:  .incbin "../build/screens/title.lz4"
.data colors: .incbin "../build/screens/colors.lz4"
