; A sprite multiplexer, which shows OBJECTS objects with the VIC-II's eight sprites. Each frame
; the objects move, each by the handler of its kind, and `sort` puts them in order down the
; screen. The top border's interrupt shows the first eight, one to a sprite, and each later
; object takes the sprite of the object eight before it, at the line where that one ends.
.module plex

.cpu 6502

.use c64::{vic, kernal, Colour, POINTERS}

.export init, update, sort, first, irq, order, objects

.const OBJECTS = 16                 ; the objects there are
.const SPRITES = 8                  ; the VIC-II's sprites
.const HEIGHT  = 21                 ; the lines a sprite takes

; Where objects may be. The highest starts below the lines in which `first` places the first
; sprites, and the lowest ends before `raster::bottom`.
.const LEFT    = 24                 ; the left edge of the screen
.const RIGHT   = 344                ; the right edge of the screen
.const WALL    = 232                ; the right edge for a bouncer, whose X keeps to 8 bits
.const HIGHEST = 64
.const LOWEST  = 210

.assert LOWEST + HEIGHT < raster::BOTTOM, "the lowest sprite runs into the bottom interrupt"

; The shapes the objects are drawn with, one for each kind, in the tape buffer, which the VIC-II
; sees. A sprite's pointer is its shape's address over 64.
.const BUFFER = $0340               ; the tape buffer
.const SHAPE  = BUFFER / 64         ; the pointer of the first kind's shape

.data shapes: .byte[.countof(Kind) * 64] = BUFFER

.assert BUFFER .mod 64 == 0, "a sprite's shape must start on a multiple of 64"

; The kinds of object, each of which moves by a handler of its own in `step`.
.enum Kind {
    bouncer                         ; moves in a straight line and bounces off the edges
    orbiter                         ; goes round in a circle
    swimmer                         ; swims to the left and bobs up and down as it goes
}

; What the table holds for each object. Each field is an array in `objects`, with an element
; for each object, so that X indexes any of them.
.enum Field {
    xpos                            ; X, the low eight bits
    xhigh                           ; X, the ninth bit
    ypos
    kind                            ; a `Kind`
    colour
    dx                              ; how far X moves in a frame, or how fast the circle turns
    dy                              ; how far Y moves in a frame, or how fast the bobbing turns
    phase                           ; where the object is in its circle or its bobbing
    cx                              ; the centre of an orbiter's circle
    cy                              ; the centre of an orbiter's circle, or a swimmer's line
}

; An object as a record, with a field for each of `Field`'s members, for the table the objects
; start from.
.struct Object {
    xpos:   .byte
    xhigh:  .byte
    ypos:   .byte
    kind:   .byte
    colour: .byte
    dx:     .byte
    dy:     .byte
    phase:  .byte
    cx:     .byte
    cy:     .byte
}

.assert .countof(Object) == .countof(Field), "`Object` and `Field` are out of step"

.segment BSS
.scope objects {
    .each Field, f {
        .data f: .byte[OBJECTS]
    }
}

.data order: .byte[OBJECTS]         ; the objects, from the top of the screen down

.segment ZEROPAGE
.data next:     .byte               ; the place in `order` of the next object to show
.data position: .byte               ; the place in `order` that `sort` is filling
.data moving:   .byte               ; the object `sort` is placing
.data key:      .byte               ; its Y

.segment RODATA
.data starts: .type Object[] {
    { kind = Kind::bouncer, xpos = 40, ypos = 70, dx = 1, dy = 1, colour = Colour::yellow }
    { kind = Kind::bouncer, xpos = 120, ypos = 90, dx = 2, dy = -1, colour = Colour::light_red }
    { kind = Kind::bouncer, xpos = 200, ypos = 150, dx = -2, dy = 2, colour = Colour::cyan }
    { kind = Kind::bouncer, xpos = 90, ypos = 190, dx = -1, dy = -2, colour = Colour::light_green }
    { kind = Kind::orbiter, cx = 100, cy = 120, dx = 2, colour = Colour::white }
    { kind = Kind::orbiter, cx = 100, cy = 120, dx = 2, phase = 64, colour = Colour::white }
    { kind = Kind::orbiter, cx = 100, cy = 120, dx = 2, phase = 128, colour = Colour::white }
    { kind = Kind::orbiter, cx = 100, cy = 120, dx = 2, phase = 192, colour = Colour::white }
    { kind = Kind::orbiter, cx = 200, cy = 140, dx = -3, colour = Colour::orange }
    { kind = Kind::orbiter, cx = 200, cy = 140, dx = -3, phase = 128, colour = Colour::orange }
    { kind = Kind::swimmer, xpos = 64, xhigh = 1, cy = 100, dx = 1, dy = 3, colour = Colour::light_blue }
    { kind = Kind::swimmer, xpos = 0, xhigh = 1, cy = 110, dx = 2, dy = 4, phase = 40, colour = Colour::purple }
    { kind = Kind::swimmer, xpos = 200, cy = 140, dx = 1, dy = 2, phase = 80, colour = Colour::green }
    { kind = Kind::swimmer, xpos = 120, cy = 170, dx = 3, dy = 5, phase = 120, colour = Colour::light_grey }
    { kind = Kind::swimmer, xpos = 30, xhigh = 1, cy = 130, dx = 2, dy = 3, phase = 160, colour = Colour::yellow }
    { kind = Kind::swimmer, xpos = 250, cy = 150, dx = 1, dy = 2, phase = 200, colour = Colour::red }
}

.assert .countof(starts) == OBJECTS, "an object without a start, or a start without an object"

; The sine of a turn in 256 steps, at 32 to the quarter turn, as signed bytes.
.data sine: .byte[256] {
    .repeat 256, i {
        .sin(i, 256, 32)
    }
}

; A bit for each sprite, and every bit but that one.
.data ones: .byte[] {
    .repeat SPRITES, n {
        1 << n
    }
}
.data holes: .byte[] {
    .repeat SPRITES, n {
        (1 << n) ^ $FF
    }
}

; Each handler's address less one, for `move`'s return to go to.
.data handlers: .addr[] {
    .each Kind, k {
        step::k - 1
    }
}

; The shapes, drawn a pixel at a time by `dot`.
.data drawn: .byte[] {
    .repeat .countof(Kind), shape {
        .repeat 21, down {
            .repeat 3, column {
                eight(shape, column * 8, down)
            }
        }
        0                           ; the shape's 64th byte, which the VIC-II does not read
    }
}

.assert .sizeof(drawn) == .sizeof(shapes), "the shapes drawn do not fill their place"

; Returns 1 if the pixel `across` pixels from the left and `down` from the top of a kind's shape
; is set, and 0 if not. A bouncer is a ball, an orbiter a ring and a swimmer a diamond, each 21
; pixels across, with their centre at 11, 10. The arithmetic is on doubled coordinates, whose
; centre is 22, 20.
.func dot(shape, across, down) = .switch(shape,
    [Kind::bouncer], square(across, down) <= 400,
    [Kind::orbiter], square(across, down) <= 400 && square(across, down) >= 196,
    distance(across, 22) + distance(down, 20) <= 20)

; Returns the square of a pixel's distance from the centre, in doubled coordinates.
.func square(across, down) = (distance(across, 22) * distance(across, 22)
    + distance(down, 20) * distance(down, 20))

; Returns how far n doubled is from the centre c, which is already doubled.
.func distance(n, c) = .max(2 * n - c, c - 2 * n)

; Returns the byte of the eight pixels from `across` on row `down` of a shape, the leftmost in
; bit 7.
.func eight(shape, across, down) = (
    (dot(shape, across, down) << 7) | (dot(shape, across + 1, down) << 6)
    | (dot(shape, across + 2, down) << 5) | (dot(shape, across + 3, down) << 4)
    | (dot(shape, across + 4, down) << 3) | (dot(shape, across + 5, down) << 2)
    | (dot(shape, across + 6, down) << 1) | dot(shape, across + 7, down))

.segment CODE

; Fills the table from `starts`, starts `order` as the objects' own order, and copies the shapes
; to where the VIC-II reads them.
.proc init {
    ldx #0
    ldy #0
@next:
    .each Field, f {
        lda starts::f,y
        sta objects::f,x
    }
    txa
    sta order,x
    tya
    clc
    adc #.sizeof(Object)
    tay
    inx
    cpx #OBJECTS
    bne @next

    ldx #.sizeof(shapes)
@copy:
    lda drawn - 1,x
    sta shapes - 1,x
    dex
    bne @copy
    rts
}

; Moves every object by its kind's handler.
.proc update {
    ldx #OBJECTS - 1
@next:
    jsr move
    dex
    bpl @next
    rts
}

; Moves object X by its kind's handler, which returns to `move`'s caller. Keeps X.
.proc move: keeps x {
    lda objects::kind,x
    asl a
    tay
    lda handlers + 1,y
    pha
    lda handlers,y
    pha
    rts
    .next handlers
}

; The handlers for each kind of object, which move object X and keep X.
.scope step {
    .proc bouncer: keeps x {
        lda objects::xpos,x
        clc
        adc objects::dx,x
        sta objects::xpos,x
        cmp #LEFT
        bcc @turn_x
        cmp #WALL
        bcc @vertical
    @turn_x:
        reverse!({objects::dx,x})
    @vertical:
        lda objects::ypos,x
        clc
        adc objects::dy,x
        sta objects::ypos,x
        cmp #HIGHEST
        bcc @turn_y
        cmp #LOWEST
        bcc @done
    @turn_y:
        reverse!({objects::dy,x})
    @done:
        rts
    }

    .proc orbiter: keeps x {
        lda objects::phase,x
        clc
        adc objects::dx,x
        sta objects::phase,x
        tay
        lda objects::cx,x
        clc
        adc sine,y
        sta objects::xpos,x
        tya
        clc
        adc #64                     ; a quarter turn on, for the cosine
        tay
        lda objects::cy,x
        clc
        adc sine,y
        sta objects::ypos,x
        rts
    }

    .proc swimmer: keeps x {
        lda objects::xpos,x
        sec
        sbc objects::dx,x
        sta objects::xpos,x
        bcs @bob
        dec objects::xhigh,x
        bpl @bob
        lda #<RIGHT                 ; past the left edge: back in from beyond the right
        sta objects::xpos,x
        lda #1
        sta objects::xhigh,x
    @bob:
        lda objects::phase,x
        clc
        adc objects::dy,x
        sta objects::phase,x
        tay
        lda objects::cy,x
        clc
        adc sine,y
        sta objects::ypos,x
        rts
    }
}

; Turns an object's speed round, where `speed` is its field indexed by X.
.macro reverse(speed: operand) {
    lda #0
    sec
    sbc speed
    sta speed
}

; Puts `order` in order of the objects' Y, the highest on the screen first. The order is the last
; frame's, which the objects have moved little since, so an insertion sort finds it nearly in
; order and has little to do.
.proc sort {
    lda #1
    sta position
@outer:
    ldy position
    ldx order,y
    stx moving
    lda objects::ypos,x
    sta key
@inner:
    ldx order - 1,y                 ; the object before the place being filled
    lda key
    cmp objects::ypos,x
    bcs @place                      ; it is no lower than the one being placed
    txa
    sta order,y
    dey
    bne @inner
@place:
    lda moving
    sta order,y
    inc position
    lda position
    cmp #OBJECTS
    bne @outer
    rts
}

; Shows the first SPRITES objects, one to a sprite, turns the sprites on, and asks for the
; interrupt that shows the next. Runs in the top border, before the first of them can start.
;
; The sprites stay off until they have been placed the first time. A sprite left at line 0, where
; it starts, would be drawn in the lines of the top border, and the VIC-II would take the cycles
; it reads its shape in from `raster::top` while it waits for `raster::stable`.
.proc first {
    lda #0
    sta next
@next:
    jsr show
    lda next
    cmp #SPRITES
    bne @next
    lda #$FF
    sta vic::ENABLE
    jsr free
    sta vic::RASTER
    lda #<irq
    sta kernal::CINV
    lda #>irq
    sta kernal::CINV + 1
    rts
}

; Shows the next object, and the ones after it whose sprites come free before it could wait for
; them, and then asks for the interrupt that shows the one after those, or for `raster::bottom`
; once every object is shown.
;
; The interrupt is acknowledged on the way out. Asking for the line being drawn raises the
; interrupt at once, which it would otherwise take again as soon as it returns.
.proc irq: interrupt {
@show:
    jsr show
    lda next
    cmp #OBJECTS
    beq @done
    jsr free
    sta vic::RASTER
    sec
    sbc #2
    cmp vic::RASTER                 ; which now reads the line being drawn
    bcc @show                       ; the line asked for has come, or comes too soon
    jmp @leave
@done:
    lda #raster::BOTTOM
    sta vic::RASTER
    lda #<raster::bottom
    sta kernal::CINV
    lda #>raster::bottom
    sta kernal::CINV + 1
@leave:
    lda #%0001
    sta vic::IRQ_FLAG
    jmp kernal::EXIT
}

; Returns in A the line at which the sprite for the next object comes free, which is the line
; after the one the object eight before it ends on.
.proc free {
    ldy next
    ldx order - SPRITES,y
    lda objects::ypos,x
    clc
    adc #HEIGHT
    rts
}

; Shows the object at `next` in `order` on sprite `next` mod 8, and moves `next` on.
;
; A sprite's colour and its shape pointer are one register to a sprite, and its X and Y two to a
; sprite, and the 6502 has one Y. So the colour's and the pointer's stores have the sprite's
; number written into their operands, and the X and Y stores are indexed by twice that number.
.proc show {
    ldy next
    ldx order,y
    tya
    and #SPRITES - 1
    tay                             ; the sprite
    clc
    adc #<vic::SPRITE_COLOUR
    sta colour + 1
    .patch colour
    tya
    clc
    adc #<POINTERS
    sta pointer + 1
    .patch pointer
    lda objects::colour,x
    colour:
    sta vic::SPRITE_COLOUR          ; the sprite's colour
    lda objects::kind,x
    clc
    adc #SHAPE                      ; each kind has a shape of its own
    pointer:
    sta POINTERS                    ; the sprite's pointer
    lda objects::xhigh,x
    beq @low
    lda vic::X_HIGH
    ora ones,y
    jmp @high
@low:
    lda vic::X_HIGH
    and holes,y
@high:
    sta vic::X_HIGH
    tya
    asl a
    tay                             ; the sprite's X and Y registers
    lda objects::xpos,x
    sta vic::SPRITE_X,y
    lda objects::ypos,x
    sta vic::SPRITE_Y,y
    inc next
    rts
}

; Adding a sprite's number to the low byte of its first colour register or pointer reaches the
; sprite's own without a carry into the high byte.
.assert (vic::SPRITE_COLOUR & $FF) + SPRITES <= $100, "the colour registers cross a page"
.assert (POINTERS & $FF) + SPRITES <= $100, "the pointers cross a page"
