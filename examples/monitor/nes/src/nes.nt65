; This module names the NES's ports that the platform uses, with the names the NESdev wiki gives
; them, and the bits it sets in them.
.module nes

.cpu 6502

; The PPU's ports.
.export .mmio PPUCTRL:   .byte = $2000  ; the NMI, and which nametable and pattern tables show
.export .mmio PPUMASK:   .byte = $2001  ; what the PPU draws
.export .mmio PPUSTATUS: .byte = $2002  ; whether vblank has started; reading it resets PPUADDR's latch
.export .mmio PPUSCROLL: .byte = $2005  ; written twice, across and then down
.export .mmio PPUADDR:   .byte = $2006  ; the VRAM address, written twice, high byte first
.export .mmio PPUDATA:   .byte = $2007  ; a byte of VRAM, after which the address steps

; The APU's and the joypads' ports.
.export .mmio DMC_FREQ:      .byte = $4010  ; the sample channel's rate, and its IRQ
.export .mmio JOY1:          .byte = $4016  ; written to latch the joypads, and read for joypad 1's buttons
.export .mmio FRAME_COUNTER: .byte = $4017  ; the APU's frame counter, and its IRQ

.export .const NMI_ON  = $80        ; PPUCTRL: an NMI at the start of each vblank
.export .const SHOW_BG = $08        ; PPUMASK: the background shows
.export .const BG_LEFT = $02        ; PPUMASK: the background shows in the leftmost eight dots too
.export .const VBLANK  = $80        ; PPUSTATUS: vblank has started
.export .const IRQ_OFF = $40        ; FRAME_COUNTER: the frame counter never raises an IRQ

.export .const PALETTE = $3F00      ; the VRAM address of the background's palettes
