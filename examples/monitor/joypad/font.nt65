; This module draws the monitor's font, the characters from space to `_` in ASCII's order, for
; the machines whose screens are 2bpp tiles.
;
; The font is drawn below as a type specimen lays it out, in eight bands of eight characters,
; each character eight dots wide and eight high, with `#` for a dot that shows. nt65 turns the
; bands into tiles as each platform compiles them, so the picture here is the only source of the
; font. The machines lay a tile's planes out differently, so each platform writes its own tiles,
; with `.each` over `bands` and `plane`.
;
; The font is drawn in three *styles*, each a set of GLYPHS tiles after the one before, which
; differ only in the colors of the tile's background and of its dots. A character's tile in a
; style is its code plus the style. So one palette serves the whole screen, and the keyboard
; shows which key the cursor is on by the tiles it draws.
.module platform::font

.use platform::text

.export GLYPHS, PLAIN, KEY, CHOSEN, STYLES, bands, plane

GLYPHS = 64                         ; the characters from space to `_`
STYLES = 3

; The styles, as what they add to a character's code.
PLAIN  = 0                          ; the monitor's text, in ink on paper
KEY    = GLYPHS                     ; a key, in ink on the keys' color
CHOSEN = 2 * GLYPHS                 ; the key the cursor is on, in paper on the light color

.assert text(' ') + STYLES * GLYPHS <= 256, "every tile of every style must fit in a byte"

; space ! " # $ % & '
.list band_0 {
    "...........#......#.#.....#.#......#.....##.......##.......#...."
    "...........#......#.#.....#.#.....####...##..#...#..#......#...."
    "...........#......#.#....#####...#.#........#....#.#......#....."
    "...........#..............#.#.....###......#......#............."
    "...........#.............#####.....#.#....#......#.#.#.........."
    "..........................#.#....####....#..##...#..#..........."
    "...........#..............#.#......#........##....##.#.........."
    "................................................................"
}

; ( ) * + , - . /
.list band_1 {
    "....#.....#....................................................."
    "...#.......#.......#.......#.................................#.."
    "..#.........#....#.#.#.....#................................#..."
    "..#.........#.....###....#####...........#####.............#...."
    "..#.........#....#.#.#.....#......##......................#....."
    "...#.......#.......#.......#.......#..............##.....#......"
    "....#.....#.......................#...............##............"
    "................................................................"
}

; 0 1 2 3 4 5 6 7
.list band_2 {
    "..###......#......###....#####......#....#####.....##....#####.."
    ".#...#....##.....#...#......#......##....#........#..........#.."
    ".#..##.....#.........#.....#......#.#....####....#..........#..."
    ".#.#.#.....#........#.......#....#..#........#...####......#...."
    ".##..#.....#.......#.........#...#####.......#...#...#....#....."
    ".#...#.....#......#......#...#......#....#...#...#...#....#....."
    "..###.....###....#####....###.......#.....###.....###.....#....."
    "................................................................"
}

; 8 9 : ; < = > ?
.list band_3 {
    "..###.....###.......................#.............#.......###..."
    ".#...#...#...#....##......##.......#...............#.....#...#.."
    ".#...#...#...#....##......##......#......#####......#........#.."
    "..###.....####...................#...................#......#..."
    ".#...#.......#....##......##......#......#####......#......#...."
    ".#...#......#.....##.......#.......#...............#............"
    "..###.....##..............#.........#.............#........#...."
    "................................................................"
}

; @ A B C D E F G
.list band_4 {
    "..###.....###....####.....###....###.....#####...#####....###..."
    ".#...#...#...#...#...#...#...#...#..#....#.......#.......#...#.."
    ".....#...#...#...#...#...#.......#...#...#.......#.......#......"
    "..##.#...#...#...####....#.......#...#...####....####....#.###.."
    ".#.#.#...#####...#...#...#.......#...#...#.......#.......#...#.."
    ".#.#.#...#...#...#...#...#...#...#..#....#.......#.......#...#.."
    "..###....#...#...####.....###....###.....#####...#........####.."
    "................................................................"
}

; H I J K L M N O
.list band_5 {
    ".#...#....###......###...#...#...#.......#...#...#...#....###..."
    ".#...#.....#........#....#..#....#.......##.##...#...#...#...#.."
    ".#...#.....#........#....#.#.....#.......#.#.#...##..#...#...#.."
    ".#####.....#........#....##......#.......#.#.#...#.#.#...#...#.."
    ".#...#.....#........#....#.#.....#.......#...#...#..##...#...#.."
    ".#...#.....#.....#..#....#..#....#.......#...#...#...#...#...#.."
    ".#...#....###.....##.....#...#...#####...#...#...#...#....###..."
    "................................................................"
}

; P Q R S T U V W
.list band_6 {
    ".####.....###....####.....####...#####...#...#...#...#...#...#.."
    ".#...#...#...#...#...#...#.........#.....#...#...#...#...#...#.."
    ".#...#...#...#...#...#...#.........#.....#...#...#...#...#...#.."
    ".####....#...#...####.....###......#.....#...#...#...#...#.#.#.."
    ".#.......#.#.#...#.#.........#.....#.....#...#...#...#...#.#.#.."
    ".#.......#..#....#..#........#.....#.....#...#....#.#....#.#.#.."
    ".#........##.#...#...#...####......#......###......#......#.#..."
    "................................................................"
}

; X Y Z [ \ ] ^ _
.list band_7 {
    ".#...#...#...#...#####....###.............###......#............"
    ".#...#...#...#.......#....#......#..........#.....#.#..........."
    "..#.#....#...#......#.....#.......#.........#....#...#.........."
    "...#......#.#......#......#........#........#..................."
    "..#.#......#......#.......#.........#.......#..................."
    ".#...#.....#.....#........#..........#......#..................."
    ".#...#.....#.....#####....###.............###............#####.."
    "................................................................"
}

; The bands, top to bottom, which the tiles follow in ASCII's order.
.list bands {
    band_0
    band_1
    band_2
    band_3
    band_4
    band_5
    band_6
    band_7
}

; Returns 1 where the dot at `at` in a row of a band shows, and 0 where it does not.
.func dot(row, at) = .strat(row, at) == '#'

; Returns the two dots from `at` in a row of a band, as a number whose bit 1 is the leftmost.
.func pair(row, at) = (dot(row, at) << 1) | dot(row, at + 1)

; Returns the four dots from `at` in a row of a band, as a number whose bit 3 is the leftmost.
.func nibble(row, at) = (pair(row, at) << 2) | pair(row, at + 2)

; Returns the eight dots from `at` in a row of a band, as a byte whose bit 7 is the leftmost.
.func dots(row, at) = (nibble(row, at) << 4) | nibble(row, at + 4)

; Returns the color a style draws a tile's background in: 0 is paper, 1 the keys' color, 2 the
; light color and 3 ink.
.func paper(style) = .switch(style, [PLAIN], 0, [KEY], 1, 2)

; Returns the color a style draws a tile's dots in.
.func ink(style) = .select(style == CHOSEN, 0, 3)

; Returns 1 where bit `p` of a color is set, and 0 where it is not.
.func has(color, p) = (color >> p) & 1

; Returns plane `p` of the eight dots `d`, drawn in a style's colors.
.func paint(d, style, p) = (d * has(ink(style), p)) | ((~d & $FF) * has(paper(style), p))

; Returns plane `p` of glyph `glyph`'s eight dots in a row of its band, in a style's colors.
.func plane(row, glyph, style, p) = paint(dots(row, glyph * 8), style, p)
