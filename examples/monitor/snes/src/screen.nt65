; This module keeps the text screen, on BG1 in mode 0. The screen is 32 columns by 28 rows of
; tiles. The monitor writes on the top 24 rows, and the keyboard takes the rest.
;
; The screen is kept in `screen`, one byte to a place, which is the tile the place shows. Each
; tile is the character in ASCII whose code is its number, so `screen` reads as text. The rows of
; the keyboard also have their palettes, in `colors`. At the start of each vblank the NMI copies
; both into the tilemap in VRAM, whatever has changed.
.module platform::screen

.cpu 65816

.use snes::*
.use platform::{text, NEWLINE, COLUMNS, running}
.use platform::font::{font, GLYPHS}

.export ROWS, TEXT_ROWS, screen, colors, row, column, frames, setup, putc, refresh

ROWS = 28                           ; the rows of tiles a screen of 224 lines shows
TEXT_ROWS = 24                      ; the rows the monitor writes on
MAP = $0000                         ; the word address in VRAM of BG1's tilemap
TILES = $1000                       ; the word address in VRAM of BG1's tile 0

.assert text(' ') + GLYPHS <= 256, "every character must be a tile a tilemap byte can name"
.assert TEXT_ROWS * COLUMNS == 3 * 256, "scrolling moves three pages"

; Returns a color, from five bits each of red, green and blue.
.func rgb(r, g, b) = r | (g << 5) | (b << 10)

PAPER = rgb(2, 5, 12)
INK   = rgb(28, 28, 24)
KEY   = rgb(7, 7, 9)
LIGHT = rgb(31, 26, 6)

; The palettes. A tile of the font shows colors 2 and 3, and the first two are never shown.
.segment RODATA
.data palette: .word[] {
    PAPER, PAPER, PAPER, INK        ; 0: the text the monitor writes
    PAPER, PAPER, LIGHT, PAPER      ; 1: the key the cursor is on
    PAPER, PAPER, KEY, INK          ; 2: the other keys
}

; What each S-PPU port that the monitor relies on is set to, before the screen is turned on.
.struct Setting {
    port:  .byte                    ; the port's offset from $2100
    value: .byte
}

.data settings: .type Setting[] {
    { port = <BGMODE, value = 0 }           ; mode 0, with 8 by 8 tiles
    { port = <BG1SC, value = >MAP }         ; a tilemap of 32 by 32 tiles
    { port = <BG12NBA, value = TILES >> 12 }
    { port = <BG1HOFS, value = 0 }
    { port = <BG1HOFS, value = 0 }
    { port = <BG1VOFS, value = $FF }        ; -1, so that the first line shows row 0 of the tiles
    { port = <BG1VOFS, value = $FF }
    { port = <TM, value = BG1 }
    { port = <VMAIN, value = STEP_HIGH }
}

.data zero: .byte 0

; The DMAs that `dma!` runs. The first three set VRAM and CGRAM up, and the NMI runs the last two.
.data clear_vram: .type Dma {
    mode = DMA_TWO_PORTS | DMA_FIXED
    port = <VMDATAL
    source = zero
    length = 0                      ; all 64K
}

.data load_font: .type Dma {
    mode = DMA_TWO_PORTS
    port = <VMDATAL
    source = font
    length = .sizeof(font)
}

.data load_palette: .type Dma {
    mode = DMA_ONE_PORT
    port = <CGDATA
    source = palette
    length = .sizeof(palette)
}

.data show_screen: .type Dma {
    mode = DMA_ONE_PORT
    port = <VMDATAL
    source = screen
    length = .sizeof(screen)
}

.data show_colors: .type Dma {
    mode = DMA_ONE_PORT
    port = <VMDATAH
    source = colors
    length = .sizeof(colors)
}

.segment ZEROPAGE
.data row:    .addr                 ; the start of the cursor's row in `screen`
.data column: .byte                 ; the cursor's column, which is COLUMNS past the end of a row
.data frames: .byte                 ; the vblanks there have been, counted by `refresh`

.segment BSS
.data screen: .byte[COLUMNS * ROWS]
; The high bytes of the tilemap's rows below the text, which choose each place's palette.
.data colors: .byte[COLUMNS * (ROWS - TEXT_ROWS)]

; Runs the DMA that `settings`, a `Dma` record, describes, on channel 0.
.macro dma(settings) {
    ldx #.sizeof(Dma) - 1
@copy:
    lda settings,x
    sta DMA0,x
    dex
    bpl @copy
    lda #1
    sta MDMAEN
}

.segment CODE
; Sets up the S-PPU for the text screen, and clears the screen. The screen must be in forced
; blank, and stays in it.
.proc setup: running {
    ldx #0
@setting:
    ldy settings + Setting::port,x
    lda settings + Setting::value,x
    sta PPU,y
    inx
    inx
    cpx #.sizeof(settings)
    bne @setting
    stz VMADDL
    stz VMADDL+1
    dma!(clear_vram)
    lda #<(TILES + text(' ') * 8)
    sta VMADDL
    lda #>(TILES + text(' ') * 8)
    sta VMADDL+1
    dma!(load_font)
    stz CGADD
    dma!(load_palette)
    ; The text is all spaces. The keyboard draws the rows below it.
    ldx #0
    lda #text(' ')
@clear:
    .repeat 3, page {
        sta screen + page * 256,x
    }
    inx
    bne @clear
    stz column
    lda #<screen
    sta row
    lda #>screen
    sta row+1
    rts
}

; Writes the character in A at the cursor, and moves the cursor on. NEWLINE moves it to the
; start of the next row. A character written past the end of a row goes at the start of the
; next one, and a new row past the last scrolls the text up.
.proc putc: running, keeps x, y {
    phx
    phy
    cmp #NEWLINE
    beq @newline
    ldy column
    cpy #COLUMNS
    bcc @place
    pha
    jsr next_row
    pla
    ldy #0
@place:
    sta (row),y
    iny
    sty column
    ply
    plx
    rts
@newline:
    jsr next_row
    ply
    plx
    rts
}

; Moves the cursor to the start of the next row, scrolling the text up a row when the cursor is
; on the last one.
.proc next_row: running {
    stz column
    lda row
    cmp #<(screen + (TEXT_ROWS - 1) * COLUMNS)
    bne @down
    lda row+1
    cmp #>(screen + (TEXT_ROWS - 1) * COLUMNS)
    beq scroll
@down:
    lda row
    clc
    adc #COLUMNS
    sta row
    bcc @done
    inc row+1
@done:
    rts
}

; Moves the text up a row, and clears the last row. Each page is moved whole before the next,
; whose first row the end of the page before reads.
.proc scroll: running {
    .repeat 3, page {
        ldx #0
    @move:
        lda screen + COLUMNS + page * 256,x
        sta screen + page * 256,x
        inx
        bne @move
    }
    ldx #COLUMNS - 1
    lda #text(' ')
@clear:
    sta screen + (TEXT_ROWS - 1) * COLUMNS,x
    dex
    bpl @clear
    rts
}

; Copies `screen` and `colors` into the tilemap, and counts the frame. The NMI calls this at the
; start of each vblank, in either mode.
.proc refresh: e*, a8, i8, dp = 0, dbr = 0 {
    lda #STEP_LOW
    sta VMAIN
    stz VMADDL
    stz VMADDL+1
    dma!(show_screen)
    lda #STEP_HIGH
    sta VMAIN
    lda #<(MAP + TEXT_ROWS * COLUMNS)
    sta VMADDL
    lda #>(MAP + TEXT_ROWS * COLUMNS)
    sta VMADDL+1
    dma!(show_colors)
    inc frames
    rts
}
