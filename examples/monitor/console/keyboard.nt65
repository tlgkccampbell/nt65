; This module reads a line from an on-screen keyboard, which the joypad drives. The keyboard is
; drawn on the rows below the text, three rows of sixteen places. The d-pad moves a cursor over
; it, and wraps round at its edges. The buttons do what `read_line` says.
;
; The platform's `joypad::read` reads the joypad as a set of `Button`s, whatever the machine
; calls its buttons.
.module platform::keyboard

.use platform::{text, NEWLINE, DELETE, COLUMNS, LINE_LENGTH, running, putc}
.use platform::screen::{screen, row, column, frames, TEXT_ROWS, ROWS}
.use platform::font::{KEY, CHOSEN}
.use monitor::parse::line

.export Button, setup, read_line, keys, pad

; What the joypad's buttons do, each a bit of a byte, laid out as the NES reads its joypad.
.enum Button {
    type   = $80                    ; types the key the cursor is on
    delete = $40                    ; deletes the last character
    space  = $20                    ; types a space
    enter  = $10                    ; ends the line, as RETURN does
    up     = $08
    down   = $04
    left   = $02
    right  = $01
}

.const KEY_COLUMNS = 16
.const KEY_ROWS = 3
.const KEYS = KEY_COLUMNS * KEY_ROWS       ; the places on the keyboard
.const FIRST_ROW = TEXT_ROWS + 1           ; the screen's row of the keyboard's first row
.const DELAY = 16                          ; the frames a held button waits before it repeats
.const REPEAT = 4                          ; the frames between its repeats
.const BLINK = $10                         ; the bit of `frames` that blinks the text cursor

.const DPAD = Button::up | Button::down | Button::left | Button::right
.const REPEATS = DPAD | Button::delete     ; the buttons that repeat

.assert ROWS - FIRST_ROW == KEY_ROWS, "the keyboard must fill the rows below the text"
.assert KEY_COLUMNS * 2 == COLUMNS, "each place on the keyboard must be two columns wide"
.assert KEYS * 2 < 256, "the keyboard's columns must be counted in a byte"

; The keys of the first two rows, which type what they show.
.list letters {
    "0123456789ABCDEF"
    "GHIJKLMNOPQRSTUV"
}

.segment RODATA
; What each place on the keyboard types. A key that spans several places types the same at each.
.data keys: .byte[KEYS] {
    .each letters, names {
        text(names)
    }
    text("WXYZ:.?   ")
    DELETE, DELETE, NEWLINE, NEWLINE, NEWLINE, NEWLINE
}

; The keyboard as it is drawn, with each key's name in the second column of its first place.
; `draw_keys` draws it in each key's style.
.data picture: .byte[KEY_ROWS * COLUMNS] {
    .each letters, names {
        .repeat KEY_COLUMNS, place {
            text(' '), text(.strsub(names, place, 1))
        }
    }
    text(" W X Y Z : . ? SPACE DEL RETURN ")
}

.segment BSS
.data pad:     .byte                ; the buttons held at the last frame
.data pressed: .byte                ; the buttons pressed since the frame before
.data key:     .byte                ; the place on the keyboard the cursor is on
.data chosen:  .byte                ; what that place types
.data style:   .byte                ; the style `draw_keys` draws a place in
.data length:  .byte                ; the characters in `line`
.data timer:   .byte                ; the frames until the buttons held repeat

.segment CODE
; Draws the keyboard below the text, with the cursor on its first key.
.proc setup: running {
    ldx #COLUMNS - 1
    lda #text(' ')
@gap:
    sta screen + TEXT_ROWS * COLUMNS,x
    dex
    bpl @gap
    lda #0
    sta key
    sta pad
    jmp draw_keys
}

; Reads a line from the keyboard into `parse::line`, echoing it on the screen. The buttons do
; these things:
;
;   type       Types the key the cursor is on.
;   delete     Deletes the last character typed.
;   space      Types a space.
;   enter      Ends the line, as RETURN does.
;   d-pad      Moves the cursor over the keyboard. A held button repeats, and so does delete.
.proc read_line: running {
    lda #0
    sta length
@frame:
    jsr show_cursor
    jsr next_frame
    lda pressed
    and #DPAD
    beq @moved
    jsr move
@moved:
    lda pressed
    and #Button::delete
    beq @kept
    jsr delete
@kept:
    lda pressed
    and #Button::space
    beq @spaced
    lda #text(' ')
    jsr type
@spaced:
    lda pressed
    and #Button::type
    beq @keyed
    ldx key
    lda keys,x
    cmp #NEWLINE
    beq @done
    cmp #DELETE
    beq @delete
    jsr type
    jmp @keyed
@delete:
    jsr delete
@keyed:
    lda pressed
    and #Button::enter
    beq @frame
@done:
    ldy column
    lda #text(' ')
    sta (row),y                     ; the cursor
    ldx length
    lda #0
    sta line,x
    lda #NEWLINE
    jmp putc
}

; Adds the character in A to the line, and writes it, unless the line is full.
.proc type: running {
    ldx length
    cpx #LINE_LENGTH
    bcs @full
    sta line,x
    inc length
    jmp putc
@full:
    rts
}

; Takes the last character off the line, and off the screen.
.proc delete: running {
    lda length
    beq @empty
    dec length
    ldy column
    lda #text(' ')
    sta (row),y                     ; the cursor
    dey
    sty column
    sta (row),y
@empty:
    rts
}

; Shows the text cursor where the next character goes, blinking.
.proc show_cursor: running {
    ldy column
    cpy #COLUMNS
    bcs @past
    lda frames
    and #BLINK
    beq @on
    lda #text(' ')
    bne @draw                       ; always taken
@on:
    lda #text('_')
@draw:
    sta (row),y
@past:
    rts
}

; Waits for the next frame, and reads the joypad. It leaves the buttons held in `pad`, and the
; buttons pressed since the frame before in `pressed`. A button that repeats counts as pressed
; again once it has been held for DELAY frames, and every REPEAT frames after that.
.proc next_frame: running {
    lda frames
@wait:
    .if .target(65816) {
        wai                         ; until the next interrupt, which may be the frame's NMI
    }
    cmp frames
    beq @wait
    jsr platform::joypad::read
    tax
    lda pad
    eor #$FF                        ; the buttons that were up
    stx pad
    and pad                         ; and are down now
    sta pressed
    and #REPEATS
    beq @held
    lda #DELAY
    sta timer
    rts
@held:
    lda pad
    and #REPEATS
    beq @done
    dec timer
    bne @done
    lda #REPEAT
    sta timer
    lda pad
    and #REPEATS
    ora pressed
    sta pressed
@done:
    rts
}

; Moves the cursor as the d-pad buttons in `pressed` say, across and then up or down, and draws
; the keys again.
.proc move: running {
    lda pressed
    and #Button::right
    beq @not_right
    jsr right
@not_right:
    lda pressed
    and #Button::left
    beq @not_left
    jsr left
@not_left:
    lda pressed
    and #Button::up
    beq @not_up
    jsr up
@not_up:
    lda pressed
    and #Button::down
    beq @not_down
    jsr down
@not_down:
    .fallthrough draw_keys
}

; Draws each key, the one the cursor is on in the chosen style and the rest in the keys' style.
.proc draw_keys: running {
    ldx key
    lda keys,x
    sta chosen
    ldx #KEYS - 1
@place:
    txa
    asl a
    tay                             ; the place's first column
    lda keys,x
    cmp chosen
    beq @chosen
    lda #KEY
    bne @style                      ; always taken
@chosen:
    lda #CHOSEN
@style:
    sta style
    clc
    adc picture,y
    sta screen + FIRST_ROW * COLUMNS,y
    lda style
    adc picture + 1,y               ; the carry is clear, as no tile passes 255
    sta screen + FIRST_ROW * COLUMNS + 1,y
    dex
    bpl @place
    rts
}

; Moves the cursor right, past the rest of the key it is on, and from the end of a row round to
; its start.
.proc right: running {
    ldx key
    lda keys,x
    sta chosen
@step:
    inx
    txa
    and #KEY_COLUMNS - 1
    bne @same_row
    txa
    sec
    sbc #KEY_COLUMNS
    tax
@same_row:
    lda keys,x
    cmp chosen
    beq @step
    stx key
    rts
}

; Moves the cursor left, past the rest of the key it is on, and from the start of a row round to
; its end.
.proc left: running {
    ldx key
    lda keys,x
    sta chosen
@step:
    txa
    and #KEY_COLUMNS - 1
    bne @same_row
    txa
    clc
    adc #KEY_COLUMNS
    tax
@same_row:
    dex
    lda keys,x
    cmp chosen
    beq @step
    stx key
    rts
}

; Moves the cursor up a row, and from the top row round to the bottom one.
.proc up: running {
    lda key
    sec
    sbc #KEY_COLUMNS
    bcs @done
    adc #KEYS
@done:
    sta key
    rts
}

; Moves the cursor down a row, and from the bottom row round to the top one.
.proc down: running {
    lda key
    clc
    adc #KEY_COLUMNS
    cmp #KEYS
    bcc @done
    sbc #KEYS
@done:
    sta key
    rts
}
