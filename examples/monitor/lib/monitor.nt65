; This module is the core of a machine-language monitor, which shows memory, changes it,
; disassembles it, and runs code in it.
;
; The monitor is a library and has no nt65.json of its own. Each platform is a project whose
; files include these, and whose own files include a module named `platform`. That module
; exports the names the monitor uses to reach the machine:
;
;   running             The signature set that every routine in the monitor declares. It
;                       describes the state the monitor runs in, which on the 65816 has 8-bit
;                       registers.
;   text                The charmap for the machine's characters. The monitor applies it to
;                       every character it writes or reads, and it must map space through `Z`
;                       in ASCII's order.
;   NEWLINE             The character that ends a line.
;   COLUMNS             The width of the screen, which decides how many bytes a line of M
;                       shows, and whether the 65816's registers fit on one line of R. The
;                       monitor's conditions test it, so the configuration must decide it.
;   LINE_LENGTH         The length of the longest line that `read_line` reads.
;   DISK                Whether the platform reads and writes files, with `load` and `save`.
;                       The monitor's conditions test it, as they test `COLUMNS`.
;   putc: keeps x, y    Writes the character in A, which is a capital letter, a digit, a
;                       punctuation mark, a space or `NEWLINE`, in `text`.
;   read_line           Reads a line from the keyboard into `parse::line`, as at most
;                       `parse::LINE_SIZE` - 1 characters followed by a zero. It leaves the
;                       cursor at the start of the next line.
;   exit: noreturn      Leaves the monitor for whatever ran it.
;   load                Carries out L, which reads a file into memory. Only a platform
;                       whose `DISK` is true supplies it.
;   save                Carries out S, which writes memory to a file. Only a platform whose
;                       `DISK` is true supplies it.
;
; The platform also starts the monitor. Its start code prepares the machine and arranges for a
; BRK to reach `broke`, with the registers the BRK found stored in `registers`. It then jumps to
; `main`.
;
; On the 65816 the monitor can reach all sixteen megabytes of memory. There an address is three
; bytes, written with the bank first, and the registers are the 65816's.
.module monitor

.use platform::{putc, text, running}
.use monitor::text::{print, newline}
.use monitor::{parse, memory, disasm, run}

.export main, broke, error, Registers, registers, addr, ADDRESS_SIZE
.if .target(65816) {
    .export Register
}

.const ADDRESS_SIZE = .select(.target(65816), 3, 2)  ; the bytes of an address

; The registers of the program being debugged, as a BRK left them or `G` will start them.
.if .target(65816) {
    ; A 16-bit register, which `G` and the platform's BRK handlers store whole, and which `R`
    ; reads a byte at a time.
    .union Register {
        word: .word
        .struct {
            low:  .byte
            high: .byte
        }
    }

    .struct Registers {
        pc: .faraddr                ; with the program bank as its third byte
        ac: .type Register
        xr: .type Register
        yr: .type Register
        sp: .type Register
        dp: .type Register
        db: .byte
        sr: .byte
        e:  .byte                   ; 1 in emulation mode
    }
} .else {
    .struct Registers {
        pc: .word
        ac: .byte
        xr: .byte
        yr: .byte
        sp: .byte
        sr: .byte
    }
}

; Each command is a letter and the routine that carries it out. A routine starts with the
; parser just past its letter, and returns when it is done, or jumps to `error`. T needs the
; 65816's block moves, and L and S a platform with a disk.
.list commands {
    memory::dump                    ; M [from [to]]
    memory::write                   ; :address byte...
    memory::fill                    ; F from to byte
    .if .target(65816) {
        memory::transfer            ; T from to address
    }
    disasm::list                    ; D [from [to]]
    run::go                         ; G [address]
    run::show                       ; R
    .if platform::DISK {
        platform::load              ; L name [address]
        platform::save              ; S name from to
    }
    platform::exit                  ; X
    help                            ; ?
}

.segment RODATA
.data letters: .byte[] {
    text("M:F")
    .if .target(65816) {
        text('T')
    }
    text("DGR")
    .if platform::DISK {
        text("LS")
    }
    text("X?")
}
.data handlers: .addr commands

.assert .sizeof(letters) == .countof(commands), "every command needs a letter"

.segment ZEROPAGE
.data addr: .byte[ADDRESS_SIZE]     ; where M, D, : and F start, and where M and D go on from

.segment BSS
.data registers: .type Registers
.data home:      .byte              ; the stack pointer each command starts with

.segment CODE
.proc main: running, noreturn {
    cld
    tsx
    stx home
    lda #0
    ldx #.sizeof(registers) - 1
@clear:
    sta registers,x
    dex
    bpl @clear
    lda home
    .if .target(65816) {
        sta registers::sp::low
        lda #1                      ; the stack is in page 1, and the monitor in emulation mode
        sta registers::sp::high
        sta registers::e
    } .else {
        sta registers::sp
    }
    jsr print
    .strz text("NT65 MONITOR")
    jsr newline
    .fallthrough prompt
}

; Reads a command and carries it out, for as long as the monitor runs. Every command starts
; with the stack as `main` found it, so one that stops part-way through leaves nothing behind.
.proc prompt: running, noreturn {
    ldx home
    txs
    lda #text('.')
    jsr putc
    jsr platform::read_line
    jsr parse::begin
    beq prompt
    ldx #.sizeof(letters) - 1
@find:
    cmp letters,x
    beq @found
    dex
    bpl @find
    jmp error
@found:
    jsr parse::skip
    txa
    asl a
    tax
    .if .target(65816) {
        ; Every command returns here, and the state after the call is what their exits agree on.
        jsr (handlers,x)
        .next commands
    } .else {
        jsr dispatch
    }
    jmp prompt
}

.if !.target(65816) {
    ; Carries out the command whose offset in `handlers` is in X. The command's own RTS returns
    ; to `prompt`. The 6502 has no `jsr (t,x)`, so the call jumps through a vector instead.
    .proc dispatch: running {
        lda handlers,x
        sta @vector
        lda handlers+1,x
        sta @vector+1
        jmp (@vector)
        .next commands

        .segment BSS {
        @vector: .res 2
        }
    }
}

; ?: lists the commands. Each line fits the narrowest screen a platform has, the Super NES's
; thirty-two columns, so none wraps.
.proc help: running {
    jsr print
    .strz text("NUMBERS ARE HEX")
    jsr newline
    jsr print
    .strz text("M [FROM [TO]]   SHOW MEMORY")
    jsr newline
    jsr print
    .strz text(":ADDR BYTE...   WRITE BYTES")
    jsr newline
    jsr print
    .strz text("F FROM TO BYTE  FILL MEMORY")
    jsr newline
    .if .target(65816) {
        jsr print
        .strz text("T FROM TO ADDR  COPY MEMORY")
        jsr newline
    }
    jsr print
    .strz text("D [FROM [TO]]   DISASSEMBLE")
    jsr newline
    jsr print
    .strz text("G [ADDR]        RUN CODE")
    jsr newline
    jsr print
    .strz text("R               SHOW REGISTERS")
    jsr newline
    .if platform::DISK {
        jsr print
        .strz text("L NAME [ADDR]   LOAD A FILE")
        jsr newline
        jsr print
        .strz text("S NAME FROM TO  SAVE A FILE")
        jsr newline
    }
    jsr print
    .strz text("X               EXIT THE MONITOR")
    jsr newline
    jsr print
    .strz text("?               SHOW THIS LIST")
    jmp newline
}

; A command found something it cannot read: say so, and read the next one.
.proc error: running, noreturn {
    lda #text('?')
    jsr putc
    jsr newline
    jmp prompt
}

; Where the platform sends a BRK, with the registers it found stored in `registers`.
.proc broke: running, noreturn {
    cld
    ldx home
    txs
    jsr print
    .strz text("BRK")
    jsr newline
    jsr run::show
    jmp prompt
}
