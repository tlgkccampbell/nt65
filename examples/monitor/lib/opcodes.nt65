; This module describes the processor's instructions as the disassembler reads them, giving
; each opcode's name and addressing mode. On the 6502 an opcode that the processor does not
; document is `???`, with no operand. The 65816 has all 256 opcodes.
.module monitor::opcodes

.use monitor::opcodes::Mode as M

.export Mode, operand_size, opening, closing, branch, banks, name_lo, name_hi, modes

.enum Mode {
    imp                             ; no operand
    acc                             ; A
    imm                             ; #$12
    zp                              ; $12
    zpx                             ; $12,X
    zpy                             ; $12,Y
    abs                             ; $1234
    absx                            ; $1234,X
    absy                            ; $1234,Y
    ind                             ; ($1234)
    indx                            ; ($12,X)
    indy                            ; ($12),Y
    rel                             ; a branch, shown as its target
    .if .target(65816) {
        imma                        ; #$12 or #$1234, as wide as A
        immi                        ; #$12 or #$1234, as wide as X and Y
        indzp                       ; ($12)
        indl                        ; [$12]
        indly                       ; [$12],Y
        sr                          ; $12,S
        sry                         ; ($12,S),Y
        long                        ; $123456
        longx                       ; $123456,X
        indabsx                     ; ($1234,X)
        indabsl                     ; [$1234]
        rell                        ; a long branch, shown as its target
        move                        ; the source bank and the destination bank: $12,$34
    }
}

; Returns how many bytes follow an opcode in mode m. An immediate as wide as a register has one
; more byte when that register is 16 bits wide.
.func operand_size(m) = .select(m == Mode::imp || m == Mode::acc, 0, .select(two_bytes(m), 2, .select(three_bytes(m), 3, 1)))
.func two_bytes(m) = m == Mode::abs || m == Mode::absx || m == Mode::absy || m == Mode::ind || .select(.target(65816), m == Mode::indabsx || m == Mode::indabsl || m == Mode::rell || m == Mode::move, 0)
.func three_bytes(m) = .select(.target(65816), m == Mode::long || m == Mode::longx, 0)

; Returns the text that an operand in mode m shows before its number. That is `#`, `(` or `[`
; where the mode has one, followed by `$`.
.func opening(m) = .select(immediate(m), "#$", .select(indirect(m), "($", .select(long_indirect(m), "[$", "$")))
.func immediate(m) = m == Mode::imm || .select(.target(65816), m == Mode::imma || m == Mode::immi, 0)
.func indirect(m) = m == Mode::ind || m == Mode::indx || m == Mode::indy || .select(.target(65816), m == Mode::indzp || m == Mode::sry || m == Mode::indabsx, 0)
.func long_indirect(m) = .select(.target(65816), m == Mode::indl || m == Mode::indly || m == Mode::indabsl, 0)

; Returns the text that an operand in mode m shows after its number, which may be empty.
.func closing(m) = .select(.target(65816), .select(m == Mode::longx, ",X", .select(m == Mode::indabsx, ",X)", .select(m == Mode::indzp, ")", .select(m == Mode::indl || m == Mode::indabsl, "]", .select(m == Mode::indly, "],Y", .select(m == Mode::sr, ",S", .select(m == Mode::sry, ",S),Y", closing_6502(m)))))))), closing_6502(m))
.func closing_6502(m) = .select(m == Mode::zpx || m == Mode::absx, ",X", .select(m == Mode::zpy || m == Mode::absy, ",Y", .select(m == Mode::indx, ",X)", .select(m == Mode::indy, "),Y", .select(m == Mode::ind, ")", "")))))

; Returns whether mode m is a branch's, whose operand is shown as the address it goes to.
.func branch(m) = m == Mode::rel || .select(.target(65816), m == Mode::rell, 0)

; Returns whether mode m is a block move's, whose operand is two banks.
.func banks(m) = .select(.target(65816), m == Mode::move, 0)

; A name's three letters, five bits each from the top of a word, counted from '?' so that
; `???` is zero too.
.func packed(name) = ((.strat(name, 0) - '?') << 11) | ((.strat(name, 1) - '?') << 6) | ((.strat(name, 2) - '?') << 1)

.if .target(65816) {
    ; Row n holds opcodes $n0 to $nF.
    .list names {
        "BRK ORA COP ORA TSB ORA ASL ORA PHP ORA ASL PHD TSB ORA ASL ORA"
        "BPL ORA ORA ORA TRB ORA ASL ORA CLC ORA INC TCS TRB ORA ASL ORA"
        "JSR AND JSL AND BIT AND ROL AND PLP AND ROL PLD BIT AND ROL AND"
        "BMI AND AND AND BIT AND ROL AND SEC AND DEC TSC BIT AND ROL AND"
        "RTI EOR WDM EOR MVP EOR LSR EOR PHA EOR LSR PHK JMP EOR LSR EOR"
        "BVC EOR EOR EOR MVN EOR LSR EOR CLI EOR PHY TCD JML EOR LSR EOR"
        "RTS ADC PER ADC STZ ADC ROR ADC PLA ADC ROR RTL JMP ADC ROR ADC"
        "BVS ADC ADC ADC STZ ADC ROR ADC SEI ADC PLY TDC JMP ADC ROR ADC"
        "BRA STA BRL STA STY STA STX STA DEY BIT TXA PHB STY STA STX STA"
        "BCC STA STA STA STY STA STX STA TYA STA TXS TXY STZ STA STZ STA"
        "LDY LDA LDX LDA LDY LDA LDX LDA TAY LDA TAX PLB LDY LDA LDX LDA"
        "BCS LDA LDA LDA LDY LDA LDX LDA CLV LDA TSX TYX LDY LDA LDX LDA"
        "CPY CMP REP CMP CPY CMP DEC CMP INY CMP DEX WAI CPY CMP DEC CMP"
        "BNE CMP CMP CMP PEI CMP DEC CMP CLD CMP PHX STP JML CMP DEC CMP"
        "CPX SBC SEP SBC CPX SBC INC SBC INX SBC NOP XBA CPX SBC INC SBC"
        "BEQ SBC SBC SBC PEA SBC INC SBC SED SBC PLX XCE JSR SBC INC SBC"
    }

    ; Two lines for each row of `names`: opcodes $n0 to $n7, then $n8 to $nF.
    .list mode_rows {
        M::imm,  M::indx, M::imm,  M::sr,   M::zp,   M::zp,   M::zp,   M::indl
        M::imp,  M::imma, M::acc,  M::imp,  M::abs,  M::abs,  M::abs,  M::long
        M::rel,  M::indy, M::indzp, M::sry, M::zp,   M::zpx,  M::zpx,  M::indly
        M::imp,  M::absy, M::acc,  M::imp,  M::abs,  M::absx, M::absx, M::longx
        M::abs,  M::indx, M::long, M::sr,   M::zp,   M::zp,   M::zp,   M::indl
        M::imp,  M::imma, M::acc,  M::imp,  M::abs,  M::abs,  M::abs,  M::long
        M::rel,  M::indy, M::indzp, M::sry, M::zpx,  M::zpx,  M::zpx,  M::indly
        M::imp,  M::absy, M::acc,  M::imp,  M::absx, M::absx, M::absx, M::longx
        M::imp,  M::indx, M::imm,  M::sr,   M::move, M::zp,   M::zp,   M::indl
        M::imp,  M::imma, M::acc,  M::imp,  M::abs,  M::abs,  M::abs,  M::long
        M::rel,  M::indy, M::indzp, M::sry, M::move, M::zpx,  M::zpx,  M::indly
        M::imp,  M::absy, M::imp,  M::imp,  M::long, M::absx, M::absx, M::longx
        M::imp,  M::indx, M::rell, M::sr,   M::zp,   M::zp,   M::zp,   M::indl
        M::imp,  M::imma, M::acc,  M::imp,  M::ind,  M::abs,  M::abs,  M::long
        M::rel,  M::indy, M::indzp, M::sry, M::zpx,  M::zpx,  M::zpx,  M::indly
        M::imp,  M::absy, M::imp,  M::imp,  M::indabsx, M::absx, M::absx, M::longx
        M::rel,  M::indx, M::rell, M::sr,   M::zp,   M::zp,   M::zp,   M::indl
        M::imp,  M::imma, M::imp,  M::imp,  M::abs,  M::abs,  M::abs,  M::long
        M::rel,  M::indy, M::indzp, M::sry, M::zpx,  M::zpx,  M::zpy,  M::indly
        M::imp,  M::absy, M::imp,  M::imp,  M::abs,  M::absx, M::absx, M::longx
        M::immi, M::indx, M::immi, M::sr,   M::zp,   M::zp,   M::zp,   M::indl
        M::imp,  M::imma, M::imp,  M::imp,  M::abs,  M::abs,  M::abs,  M::long
        M::rel,  M::indy, M::indzp, M::sry, M::zpx,  M::zpx,  M::zpy,  M::indly
        M::imp,  M::absy, M::imp,  M::imp,  M::absx, M::absx, M::absy, M::longx
        M::immi, M::indx, M::imm,  M::sr,   M::zp,   M::zp,   M::zp,   M::indl
        M::imp,  M::imma, M::imp,  M::imp,  M::abs,  M::abs,  M::abs,  M::long
        M::rel,  M::indy, M::indzp, M::sry, M::indzp, M::zpx, M::zpx,  M::indly
        M::imp,  M::absy, M::imp,  M::imp,  M::indabsl, M::absx, M::absx, M::longx
        M::immi, M::indx, M::imm,  M::sr,   M::zp,   M::zp,   M::zp,   M::indl
        M::imp,  M::imma, M::imp,  M::imp,  M::abs,  M::abs,  M::abs,  M::long
        M::rel,  M::indy, M::indzp, M::sry, M::abs,  M::zpx,  M::zpx,  M::indly
        M::imp,  M::absy, M::imp,  M::imp,  M::indabsx, M::absx, M::absx, M::longx
    }
} .else {
    ; The 6502's, in the same rows.
    .list names {
        "BRK ORA ??? ??? ??? ORA ASL ??? PHP ORA ASL ??? ??? ORA ASL ???"
        "BPL ORA ??? ??? ??? ORA ASL ??? CLC ORA ??? ??? ??? ORA ASL ???"
        "JSR AND ??? ??? BIT AND ROL ??? PLP AND ROL ??? BIT AND ROL ???"
        "BMI AND ??? ??? ??? AND ROL ??? SEC AND ??? ??? ??? AND ROL ???"
        "RTI EOR ??? ??? ??? EOR LSR ??? PHA EOR LSR ??? JMP EOR LSR ???"
        "BVC EOR ??? ??? ??? EOR LSR ??? CLI EOR ??? ??? ??? EOR LSR ???"
        "RTS ADC ??? ??? ??? ADC ROR ??? PLA ADC ROR ??? JMP ADC ROR ???"
        "BVS ADC ??? ??? ??? ADC ROR ??? SEI ADC ??? ??? ??? ADC ROR ???"
        "??? STA ??? ??? STY STA STX ??? DEY ??? TXA ??? STY STA STX ???"
        "BCC STA ??? ??? STY STA STX ??? TYA STA TXS ??? ??? STA ??? ???"
        "LDY LDA LDX ??? LDY LDA LDX ??? TAY LDA TAX ??? LDY LDA LDX ???"
        "BCS LDA ??? ??? LDY LDA LDX ??? CLV LDA TSX ??? LDY LDA LDX ???"
        "CPY CMP ??? ??? CPY CMP DEC ??? INY CMP DEX ??? CPY CMP DEC ???"
        "BNE CMP ??? ??? ??? CMP DEC ??? CLD CMP ??? ??? ??? CMP DEC ???"
        "CPX SBC ??? ??? CPX SBC INC ??? INX SBC NOP ??? CPX SBC INC ???"
        "BEQ SBC ??? ??? ??? SBC INC ??? SED SBC ??? ??? ??? SBC INC ???"
    }

    ; Two lines for each row of `names`: opcodes $n0 to $n7, then $n8 to $nF.
    .list mode_rows {
        M::imp,  M::indx, M::imp,  M::imp,  M::imp,  M::zp,   M::zp,   M::imp
        M::imp,  M::imm,  M::acc,  M::imp,  M::imp,  M::abs,  M::abs,  M::imp
        M::rel,  M::indy, M::imp,  M::imp,  M::imp,  M::zpx,  M::zpx,  M::imp
        M::imp,  M::absy, M::imp,  M::imp,  M::imp,  M::absx, M::absx, M::imp
        M::abs,  M::indx, M::imp,  M::imp,  M::zp,   M::zp,   M::zp,   M::imp
        M::imp,  M::imm,  M::acc,  M::imp,  M::abs,  M::abs,  M::abs,  M::imp
        M::rel,  M::indy, M::imp,  M::imp,  M::imp,  M::zpx,  M::zpx,  M::imp
        M::imp,  M::absy, M::imp,  M::imp,  M::imp,  M::absx, M::absx, M::imp
        M::imp,  M::indx, M::imp,  M::imp,  M::imp,  M::zp,   M::zp,   M::imp
        M::imp,  M::imm,  M::acc,  M::imp,  M::abs,  M::abs,  M::abs,  M::imp
        M::rel,  M::indy, M::imp,  M::imp,  M::imp,  M::zpx,  M::zpx,  M::imp
        M::imp,  M::absy, M::imp,  M::imp,  M::imp,  M::absx, M::absx, M::imp
        M::imp,  M::indx, M::imp,  M::imp,  M::imp,  M::zp,   M::zp,   M::imp
        M::imp,  M::imm,  M::acc,  M::imp,  M::ind,  M::abs,  M::abs,  M::imp
        M::rel,  M::indy, M::imp,  M::imp,  M::imp,  M::zpx,  M::zpx,  M::imp
        M::imp,  M::absy, M::imp,  M::imp,  M::imp,  M::absx, M::absx, M::imp
        M::imp,  M::indx, M::imp,  M::imp,  M::zp,   M::zp,   M::zp,   M::imp
        M::imp,  M::imp,  M::imp,  M::imp,  M::abs,  M::abs,  M::abs,  M::imp
        M::rel,  M::indy, M::imp,  M::imp,  M::zpx,  M::zpx,  M::zpy,  M::imp
        M::imp,  M::absy, M::imp,  M::imp,  M::imp,  M::absx, M::imp,  M::imp
        M::imm,  M::indx, M::imm,  M::imp,  M::zp,   M::zp,   M::zp,   M::imp
        M::imp,  M::imm,  M::imp,  M::imp,  M::abs,  M::abs,  M::abs,  M::imp
        M::rel,  M::indy, M::imp,  M::imp,  M::zpx,  M::zpx,  M::zpy,  M::imp
        M::imp,  M::absy, M::imp,  M::imp,  M::absx, M::absx, M::absy, M::imp
        M::imm,  M::indx, M::imp,  M::imp,  M::zp,   M::zp,   M::zp,   M::imp
        M::imp,  M::imm,  M::imp,  M::imp,  M::abs,  M::abs,  M::abs,  M::imp
        M::rel,  M::indy, M::imp,  M::imp,  M::imp,  M::zpx,  M::zpx,  M::imp
        M::imp,  M::absy, M::imp,  M::imp,  M::imp,  M::absx, M::absx, M::imp
        M::imm,  M::indx, M::imp,  M::imp,  M::zp,   M::zp,   M::zp,   M::imp
        M::imp,  M::imm,  M::imp,  M::imp,  M::abs,  M::abs,  M::abs,  M::imp
        M::rel,  M::indy, M::imp,  M::imp,  M::imp,  M::zpx,  M::zpx,  M::imp
        M::imp,  M::absy, M::imp,  M::imp,  M::imp,  M::absx, M::absx, M::imp
    }
}

.segment RODATA
.data name_lo: .byte[256] {
    .each names, row {
        .repeat 16, column {
            .lobyte(packed(.strsub(row, column * 4, 3)))
        }
    }
}
.data name_hi: .byte[256] {
    .each names, row {
        .repeat 16, column {
            .hibyte(packed(.strsub(row, column * 4, 3)))
        }
    }
}
.data modes: .byte[256] { mode_rows }
