; D: shows memory as instructions.
.module monitor::disasm

.use platform::{putc, text, running, COLUMNS}
.use monitor::{addr, registers, ADDRESS_SIZE}
.use monitor::opcodes::{Mode, operand_size, opening, closing, branch, banks, name_lo, name_hi, modes}
.use monitor::text::{print, print_byte, space, newline}
.use monitor::memory::{range, last}
.use monitor::macros::{add_address, compare_address, peek, print_address}

.export list

.const INSTRUCTIONS = 16                             ; what D shows when it is not told where to stop
.const LONGEST      = .select(.target(65816), 4, 3)  ; the bytes of the longest instruction
.const M_FLAG       = $20                            ; the 65816's flag for an 8-bit A
.const X_FLAG       = $10                            ; the 65816's flag for 8-bit X and Y
.const REP_OPCODE   = $C2
.const SEP_OPCODE   = $E2

; Returns the width of the widest line of D, whose bytes are `gap` columns apart. The line holds a
; comma and the address, then a space and the bytes, then a space and the name, and then a space
; and the widest operand, such as `$1234,X`.
.func line_width(gap) = (
    1 + 2 * ADDRESS_SIZE + 1 + 2 * LONGEST + gap * (LONGEST - 1) + 1 + 3 + 1 + 2 * ADDRESS_SIZE + 3
)

; The bytes are a space apart where the screen has room, and run together otherwise. A line stays
; narrower than the screen, so that the cursor does not wrap onto the next row.
.const GAP = .select(line_width(1) < COLUMNS, 1, 0)

.assert line_width(GAP) < COLUMNS, "a line of D must fit on the screen"

.segment BSS
.data count:  .byte                 ; instructions still to show, or 0 to stop past `last`
.data opcode: .byte
.data mode:   .byte
.data length: .byte                 ; the instruction's bytes, the opcode's included
.data name:   .word                 ; the opcode's name, still packed
.data target: .byte[ADDRESS_SIZE]   ; where a branch goes
.if .target(65816) {
    .data widths: .byte             ; M_FLAG and X_FLAG, set for each register that is 8 bits wide
}

.segment RODATA
.data lengths: .byte[] {
    .each Mode, m {
        operand_size(m) + 1
    }
}
.data operands: .addr[] {
    .each Mode, m {
        operand::m
    }
}

.segment CODE
; D [from [to]]: shows instructions from `from`, or from where the last M or D stopped, up to
; the one that holds `to`, or sixteen of them. On the 65816 an immediate is as wide as the
; registers `R` shows, and as each REP and SEP in the listing leaves them.
.proc list: running {
    .if .target(65816) {
        lda #M_FLAG | X_FLAG        ; emulation mode has only 8-bit registers
        ldx registers::e
        bne @emulation
        lda registers::sr
        and #M_FLAG | X_FLAG
    @emulation:
        sta widths
    }
    jsr range
    lda #0
    bcs @count
    lda #INSTRUCTIONS
@count:
    sta count
@next:
    jsr instruction
    bcs @done                       ; the instruction ended at the top of memory
    lda count
    beq @to_last
    dec count
    bne @next
    rts
@to_last:
    compare_address!(last, addr)
    bcs @next
@done:
    rts
}

; Shows the instruction at `addr`, as its address, its bytes and what they mean, and moves
; `addr` past it. Returns with the carry set if that took it past the top of memory.
.proc instruction: running {
    ldy #0
    peek!(addr)
    sta opcode
    tax
    lda modes,x
    sta mode
    tax
    lda lengths,x
    sta length
    .if .target(65816) {
        jsr widen
    }
    lda #text(',')
    jsr putc
    print_address!(addr)
    ; The instruction's bytes, in the columns the longest one needs.
    .if GAP == 0 {
        jsr space
    }
    ldy #0
@column:
    .if GAP == 1 {
        jsr space
    }
    cpy length
    bcc @byte
    jsr space
    jsr space
    jmp @step
@byte:
    peek!(addr)
    jsr print_byte
@step:
    iny
    cpy #LONGEST
    bne @column
    jsr space
    jsr print_name
    jsr print_operand
    jsr newline
    .if .target(65816) {
        jsr follow
    }
    add_address!(addr, length)
    rts
}

.if .target(65816) {
    ; Makes an immediate as wide as the register it is for, where that register is 16 bits.
    .proc widen: running {
        lda mode
        ldx #M_FLAG
        cmp #Mode::imma
        beq @test
        ldx #X_FLAG
        cmp #Mode::immi
        bne @done
    @test:
        txa
        and widths
        bne @done
        inc length
    @done:
        rts
    }

    ; Follows a REP or SEP, which sets the widths of the instructions after it.
    .proc follow: running {
        ldy #1
        lda opcode
        cmp #REP_OPCODE
        beq @rep
        cmp #SEP_OPCODE
        bne @done
        peek!(addr)
        and #M_FLAG | X_FLAG
        ora widths
        sta widths
    @done:
        rts
    @rep:
        peek!(addr)
        eor #$FF
        and widths
        sta widths
        rts
    }
}

; Unpacks the opcode's name, five bits to a letter, and writes it.
.proc print_name: running {
    ldx opcode
    lda name_lo,x
    sta name
    lda name_hi,x
    sta name+1
    ldy #3
@letter:
    lda #0
    ldx #5
@bit:
    asl name
    rol name+1
    rol a
    dex
    bne @bit
    adc #text('?')                  ; the carry is clear: A was under 32 before the last rol
    jsr putc
    dey
    bne @letter
    rts
}

; Writes the operand as its addressing mode shows it; the printer's RTS returns from here.
.proc print_operand: running {
    lda mode
    asl a
    tax
    lda operands,x
    sta @vector
    lda operands+1,x
    sta @vector+1
    jmp (@vector)
    .next operands

    .segment BSS {
    @vector: .res 2
    }
}

; One printer for each addressing mode, all from the one body below: `operand::zpx` writes
; ` $12,X` from the byte after the opcode.
.scope operand {
    .multiproc Mode, m: running {
        .if m == Mode::imp {
            rts
        } .elseif m == Mode::acc {
            jsr space
            lda #text('A')
            jmp putc
        } .else {
            jsr space
            jsr print
            .strz text(opening(m))
            .if branch(m) {
                jsr print_target
            } .elseif banks(m) {
                ; A block move's banks, the source's first, which is the second byte.
                ldy #2
                peek!(addr)
                jsr print_byte
                jsr print
                .strz text(",$")
                dey
                peek!(addr)
                jsr print_byte
            } .else {
                jsr print_number
            }
            .if .strlen(closing(m)) > 0 {
                jsr print
                .strz text(closing(m))
            }
            rts
        }
    }
}

; Writes the bytes after the opcode as one number, the last byte first.
.proc print_number: running {
    ldy length
@next:
    dey
    beq @done
    peek!(addr)
    jsr print_byte
    jmp @next
@done:
    rts
}

; Writes where the branch at `addr` goes: the address after it, plus its offset, which is
; signed. A branch stays in its bank.
.proc print_target: running {
    ldy #1
    peek!(addr)
    sta target
    ldx #0
    cmp #$80
    bcc @forward
    dex                             ; a negative offset's high byte is $FF
@forward:
    stx target+1
    .if .target(65816) {
        lda length
        cmp #3
        bcc @short
        iny                         ; BRL and PER have a two-byte offset
        peek!(addr)
        sta target+1
    @short:
        lda addr+2
        sta target+2
    }
    clc
    lda target
    adc addr
    sta target
    lda target+1
    adc addr+1
    sta target+1
    clc
    lda target
    adc length
    sta target
    bcc @same_page
    inc target+1
@same_page:
    print_address!(target)
    rts
}
