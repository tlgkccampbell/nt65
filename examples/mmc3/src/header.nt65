; This module holds the cartridge's iNES header, which the NES's emulators read at the start of the
; file, and the interrupt vectors, at $FFFA in the last program bank.
.module header

.cpu 6502

.use main::{reset, nmi, irq}

.const MMC3     = 4                 ; the MMC3's iNES mapper number
.const VERTICAL = 1                 ; flags_6: vertical mirroring, which the MMC3 overrides

; The iNES header.
.struct Header {
    name:     .res 3, ' '           ; "NES"
    eof:      .byte                 ; $1A, MS-DOS's end of file
    prg_size: .byte                 ; the program ROM, in 16K banks
    chr_size: .byte                 ; the character ROM, in 8K banks
    flags_6:  .byte                 ; the mapper's low four bits, and how the nametables mirror
    flags_7:  .byte                 ; the mapper's high four bits
    unused:   .res 8
}

; The 6502's vectors.
.struct Vectors {
    nmi:   .addr
    reset: .addr
    irq:   .addr
}

.assert .sizeof(Header) == 16, "an iNES header is sixteen bytes"

.segment HEADER
.data header: .type Header {
    name     = "NES"
    eof      = $1A
    prg_size = 4
    chr_size = 2
    flags_6  = ((MMC3 & $0F) << 4) | VERTICAL
    flags_7  = MMC3 & $F0
}

.segment VECTORS
.data vectors: .type Vectors {
    nmi   = nmi
    reset = reset
    irq   = irq
}
