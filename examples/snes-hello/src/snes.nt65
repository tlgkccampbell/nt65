; The SNES hardware this program touches, and the state its routines run in.
.module snes

.cpu 65816

.export INIDISP, CGADD, CGDATA, NMITIMEN, RDNMI, HVBJOY, JOY1L
.export Joy, std, rgb15

INIDISP  = $2100                ; forced blank and brightness
CGADD    = $2121                ; palette index
CGDATA   = $2122                ; palette data, low byte then high
NMITIMEN = $4200                ; NMI and joypad auto-read enable
RDNMI    = $4210                ; read to acknowledge the NMI
HVBJOY   = $4212                ; bit 0 is set while auto-read runs
JOY1L    = $4218                ; joypad 1, read 16-bit

; The buttons as JOY1L reads them.
.enum Joy {
    R      = $0010
    L      = $0020
    X      = $0040
    A      = $0080
    right  = $0100
    left   = $0200
    down   = $0400
    up     = $0800
    start  = $1000
    select = $2000
    Y      = $4000
    B      = $8000
}

; The state every routine but reset and the interrupts is entered and left in.
.signature std = a8, i16, dp = 0, dbr = 0

; A BGR555 colour from 5-bit components.
.func rgb15(r, g, b) = r | (g << 5) | (b << 10)
