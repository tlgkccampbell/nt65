{
  "name": "nt65 Assembly Language (6502/65816)",
  "scopeName": "source.nt65",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#labels" },
    { "include": "#directives" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.nt65",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nt65",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.single.nt65",
          "begin": "'",
          "end": "'|$",
          "patterns": [{ "include": "#escapes" }]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.nt65",
          "match": "\\\\x[0-9A-Fa-f]{2}"
        },
        {
          "name": "constant.character.escape.nt65",
          "match": "\\\\[\\\\'\"trn]"
        },
        {
          "name": "invalid.illegal.escape.nt65",
          "match": "\\\\."
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "^[ \\t]*([A-Za-z_][A-Za-z0-9_]*)[ \\t]*:(?!=)",
          "captures": {
            "1": { "name": "entity.name.label.nt65" }
          }
        },
        {
          "name": "entity.name.label.cheap.nt65",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.label.unnamed.nt65",
          "match": "^[ \\t]*:(?![=+-])"
        }
      ]
    },
    "directives": {
      "name": "keyword.control.directive.nt65",
      "match": "\\.[A-Za-z_][A-Za-z0-9_]*"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.nt65",
          "match": "\\$[0-9A-Fa-f]+"
        },
        {
          "name": "constant.numeric.binary.nt65",
          "match": "%[01]+"
        },
        {
          "name": "constant.numeric.hex.nt65",
          "match": "\\b[0-9][0-9A-Fa-f]*[hH]\\b"
        },
        {
          "name": "constant.numeric.decimal.nt65",
          "match": "\\b[0-9]+\\b"
        }
      ]
    }
  }
}
