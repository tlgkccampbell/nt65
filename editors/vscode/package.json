{
  "name": "nt65",
  "displayName": "nt65 (Norristown Assembler)",
  "description": "nt65 assembly: highlighting, and the Norristown language server.",
  "version": "0.0.0",
  "private": true,
  "publisher": "nt65",
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:nt65",
    "workspaceContains:**/nt65.json",
    "onTaskType:nt65",
    "onWebviewPanel:nt65.directPageGrid"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nt65.selectConfiguration",
        "title": "Select Configuration",
        "category": "nt65"
      },
      {
        "command": "nt65.toggleCycleCounts",
        "title": "Toggle Cycle Counts",
        "category": "nt65"
      },
      {
        "command": "nt65.showOutputBeside",
        "title": "Show Output Beside",
        "category": "nt65"
      },
      {
        "command": "nt65.showExpansion",
        "title": "Show Macro Expansion",
        "category": "nt65"
      },
      {
        "command": "nt65.restartServer",
        "title": "Restart Server",
        "category": "nt65"
      },
      {
        "command": "nt65.nextSource",
        "title": "Go to Next Input Source",
        "category": "nt65"
      },
      {
        "command": "nt65.previousSource",
        "title": "Go to Previous Input Source",
        "category": "nt65"
      },
      {
        "command": "nt65.peekSources",
        "title": "Peek Input Sources",
        "category": "nt65"
      },
      {
        "command": "nt65.toggleSources",
        "title": "Toggle Input Sources",
        "category": "nt65"
      },
      {
        "command": "nt65.toggleFlowArrows",
        "title": "Toggle Flow Arrows",
        "category": "nt65"
      },
      {
        "command": "nt65.directPages.refresh",
        "title": "Refresh Direct Pages",
        "category": "nt65",
        "icon": "$(refresh)"
      },
      {
        "command": "nt65.directPages.toggleHazards",
        "title": "Toggle Direct Page Hazards",
        "category": "nt65"
      },
      {
        "command": "nt65.directPages.hideHazards",
        "title": "Hide Hazards",
        "category": "nt65",
        "icon": "$(warning)"
      },
      {
        "command": "nt65.directPages.showHazards",
        "title": "Show Hazards",
        "category": "nt65",
        "icon": "$(eye-closed)"
      },
      {
        "command": "nt65.showDirectPageGrid",
        "title": "Show Direct Page Grid",
        "category": "nt65",
        "icon": "$(table)"
      }
    ],
    "keybindings": [
      {
        "command": "nt65.nextSource",
        "key": "shift+alt+pagedown",
        "when": "editorTextFocus && editorLangId == nt65 && nt65.sources.active"
      },
      {
        "command": "nt65.previousSource",
        "key": "shift+alt+pageup",
        "when": "editorTextFocus && editorLangId == nt65 && nt65.sources.active"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nt65",
          "title": "nt65",
          "icon": "icons/direct-pages.svg"
        }
      ]
    },
    "views": {
      "nt65": [
        {
          "id": "nt65.directPages",
          "name": "Direct Pages",
          "contextualTitle": "nt65"
        },
        {
          "id": "nt65.directPagesLegend",
          "name": "Legend",
          "contextualTitle": "nt65",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nt65.directPages",
        "contents": "Open a file of an nt65 program to see the direct pages it uses.",
        "when": "nt65.directPages.empty == noProgram"
      },
      {
        "view": "nt65.directPages",
        "contents": "This program reaches no memory through the direct page.",
        "when": "nt65.directPages.empty == noPages"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nt65.directPages.hideHazards",
          "when": "view == nt65.directPages && nt65.directPages.hazards",
          "group": "navigation@1"
        },
        {
          "command": "nt65.directPages.showHazards",
          "when": "view == nt65.directPages && !nt65.directPages.hazards",
          "group": "navigation@1"
        },
        {
          "command": "nt65.showDirectPageGrid",
          "when": "view == nt65.directPages",
          "group": "navigation@2"
        },
        {
          "command": "nt65.directPages.refresh",
          "when": "view == nt65.directPages",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "nt65.showDirectPageGrid",
          "when": "view == nt65.directPages && viewItem == page",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "nt65.directPages.hideHazards",
          "when": "false"
        },
        {
          "command": "nt65.directPages.showHazards",
          "when": "false"
        }
      ]
    },
    "colors": [
      {
        "id": "nt65.sources.a",
        "description": "The bar, tag, chip and ruler mark that show where A was set, for the instruction at the caret.",
        "defaults": {
          "dark": "#4FC1FF",
          "light": "#0070C1",
          "highContrast": "#79D7FF",
          "highContrastLight": "#0050A0"
        }
      },
      {
        "id": "nt65.sources.aBackground",
        "description": "The tint of a line that set A, for the instruction at the caret.",
        "defaults": {
          "dark": "#4FC1FF26",
          "light": "#0070C11F",
          "highContrast": "#79D7FF40",
          "highContrastLight": "#0050A033"
        }
      },
      {
        "id": "nt65.sources.aFaintBackground",
        "description": "The tint of a line that may have set A, where nt65 can only make a best guess.",
        "defaults": {
          "dark": "#4FC1FF12",
          "light": "#0070C10F",
          "highContrast": "#79D7FF20",
          "highContrastLight": "#0050A018"
        }
      },
      {
        "id": "nt65.sources.x",
