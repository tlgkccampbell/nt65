{
  "name": "nt65",
  "displayName": "nt65 (Norristown Assembler)",
  "description": "nt65 assembly: highlighting, and the Norristown language server.",
  "version": "1.0.0",
  "private": true,
  "publisher": "nt65",
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/nt65.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nt65.selectConfiguration",
        "title": "Select Configuration",
        "category": "nt65"
      }
    ],
    "languages": [
      {
        "id": "nt65",
        "aliases": [
          "nt65"
        ],
        "extensions": [
          ".nt65"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nt65",
        "scopeName": "source.nt65",
        "path": "./syntaxes/nt65.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "nt65",
      "properties": {
        "nt65.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Norristown language server executable. Empty uses the server packaged with the extension, or the Debug build of this repository when the extension runs from it."
        },
        "nt65.configuration": {
          "type": "string",
          "default": "",
          "description": "The named configuration from nt65.json the editor analyzes the program as, such as \"debug\". Empty uses the project's own settings."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
