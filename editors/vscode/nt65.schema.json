      "description": "A number: a JSON number, or a string in nt65's number syntax, \"$2100\" or \"%1010\".",
      "anyOf": [
        { "type": "integer" },
        { "type": "string", "pattern": "^[+-]?(\\$[0-9A-Fa-f_]+|%[01_]+|[0-9][0-9_]*)$" }
      ]
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": {
        "description": "How much it matters: \"off\" not at all, \"warning\" as a warning, \"error\" as an error. A diagnostic nt65 reports as an error may not be turned down.",
