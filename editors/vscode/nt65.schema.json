{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nt65 project",
  "description": "nt65.json: what a program is built from, and how. `nt65 build` reads it from the directory it runs in or the nearest one above it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The schema this file is validated against. nt65 accepts it and reads nothing from it."
    },
    "cpu": {
      "description": "The processor the program is built for. A `.cpu` item in a file must agree with it.",
      "enum": ["6502", "6502x", "65sc02", "r65c02", "65c02", "65816"]
    },
    "files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Globs naming the program's sources, from the project root. Order is not significant, and a glob may reach above the root, so a library shared between projects is part of each.",
      "examples": [["src/**/*.nt65"]]
    },
    "out": {
      "type": "string",
      "description": "Where the output goes; the project root when there is none. A module's output is named after it, so `.module gfx::sprite` is written to `out/gfx/sprite.s` wherever its source is."
    },
    "settings": {
      "description": "The values the build gives settings, which modules declare with `.const NAME ?= value`. A setting is named by its path, \"hw::SOUND\", or by its name alone where only one module declares a setting of that name.",
      "allOf": [{ "$ref": "#/definitions/settings" }]
    },
    "diagnostics": {
      "description": "How much each diagnostic matters to this project, by name, over what nt65 reports it as. `nt65 explain <name>` describes one.",
      "allOf": [{ "$ref": "#/definitions/diagnostics" }],
      "examples": [{ "unused-symbol": "off", "mnemonic-name": "error" }]
    },
    "spaces": {
      "type": "object",
      "additionalProperties": {
        "description": "\"code\" for a space that runs this program's processor, whose routines nt65 checks; \"data\" for another processor's memory, whose code is data and macro calls.",
        "enum": ["code", "data"]
      },
      "description": "Address spaces other than the host's, such as a sound CPU's or a disk drive's memory. A name in one is a value to code in another: an immediate or data, never a jump target or an operand that reaches memory.",
      "examples": [{ "spc": "data" }]
    },
    "segments": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/segment" },
      "description": "The segments the program uses, with the address size each is reached at. A segment declared here may not also be declared in a file.",
      "examples": [{ "ZEROPAGE": { "size": "zp" }, "CODE": { "size": "abs" } }]
    },
    "ranges": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/banks" },
      "propertyNames": {
        "pattern": "^\\s*[+-]?(\\$[0-9A-Fa-f_]+|%[01_]+|[0-9][0-9_]*)\\s*(-\\s*[+-]?(\\$[0-9A-Fa-f_]+|%[01_]+|[0-9][0-9_]*)\\s*)?$"
      },
      "description": "Which banks an absolute constant address in each range may be reached from, for hardware registers mirrored in some banks only. A key is one address or a range of them, and no two keys may overlap.",
      "examples": [{ "$2100-$21ff": ["$00-$3f", "$80-$bf"] }]
    },
    "links": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/link" },
      "description": "The ld65 linker configs the output is linked with, by name. With links, each config's `SEGMENTS` block declares the segments it places: a segment's size comes from its `type`, and its bank from where it runs. `segments` then adds only what no config can say.",
      "examples": [{ "prg": { "config": "c64.cfg" } }]
    },
    "configurations": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/configuration" },
      "propertyNames": { "pattern": "^[A-Za-z0-9_-]+$" },
      "description": "Named builds of the program, chosen with `--config name`. A name is letters, digits, `_` and `-`; with none chosen the project's own settings build.",
      "examples": [{ "debug": { "settings": { "DEBUG": 1 }, "out": "build/debug" } }]
    }
  },
