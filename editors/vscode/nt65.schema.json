    "settings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/number" },
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$" }
    },
    "banks": {
      "type": "array",
      "description": "Banks, each one bank or a range of them: 1, \"$7e\" or \"$00-$3f\".",
      "items": {
        "anyOf": [
          { "$ref": "#/definitions/number" },
          { "type": "string", "pattern": "^\\s*[+-]?(\\$[0-9A-Fa-f_]+|%[01_]+|[0-9][0-9_]*)\\s*-\\s*[+-]?(\\$[0-9A-Fa-f_]+|%[01_]+|[0-9][0-9_]*)\\s*$" }
        ]
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "description": "How wide an address in the segment is: \"zp\" for the direct page, \"abs\" for two bytes, \"far\" for three. Required without `links`; with them it comes from the config, and only \"far\" may be given.",
          "enum": ["zp", "abs", "far"]
        },
        "dp": {
          "description": "The direct-page register the segment is reached through, for a `zp` segment on the 65816.",
          "allOf": [{ "$ref": "#/definitions/number" }]
        },
        "bank": {
          "description": "The bank the segment sits in, on the 65816.",
          "allOf": [{ "$ref": "#/definitions/number" }]
        },
        "mirrors": {
          "description": "The other banks the segment appears in, in the same form as the banks in `ranges`. A segment with mirrors needs a bank.",
          "allOf": [{ "$ref": "#/definitions/banks" }]
        },
        "space": {
          "type": "string",
          "description": "The address space the segment is in, one `spaces` declares: another processor's memory. A segment that names none is in the host's."
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settings": {
          "description": "Setting values over the project's, by name.",
          "allOf": [{ "$ref": "#/definitions/settings" }]
        },
        "diagnostics": {
          "description": "How much each diagnostic matters in this configuration, over the project's own answers.",
          "allOf": [{ "$ref": "#/definitions/diagnostics" }]
        },
        "links": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/link" },
          "description": "Links over the project's, each replacing the project's link of the same name."
        },
        "out": {
          "type": "string",
          "description": "Where this configuration's output goes, in place of the project's `out`."
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config"],
      "properties": {
        "config": {
          "type": "string",
          "description": "The ld65 linker config, as a path from the project file."
        },
        "memory": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/linkMemory" },
          "description": "What the config cannot say about its memory areas, by the names its `MEMORY` block gives them."
        },
        "space": {
          "type": "string",
          "description": "The address space everything in this link is in, one `spaces` declares. A memory area's own `space` takes precedence."
        }
      }
    },
    "linkMemory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mirrors": {
          "description": "The other banks the memory area appears in, in the same form as the banks in `ranges`.",
          "allOf": [{ "$ref": "#/definitions/banks" }]
        },
        "space": {
          "type": "string",
          "description": "The address space the memory area is in, one `spaces` declares."
        }
      }
    }
  }
}
