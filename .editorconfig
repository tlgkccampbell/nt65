root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

# Only rules that something in the build actually runs belong here. StyleCop is deliberately
# not a dependency, so its SA rules would do nothing; the conventions no first-party analyzer
# can check (member ordering, one type per file) live in CLAUDE.md and are not enforced.
[*.cs]
indent_size = 4

# System directives first, outside the namespace, and no unnecessary ones.
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace
dotnet_diagnostic.IDE0005.severity = warning

# File-scoped namespaces.
csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = warning

# Whitespace and wrapping, as dotnet format would write them.
dotnet_diagnostic.IDE0055.severity = warning

# The CA rules run (AnalysisLevel in Directory.Build.props). These four are wrong here, and
# each is off with its reason rather than suppressed one site at a time.

# Return types are abstract on purpose: an API boundary states what it gives, not the concrete
# type behind it. The parser returns the green node base type a dispatch switches on, and a
# collection crosses a boundary as a read-only view.
dotnet_diagnostic.CA1859.severity = none

# The `Stack` suffix is deliberate: `AnalysisStack` and `SavedStack` model the processor's
# stack as the analysis follows it; they are not collections a consumer pushes to.
dotnet_diagnostic.CA1711.severity = none

# `Step` is nt65's name for one occurrence of a statement in the laid-out code (a statement in
# a macro body or a repetition has one per expansion or iteration), and is not renamed to
# avoid a Visual Basic keyword.
dotnet_diagnostic.CA1716.severity = none

# `Long` is the 65816's addressing mode, named as its datasheet names it.
dotnet_diagnostic.CA1720.severity = none

# Every method here is a JSON-RPC handler, which the dispatcher finds on the instance.
[src/Norristown.LanguageServer/Server.cs]
dotnet_diagnostic.CA1822.severity = none

[*.{json,yml,yaml}]
indent_size = 2
