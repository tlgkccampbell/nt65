<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Code style rules in .editorconfig are checked by the build, not only in the IDE. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The CA rules run under the warnings-are-errors above; .editorconfig says which are off. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Public members carry XML documentation, and generating the file also lets IDE0005
         (unnecessary using) report on build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Output never depends on the machine's culture (PLAN.md, determinism). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The version nt65 reports. -->
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
