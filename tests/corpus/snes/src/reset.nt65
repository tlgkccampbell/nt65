; Power-on, interrupt entry and hardware initialisation.
.module reset

.cpu 65816

.use snes::*

.export reset_stub, nmi_stub, irq_stub, cop_stub, brk_stub

; The vectors point into bank $00. Each stub jumps long into bank $80, where the code runs
; from FastROM: nothing returns to a stub, so the jump is checked against the entry alone.
.segment STUBS
.proc reset_stub: emu, dp?, dbr?, noreturn {
    sei
    jml reset
}

.proc nmi_stub: interrupt, native {
    jml nmi
}

.proc irq_stub: interrupt, native {
    rti
}

.proc cop_stub: interrupt, native {
    rti
}

.proc brk_stub: interrupt {
    stp
}

.segment CODE0

; Reset: leave emulation mode, set up the stack, D and B, clear memory and the PPU, then
; run the game, which never returns.
.proc reset: emu, dp?, dbr?, noreturn {
    clc
    xce                         ; native, both widths 8
    rep #$38                    ; a16, i16, binary mode
    ldx #$1fff
    txs
    lda #$0000
    tcd                         ; D = $0000
    phk
    plb                         ; B = $80
    sep #$20
    ppu_off!()
    stz NMITIMEN
    lda #$01
    sta MEMSEL                  ; FastROM on
    jsr clear_ram
    jsr init_ppu
    jsl bank1::load_palette
    jsr gfx::upload_graphics
    lda #GameState::title
    sta game_state
    lda #$81
    sta NMITIMEN                ; NMI and joypad auto-read
    cli
    jmp main::main
}

; Zero low RAM and all of bank $7e with block moves.
.proc clear_ram: std {
    rep #$20
    stz $0000
    ldx #$0000
    ldy #$0001
    lda #$1dfe
    mvn #$00, #$00              ; low RAM $0000-$1dff, below the stack
    lda #$0000
    sta f:$7e0000
    ldx #$0000
    ldy #$0001
    lda #$fffe
    mvn #^oam_shadow, #^oam_shadow
    phk
    plb
    sep #$20
    rts
}

; Write every PPU register through the direct page at $2100.
.proc init_ppu: std {
    phd
    pea $2100
    pld
    ldx #$0033
@clear:
    stz d:$2100,x
    dex
    bne @clear
    lda #$80
    sta d:INIDISP               ; still forced blank
    lda #$01
    sta d:BGMODE                ; mode 1
    stz d:BG1SC                 ; BG1 map at VRAM $0000
    lda #$02
    sta d:BG12NBA               ; BG1 tiles at VRAM $2000
    lda #$01
    sta d:TM                    ; BG1 on the main screen
    lda #$80
    sta d:VMAIN                 ; increment after the high byte
    pld
    rts
}

; NMI, entered in native mode from anywhere in the program.
.proc nmi: interrupt, native {
    rep #$30
    pha
    phx
    phy
    phd
    phb
    phk
    plb
    lda #$0000
    tcd
    sep #$20
    lda RDNMI                   ; acknowledge
    lda nmi_ready
    beq @late                   ; main loop is still busy: skip the upload
    jsr upload_oam
    lda inidisp_shadow
    sta INIDISP
    stz nmi_ready
@late:
    rep #$30
    inc frame_count
    plb
    pld
    ply
    plx
    pla
    rti
}

.proc upload_oam: std {
    phd
    pea $4300
    pld
    dma_channel0!(mode = $00, bbad = $04)
    ldx #.loword(oam_shadow)
    stx d:A1T0L
    lda #^oam_shadow
    sta d:A1B0
    ldx #.sizeof(oam_shadow)
    stx d:DAS0L
    pld
    stz $2102
    stz $2103
    lda #$01
    sta MDMAEN
    rts
}

