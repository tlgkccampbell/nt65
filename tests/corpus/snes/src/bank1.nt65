; Code and data that live in bank $81 and are reached with jsl.
.cpu 65816

; Exporting this from hw.nt65 emits a bad `.export rgb15`, so it lives here.
.func rgb15(r, g, b) = r | (g << 5) | (b << 10)



.scope bank1 {
.export load_palette, spawn_player, level_speed

.segment "BANK1" {

palette:
    .word rgb15(0, 0, 0)
    .word rgb15(31, 31, 31)
    .word rgb15(31, 0, 0)
    .word rgb15(0, 31, 0)
    .word rgb15(0, 0, 31)
    .word rgb15(31, 31, 0)
    .word rgb15(0, 31, 31)
    .word rgb15(31, 0, 31)

spawn_points:
    .word 32, 48
    .word 120, 96
    .word 200, 160

speeds:
    .byte 1, 2, 3, 4

; Called far from bank $80: upload the palette that sits beside it in bank $81.
.proc load_palette: far, a8, i16, dp = 0 {
    phb
    phk
    plb                         ; B = $81
    ldx #.loword(palette)
    stx dma_src
    lda #^palette
    sta dma_src+2
    ldx #.sizeof(palette)
    stx dma_len
    jsl cgram_copy_far
    plb
    rtl
}

; Put the player at spawn point X (0-2).
.proc spawn_player: far, a8, i16, dp = 0 {
    phb
    phk
    plb
    rep #$20
    txa
    asl a
    asl a
    tax
    lda spawn_points,x
    sta f:player_x
    lda spawn_points+2,x
    sta f:player_y
    sep #$20
    plb
    rtl
}

; A = speed for level A (0-3), read with a long operand so B does not matter.
.proc level_speed: far, a8, i16 {
    rep #$20
    and #$0003
    tax
    sep #$20
    lda f:speeds,x
    rtl
}

}
}
