; Code and data that live in bank $81 and are reached with jsl, as `bank1::load_palette`.
.module bank1

.cpu 65816

.use snes::*
.use gfx::cgram_copy_far

.export load_palette, spawn_player, level_speed

.segment BANK1

.data palette: .word[] {
    rgb15(0, 0, 0)
    rgb15(31, 31, 31)
    rgb15(31, 0, 0)
    rgb15(0, 31, 0)
    rgb15(0, 0, 31)
    rgb15(31, 31, 0)
    rgb15(0, 31, 31)
    rgb15(31, 0, 31)
}

.data spawn_points: .word[] {
    32, 48
    120, 96
    200, 160
}

.data speeds: .byte 1, 2, 3, 4

; Called far from bank $80: upload the palette that sits beside it in bank $81.
.proc load_palette: far, a8, i16, dp = 0 {
    phb
    phk
    plb                         ; B = $81
    ldx #.loword(palette)
    stx dma_src
    lda #^palette
    sta dma_src+2
    ldx #.sizeof(palette)
    stx dma_len
    jsl cgram_copy_far
    plb
    rtl
}

; Put the player at spawn point X (0-2).
.proc spawn_player: far, a8, i16, dp = 0 {
    phb
    phk
    plb
    rep #$20
    txa
    asl a
    asl a
    tax
    lda spawn_points,x
    sta f:player_x
    lda spawn_points+2,x
    sta f:player_y
    sep #$20
    plb
    rtl
}

; A = speed for level A (0-3), read with a long operand so B does not matter.
.proc level_speed: far, a8, i16 {
    rep #$20
    and #$0003
    tax
    sep #$20
    lda f:speeds,x
    rtl
}
