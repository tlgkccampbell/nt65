; Graphics upload: DMA to VRAM and CGRAM during forced blank or vblank.
.module gfx

.cpu 65816

.use snes::*

.export upload_graphics, vram_copy, cgram_copy, cgram_copy_far, print_text, setup_hdma
.export clear_oam, print_inline

.charmap bgtext {
    'A'..'Z' = $01
    '0'..'9' = $1b
    ' '      = $00
    '!'      = $25
}

.segment GFXDATA
.data tiles:      .incbin "tiles.bin"
.data tilemap: .word[32] {
    .repeat 32, i {
        i
    }
}

; COLDATA gradient on channel 1: count, value pairs.
.data gradient: .byte 40, $e0, 40, $e4, 40, $e8, 40, $ec, 40, $ef, 0

.segment RODATA0
.data title_text: .byte bgtext("PRESS START"), $ff

.segment CODE0

; Upload the BG tiles and the first row of the tilemap. Forced blank must be on.
.proc upload_graphics: std {
    ; tiles to VRAM $2000
    ldx #.loword(tiles)
    stx dma_src
    lda #^tiles
    sta dma_src+2
    ldx #.sizeof(tiles)
    stx dma_len
    ldx #$2000
    stx dma_dst
    jsr vram_copy

    ; tilemap to VRAM $0000
    ldx #.loword(tilemap)
    stx dma_src
    lda #^tilemap
    sta dma_src+2
    ldx #.sizeof(tilemap)
    stx dma_len
    stz dma_dst
    stz dma_dst+1
    jsr vram_copy

    ldx #$0020
    ldy #.loword(title_text)
    jmp print_text
}

; Copy dma_len bytes from the far pointer dma_src to VRAM at dma_dst.
.proc vram_copy: std {
    ldx dma_dst
    stx VMADDL
    ldx dma_src
    ldy dma_len
    lda dma_src+2
    phd
    pea $4300
    pld
    sta d:A1B0
    stx d:A1T0L
    sty d:DAS0L
    dma_channel0!(mode = $01, bbad = $18)
    pld
    lda #$01
    sta MDMAEN
    rts
}

; Copy dma_len bytes from the far pointer dma_src to CGRAM from colour 0.
.proc cgram_copy: std {
    stz CGADD
    ldx dma_src
    ldy dma_len
    lda dma_src+2
    phd
    pea $4300
    pld
    sta d:A1B0
    stx d:A1T0L
    sty d:DAS0L
    dma_channel0!(mode = $00, bbad = $22)
    pld
    lda #$01
    sta MDMAEN
    rts
}

; cgram_copy for callers in other banks.
.proc cgram_copy_far: std, far, dbr* {
    phb
    phk
    plb
    jsr cgram_copy
    plb
    rtl
}

; Start a COLDATA gradient on HDMA channel 1 from the far table.
.proc setup_hdma: std {
    phd
    pea $4300
    pld
    stz d:$4310                 ; one register, write once
    lda #$32
    sta d:$4311                 ; COLDATA
    ldx #.loword(gradient)
    stx d:$4312
    lda #^gradient
    sta d:$4314
    pld
    lda #$02
    sta HDMAEN
    rts
}

; Hide all 128 sprites in the WRAM shadow, with B moved to $7e for short operands.
.proc clear_oam: std {
    phb
    lda #WRAM_BANK
    pha
    plb
    ldx #.sizeof(oam_shadow) - .sizeof(Sprite)
    lda #$f0
@loop:
    sta oam_shadow::y,x
    stz oam_shadow::tile,x
    dex
    dex
    dex
    dex
    bpl @loop
    plb
    rts
}

; Print the $ff-terminated text that follows the call at the tile given by the two
; bytes before it: `jsr print_inline` then `.word tile` then the text... here fixed at
; two bytes of tile index, as the signature says.
.proc print_inline: std, inline 2 {
    rep #$20
    lda 1,s                     ; return address - 1
    inc a
    tay
    lda 0,y                     ; the inline tile index
    tax
    lda 1,s
    inc a
    inc a
    sta 1,s                     ; return past the data
    sep #$20
    rts
}

; Write a $ff-terminated string at CODE_BANK:Y to the tilemap at tile X, one byte at a
; time through the VRAM port.
.proc print_text: std {
    rep #$20
    txa
    sta VMADDL
    sep #$20
@next:
    lda 0,y
    cmp #$ff
    beq @done
    sta $2118
    stz $2119
    iny
    bra @next
@done:
    rts
}

