; SNES hardware: register addresses, shared variables and small macros.
.cpu 65816

.export INIDISP, OBSEL, BGMODE, BG1SC, BG12NBA, VMAIN, VMADDL, CGADD, TM, SETINI
.export NMITIMEN, WRMPYA, RDNMI, HVBJOY, JOY1L, MDMAEN, HDMAEN, MEMSEL
.export DMAP0, BBAD0, A1T0L, A1B0, DAS0L
.export JOY_B, JOY_Y, JOY_SELECT, JOY_START, JOY_UP, JOY_DOWN, JOY_LEFT, JOY_RIGHT
.export JOY_A, JOY_X, JOY_L, JOY_R
.export frame_count, nmi_ready, inidisp_shadow, pad_held, pad_pressed, pad_last
.export game_state, player_x, player_y, dma_src, dma_len, dma_dst, scratch
.export oam_shadow, Sprite, GameState, WRAM_BANK, CODE_BANK
.export ppu_off, ppu_on, critical, mov16, dma_channel0, rgb15

CODE_BANK = $80
WRAM_BANK = $7e

; A BGR555 colour from 5-bit components.
.func rgb15(r, g, b) = r | (g << 5) | (b << 10)

; PPU registers ($21xx), mirrored in banks $00-$3f and $80-$bf
INIDISP = $2100
OBSEL   = $2101
BGMODE  = $2105
BG1SC   = $2107
BG12NBA = $210b
VMAIN   = $2115
VMADDL  = $2116
CGADD   = $2121
TM      = $212c
SETINI  = $2133

; CPU registers ($42xx)
NMITIMEN = $4200
WRMPYA   = $4202
MEMSEL   = $420d
MDMAEN   = $420b
HDMAEN   = $420c
RDNMI    = $4210
HVBJOY   = $4212
JOY1L    = $4218

; DMA channel 0 ($43x0)
DMAP0 = $4300
BBAD0 = $4301
A1T0L = $4302
A1B0  = $4304
DAS0L = $4305

; joypad bits, as read 16-bit from JOY1L
JOY_R      = $0010
JOY_L      = $0020
JOY_X      = $0040
JOY_A      = $0080
JOY_RIGHT  = $0100
JOY_LEFT   = $0200
JOY_DOWN   = $0400
JOY_UP     = $0800
JOY_START  = $1000
JOY_SELECT = $2000
JOY_Y      = $4000
JOY_B      = $8000

.enum GameState {
    title
    play
    pause
}

.struct Sprite {
    x:     .byte
    y:     .byte
    tile:  .byte
    attr:  .byte
}



.segment "DIRECT" {
frame_count:    .res 2
nmi_ready:      .res 1
inidisp_shadow: .res 1
pad_held:       .res 2
pad_pressed:    .res 2
pad_last:       .res 2
game_state:     .res 1
dma_src:        .res 3
dma_len:        .res 2
dma_dst:        .res 2
scratch:        .res 2
}

.segment "LORAM" {
player_x:       .res 2
player_y:       .res 2
}

.segment "WRAM" {
oam_shadow:     .tag Sprite, 128
}

; Screen off: force blank at full brightness 0.
.macro ppu_off(): a8 {
    lda #$80
    sta inidisp_shadow
    sta INIDISP
}

; Screen on at full brightness; the NMI copies the shadow.
.macro ppu_on(): a8 {
    lda #$0f
    sta inidisp_shadow
}

; Run a block with interrupts off, restoring I (and the widths) afterwards.
.macro critical(body: block) {
    php
    sei
    body
    plp
}

; Copy a word, from memory or an immediate.
.macro mov16(dest: operand, src: operand): a16 {
    lda src
    sta dest
}

; Program DMA channel 0 through the direct page at $4300.
.macro dma_channel0(mode: const, bbad: const): a8, dp = $4300 {
    lda #mode
    sta d:DMAP0
    lda #bbad
    sta d:BBAD0
}
