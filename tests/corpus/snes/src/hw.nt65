; SNES hardware: the facade the rest of the program uses. The registers and the joypad bits
; are submodules' names, which this module presents as its own; the shared variables, the
; types and the small macros are its own.
.module snes

.cpu 65816

.export .use snes::reg::{INIDISP, OBSEL, BGMODE, BG1SC, BG12NBA, VMAIN, VMADDL, CGADD, TM, SETINI}
.export .use snes::reg::{NMITIMEN, WRMPYA, RDNMI, HVBJOY, JOY1L, MDMAEN, HDMAEN, MEMSEL}
.export .use snes::reg::{DMAP0, BBAD0, A1T0L, A1B0, DAS0L}
.export .use snes::pad::Joy

.export frame_count, nmi_ready, inidisp_shadow, pad_held, pad_pressed, pad_last
.export game_state, player_x, player_y, dma_src, dma_len, dma_dst, scratch
.export oam_shadow, Sprite, GameState, WRAM_BANK, CODE_BANK
.export ppu_off, ppu_on, critical, mov16, dma_channel0, rgb15

CODE_BANK = $80
WRAM_BANK = $7e

; A BGR555 colour from 5-bit components.
.func rgb15(r, g, b) = r | (g << 5) | (b << 10)

.enum GameState {
    title
    play
    pause
}

.struct Sprite {
    x:     .byte
    y:     .byte
    tile:  .byte
    attr:  .byte
}



.segment DIRECT
.data frame_count:    .word
.data nmi_ready:      .byte
.data inidisp_shadow: .byte
.data pad_held:       .word
.data pad_pressed:    .word
.data pad_last:       .word
.data game_state:     .byte
.data dma_src:        .faraddr
.data dma_len:        .word
.data dma_dst:        .word
.data scratch:        .word

.segment LORAM
.data player_x:       .word
.data player_y:       .word

.segment WRAM
.data oam_shadow:     .type Sprite[128]

; Screen off: force blank at full brightness 0.
.macro ppu_off(): a8 {
    lda #$80
    sta inidisp_shadow
    sta INIDISP
}

; Screen on at full brightness; the NMI copies the shadow.
.macro ppu_on(): a8 {
    lda #$0f
    sta inidisp_shadow
}

; Run a block with interrupts off, restoring I (and the widths) afterwards.
.macro critical(body: block) {
    php
    sei
    body
    plp
}

; Copy a word, from memory or an immediate.
.macro mov16(dest: operand, src: operand): a16 {
    lda src
    sta dest
}

; Program DMA channel 0 through the direct page at $4300.
.macro dma_channel0(mode: const, bbad: const): a8, dp = $4300 {
    lda #mode
    sta d:DMAP0
    lda #bbad
    sta d:BBAD0
}
