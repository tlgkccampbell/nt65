; SNES register addresses. The rest of the program reaches them through the `snes` facade.
.module snes::reg

.cpu 65816

; PPU registers ($21xx), mirrored in banks $00-$3f and $80-$bf
.export .mmio INIDISP: .byte = $2100
.export .mmio OBSEL:   .byte = $2101
.export .mmio BGMODE:  .byte = $2105
.export .mmio BG1SC:   .byte = $2107
.export .mmio BG12NBA: .byte = $210b
.export .mmio VMAIN:   .byte = $2115
.export .mmio VMADDL:  .byte = $2116
.export .mmio CGADD:   .byte = $2121
.export .mmio TM:      .byte = $212c
.export .mmio SETINI:  .byte = $2133

; CPU registers ($42xx)
.export .mmio NMITIMEN: .byte = $4200
.export .mmio WRMPYA:   .byte = $4202
.export .mmio MEMSEL:   .byte = $420d
.export .mmio MDMAEN:   .byte = $420b
.export .mmio HDMAEN:   .byte = $420c
.export .mmio RDNMI:    .byte = $4210
.export .mmio HVBJOY:   .byte = $4212
.export .mmio JOY1L:    .byte = $4218

; DMA channel 0 ($43x0)
.export .mmio DMAP0: .byte = $4300
.export .mmio BBAD0: .byte = $4301
.export .mmio A1T0L: .byte = $4302
.export .mmio A1B0:  .byte = $4304
.export .mmio DAS0L: .byte = $4305
