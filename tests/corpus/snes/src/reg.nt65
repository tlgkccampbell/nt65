; SNES register addresses. The rest of the program reaches them through the `snes` facade.
.module snes::reg

.cpu 65816

; PPU registers ($21xx), mirrored in banks $00-$3f and $80-$bf
.export .const INIDISP = $2100
.export .const OBSEL   = $2101
.export .const BGMODE  = $2105
.export .const BG1SC   = $2107
.export .const BG12NBA = $210b
.export .const VMAIN   = $2115
.export .const VMADDL  = $2116
.export .const CGADD   = $2121
.export .const TM      = $212c
.export .const SETINI  = $2133

; CPU registers ($42xx)
.export .const NMITIMEN = $4200
.export .const WRMPYA   = $4202
.export .const MEMSEL   = $420d
.export .const MDMAEN   = $420b
.export .const HDMAEN   = $420c
.export .const RDNMI    = $4210
.export .const HVBJOY   = $4212
.export .const JOY1L    = $4218

; DMA channel 0 ($43x0)
.export .const DMAP0 = $4300
.export .const BBAD0 = $4301
.export .const A1T0L = $4302
.export .const A1B0  = $4304
.export .const DAS0L = $4305
