; Internal ROM header at $00:ffc0 and the interrupt vectors at $00:ffe0.
.cpu 65816

.struct RomHeader {
    title:     .res 21
    map_mode:  .byte
    cart_type: .byte
    rom_size:  .byte
    ram_size:  .byte
    region:    .byte
    developer: .byte
    version:   .byte
    checksum_complement: .word
    checksum:  .word
}

.segment "HEADER" {
header: .tag RomHeader {
    title = "NT65 SNES DEMO"
    map_mode = $30              ; LoROM, FastROM
    cart_type = $00             ; ROM only
    rom_size = $08              ; 256 KiB rounded
    ram_size = $00
    region = $01                ; North America
    developer = $33
    version = 0
    checksum_complement = $ffff
    checksum = $0000
}
.assert .sizeof(RomHeader) == 32, error, "header must be 32 bytes"
}

.segment "VECTORS" {
native_vectors:
    .res 4                      ; unused
    .addr cop_stub              ; COP
    .addr brk_stub              ; BRK
    .addr brk_stub              ; ABORT
    .addr nmi_stub              ; NMI
    .res 2                      ; unused
    .addr irq_stub              ; IRQ
emulation_vectors:
    .res 4
    .addr brk_stub              ; COP
    .res 2
    .addr brk_stub              ; ABORT
    .addr brk_stub              ; NMI
    .addr reset_stub            ; RESET
    .addr brk_stub              ; IRQ/BRK
}
