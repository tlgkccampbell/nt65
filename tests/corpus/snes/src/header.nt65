; Internal ROM header at $00:ffc0 and the interrupt vectors at $00:ffe0.
.module header

.cpu 65816

.use reset::{cop_stub, brk_stub, nmi_stub, irq_stub, reset_stub}

.struct RomHeader {
    title:     .res 21, ' '
    map_mode:  .byte
    cart_type: .byte
    rom_size:  .byte
    ram_size:  .byte
    region:    .byte
    developer: .byte
    version:   .byte
    checksum_complement: .word
    checksum:  .word
}

.segment HEADER
.data header: .type RomHeader {
    title = "NT65 SNES DEMO"
    map_mode = $30              ; LoROM, FastROM
    cart_type = $00             ; ROM only
    rom_size = $08              ; 256 KiB rounded
    ram_size = $00
    region = $01                ; North America
    developer = $33
    version = 0
    checksum_complement = $ffff
    checksum = $0000
}
.assert .sizeof(RomHeader) == 32, "header must be 32 bytes"

.segment VECTORS
.data vectors {
    ; unused, unused, COP, BRK, ABORT, NMI, unused, IRQ
    .data native: .addr[8] {
        0, 0, cop_stub, brk_stub, brk_stub, nmi_stub, 0, irq_stub
    }
    ; unused, unused, COP, unused, ABORT, NMI, RESET, IRQ/BRK
    .data emulation: .addr[8] {
        0, 0, brk_stub, 0, brk_stub, brk_stub, reset_stub, brk_stub
    }
}
