; Variables. The C64 leaves $FB-$FE free in zero page; everything else goes to BSS.
.cpu 6502

.export ptr1, ptr2, frame_flag, frame_count, game_state, score, player_x, player_y
.export joy_prev, lives, split_index

.segment ZEROPAGE
.data ptr1:        .word
.data ptr2:        .word

.segment BSS
.data frame_flag:  .byte
.data frame_count: .word
.data game_state:  .byte
.data score:       .byte[3]          ; BCD, least significant byte first
.data player_x:    .word          ; 9-bit sprite X
.data player_y:    .byte
.data joy_prev:    .byte
.data lives:       .byte
.data split_index: .byte
