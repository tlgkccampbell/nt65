; Variables. The C64 leaves $FB-$FE free in zero page; everything else goes to BSS.
.module zp

.cpu 6502

.segment ZEROPAGE
.export .data ptr1:        .word
.export .data ptr2:        .word

.segment BSS
.export .data frame_flag:  .byte
.export .data frame_count: .word
.export .data game_state:  .byte
.export .data score:       .byte[3]      ; BCD, least significant byte first
.export .data player_x:    .word         ; 9-bit sprite X
.export .data player_y:    .byte
.export .data joy_prev:    .byte
.export .data lives:       .byte
.export .data split_index: .byte
