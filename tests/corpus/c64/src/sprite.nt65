; Player sprite: joystick in port 2 moves sprite 0 inside the visible area.
.module sprite

.cpu 6502

.use hw::{vic, cia1, SPRITE_PTRS, Color, Joy, Sprite}
.use zp::{player_x, player_y, joy_prev}
.use macros::*

.export init, player_update, player_reset

.const SPRITE_BLOCK = 13            ; sprite data at 13 * 64 = $0340 (cassette buffer)
.const SPRITE_ADDR  = SPRITE_BLOCK * 64
.const MIN_X        = 24
.const MAX_X        = 320
.const MIN_Y        = 50
.const MAX_Y        = 229
.const SPEED        = 2

.segment RODATA
.data ship_shape: .byte[64] {
    %00000000, %00011000, %00000000
    %00000000, %00111100, %00000000
    %00000000, %01111110, %00000000
    %00000000, %11111111, %00000000
    %00000001, %11111111, %10000000
    %00000011, %11111111, %11000000
    %00000111, %11100111, %11100000
    %00001111, %11000011, %11110000
    .repeat 13 {
        0, 0, 0
    }
    0                           ; multicolour/unused byte
}

.segment CODE
.proc init {
    ldx #63
@copy:
    lda ship_shape,x
    sta SPRITE_ADDR,x
    dex
    bpl @copy

    poke!(SPRITE_PTRS, SPRITE_BLOCK)
    poke!(vic::SPR0_COL, Color::yellow)
    poke!(vic::SPR_ENA, %00000001)
    rts
}

.proc player_reset {
    mov16!(player_x, {#160})
    lda #200
    sta player_y
    jmp write_position
}

; Read the joystick and move. Returns C set when fire was newly pressed.
.proc player_update {
    lda cia1::PRA
    eor #$FF                    ; active high
    and #Joy::up | Joy::down | Joy::left | Joy::right | Joy::fire
    tax                         ; keep for edge detection

    lsr a                       ; up
    pha
    if!(cs) {
        lda player_y
        cmp #MIN_Y + SPEED
        if!(cs) {
            sbc #SPEED
            sta player_y
        }
    }
    pla
    lsr a                       ; down
    pha
    if!(cs) {
        lda player_y
        cmp #MAX_Y - SPEED
        if!(cc) {
            adc #SPEED
            sta player_y
        }
    }
    pla
    lsr a                       ; left
    pha
    bcc @no_left
    cmp16!(player_x, {#MIN_X + SPEED})
    bcc @no_left
    sub16!(player_x, {#SPEED})
@no_left:
    pla
    lsr a                       ; right
    bcc @no_right
    cmp16!(player_x, {#MAX_X - SPEED})
    bcs @no_right
    add16!(player_x, {#SPEED})
@no_right:

    jsr write_position

    ; fire edge: pressed now, not pressed last frame
    txa
    and #Joy::fire
    tay
    eor joy_prev
    and #Joy::fire
    sty joy_prev
    beq @no_fire
    tya
    beq @no_fire
    sec
    rts
@no_fire:
    clc
    rts
}

; One routine per sprite: X in A, Y in Y, and C holding the ninth bit of X. The registers
; are two bytes apart per sprite and the high bits are one register of flags, so every
; instance is these lines with its own sprite's number in them.
.scope move {
    .multiproc Sprite, n {
        sta vic::SPR0_X + 2 * Sprite::n
        sty vic::SPR0_Y + 2 * Sprite::n
        lda vic::SPR_MSB
        if!(cs) {
            ora #(1 << Sprite::n)
        } else {
            and #((1 << Sprite::n) ^ $FF)
        }
        sta vic::SPR_MSB
        rts
    }
}

.proc write_position {
    lda player_x+1
    lsr a                       ; the ninth bit of X into C
    ldy player_y
    lda player_x
    jmp move::s0
}
