; C64 hardware registers and KERNAL entry points, a scope per chip. Exporting a scope
; exports what it declares, so another module writes `vic::BORDER`.
.module hw

.cpu 6502

; Built with the state checks and the border flashes that help find a bug.
.export .const DEBUG ?= 0

.export .scope vic {
    .mmio BASE:         .byte[47] = $D000
    .mmio SPR0_X:       .byte = BASE + $00
    .mmio SPR0_Y:       .byte = BASE + $01
    .mmio SPR_MSB:      .byte = BASE + $10
    .mmio CTRL1:        .byte = BASE + $11
    .mmio RASTER:       .byte = BASE + $12
    .mmio SPR_ENA:      .byte = BASE + $15
    .mmio MEMSETUP:     .byte = BASE + $18
    .mmio IRQ_FLAG:     .byte = BASE + $19
    .mmio IRQ_MASK:     .byte = BASE + $1A
    .mmio SPR_SPR_COLL: .byte = BASE + $1E
    .mmio BORDER:       .byte = BASE + $20
    .mmio BG0:          .byte = BASE + $21
    .mmio SPR0_COL:     .byte = BASE + $27
}

.export .scope cia1 {
    .mmio PRA: .byte = $DC00        ; joystick port 2
    .mmio ICR: .byte = $DC0D
}

.export .scope cia2 {
    .mmio ICR: .byte = $DD0D
}

.export .scope kernal {
    .data IRQ_VECTOR: .byte = $0314  ; CINV
    .proc IRQ      = $EA31: interrupt   ; full KERNAL IRQ (keyboard scan, cursor blink)
    .proc IRQ_EXIT = $EA81: interrupt   ; restore registers and RTI

    ; CHROUT is documented as using A alone, so X and Y come back; the rest use all three
    ; and promise nothing.
    .proc CHROUT = $FFD2: keeps x, y
    .proc GETIN  = $FFE4
    .proc SCNKEY = $FF9F
    .proc CLRSCR = $E544
}

.export .data SCREEN_RAM:  .byte[1024] = $0400
.export .data COLOR_RAM:   .byte = $D800
.export .data SPRITE_PTRS: .byte = SCREEN_RAM + $03F8

.export .enum Color {
    black
    white
    red
    cyan
    purple
    green
    blue
    yellow
    orange
    brown
    light_red
    dark_grey
    grey
    light_green
    light_blue
    light_grey
}

; The eight sprites. Their position registers are two bytes apart and their high X bits are
; one register of flags, so the routine for one sprite differs from the next only by a number.
.export .enum Sprite {
    s0
    s1
    s2
    s3
    s4
    s5
    s6
    s7
}

; Joystick bits in CIA1 port A, active low.
.export .enum Joy {
    up    = %00001
    down  = %00010
    left  = %00100
    right = %01000
    fire  = %10000
}
