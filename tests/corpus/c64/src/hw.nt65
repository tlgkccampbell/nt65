; C64 hardware registers and KERNAL entry points, a scope per chip. Exporting a scope
; exports what it declares, so another module writes `vic::BORDER`.
.module hw

.cpu 6502

; Built with the state checks and the border flashes that help find a bug.
.export .const DEBUG ?= 0

.export .scope vic {
    .const BASE         = $D000
    .const SPR0_X       = BASE + $00
    .const SPR0_Y       = BASE + $01
    .const SPR_MSB      = BASE + $10
    .const CTRL1        = BASE + $11
    .const RASTER       = BASE + $12
    .const SPR_ENA      = BASE + $15
    .const MEMSETUP     = BASE + $18
    .const IRQ_FLAG     = BASE + $19
    .const IRQ_MASK     = BASE + $1A
    .const SPR_SPR_COLL = BASE + $1E
    .const BORDER       = BASE + $20
    .const BG0          = BASE + $21
    .const SPR0_COL     = BASE + $27
}

.export .scope cia1 {
    .const PRA = $DC00              ; joystick port 2
    .const ICR = $DC0D
}

.export .scope cia2 {
    .const ICR = $DD0D
}

.export .scope kernal {
    .const IRQ_VECTOR = $0314       ; CINV
    .const IRQ        = $EA31       ; full KERNAL IRQ (keyboard scan, cursor blink)
    .const IRQ_EXIT   = $EA81       ; restore registers and RTI

    ; CHROUT is documented as using A alone, so X and Y come back; the rest use all three
    ; and promise nothing.
    .proc CHROUT = $FFD2: keeps x, y
    .proc GETIN  = $FFE4
    .proc SCNKEY = $FF9F
    .proc CLRSCR = $E544
}

.export .const SCREEN_RAM  = $0400
.export .const COLOR_RAM   = $D800
.export .const SPRITE_PTRS = SCREEN_RAM + $03F8

.export .enum Color {
    black
    white
    red
    cyan
    purple
    green
    blue
    yellow
    orange
    brown
    light_red
    dark_grey
    grey
    light_green
    light_blue
    light_grey
}

; The eight sprites. Their position registers are two bytes apart and their high X bits are
; one register of flags, so the routine for one sprite differs from the next only by a number.
.export .enum Sprite {
    s0
    s1
    s2
    s3
    s4
    s5
    s6
    s7
}

; Joystick bits in CIA1 port A, active low.
.export .enum Joy {
    up    = %00001
    down  = %00010
    left  = %00100
    right = %01000
    fire  = %10000
}
