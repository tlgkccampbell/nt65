; Raster interrupt: two colour splits per frame, chained into the KERNAL IRQ.
.module irq

.cpu 6502

.use hw::{vic, cia1, cia2, kernal, Color}
.use zp::{split_index, frame_flag, frame_count}
.use macros::{mov16, inc16, if}

.export install, remove

SPLITS = 3

.segment RODATA
; raster line, border colour, background colour for each split
.data split_line:   .byte 0, 100, 200
.data split_border: .byte Color::light_blue, Color::red, Color::black
.data split_bg:     .byte Color::blue, Color::black, Color::dark_grey

.assert .countof(split_line) == SPLITS, error, "split tables out of step"
.assert .countof(split_border) == SPLITS, error, "split tables out of step"

.segment BSS
.data old_irq: .word

.segment CODE
.proc install {
    sei
    lda #%01111111              ; disable CIA timer interrupts
    sta cia1::ICR
    sta cia2::ICR
    lda cia1::ICR                ; acknowledge pending
    lda cia2::ICR

    mov16!(old_irq, kernal::IRQ_VECTOR)
    mov16!(kernal::IRQ_VECTOR, {#raster_irq})

    lda #0
    sta split_index
    lda split_line
    sta vic::RASTER
    lda vic::CTRL1
    and #%01111111              ; raster bit 8 = 0
    sta vic::CTRL1

    lda #%00000001              ; enable raster IRQ
    sta vic::IRQ_MASK
    asl vic::IRQ_FLAG            ; acknowledge any pending VIC IRQ
    cli
    rts
}

.proc remove {
    sei
    lda #0
    sta vic::IRQ_MASK
    mov16!(kernal::IRQ_VECTOR, old_irq)
    lda #%10000001
    sta cia1::ICR
    cli
    rts
}

; An interrupt handler, entered through the vector and left through the KERNAL's own exit,
; so nothing ever calls it.
.proc raster_irq: interrupt {
    lda vic::IRQ_FLAG
    and #1
    bne @ours
    jmp (old_irq)               ; not a raster IRQ: let the KERNAL have it

@ours:
    sta vic::IRQ_FLAG            ; A = 1: acknowledge
    ldx split_index
    lda split_border,x
    sta vic::BORDER
    lda split_bg,x
    sta vic::BG0

    inx
    cpx #SPLITS
    if!(eq) {
        ldx #0
    }
    stx split_index
    lda split_line,x
    sta vic::RASTER

    ; Only the first split of the frame runs the KERNAL (keyboard, jiffy clock).
    cpx #1
    bne @exit
    lda #1
    sta frame_flag
    inc16!(frame_count)
    jmp kernal::IRQ
@exit:
    jmp kernal::IRQ_EXIT
}
