; Data shared with C.
.import ptr1: zp, ptr2: zp, tmp1: zp
.export _sprites, _sprite_count, Sprite, _cmd_table, _message, _glyphs, _glyphs_size
.export _buffer, _buffer_size, Cmd

; struct sprite { unsigned char x, y; unsigned tile; const char* name; };
.struct Sprite {
x:      .byte
y:      .byte
tile:   .word
name:   .addr
}

.enum Cmd {
    move
    fire
    jump
    quit
}

.charmap apple {
    ' '..'_' = $A0          ; Apple II normal text: high bit set
}

.rodata {
_sprites:
        .tag Sprite { x = 10, y = 20, tile = $0100, name = name_hero }
        .tag Sprite { x = 30, y = 40, tile = $0200, name = name_boss }
        .tag Sprite { x = 50, y = 60, tile = $0300, name = name_boss }
sprites_end:
_sprite_count:
        .byte (sprites_end - _sprites) / .sizeof(Sprite)

name_hero: .asciiz "HERO"
name_boss: .asciiz "BOSS"

_message:  .byte apple("HELLO, WORLD"), 0

_glyphs:   .incbin "../data/glyphs.bin"
_glyphs_size:
           .word .sizeof(_glyphs)

; One handler address per command, in enum order.
_cmd_table:
.addr cmd_handlers

}

.list cmd_handlers {
    actions::move
    actions::fire
    actions::jump
    actions::quit
}
.assert .countof(cmd_handlers) == Cmd::quit + 1, error, "one handler per command"

.scope actions {
    .proc move {
        rts
    }
    .proc fire {
        rts
    }
    .proc jump {
        rts
    }
    .proc quit {
        rts
    }
}

.bss {
_buffer: .res BUF_SIZE
}
_buffer_size = BUF_SIZE

; Run once at start-up (registered as a constructor by asm/ctor.s).
.export init_lib
.segment "ONCE" {
.proc init_lib {
    lda #<_buffer
    sta ptr1
    lda #>_buffer
    sta ptr1+1
    lda #<BUF_SIZE
    sta ptr2
    lda #>BUF_SIZE
    sta ptr2+1
    lda #$EE
    sta tmp1
    jmp _memfill::fill      ; the interior entry of mem.nt65
}
}
