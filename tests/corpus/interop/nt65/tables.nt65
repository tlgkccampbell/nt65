; Data shared with C.
.import ptr1: zp, ptr2: zp, tmp1: zp
.export _sprites, _sprite_count, Sprite, _cmd_table, _message, _glyphs, _glyphs_size
.export _buffer, _buffer_size, Cmd

; struct sprite { unsigned char x, y; unsigned tile; const char* name; };
.struct Sprite {
x:      .byte
y:      .byte
tile:   .word
name:   .addr
}

.enum Cmd {
    move
    fire
    jump
    quit
}

.charmap apple {
    ' '..'_' = $A0          ; Apple II normal text: high bit set
}

.segment RODATA
.data _sprites: .type Sprite[] {
    { x = 10, y = 20, tile = $0100, name = name_hero }
    { x = 30, y = 40, tile = $0200, name = name_boss }
    { x = 50, y = 60, tile = $0300, name = name_boss }
}
.data _sprite_count: .byte .countof(_sprites)

.data name_hero: .asciiz "HERO"
.data name_boss: .asciiz "BOSS"

.data _message:  .byte apple("HELLO, WORLD"), 0

.data _glyphs:   .incbin "../data/glyphs.bin"
.data _glyphs_size: .word .sizeof(_glyphs)

; One handler address per command, in enum order: each is the routine named after it.
.data _cmd_table: .addr[] {
    .each Cmd, c {
        actions::c
    }
}

.segment CODE
.scope actions {
    .proc move {
        rts
    }
    .proc fire {
        rts
    }
    .proc jump {
        rts
    }
    .proc quit {
        rts
    }
}

.segment BSS
.data _buffer: .byte[BUF_SIZE]
_buffer_size = BUF_SIZE

; Run once at start-up (registered as a constructor by asm/ctor.s).
.export init_lib
.segment ONCE
.proc init_lib {
    lda #<_buffer
    sta ptr1
    lda #>_buffer
    sta ptr1+1
    lda #<BUF_SIZE
    sta ptr2
    lda #>BUF_SIZE
    sta ptr2+1
    lda #$EE
    sta tmp1
    jmp _memfill::fill      ; the interior entry of mem.nt65
}
