; Data shared with C, under the names cc65 gives C's.
.module tables

.use cc65::{ptr1, ptr2, tmp1}

.export sprites as "_sprites", sprite_count as "_sprite_count", cmd_table as "_cmd_table"
.export message as "_message", glyphs as "_glyphs", glyphs_size as "_glyphs_size"
.export buffer as "_buffer"

; A constant C takes the address of, which cc65 imports as absolute.
.export buffer_size: abs as "_buffer_size"

; struct sprite { unsigned char x, y; unsigned tile; const char* name; };
.export .struct Sprite {
    x:    .byte
    y:    .byte
    tile: .word
    name: .addr
}

.export .enum Cmd {
    move
    fire
    jump
    quit
}

.charmap apple {
    ' '..'_' = $A0          ; Apple II normal text: high bit set
}

.segment RODATA
.data sprites: .type Sprite[] {
    { x = 10, y = 20, tile = $0100, name = name_hero }
    { x = 30, y = 40, tile = $0200, name = name_boss }
    { x = 50, y = 60, tile = $0300, name = name_boss }
}
.data sprite_count: .byte .countof(sprites)

.data name_hero: .strz "HERO"
.data name_boss: .strz "BOSS"

.data message: .byte apple("HELLO, WORLD"), 0

.data glyphs:      .incbin "../data/glyphs.bin"
.data glyphs_size: .word .sizeof(glyphs)

; One handler address per command, in enum order: each is the routine named after it.
.data cmd_table: .addr[] {
    .each Cmd, c {
        actions::c
    }
}

.segment CODE
.scope actions {
    .proc move {
        rts
    }
    .proc fire {
        rts
    }
    .proc jump {
        rts
    }
    .proc quit {
        rts
    }
}

; The size of the buffer C shares, which the build may change.
.const BUF_SIZE ?= 64

.segment BSS
.data buffer: .byte[BUF_SIZE]
.const buffer_size = BUF_SIZE

; Run once at start-up (registered as a constructor by asm/ctor.s).
.segment ONCE
.export .proc init_lib {
    lda #<buffer
    sta ptr1
    lda #>buffer
    sta ptr1[1]
    lda #<BUF_SIZE
    sta ptr2
    lda #>BUF_SIZE
    sta ptr2[1]
    lda #$EE
    sta tmp1
    jmp mem::memfill::fill  ; the interior entry of module mem
}
