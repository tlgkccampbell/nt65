; void beep(void) -- clicks the speaker, using the hand-written wait_short.
.module sound

.use apple2::{SPKR, TXTPAGE1}

.export beep as "_beep"

; Built with a mark on the screen at each beep.
.const DEBUG ?= 0

.const BEEP_CYCLES = 32

.segment CODE
.proc beep {
    ldy #BEEP_CYCLES
@loop:
    lda SPKR            ; toggles the speaker
    lda #40
    jsr cc65::wait_short
    dey
    bne @loop
    .if DEBUG {
        lda #'B'
        sta TXTPAGE1
    }
    rts
}
