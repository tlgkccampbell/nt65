; Hardware constants from asm/apple2.inc, checked at link time against asm/hwconst.s. They are
; imported once, here, and every module that uses one imports it as if it had declared it.
.module apple2::hw

.export .import KBD = $C000, KBDSTRB = $C010, SPKR = $C030
.export .import TXTPAGE1 = $0400
.export .import WNDLFT = $20

.export read_key as "_read_key", set_left_margin as "_set_left_margin"

; uint8 read_key(void): returns the key with the strobe bit clear, 0 if none waiting.
.segment CODE
.proc read_key {
    ldx #0
    lda KBD
    bpl @none
    bit KBDSTRB
    and #$7F
    rts
@none:
    lda #0
    rts
}

; void set_left_margin(unsigned char col)
.proc set_left_margin {
    sta WNDLFT
    rts
}
