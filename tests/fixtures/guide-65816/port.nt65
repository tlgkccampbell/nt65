; The three things a 65816 port writes down first: a signature on every routine, a second
; entry point as its own routine that the one above falls through into, and a ROM address as an
; extern proc.
.module port

.export draw, widen, setup, fill

.segment CODE
.signature port = a8, i16, dbr = $80

.proc draw: port {
    rts
}

.proc widen: port -> a16, i16 {
    rep #$20
    rts
}

.proc setup: port {
    lda #0
    .fallthrough fill           ; it runs into `fill`, which is written next
}

.proc fill: port {
    sta $2100
    rts
}

.proc CHROUT = $FFD2: a8, i16
.proc TOOLBOX = $00E10000: a16, i16, far

.proc calls: port {
    jsr CHROUT
    .ensure a16
    jsl TOOLBOX
    .ensure a8
    rts
}

.export calls
