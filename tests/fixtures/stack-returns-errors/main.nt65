; A return goes through the top bytes of the stack. nt65 counts what each routine pushes and
; pulls, so a return with the routine's own pushes above a return address nothing has pulled is
; an error. Once a pull has gone beneath the return address, nothing is reported.
.module main

.cpu 6502

.export pushed, one_path, looped, entered, discards, leaves1, takes1, adjusts, enters
.export irq, calls_irq_label

; The return address is still beneath the pushed byte.
.segment CODE
.proc pushed {
    pha
    rts                     ;! error[return-past-pushes]: `rts` returns through 1 byte this routine pushed rather than through its return address: pull them first, or add a `.next` naming where it goes
}

; A push on one path only.
.proc one_path {
    beq @skip
    pha
    rts                     ;! error[return-past-pushes]: `rts` returns through 1 byte this routine pushed rather than through its return address: pull them first, or add a `.next` naming where it goes
@skip:
    rts
}

; A loop that pushes without pulling holds at least one more byte on each pass.
.proc looped {
@again:
    pha
    dex
    beq @out
    rts                     ;! error[return-past-pushes]: `rts` returns through at least 1 byte this routine pushed rather than through its return address: pull them first, or add a `.next` naming where it goes
@out:
    jmp @again
}

; Whoever jumps to `inside` may have pushed a byte for the `pla` below it to take, as
; msbasic's operator stack does, so the return is not reported.
.proc entered {
    pha
    inside:
    .state ?
    pla
    rts
}

.proc enters {
    jmp entered::inside
}

; Discarding the return address returns to the caller's caller, which is not reported either.
.proc discards {
    pla
    pla
    rts
}

; A routine that pulls its return address and pushes it back above a byte it leaves for its
; caller returns through that address.
.proc leaves1 {
    pla
    tax
    pla
    tay
    lda #0
    pha
    tya
    pha
    txa
    pha
    rts
}

; A routine that takes one byte of its caller's stack and pushes its return address back
; returns through that address too.
.proc takes1 {
    pla
    tax
    pla
    tay
    pla
    tya
    pha
    txa
    pha
    rts
}

; Changing the low byte of the return address returns through the address it made.
.proc adjusts {
    pla
    clc
    adc #2
    pha
    rts
}

; An interrupt handler's `rti` pulls the flags as well as the return address, but a call
; pushes only the return address. The path from a label inside a handler leaves by that `rti`,
; so a call to the label returns through the wrong bytes, as a call to the handler would.
.proc irq: interrupt {
    pha
    pla
    resume:
    rti
}

.proc calls_irq_label {
    jsr irq::resume             ;! error[handler-called]: `resume` is inside interrupt handler `irq` and cannot be called: the path from it returns with `rti`, which would not return to the caller
    rts
}
