; What a repetition refuses.

.module main

.segment RODATA
.data here: .byte 0

.const SIZE = -1
.data turns: .byte[] {
    .repeat here, i {           ;! error[repeat-count-not-constant]: a `.repeat` count must be a constant
        i
    }
    .repeat SIZE, i {           ;! error[repeat-count-negative]: a `.repeat` count cannot be negative, and this one is -1
        i
    }
    .each SIZE, h {             ;! error[each-not-over-a-list]: `.each` walks a list or an enum, and this is neither
        h
    }
}

; A repetition's body is written out once per iteration, so it cannot hold a declaration that
; names one symbol for the whole file.
.repeat 2, i {
    .export here                ;! error[declaration-in-a-repetition]: an export or an import cannot be inside a `.repeat` or `.each` body: it names one symbol, and the body is expanded once per iteration
}

.enum Cmd {
    move
    fire
}

.segment CODE
.scope actions {
    .proc move {
        rts
    }
}

; A path may end in a repetition's binding only over an enum, and the scope needs every member.
.segment RODATA
.data by_command: .addr[] {
    .each Cmd, c {
        actions::c              ;! error[family-member-missing]: `actions` has no member `fire`, which `c` names on this iteration
    }
}

.list handlers {
    here
}

.data by_handler: .addr[] {
    .each handlers, h {
        actions::h              ;! error[binding-not-over-an-enum]: `h` does not iterate over an enum, so it cannot end a path: only an `.each` over an enum names a member this way
    }
}

; A repetition in a macro body counts every turn towards what an expansion may lay out, so
; two calls that each stay under the bound can still take the file past it together.
.macro big(n: const) {
    .repeat n {
        .byte 0
    }
}

.data lots {
    big!(20000)
    big!(20000)                 ;! error[expansion-limit]: the expansions in this file come to more than 65536 statements, which is as far as nt65 goes
}

; One repetition that runs further than nt65 unrolls is said where its count is written,
; whatever the file comes to in all.
.data too_many {
    .repeat 70000 {             ;! error[repeat-too-many]: this repetition runs 70000 times, more than the limit of 65536
        .byte 0
    }
}
