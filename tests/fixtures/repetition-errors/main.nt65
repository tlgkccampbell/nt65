; What a repetition refuses.

.segment RODATA
.data here: .byte 0

SIZE = -1
.data turns: .byte[] {
    .repeat here, i {           ;! error: a `.repeat` count is a constant, and this is not one
        i
    }
    .repeat SIZE, i {           ;! error: a `.repeat` count cannot be negative, and this one is -1
        i
    }
    .each SIZE, h {             ;! error: `.each` walks a list or an enum, and this is neither
        h
    }
}

; A repetition's body is written out once per turn, so it holds nothing that is one thing
; for the whole file.
.repeat 2, i {
    .export here                ;! error: an export or an import belongs outside a repetition: it names one symbol, and a repetition's body is written out once per turn
}

.enum Cmd {
move
fire
}

.segment CODE
.scope actions {
.proc move {
    rts
}
}

; A path ends in a repetition's name only over an enum, and the scope needs every member.
.segment RODATA
.data by_command: .addr[] {
    .each Cmd, c {
        actions::c              ;! error: `actions` has no `fire`, which `c` stands for on this turn
    }
}

.list handlers {
    here
}

.data by_handler: .addr[] {
    .each handlers, h {
        actions::h              ;! error: `h` does not walk an enum, so it names no member: a path ends in a repetition's name only over an enum's members
    }
}

; A repetition in a macro body counts every turn towards what an expansion may lay out.
.macro big(n: const) {
.repeat n {
    .byte 0
}
}

.data lots {
    big!(70000)                 ;! error: the expansions in this file come to more than 65536 statements, which is as far as nt65 goes
}
