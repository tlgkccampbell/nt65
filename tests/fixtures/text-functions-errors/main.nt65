; What text-building refuses: a substring that reaches outside its text, a joined number that is
; not a byte, a zero inside text that `.strz` ends with one, and arguments of the wrong kind.
.module main
.cpu 6502

.segment RODATA
.data past:     .byte .strsub("HELLO", 3, 3)    ;! error[strsub-out-of-range]: `.strsub` reaches outside the text: it asks for 3 bytes from 3, and the text is 5 bytes long
.data before:   .byte .strsub("HELLO", -1, 1)   ;! error[strsub-out-of-range]: `.strsub` reaches outside the text: it asks for 1 byte from -1, and the text is 5 bytes long
.data wide:     .byte .strcat("A", 256)         ;! error[strcat-not-a-byte]: `.strcat` adds a number as a single byte, and $0100 is not in the range 0 to 255
.data negative: .byte .strcat(-1, "A")          ;! error[strcat-not-a-byte]: `.strcat` adds a number as a single byte, and -1 is not in the range 0 to 255
.data ended:    .strz .strcat("A", 0, "B")      ;! error[strz-zero-in-text]: the text holds a zero, which would end it early: `.strz` writes the zero that ends it
.data number:   .byte .strsub(5, 0, 1)          ;! error[builtin-arguments]: `.strsub` takes `.strsub(text, start, count)`: a text and two numbers
.data nothing:  .byte .strcat()                 ;! error[builtin-arguments]: `.strcat` takes `.strcat(part, ...)`: at least one text or number

; Text is ASCII outside a charmap, and a call building text from a literal is outside one.
.data accent: .byte .strcat("é")              ;! error[text-not-ascii]: text is ASCII outside a charmap; use `\xHH` for a byte above $7f

; There is still no arithmetic on text: `.strcat` joins it.
.const JOINED = "A" + "B"                              ;! error[operator-on-text]: `+` cannot be used on a string
