; On the 65816 a near jump, call or branch cannot leave its bank, and a long one reaches any bank.
; Two segments that share addresses in one bank are never mapped at once, so even a long jump
; or call cannot reach from one to the other.
.module main

.cpu 65816

.export start

.segment BANK1
.proc far_routine: far, a8, i8 {
    rtl
}

.proc near_routine: a8, i8 {
    rts
}

.segment CODE
.proc start: a8, i8, native {
    jsl far_routine
    jsr near_routine        ;! error[jump-leaves-bank]: `near_routine` is in bank $81, and `jsr` cannot leave bank $80: use `jsl`
    jeq near_routine        ;! error[jump-leaves-bank]: `near_routine` is in bank $81, and `jeq` cannot leave bank $80: branch the other way around a `jml` to it
    jsl overlay_a
    rts
}

.segment OVERLAYA
.proc overlay_a: far, a8, i8 {
    jsl overlay_b           ;! error[segment-not-visible]: `jsl` targets `overlay_b` in segment `OVERLAYB`, which is never mapped at the same time as segment `OVERLAYA`: `rom.cfg` gives memory areas `OVLB` and `OVLA` the same addresses
    lda f:table_b           ;! error[segment-not-visible]: `table_b` in segment `OVERLAYB`, which is never mapped at the same time as segment `OVERLAYA`: `rom.cfg` gives memory areas `OVLB` and `OVLA` the same addresses
    jsl far_routine
    rtl
}

.segment OVERLAYB
.proc overlay_b: far, a8, i8 {
    rtl
}

.data table_b: .byte 1
