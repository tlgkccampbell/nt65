; What `keeps` cannot promise on the 65816, where a register's width is part of what a push
; moves: a save and its restore cancel only when the register is the same width at both.
.module main

.cpu 65816

.export saves_across, jumps_in
.export hands_off, widens, hands_on, holds
.export branches_off, next_hands_off, branches_on

; A routine whose widths nothing says, which is what a hardware entry point looks like.
.proc twiddle = $8000: a? -> a?

.segment BSS
.data vector: .addr

.segment CODE

; `pha` pushes as many bytes as A is wide and `pla` pulls as many as A is wide where it
; stands. Two widths nobody knows are not the same width: `twiddle` may widen A between them,
; and the `pla` then takes back a byte the `pha` never pushed.
.proc saves_across: a?, keeps a -> a? {
    pha
    jsr twiddle
    pla
    rts                     ;! error[keeps-broken]: `saves_across` promises `keeps a`, but A is not the same as on entry here: restore it before returning, or add `.state keeps a` at the point where the entry value is restored
}

; The same on the 65816, where the label's `.state` also declares the widths a jump in is checked
; against; it cannot declare the stack, so a jump in has not made the `pha` above it.
.proc saves_across_a_label: a8, i8, keeps a {
    pha
    halfway:
    .state a8, i8, native
    pla
    rts                     ;! error[keeps-broken]: `saves_across_a_label` promises `keeps a`, but A is not the same as on entry here, because `halfway` can be entered from outside `saves_across_a_label`, and a jump to it has not pushed what the path above the label pushes: move the pushes above `halfway` to the same side of it as the code that reads them; `args n` on `saves_across_a_label` declares what the caller of a second entry point pushed
}

.proc jumps_in: a8, i8 {
    jmp saves_across_a_label::halfway
}

; A jump into another routine's label leaves this routine for good, so what it hands back is what
; the path from that label hands back. A `keeps` on the routine the label is in does not cover that
; path, because it is checked only from the routine's entry.
.proc hands_off: a8, i8, keeps a {
    jmp widens::partway     ;! error[keeps-broken]: `hands_off` promises `keeps a`, but A is not the same as on entry here: control does not come back from `partway` in `widens`, and the path from there does not keep a: restore it there, or add `.next ?` here to end the path unchecked
}

.proc widens: a8, i8 {
    partway:
    .state a8, i8, native
    lda #$12
    rts
}

; The same jump where the path from the label keeps A.
.proc hands_on: a8, i8, keeps a {
    jmp holds::partway
}

.proc holds: a8, i8, keeps a {
    partway:
    .state a8, i8, native
    ldx #$12
    rts
}

; A branch that names the routine itself, and a `.next` naming one on a jump through a pointer,
; hand control on the same way: control comes back from neither.
.proc branches_off: a8, i8, keeps a {
    ldx #1
    bne widens              ;! error[keeps-broken]: `branches_off` promises `keeps a`, but A is not the same as on entry here: control does not come back from `widens`, which does not promise to keep a: add `keeps a` to `widens` if it preserves it, or add `.next ?` here to end the path unchecked
    rts
}

.proc next_hands_off: a8, i8, keeps a {
    jmp (vector)            ;! error[keeps-broken]: `next_hands_off` promises `keeps a`, but A is not the same as on entry here: control does not come back from `widens`, which does not promise to keep a: add `keeps a` to `widens` if it preserves it, or add `.next ?` here to end the path unchecked
    .next widens
}

; And where the routine handed to promises to keep A, the branch is certified.
.proc branches_on: a8, i8, keeps a {
    ldx #1
    bne holds
    rts
}

; Setting the index flag zeroes the high bytes of X and Y, and pulling the flags back afterwards
; does not bring them back.
.export .proc narrows: i16, keeps x, y {
    php
    sep #$10
    plp
    rts ;! error[keeps-broken]: `narrows` promises `keeps x, y`, but X, Y are not the same as on entry here: restore them before returning, or add `.state keeps x, y` at the point where the entry value is restored
}

; Neither does a `plp` that may pull the flag set.
.export .proc pulls_narrow: a8, i16, keeps x, y {
    lda #$30
    pha
    plp
    rep #$10
    sep #$20
    rts ;! error[keeps-broken]: `pulls_narrow` promises `keeps x, y`, but X, Y are not the same as on entry here: restore them before returning, or add `.state keeps x, y` at the point where the entry value is restored
}

; A routine entered with 8-bit index registers found the high bytes zero, so a `plp` that
; narrows them again leaves them as they were.
.export .proc pulls_back: i8, keeps x, y {
    php
    rep #$10
    plp
    rts
}

; A routine that widens and narrows again leaves the high bytes as it found them.
.export .proc widens_and_back: i8, keeps x, y {
    rep #$10
    sep #$10
    rts
}

; So does one whose `plp` pulls the flags back to 16-bit.
.export .proc keeps_wide: i16, keeps x, y {
    php
    rep #$10
    plp
    rts
}
