; What `keeps` cannot promise on the 65816, where a register's width is part of what a push
; moves: a save and its restore cancel only when the register is the same width at both.
.module main

.cpu 65816

.export saves_across, jumps_in
.export hands_off, widens, hands_on, holds
.export branches_off, next_hands_off, branches_on

; A routine whose widths nothing says, which is what a hardware entry point looks like.
.proc twiddle = $8000: a? -> a?

.segment BSS
.data vector: .addr

.segment CODE

; `pha` pushes as many bytes as A is wide and `pla` pulls as many as A is wide where it
; stands. Two widths nobody knows are not the same width: `twiddle` may widen A between them,
; and the `pla` then takes back a byte the `pha` never pushed.
.proc saves_across: a?, keeps a -> a? {
    pha
    jsr twiddle
    pla
    rts                     ;! error[keeps-broken]: `saves_across` promises `keeps a`, and A is not what the routine was entered with here: restore it before returning, or a `.state keeps a` where the value comes back says so
}

; The same on the 65816, where the label's `.state` also declares the widths a jump in is checked
; against; it cannot declare the stack, so a jump in has not made the `pha` above it.
.proc saves_across_a_label: a8, i8, keeps a {
    pha
    halfway:
    .state a8, i8, native
    pla
    rts                     ;! error[keeps-broken]: `saves_across_a_label` promises `keeps a`, and A is not what the routine was entered with here, because `halfway` can be entered from outside `saves_across_a_label`, and a jump in has not pushed what the path above the label has: the pushes above `halfway` belong on the same side of it as what reads them, and `args n` on `saves_across_a_label` is how a second entry point says what its caller pushed
}

.proc jumps_in: a8, i8 {
    jmp saves_across_a_label::halfway
}

; A jump into another routine's label leaves this routine for good, so what it hands back is what
; that routine hands back: its `keeps` is taken at its word, just as for a jump to the routine
; itself, since control comes back from neither.
.proc hands_off: a8, i8, keeps a {
    jmp widens::partway     ;! error[keeps-broken]: `hands_off` promises `keeps a`, and A is not what the routine was entered with here: control does not come back from `partway`, and `widens` does not promise to keep a: a `keeps a` on `widens` says it hands it back, and a `.next ?` here ends the path with nothing checked
}

.proc widens: a8, i8 {
    partway:
    .state a8, i8, native
    lda #$12
    rts
}

; The same jump where the routine the label is in promises to keep A.
.proc hands_on: a8, i8, keeps a {
    jmp holds::partway
}

.proc holds: a8, i8, keeps a {
    partway:
    .state a8, i8, native
    ldx #$12
    rts
}

; A branch that names the routine itself, and a `.next` naming one on a jump through a pointer,
; hand control on the same way: control comes back from neither.
.proc branches_off: a8, i8, keeps a {
    ldx #1
    bne widens              ;! error[keeps-broken]: `branches_off` promises `keeps a`, and A is not what the routine was entered with here: control does not come back from `widens`, which does not promise to keep a: a `keeps a` on `widens` says it hands it back, and a `.next ?` here ends the path with nothing checked
    rts
}

.proc next_hands_off: a8, i8, keeps a {
    jmp (vector)            ;! error[keeps-broken]: `next_hands_off` promises `keeps a`, and A is not what the routine was entered with here: control does not come back from `widens`, which does not promise to keep a: a `keeps a` on `widens` says it hands it back, and a `.next ?` here ends the path with nothing checked
    .next widens
}

; And where the routine handed to promises to keep A, the branch is certified.
.proc branches_on: a8, i8, keeps a {
    ldx #1
    bne holds
    rts
}
