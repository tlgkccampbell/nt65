; How another file uses a family: each instance is an ordinary name, and a path ending in the
; `.each` binding builds a table of them.
.module main
.use hw::Bank
.use snd::stop

.segment RODATA
; `play` itself is not exported but each of its routines is, so they are named through it.
.data playing: .addr[] {
    .each Bank, b {
        snd::play::b
    }
}

.segment CODE
; `play::lo` declares `dbr = Bank::lo`, which is what B is here.
.proc main: a8, i8, dbr = 0 {
    jsr snd::play::lo
    jsr stop::hi
    rts
}

.export main, playing
