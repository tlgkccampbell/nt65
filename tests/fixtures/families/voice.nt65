; The example from the design: a family of data and a family of routines over one enum, the
; table beside them, and a call of one instance.
.module voice

.enum Channel {
    pulse1
    pulse2
    triangle
    noise
}

.segment ZEROPAGE
.scope level {
    .each Channel, ch {                     ; the form `.multiproc` stands for
        .data ch: .byte             ; level::pulse1, level::pulse2, ...
    }
}

.segment CODE
.scope play {
    .multiproc Channel, ch: a8, i8 {        ; play::pulse1, play::pulse2, ...
        lda level::ch
        .if ch == Channel::noise {          ; the enum's members may be named in a condition here
            inc a
        }
        sta level::ch
        rts
    }
}

.segment RODATA
.data dispatch: .addr[] {
    .each Channel, c {
        play::c                             ; play::pulse1, play::pulse2, ...
    }
}

.segment CODE
.proc run: a8, i8 {
    jsr play::triangle
    rts
}

; A record's fields are reached the same way: a path through data of a record type that ends
; in the binding names the field of the member's name, at the record's offset for that field.
.enum Setting {
    volume
    pitch
}

.struct Settings {
    volume: .byte
    pitch:  .byte
}

.segment RODATA
.data defaults: .type Settings[] {
    { volume = 15, pitch = 40 }
    { volume = 8, pitch = 20 }
}

.segment BSS
.scope current {
    .each Setting, setting {
        .data setting: .byte[2]
    }
}

.segment CODE
.proc reset: a8, i8 {
    ldy #.sizeof(Settings)
    .each Setting, setting {
        lda defaults::setting,y         ; defaults+1,y for `pitch`
        sta current::setting + 1
        lda defaults[0]::setting        ; defaults+1 for `pitch`
        sta current::setting
    }
    rts
}

.export dispatch, run, reset
