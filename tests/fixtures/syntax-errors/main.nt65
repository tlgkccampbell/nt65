; Lexical and block-structure errors reach the compiler's diagnostics.
.module main

.segment CODE
.proc main {
    .byte 'ab'            ;! error: a character literal holds exactly one character
    lda #$1G            ;! error: invalid hexadecimal number `$1G`
    m!({                ;! error: expected an expression ;! error: `m` is not declared
    rts
}
}                       ;! error: unmatched `}`
.proc other {           ;! error: missing `}` to close this block
    rts
