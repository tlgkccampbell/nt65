; Every operand form the 6502 has, and the addressing mode nt65 picks for each. The
; output makes each choice explicit with a `z:` or `a:` prefix wherever the instruction
; offers more than one width.
.module main

.cpu 6502

.segment ZEROPAGE
.data ptr:    .word
.data vector: .word

.segment BSS
.data buf: .byte[256]

hi = $12
lo = $34

; A routine at a fixed address, which the output writes as the constant it is.
.proc CHROUT = $ffd2

.segment CODE
.proc forms {
    inx                     ; implied
    asl                     ; accumulator, bare
    asl a                   ; accumulator, written out
    lda #$10                ; immediate
    lda ptr                 ; direct, because ptr is in a zero-page segment
    lda buf                 ; absolute, because buf is not
    lda z:ptr               ; the same choice, written out in the source
    lda a:ptr               ; forced wider than it needs to be
    lda $10                 ; a constant below $100 is direct
    lda $0400               ; and one above it is absolute
    lda buf,x
    lda buf,y
    ldx buf,y
    sty z:ptr,x
    lda (ptr),y
    lda (ptr,x)
    jmp (vector)
    bne @loop               ; relative
    brk #0                  ; the signature byte is required, and both bytes are counted
    lda (hi + lo) * 2       ; parentheses around part of an expression, not an indirection
    lda z:ptr+1             ; the prefix reaches the whole expression
    jsr CHROUT              ; an extern proc is a near target like any other
@loop:
    rts
}
