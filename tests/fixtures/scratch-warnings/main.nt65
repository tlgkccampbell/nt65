; Scratch is working storage. A caller may store an argument there for the routine it calls, but a
; call that may store to scratch leaves nothing there the caller can rely on, so a read of it
; after such a call may read the callee's value rather than the routine's own.
.module main

.cpu 6502

.export reads_after_call, reads_through_nested_call, stores_again, callee_leaves_it, shared_on_purpose
.export reads_pointer, reads_in_loop, reads_after_indexed_store, reads_in_macro, odd, draw_row
.export argument_overwritten, argument_kept, argument_to_tail_call, argument_through_fallthrough
.export stores_one_byte_again

.segment ZEROPAGE
.scratch tmp:   .byte
.scratch other: .byte
.scratch ptr:   .addr
.scratch buf:   .byte[4]
.data result:   .byte

.segment CODE

; The routine stores `tmp`, and the call to `uses_tmp` may store to it too.
.proc reads_after_call {
    lda #1
    sta tmp
    jsr uses_tmp
    lda tmp             ;! warning[scratch-overwritten]: `tmp` may have been overwritten by the call to `uses_tmp`; store it again after the call, or use scratch that `uses_tmp` does not write
    rts
}

; The store is two calls down, and the warning names the routine that makes it.
.proc reads_through_nested_call {
    lda #1
    sta tmp
    jsr calls_uses_tmp
    lda tmp             ;! warning[scratch-overwritten]: `tmp` may have been overwritten by the call to `calls_uses_tmp`, through `uses_tmp`; store it again after the call, or use scratch that `calls_uses_tmp` does not write
    rts
}

; A store after the call makes the scratch the routine's own again.
.proc stores_again {
    lda #1
    sta tmp
    jsr uses_tmp
    lda #2
    sta tmp
    lda tmp
    rts
}

; A callee that never stores to the scratch leaves it alone.
.proc callee_leaves_it {
    lda #1
    sta other
    jsr uses_tmp
    lda other
    rts
}

; Memory declared with `.data` may carry a value through a call on purpose, and is not checked.
.proc shared_on_purpose {
    jsr returns_result
    lda result
    rts
}

; A pointer reads both its bytes, and the read is reported once.
.proc reads_pointer {
    lda #0
    sta ptr
    sta ptr + 1
    jsr uses_ptr
    ldy #0
    lda (ptr),y         ;! warning[scratch-overwritten]: `ptr` may have been overwritten by the call to `uses_ptr`; store it again after the call, or use scratch that `uses_ptr` does not write
    rts
}

; A loop brings what the call in its body stores back round to the read at its top.
.proc reads_in_loop {
    lda #1
    sta tmp
    ldx #3
@next:
    lda tmp             ;! warning[scratch-overwritten]: `tmp` may have been overwritten by the call to `uses_tmp`; store it again after the call, or use scratch that `uses_tmp` does not write
    jsr uses_tmp
    dex
    bne @next
    rts
}

; An indexed store may reach any byte of the scratch it names.
.proc reads_after_indexed_store {
    lda #1
    sta buf + 2
    jsr fills_buf
    lda buf + 2         ;! warning[scratch-overwritten]: `buf+2` may have been overwritten by the call to `fills_buf`; store it again after the call, or use scratch that `fills_buf` does not write
    rts
}

; A store after the call makes that byte the routine's own again, though the call reached every
; byte of the scratch.
.proc stores_one_byte_again {
    jsr fills_buf
    lda #1
    sta buf + 2
    lda buf + 2
    rts
}

; A read in a macro body is reported at the call that expanded it.
.macro reload() {
    lda tmp
}

.proc reads_in_macro {
    lda #1
    sta tmp
    jsr uses_tmp
    reload!()           ;! warning[scratch-overwritten]: `tmp` may have been overwritten by the call to `uses_tmp`; store it again after the call, or use scratch that `uses_tmp` does not write
    rts
}

; A routine on a cycle of calls takes on what every routine of the cycle stores.
.proc odd {
    lda #1
    sta other
    jsr even
    lda other           ;! warning[scratch-overwritten]: `other` may have been overwritten by the call to `even`, through `odd`; store it again after the call, or use scratch that `even` does not write
    rts
}

.proc even {
    jsr odd
    rts
}

.proc uses_tmp {
    sta tmp
    rts
}

.proc calls_uses_tmp {
    jsr uses_tmp
    rts
}

.proc returns_result {
    lda #3
    sta result
    rts
}

.proc uses_ptr {
    lda #<buf
    sta ptr
    lda #>buf
    sta ptr + 1
    rts
}

.proc fills_buf {
    ldx #3
@next:
    sta buf,x
    dex
    bpl @next
    rts
}

; The example in the design.
.proc draw_row {
    sta tmp
    jsr plot            ; plot calls mul8, which stores to tmp
    lda tmp             ;! warning[scratch-overwritten]: `tmp` may have been overwritten by the call to `plot`, through `mul8`; store it again after the call, or use scratch that `plot` does not write
    rts
}

.proc plot {
    jsr mul8
    rts
}

.proc mul8 {
    sta tmp
    rts
}

; An argument in scratch is overwritten by a call between its store and the call that reads it.
.proc argument_overwritten {
    lda #0
    sta ptr
    sta ptr + 1
    jsr uses_ptr
    jsr reads_ptr       ;! warning[scratch-overwritten]: `ptr` may have been overwritten by the call to `uses_ptr` before `reads_ptr` reads it; store it again after the call, or use scratch that `uses_ptr` does not write
    rts
}

; A routine that only reads the argument leaves it as it was, so the next call gets it too.
.proc argument_kept {
    lda #0
    sta ptr
    sta ptr + 1
    jsr reads_ptr
    jsr reads_ptr
    rts
}

; A tail call reads its arguments as a call does.
.proc argument_to_tail_call {
    lda #0
    sta ptr
    sta ptr + 1
    jsr uses_ptr
    jmp reads_ptr       ;! warning[scratch-overwritten]: `ptr` may have been overwritten by the call to `uses_ptr` before `reads_ptr` reads it; store it again after the call, or use scratch that `uses_ptr` does not write
}

.proc reads_ptr {
    ldy #0
    lda (ptr),y
    rts
}

; A routine that runs into another with `.fallthrough` reads what that routine reads.
.proc argument_through_fallthrough {
    lda #1
    sta tmp
    jsr uses_tmp
    jsr reads_through_fallthrough ;! warning[scratch-overwritten]: `tmp` may have been overwritten by the call to `uses_tmp` before `reads_through_fallthrough` reads it; store it again after the call, or use scratch that `uses_tmp` does not write
    rts
}

.proc reads_through_fallthrough {
    ldx #0
    .fallthrough reads_tmp
}

.proc reads_tmp {
    lda tmp
    rts
}
