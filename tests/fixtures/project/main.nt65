; The project file says what this program is built for, where its output goes, what its
; defines are worth and which segments it has. Nothing here repeats any of it.

.module main

.segment FAST
.data scratch:    .word

.segment VRAM
.data tiles:      .byte[64]

.segment CODE
.proc start {
    stz scratch             ; a 65C02 instruction, from the project's `cpu`
    lda #DEBUG              ; a define, written out as its value
    ldx #<VERSION
    ldy #>VERSION
    lda tiles
    rts
}
