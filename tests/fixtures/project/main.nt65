; The project file says what this program is built for, where its output goes, what its
; settings are worth and which segments it has. Nothing here repeats any of it.

.module main

.const DEBUG   ?= 0
.const VERSION ?= 0

.segment FAST
.data scratch: .word

.segment VRAM
.data tiles: .byte[64]

.segment CODE
.export .proc start {
    stz scratch             ; a 65C02 instruction, from the project's `cpu`
    lda #DEBUG              ; a setting, written out as its value
    ldx #<VERSION
    ldy #>VERSION
    lda tiles
    rts
}
