; What a name is worth, which names are addresses rather than constants,
; and what a name that needs itself does.

.module main

FIRST   = SECOND + 1        ; a name may be used before the line that declares it
SECOND  = 2
SCREEN  = $0400
LOW     = <(SCREEN + 1)
TEXT    = "hi"
LENGTH  = .strlen(TEXT)
WIDE    = .addrsize(SCREEN)
PICK    = .max(FIRST, SECOND)

.segment ZEROPAGE
.data ptr:    .word

; An expression that names an address is an address alias, not a constant.
NEXT    = ptr + 1
HERE    = *

; A name that needs itself, directly or through another, is an error reported once.
SELF    = SELF + 1          ;! error: `SELF` is defined in terms of itself
LOOP_A  = LOOP_B            ;! error: `LOOP_A` is defined in terms of itself
LOOP_B  = LOOP_A

DIVIDE  = 1 / 0             ;! error: division by zero
JOIN    = TEXT + 1          ;! error: `+` cannot be used on a string
