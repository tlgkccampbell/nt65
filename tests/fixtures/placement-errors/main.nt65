; What placement refuses, and a `.fallthrough` into another module that placement does not make true.
.module main

.segment CODE
.export .proc first {
    lda #1
    .fallthrough inner::second      ;! error[fallthrough-not-adjacent]: `second` does not start where this routine ends: `.fallthrough` can only name the routine written directly after it in the same segment
}

.place inner

.export .proc third {
    lda #3
    .fallthrough fourth             ;! error[fallthrough-not-adjacent]: `fourth` does not start where this routine ends: `.fallthrough` can only name the routine written directly after it in the same segment
}

.place middle                       ; its bytes go between `third` and `fourth`

.export .proc fourth {
    lda #4
    .fallthrough alone::entry       ;! error[fallthrough-not-placed]: `entry` is in module `alone`, and the two modules are separate translation units, whose order only the linker knows: use `.place` to lay one out inside the other
}

.export .proc fifth {
    lda #5
    .fallthrough spare::go          ;! error[fallthrough-not-placed]: `go` is in module `spare`, and the two modules are separate translation units, whose order only the linker knows: use `.place` to lay one out inside the other
}

.if FAST {
    .place stray                    ;! error[place-misplaced]: `.place` must be at file level, outside every block: which modules are assembled together cannot depend on a condition
}

.scope inside {
    .place stray                    ;! error[place-misplaced]: `.place` must be at file level, outside every block: which modules are assembled together cannot depend on a condition
}

.place nowhere                      ;! error[module-unknown]: no module `nowhere` is in this build
.place alone                        ;! error[place-not-placeable]: module `alone` is not marked as placeable: declare it `.module alone: placed` so that another module can place it
.place twice

.export .proc sixth {
    rts
}
