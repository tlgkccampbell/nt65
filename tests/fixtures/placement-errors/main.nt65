; What placement refuses, and a `.next` into another module that placement does not make true.
.module main

.segment CODE
.export .proc first {
    lda #1
    .next inner::second             ;! error[next-routine-not-adjacent]: `.next second` says flow runs on into `second`, and it does not start where this statement ends: a routine runs into the one written directly after it
}

.place inner

.export .proc third {
    lda #3
    .next fourth                    ;! error[next-routine-not-adjacent]: `.next fourth` says flow runs on into `fourth`, and it does not start where this statement ends: a routine runs into the one written directly after it
}

.place middle                       ; its bytes stand between the two

.export .proc fourth {
    lda #4
    .next alone::entry              ;! error[next-routine-not-placed]: `.next entry` says flow runs on into `entry`, which is in module `alone`, and the two are not one translation unit: `.place` lays one module's bytes out where the other's run into them
}

.export .proc fifth {
    lda #5
    .next spare::go                 ;! error[next-routine-not-placed]: `.next go` says flow runs on into `go`, which is in module `spare`, and the two are not one translation unit: `.place` lays one module's bytes out where the other's run into them
}

.if FAST {
    .place stray                    ;! error[place-misplaced]: a `.place` is written at file level, outside every block: which modules share a translation unit depends on no condition
}

.scope inside {
    .place stray                    ;! error[place-misplaced]: a `.place` is written at file level, outside every block: which modules share a translation unit depends on no condition
}

.place nowhere                      ;! error[module-unknown]: no module `nowhere` is in this build
.place alone                        ;! error[place-not-placeable]: module `alone` stands alone, so it may not be placed: its declaration says whether it may, `.module alone: placed`
.place twice

.export .proc sixth {
    rts
}
