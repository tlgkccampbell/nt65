; A name a `.use` brings in comes before what a `.use module::*` brings in, and a constant the
; configuration decides reaches a condition as a setting does.
.module aliased
.use hw::cfg::{SPEED as TURBO}
.use hub::*

.const DOUBLED = TURBO * 2

.if TURBO != 3 {
    .error "a setting brought in by `.use` has the wrong value"
}
.if DELAY != 7 {
    .error "a setting brought in by `*` has the wrong value"
}
.if DOUBLED != 6 {
    .error "a constant built from a setting has the wrong value"
}
