; What a `.func` whose value depends on an address cannot do. ld65 works out operators on an
; address, and nothing else in the body can be left to it. The body is written into the
; calling file's output, so an address it names has to be declared there. A value that goes
; into a byte has to be one nt65 can show fits there, or be narrowed with `<`.
.module main

.use lib::offset

.export start, line

.func low(n) = .lobyte(n)
.func inside(n) = n .in [1, 2]
.func outer(n) = 1 + low(n)
.func triple(n) = n * 3
.func digit(n) = '0' + n .mod 10

.segment CODE
.data line {
    .word low(start)        ;! error[func-not-linkable]: `low` is written for ld65 to work out, because its value depends on an address, and its body uses `.lobyte(n)`: ld65 works out only operators on an address, so that part of the body needs a constant
    .word inside(start)     ;! error[func-not-linkable]: `inside` is written for ld65 to work out, because its value depends on an address, and its body uses `n .in [1, 2]`: ld65 works out only operators on an address, so that part of the body needs a constant
    .word outer(start)      ;! error[func-not-linkable]: `outer` is written for ld65 to work out, because its value depends on an address, and its body uses `.lobyte(n)`: ld65 works out only operators on an address, so that part of the body needs a constant
    .word offset(1)         ;! error[func-not-linkable]: `offset` is written for ld65 to work out, because its value depends on an address, and its body uses `table`: that address is declared in another file, which this file's output cannot name
    .byte triple(start)     ;! error[linked-value-may-not-fit]: `triple(start)` is worked out by the linker from an address, and `.byte` holds 8 bits, which nt65 cannot show it fits: use `<(triple(start))` for its low byte
    .byte digit(start) + 300 ;! error[linked-value-may-not-fit]: `digit(start) + 300` is worked out by the linker from an address, and `.byte` holds 8 bits, which nt65 cannot show it fits: use `<(digit(start) + 300)` for its low byte
}

.proc start {
    lda #triple(start)      ;! error[linked-value-may-not-fit]: `triple(start)` is worked out by the linker from an address, and an immediate is one byte, which nt65 cannot show it fits: use `<(triple(start))` for its low byte
    rts
}
