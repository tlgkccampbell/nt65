; The symbols ld65 defines for a segment are as wide as the segment's placement in the linked
; config, and are bounded by the memory areas it puts the segment in. ca65 refuses an absolute
; symbol in a one-byte slot whatever its value, so a value that always fits a byte is written as
; its low byte, which loses nothing. ld65 defines every such symbol as absolute, so a run address
; in the zero page is written as its low byte wherever it fills a one-byte slot. An operand
; given whole to a macro is written the same way as one written in place, whether the body
; offsets it or passes it on to another macro.
.module main

.export main, pages, given

.macro load(source: operand) {
    lda source
}

.macro load_from(source: operand) {
    load!(source)
}

.macro load_next(source: operand) {
    lda source+1
}

.segment TABLES
.data squares: .byte 0, 1, 4, 9

.segment FAST
.proc fast {
    inc squares
    rts
}

.segment CODE
.data pages {
    .byte .loadof(CODE) / 256           ; $08 to $9f, wherever CODE lands in MAIN
    .byte .runof(TABLES) >> 8           ; $c0 to $cf
    .byte .spanof(FAST)                 ; no more than ZPCODE's $7e bytes
    .byte .runof(FAST)                  ; a zero-page address
}

.proc main {
    ldx #.spanof(FAST)
@copy:
    lda .loadof(FAST) - 1,x
    sta .runof(FAST) - 1,x
    dex
    bne @copy
    lda #.loadof(TABLES) / 256
    jsr fast
    lda .runof(FAST)                    ; a zero-page operand
    ldy #0
    lda (.runof(FAST)),y                ; a zero-page pointer
    lda (.runof(FAST),x)
    stx .runof(FAST),y                  ; zero-page modes with no absolute form
    sty .runof(FAST),x
    rts
}

.proc given {
    load!({#.spanof(FAST)})                 ; an immediate
    load!(.runof(FAST))                     ; a zero-page operand
    ldy #0
    load!({(.runof(FAST)),y})               ; a zero-page pointer
    load!({.runof(FAST) + 1,x})             ; a zero-page operand with an index
    load_from!({.runof(FAST) + 1,x})        ; through a parameter of an enclosing macro
    load_next!(.runof(FAST))                ; the byte after a zero-page operand
    load_next!({.runof(FAST),x})
    rts
}
