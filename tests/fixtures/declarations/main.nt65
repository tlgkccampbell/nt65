; Every form of data declaration, measured twice: nt65 answers `.sizeof` and `.countof` at
; edit time, and ld65 checks each answer against where the declaration's bytes end.
.module main

.cpu 6502

.struct Point {
    x: .byte
    y: .byte
}

.struct Sprite {
    pos:    .type Point
    tile:   .word
    colors: .byte[3]
    name:   .res 4, ' '         ; padded with spaces, given text or not
}

.enum Cmd {
    move
    fire
}

.segment ZEROPAGE
.data cursor: .word

.segment BSS
.data buffer: .byte[16]
.data points: .type Point[4]

.segment RODATA
.data gradient: .byte 40, $e0, 0
.data lut: .byte[4] { 1, 2, 4, 8 }
.data row_lo: .byte[] {
    .repeat 5, i {
        i * 40
    }
}
.data text: .asciiz "hi"
.data handlers: .addr[] {
    .each Cmd, c {
        actions::c
    }
}
.data hero: .type Sprite { pos = { x = 1, y = 2 }, tile = $0100, colors = { 1, 2, 3 }, name = "HERO" }
.data sprites: .type Sprite[] {
    { pos = { x = 10 }, name = "A" }
    { pos = { x = 20, y = 30 } }
    { tile = $0300 }
}
.data blank: .type Sprite
.data vectors {
    .data native: .addr[2] { 0, main }
    .byte $ff
@middle:
    .data emulation: .addr[2] {
        main, @middle
    }
}

; What nt65 answers as it is written.
.assert .sizeof(cursor) == 2 && .countof(cursor) == 1, error, "cursor"
.assert .sizeof(buffer) == 16 && .countof(buffer) == 16, error, "buffer"
.assert .sizeof(points) == 8 && .countof(points) == 4, error, "points"
.assert .sizeof(gradient) == 3 && .countof(gradient) == 3, error, "gradient"
.assert .sizeof(lut) == 4 && .countof(lut) == 4, error, "lut"
.assert .sizeof(row_lo) == 5 && .countof(row_lo) == 5, error, "row_lo"
.assert .sizeof(text) == 3 && .countof(text) == 3, error, "text"
.assert .sizeof(handlers) == 4 && .countof(handlers) == 2, error, "handlers"
.assert .sizeof(Sprite) == 11, error, "Sprite"
.assert .sizeof(hero) == 11 && .countof(hero) == 1, error, "hero"
.assert .sizeof(sprites) == 33 && .countof(sprites) == 3, error, "sprites"
.assert .sizeof(blank) == 11, error, "blank"
.assert .sizeof(vectors) == 9 && .spanof(vectors) == 9, error, "vectors"
.assert .sizeof(vectors::native) == 4 && .countof(vectors::emulation) == 2, error, "vectors members"

; What ld65 checks against the bytes ca65 wrote: each declaration ends where its size says.
.assert .endof(cursor) - cursor == .sizeof(cursor), lderror, "cursor"
.assert .endof(buffer) - buffer == .sizeof(buffer), lderror, "buffer"
.assert .endof(points) - points == .countof(points) * .sizeof(Point), lderror, "points"
.assert .endof(gradient) - gradient == .sizeof(gradient), lderror, "gradient"
.assert .endof(lut) - lut == .sizeof(lut), lderror, "lut"
.assert .endof(row_lo) - row_lo == .sizeof(row_lo), lderror, "row_lo"
.assert .endof(text) - text == .sizeof(text), lderror, "text"
.assert .endof(handlers) - handlers == .sizeof(handlers), lderror, "handlers"
.assert .endof(hero) - hero == .sizeof(hero), lderror, "hero"
.assert .endof(sprites) - sprites == .countof(sprites) * .sizeof(Sprite), lderror, "sprites"
.assert .endof(blank) - blank == .sizeof(blank), lderror, "blank"
.assert .endof(vectors) - vectors == .sizeof(vectors), lderror, "vectors"
.assert vectors::emulation - vectors == .sizeof(vectors::native) + 1, lderror, "vectors::emulation"

.segment CODE
.scope actions {
    .proc move {
        rts
    }
    .proc fire {
        rts
    }
}

.proc main {
    ; An element of a record array is its index times the type's size in: this is the third
    ; sprite's tile, reached both ways.
    ldx #2 * .sizeof(Sprite)
    lda sprites::tile,x
    lda sprites + 2 * .sizeof(Sprite) + Sprite::tile
    lda points::y,x
    lda vectors::emulation
    lda cursor
    sta buffer
    jmp (handlers)
    .next handlers
}
