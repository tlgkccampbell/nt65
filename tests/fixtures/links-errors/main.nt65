; A project that links a config takes its segments from it, so a segment the config does not
; place is an error where the program names it, as is a second declaration of one it does.
.module main

.export start, unplaced, image, copied

.segment CODE: abs              ;! error[segment-declared-twice]: segment "CODE" is already declared

.segment DATA                   ;! error[segment-not-linked]: segment "DATA" is not in any linked config, so ld65 has nowhere to put it
.data unplaced: .byte 0

.segment IMAGE
.data image: .byte 1

.segment COPIED
.data copied: .byte 2

.segment CODE
.proc start {
    lda .loadof(IMAGE)          ;! error[segment-not-defined]: `.loadof` needs `define = yes` on segment "IMAGE" in `link.cfg`: ld65 defines `__IMAGE_LOAD__` only for such a segment
    lda .loadof(COPIED)
    rts
}
