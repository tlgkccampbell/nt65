; `unused-symbol` is off here, so the declaration nothing names says nothing; `mnemonic-name`
; is an error here, so the label ca65 would read as an instruction stops the build.
.module main

.const QUIET = 1

.segment CODE
.proc start {
    lda:                                ;! error[mnemonic-name]: `lda` is legal as a name but reads as the 6502 instruction
    rts
}
