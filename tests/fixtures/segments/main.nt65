; §5.2: a segment's address size is declared exactly once per program, and a block may only
; name a segment that something declares.
.segment "ZP2": zp
.segment "WRAM": abs, bank = $7e

.segment "ZP2" {
scratch:    .res 2
}

.segment "WRAM" {
buffer:     .res 256
}

.segment "NOWHERE" {        ;! error: segment "NOWHERE" is not declared
lost:       .res 1
}

.segment "ZP2": zp          ;! error: segment "ZP2" is already declared
.segment "ZEROPAGE": zp     ;! error: segment "ZEROPAGE" is already declared
