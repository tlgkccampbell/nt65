{
  // The project file is read as data: a key it does not know, or a value of the wrong shape,
  // is reported and the rest of the file is still read. Comments are for these notes.
  "cpu": "6809",          // ;! error: `6809` is not a processor nt65 knows: `6502`, `65sc02`, `r65c02`, `65c02` or `65816`
  "files": "*.nt65",      // ;! error: `files` is a list of strings
  "outputs": "build",     // ;! error: `outputs` is not a nt65.json key
  "defines": {
    "SIZE": "twelve"      // ;! error: `SIZE` is not a number, and a define is a number
  },
  "segments": {
    "VRAM": { "size": "word" },  // ;! error: segment "VRAM" needs a `size` of "zp", "abs" or "far"
    "SLOW": { "size": "abs", "dp": "$2100" },  // ;! error: `dp` says which direct page a `zp` segment is reached through, and "SLOW" is not `zp`
    "WIDE": { "size": "abs", "bank": 256 },    // ;! error: a bank is one byte
    "ODD":  { "size": "abs", "base": 1 }       // ;! error: segment "ODD": `base` is not a segment key: a segment has a `size`, a `dp`, a `bank` and `mirrors`
  },
  "ranges": {
    "$2100-$21ff": ["$00-$3f", "$80-$bf"],
    "$2180": ["$00"],     // ;! error: `$2180` overlaps `$2100-$21ff`: an address is in one range at most
    "$21ff-$2100": [0],   // ;! error: `$21ff-$2100` is not a range of absolute addresses, such as "$2100-$21ff"
    "$4200": ["$00-$1ff"] // ;! error: `$4200`: "$00-$1ff" is not a bank or a range of banks
  }
}
