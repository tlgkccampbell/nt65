{
  // The project file is read as data: a key it does not know, or a value of the wrong shape,
  // is reported and the rest of the file is still read. Comments are for these notes.
  "cpu": "6809",          // ;! error[project-cpu-unknown]: `6809` is not a supported `cpu`: use `6502`, `6502x`, `65sc02`, `r65c02`, `65c02` or `65816`
  "files": "*.nt65",      // ;! error[project-not-a-list]: `files` must be a list of strings
  "outputs": "build",     // ;! error[project-key-unknown]: `outputs` is not a key of nt65.json
  "setting": {},          // ;! error[project-key-unknown]: `setting` is not a key of nt65.json; did you mean `settings`?
  "settings": {
    "SIZE": "twelve"      // ;! error[setting-not-a-number]: `SIZE`: a setting's value must be a number
  },
  "diagnostics": {
    "unused-symbols": "off",   // ;! error[diagnostic-name-unknown]: `unused-symbols` is not a diagnostic nt65 reports; did you mean `unused-symbol`?
    "unused-symbol": "quiet",  // ;! error[diagnostic-severity-unknown]: the severity of `unused-symbol` must be "off", "warning" or "error"
    "not-declared": "warning"  // ;! error[diagnostic-not-turned-down]: `not-declared` is an error, and a project cannot turn an error into a warning or off
  },
  "spaces": {
    "spc": "sound"        // ;! error[project-space-holds-unknown]: space `spc` must be "code" or "data"
  },
  "segments": {
    "VRAM": { "size": "word" },  // ;! error[project-segment-size-missing]: segment "VRAM" needs a `size` of "zp", "abs" or "far"
    "SLOW": { "size": "abs", "dp": "$2100" },  // ;! error[segment-dp-not-zp]: segment "SLOW" is not `zp`, and only a `zp` segment takes a `dp`
    "WIDE": { "size": "abs", "bank": 256 },    // ;! error[segment-attribute-out-of-range]: `bank` must be $00 to $ff: a bank is one byte
    "CODE": { "size": "far" },                 // ;! error[segment-standard-size]: "CODE" is a standard segment and is always `abs`
    "ODD":  { "size": "abs", "base": 1 },      // ;! error[project-segment-key-unknown]: segment "ODD" cannot set `base`: a segment may set only `size`, `dp`, `bank`, `mirrors` and `space`
