  "configurations": {
    "fast": { "cpu": "65816" },   // ;! error[configuration-key-unknown]: configuration `fast` cannot set `cpu`: a configuration may set only `settings`, `diagnostics`, `links` and `out`
    "slow down": {}               // ;! error[configuration-name-invalid]: `slow down` is not a valid configuration name: use only letters, digits, `_` and `-`
  }
