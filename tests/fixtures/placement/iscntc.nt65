; Code only one configuration needs is a module that is always placed, with its items under an
; `.if` of their own: built without KIM, it places nothing at all.
.module iscntc: placed

.const KIM ?= 0

.segment CODE

.if KIM {
    .export .proc ISCNTC {
        lda $1742
        cmp #$03
        .fallthrough flow1::STOP    ; runs into STOP, which the placement puts next
    }
}
