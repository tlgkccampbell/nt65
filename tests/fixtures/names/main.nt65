; What goes wrong with a name: one that is not declared, one declared twice, a
; register name, and a cheap local written or reached where it may not be. A mnemonic
; is a name like any other, and only warned about.

.module main

.const SIZE = 1
.const SIZE = 2                     ;! error[name-already-declared]: `SIZE` is already declared in this scope

.const lda = 5                      ;! warning[mnemonic-name]: `lda` is legal as a name but reads as the 6502 instruction

; The one name the output cannot spell: an `as` name is written into the output exactly,
; and ca65 defines no symbol spelled like one of its own instructions — on any CPU, since
; the name is what a module built for another one would link against.
.const PALETTE = 3
.export PALETTE as "lda"    ;! error[linker-name-is-an-instruction]: cannot export as `lda`: ca65 would read it as an instruction
.export SIZE as "swa"       ;! error[linker-name-is-an-instruction]: cannot export as `swa`: ca65 would read it as an instruction

.segment CODE
.data x: .byte 0                    ;! error[register-name]: `x` is a register and cannot be a name

; An anonymous enum declares its members where it is written, so they are ordinary names.
.enum {
    y                       ;! error[register-name]: `y` is a register and cannot be a name
}

@stray:                     ;! error[cheap-local-outside-a-scope]: `@stray` is a cheap local, which needs an enclosing `.proc` or `.scope`

.proc main {
    jsr missing             ;! error[not-declared]: `missing` is not declared
    lda #COUNT              ;! error[not-declared]: `COUNT` is not declared
    bne @nowhere            ;! error[not-declared]: `@nowhere` is not declared
@loop:
    rts
}

.proc main {                ;! error[name-already-declared]: `main` is already declared in this scope
    rts
}

; A name a letter or two from a declared one says which, so what the editor offers as a fix
; is what a build at the command line is told.
.proc spelling {
    .const COUNTER = 0
    ldx #COUNTER
    lda #COUNTR             ;! error[not-declared]: `COUNTR` is not declared; did you mean `COUNTER`?
@loop:
    dex
    bne @lop                ;! error[not-declared]: `@lop` is not declared; did you mean `@loop`?
    rts
}

.proc reach {
    lda ::@loop             ;! error[cheap-local-in-a-path]: `@loop` is a cheap local and cannot be reached with `::`
    lda ::nothing           ;! error[module-unknown]: no module `nothing` is in this build
    lda ::main::nothing     ;! error[not-declared-in]: `nothing` is not declared in module `main`
    lda SIZE::inner         ;! error[not-a-scope]: `SIZE` is a constant, not a scope
    lda main::inner         ;! error[not-declared-in]: `inner` is not declared in `main`
    rts
}
