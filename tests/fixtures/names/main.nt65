; What goes wrong with a name: one that is not declared, one declared twice, a
; reserved word, and a cheap local written or reached where it may not be.

.module main

SIZE = 1
SIZE = 2                    ;! error: `SIZE` is already declared in this scope

lda = 5                     ;! error: `lda` is a mnemonic of the 6502 and cannot be used as a name
.segment CODE
.data x: .byte 0                 ;! error: `x` is a register name and cannot be used as a name

; An anonymous enum declares its members where it is written, so they are ordinary names.
.enum {
    y                       ;! error: `y` is a register name and cannot be used as a name
}

@stray:                     ;! error: `@stray` is a cheap local, which needs an enclosing `.proc` or `.scope`

.proc main {
    jsr missing             ;! error: `missing` is not declared
    lda #COUNT              ;! error: `COUNT` is not declared
    bne @nowhere            ;! error: `@nowhere` is not declared
@loop:
    rts
}

.proc main {                ;! error: `main` is already declared in this scope
    rts
}

; A name a letter or two from a declared one says which, so what the editor offers as a fix
; is what a build at the command line is told.
.proc spelling {
    COUNTER = 0
    ldx #COUNTER
    lda #COUNTR             ;! error: `COUNTR` is not declared; `COUNTER` is
@loop:
    dex
    bne @lop                ;! error: `@lop` is not declared; `@loop` is
    rts
}

.proc reach {
    lda ::@loop             ;! error: `@loop` is a cheap local and cannot be reached with `::`
    lda ::nothing           ;! error: no module `nothing` is in this build
    lda ::main::nothing     ;! error: `nothing` is not declared in module `main`
    lda SIZE::inner         ;! error: `SIZE` is a constant, not a scope
    lda main::inner         ;! error: `inner` is not declared in `main`
    rts
}
