; What is wrong with a name in another address space, where the code that names it can fix it.
.module main

.cpu 65816

.import spc_entry: abs in SPCIMAGE
.import lost: abs in NOWHERE            ;! error[segment-undeclared]: segment "NOWHERE" is not declared

.segment WHERE: abs, space = nowhere    ;! error[space-undeclared]: space `nowhere` is not declared
.segment TWICE: abs, space = spc, space = spc   ;! error[segment-attribute-twice]: segment "TWICE" already gives its `space`
.segment ODD: abs, space = 3            ;! error[space-not-a-name]: a segment's `space` is the name of an address space

.segment SPCIMAGE
.data image {
    .data main {
        .byte $6f
    }
}

; A space that holds data holds no instructions.
.proc on_spc: a8, i8 {
    nop                                 ;! error[code-in-a-data-space]: "SPCIMAGE" is in space `spc`, which holds data: another processor's code is written there as data and macro calls
    rts
}

.segment DRIVE
.proc drive_main: a8, i8 {
    rts
}

; The host may not go to another space's code, nor reach its memory.
.segment CODE
.proc host: a8, i8 {
    jsr spc_entry                       ;! error[transfer-to-another-space]: `jsr` goes to `spc_entry`, which is in "SPCIMAGE", in space `spc`, and this code is in the host's space: another processor runs it
    jsr drive_main                      ;! error[transfer-to-another-space]: `jsr` goes to `drive_main`, which is in "DRIVE", in space `drive`, and this code is in the host's space: another processor runs it
    lda image::main                     ;! error[operand-in-another-space]: `image::main` is in "SPCIMAGE", in space `spc`, and this code is in the host's space: here it is a value, for an immediate or for data
    lda #<.loadof(NOSEG)                ;! error[segment-undeclared]: segment "NOSEG" is not declared
    rts
}
