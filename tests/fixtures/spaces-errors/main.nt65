; What is wrong with a name in another address space, where the code that names it can fix it.
.module main

.cpu 65816

.import spc_entry: abs in SPCIMAGE
.import lost: abs in NOWHERE            ;! error[segment-undeclared]: segment `NOWHERE` is not declared

.segment WHERE: abs, space = nowhere    ;! error[space-undeclared]: space `nowhere` is not declared
.segment TWICE: abs, space = spc, space = spc   ;! error[segment-attribute-twice]: segment `TWICE` already has a `space`
.segment ODD: abs, space = 3            ;! error[space-not-a-name]: `space` takes the name of an address space

.segment SPCIMAGE
.data image {
    .data main {
        .byte $6f
    }
}

; A space that holds data holds no instructions.
.proc on_spc: a8, i8 {
    nop                                 ;! error[code-in-a-data-space]: segment `SPCIMAGE` is in data space `spc` and cannot hold this processor's code
    rts
}

.segment DRIVE
.proc drive_main: a8, i8 {
    rts
}

; The host may not go to another space's code, nor reach its memory.
.segment CODE
.proc host: a8, i8 {
    jsr spc_entry                       ;! error[transfer-to-another-space]: `spc_entry` is code for another processor, in space `spc`, so `jsr` cannot reach it
    jsr drive_main                      ;! error[transfer-to-another-space]: `drive_main` is code for another processor, in space `drive`, so `jsr` cannot reach it
    lda image::main                     ;! error[operand-in-another-space]: `image::main` is in segment `SPCIMAGE` of space `spc`, and this code runs in the host's space: here it can only be used as an immediate value or in data
    lda #<.loadof(NOSEG)                ;! error[segment-undeclared]: segment `NOSEG` is not declared
    rts
}
