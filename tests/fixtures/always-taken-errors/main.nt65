; What an always-taken branch refuses: a `.next` naming anything but the branch's own target.
; What follows the branch is then reached only by what else names it, so a label nothing else
; reaches is unreachable.
.module main

.cpu 6502

.export wrong_target, two_targets, unreached, end_path, computed, computed_unknown, elsewhere
.export offset_to_start, offset_to_label, offset_inside, offset_outside

.segment CODE
.proc wrong_target {
    lda #1
    bne @done
    .next elsewhere     ;! error[next-not-the-branch-target]: `.next` after `bne @done` can name only the branch's own target, `@done`, to state that the branch is always taken
@done:
    rts
}

.proc two_targets {
    lda #1
    bne @done
    .next @done, elsewhere  ;! error[next-not-the-branch-target]: `.next` after `bne @done` can name only the branch's own target, `@done`, to state that the branch is always taken
@done:
    rts
}

.proc unreached {
    lda #1
    bne @done
    .next @done
@never:                 ;! warning[label-unreachable]: `@never` is never reached: no code falls into it and nothing refers to it; if it is an entry point nt65 cannot see, add a `.state` after it, and otherwise remove it
    rts
@done:
    rts
}

; `.next ?` would give up the path where the branch is not taken as well, and a branch goes
; only to its operand or on, so neither way is unknown.
.proc end_path {
    lda #1
    bne @done
    .next ?                 ;! error[next-unknown-after-branch]: `.next ?` cannot follow `bne @done`, because it would also give up the path where the branch is not taken: if the branch is always taken, write `.next @done`, and otherwise remove the `.next`
@done:
    rts
}

; A branch to an address written as an expression needs the label there named instead, and
; `.next ?` cannot stand in for it.
.proc computed {
    lda #1
    bne computed_end-1      ;! error[computed-branch-unchecked]: `bne computed_end-1` branches to a computed address, which nt65 cannot follow: write the label it goes to as its operand
    rts
}
.proc computed_unknown {
    lda #1
    bne computed_end-1
    .next ?                 ;! error[next-unknown-after-branch]: `.next ?` cannot follow `bne computed_end-1`, because it would also give up the path where the branch is not taken: write the label the branch goes to as its operand
    .allow "code-unreachable", "the `.next ?` above is the error under test"
    rts
}
; A branch to an offset from itself, `*+n`, is placed against the routine's bytes. Landing on an
; instruction, it can name a label there instead; inside an instruction or outside the routine,
; there is no instruction start to name, and the message says why.
.proc offset_to_start {
    lda #1
    beq *+4                 ;! error[computed-branch-unchecked]: `beq *+4` branches to `*+4`, an offset from the branch rather than a label, which nt65 cannot follow: label the instruction it lands on, `rts`, and branch to the label
    lda #2
    rts
}
.proc offset_to_label {
    lda #1
    beq *+4                 ;! error[computed-branch-unchecked]: `beq *+4` branches to `*+4`, an offset from the branch rather than a label, which nt65 cannot follow: write `@done`, the label of the instruction it lands on, `rts`, as its operand
    lda #2
@done:
    rts
}
.proc offset_inside {
    lda #1
    beq *+3                 ;! error[computed-branch-unchecked]: `beq *+3` branches to `*+3`, an offset from the branch rather than a label, which nt65 cannot follow: it lands 1 byte into `lda #2`, where no instruction starts, so name that position with a `.label` and branch to it
    lda #2
    rts
}
.proc offset_outside {
    lda #1
    beq *-4                 ;! error[computed-branch-unchecked]: `beq *-4` branches to `*-4`, an offset from the branch rather than a label, which nt65 cannot follow: it lands outside `offset_outside`, so write the label of the code there as its operand
    rts
}

.proc computed_end {
    rts
}

.proc elsewhere {
    rts
}
