; What is wrong with signature sets, routines that never return, interrupt handlers, mirrors
; and arguments, each where it can be fixed.
.module main

.cpu 65816

.export late, wrong, stop, crowded, late_never, doubly, handler, closed, calls, tail, takes, short, pointed
.export near_std, far_jump, wrong_mirror, far_near, reads

LIMIT = 3

; A routine with no body declares what calls through it are checked against, and has nothing
; else to say it.
.proc TOOLBOX = $E10000         ;! error[signature-missing]: `TOOLBOX` is an extern proc with no processor-state signature: nt65 cannot see its body, so declare what it expects and leaves, or `?` if that is unknown
.import blind: proc()           ;! error[signature-missing]: `blind` is an imported routine with no processor-state signature: nt65 cannot see its body, so declare what it expects and leaves, or `?` if that is unknown

; One that names another routine and writes nothing takes that routine's, which is a declaration.
.proc also_stop = stop

; A set is declared once and checked there.
.signature std = a8, i16, dp = 0
.signature a8 = i16             ;! error[signature-set-name-is-an-item]: `a8` is a signature item, and cannot name a signature set
.signature loop = again         ;! error[signature-set-self-reference]: signature set `loop` names `again`, which leads back to `loop`: a set cannot include itself
.signature again = loop         ;! error[signature-set-self-reference]: signature set `again` names `loop`, which leads back to `again`: a set cannot include itself
.signature noisy = interrupt, a8 ;! error[handler-assumes-state]: `a8`: an interrupt handler can be entered at any instruction, so its signature can give only the mode: `interrupt, native` or `interrupt, emu`

; A set comes first in its list, and names a set.
.segment CODE0
.proc late: a8, std {           ;! error[signature-set-not-first]: signature set `std` must come first in its list: the items after it change what it gives
    rts
}

.proc wrong: LIMIT {            ;! error[signature-set-not-a-set]: `LIMIT` is a constant, not a signature set: a bare name among a signature's items has to name a `.signature` set
    rts
}

; A routine that never returns does not return, and has no exit state.
.proc stop: std, noreturn {
    rts                         ;! error[noreturn-returns]: `stop` is declared `noreturn`, but `rts` returns from it
}

.proc crowded: a8, noreturn -> a16 { ;! error[noreturn-declares-an-exit]: a `noreturn` routine never returns, so it cannot declare a state after `->`
    stp
}

.proc late_never: a8 -> noreturn { ;! error[item-belongs-at-entry]: `noreturn` describes how a routine is called, entered or left, and belongs before `->`
    rts
}

.proc doubly: interrupt, native, noreturn { ;! error[handler-noreturn]: `noreturn` does not apply to an interrupt handler, which leaves with `rti` and has no caller to return to
    rti
}

; An interrupt handler leaves by `rti`, declares no exit, and is never called.
.proc handler: interrupt, native {
    rts                         ;! error[handler-returns-not-rti]: `handler` is an interrupt handler and must return with `rti`, not `rts`
}

.proc closed: interrupt -> a8 { ;! error[handler-declares-an-exit]: an interrupt handler cannot declare a state after `->`: it leaves with `rti`, which restores the interrupted state
    rti
}

.proc calls: std {
    jsr handler                 ;! error[handler-called]: `handler` is an interrupt handler and cannot be called: it returns with `rti`, which would not return to the caller
    .state std                  ;! error[state-item-not-a-point]: `std` describes a whole routine, not one point in it: put it in the routine's signature, not in `.state`
    rts
}

.proc tail: std {
    jmp handler                 ;! error[tail-call-to-handler]: `jmp handler` is a tail call into interrupt handler `handler`, whose `rti` would not return to this routine's caller: only a `noreturn` routine or another interrupt handler may jump to one
}

.macro entered(): interrupt {   ;! error[macro-distance]: `interrupt` does not apply to a macro: it describes how a routine is called, and a macro is expanded in place
    nop
}

; The caller pushes what `args` counts.
.proc takes: std, a16, args 4 {
    rts
}

.proc short: std, a16 {
    pea 1
    jsr takes                   ;! error[args-not-pushed]: `takes` declares `args 4`, bytes the caller pushes before the call, but only 2 bytes are pushed here
    pla
    rts
}

.proc pointed: std, args LIMIT + counter { ;! error[args-not-constant]: `args LIMIT + counter` needs a constant: the byte count has to be known while nt65 builds
    rts
}

.proc near_std: std {
    rts
}

; A long jump to a near routine enters another bank, which only a routine nothing returns
; to may do; and a routine's address in a bank is in its home bank or a mirror.
.segment STUBS
.proc far_jump: std {
    jml near_std                ;! error[jump-across-banks]: `near_std` is near and in another bank: after this `jml` its `rts` would return inside its own bank, not to `far_jump`'s caller
}

.proc wrong_mirror: std, noreturn {
    jml ($81 << 16) | .loword(near_std) ;! error[mirror-bank-mismatch]: `near_std` is in segment "CODE0", in bank $80 and mirrored in banks $00-$3f, but this reaches it through bank $81
}

.segment CODE0
.proc far_near: std, noreturn {
    jml near_std                ;! error[jump-distance-mismatch]: `near_std` is near: jump to it with `jmp near_std`
}

; Data in a mirrored segment is reached from its home bank and its mirrors only.
.segment LORAM
.data counter: .word

.segment CODE0
.proc reads: a8, dbr = $c0 {
    lda counter                 ;! error[bank-mismatch]: `counter` is in segment "LORAM", which is in bank $7e and mirrored in banks $00-$3f, $80-$bf, but B is $c0 here
    rts
}

; A mirror is a bank, or a range from the lower to the higher.
.segment SRAM: abs, bank = $70, mirrors = [$7d..$71] ;! error[segment-mirror-invalid]: each mirror must be a constant bank, or a range of banks given lower first, such as `$00..$3f`
