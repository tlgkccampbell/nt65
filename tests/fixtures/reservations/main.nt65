; What the output does with room it reserves and with runs of one repeated byte. ca65
; reserves at most $ffff bytes in one `.res`, and that limit should not decide which
; declarations a program may write, so a bigger one is written as several directives.
.module main

.segment RODATA

; More than one `.res` holds: 65,535 bytes and then the rest.
.data big: .byte[$12000]

; A run of one repeated byte becomes the `.res` that says the same thing. Each of these lines
; alone would be written as its byte with the character it came from in a comment beside it,
; and the `.res` carries that comment too.
.data marks: .byte[] {
    'x'
    'x'
    'x'
    'x'
}

.export big, marks
