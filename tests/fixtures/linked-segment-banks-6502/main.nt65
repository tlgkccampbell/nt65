; An `.addr` and an absolute operand hold the address within its bank on the 6502, as they do
; on the 65816. ca65 range-checks both on the 6502, so one that names a label the linked config
; places past $ffff is written inside `.loword()`, which gives ca65 the address within the bank.
; ca65 range-checks the pointer of an indirect jump on every CPU, so it is written the same way.
; So is the byte after an operand given whole to a macro, where the body offsets it.
.module main

.export start, pointers, dispatch, given

.macro step(source: operand) {
    lda source+1
}

.segment BANK1
.data table:  .byte 1, 2, 3
.data vector: .addr far_side

.proc far_side {
    jsr far_helper                          ; a call within bank $01
    rts
}

.proc far_helper {
    rts
}

.segment RODATA
.data pointers {
    .addr table                             ; $8000 in bank $01
    .addr table + 2
    .addr start                             ; placed below $10000, so written as it stands
    .word table - $10000                    ; $8000 to $ffff
}

.segment CODE
.proc start {
    ldx #2
    lda table,x                             ; the bank $01 cartridge window
    sta table + 1
    lda pointers
    rts
}

.proc dispatch {
    jmp (vector)                            ; a pointer in the bank $01 cartridge window
    .next ?
}

.proc given {
    ldx #0
    step!(table)                            ; the byte after a label in bank $01
    step!({table,x})
    rts
}
