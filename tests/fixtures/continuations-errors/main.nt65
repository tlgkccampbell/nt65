; Only an expression's brackets, a macro call's arguments and a list of parameters may hold a
; line break. An operand's parentheses stay on one line, in an instruction and in a braced
; argument alike.
.module main

.cpu 6502

.macro pair(first, second) {
    .byte first, second             ;! error[value-too-wide]: $012c does not fit in this directive
}

.macro load(source: operand) {
    lda source
}

; A list of parameters continues too, but a line there that starts like a label with no kind
; after it still starts a statement of its own.
.macro twice(first,                 ;! error[expected-name]: expected a parameter name
loop:                               ;! error[label-outside-a-routine]: `loop` is a label outside a `.proc`: labels mark positions in code, and data is named by a declaration, `.data loop: ...`

.segment ZEROPAGE
.data ptr: .word

.segment CODE
.export .proc main {
    lda (ptr                        ;! error[continuation-outside-expression]: a line continues onto the next only inside an expression's brackets, a macro call's arguments or a list of parameters
    ),y
    load!({(ptr                     ;! error[continuation-outside-expression]: a line continues onto the next only inside an expression's brackets, a macro call's arguments or a list of parameters
    ),y})
    rts
    .next ?
    pair!(1,                        ; a value too wide, reported in the body
        300)
    pair!(5,                        ;! error[expected-expression]: expected an expression
    .byte 6
    .byte (3                        ;! error[expected-parenthesis]: expected `)`
    .byte 4
    .next ?
}
