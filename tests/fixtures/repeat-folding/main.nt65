; nt65 unrolls a repetition, then writes it back out as one ca65 `.repeat` where every
; iteration came out the same. nt65 makes every per-iteration decision itself, so the test is
; made on the lines each iteration produced and never on the source: what the iterations
; produced decides whether ca65 can repeat them rather than be given them one at a time.
; Where iterations differ only in the binding's value, the body is written once with a ca65
; counter in its place, but only after checking that putting each iteration's number back
; gives exactly the line that iteration produced.
.module main

.cpu 65816

.export shift, spaced, widths_alike, widths_differ, nested, twice, per_turn_label
.export branching, padding, over_a_list, over_an_enum
.export ramp, grid, edge, chosen, crossing, low_bytes, waits

.segment ZP: zp

.segment ZP
.data slot: .byte

.segment BSS
.data count: .word
.data other: .word

.enum Cmd {
    move
    fire
    wait
}

.list targets {
    slot, count, other
}

; The case this exists for: one instruction said over and over, which ca65 says with its
; own `.repeat` exactly as nt65 means it.
.segment CODE
.proc shift: a16, i16 {
    lda count
    .repeat 5 {
        asl a
    }
    sta count
    rts
}

; A blank line in the source is written before the repetition rather than inside it, so the
; body holds only the iteration.
.proc spaced: a16, i16 {
    lda count

    .repeat 4 {
        asl a
        clc
    }
    rts
}

; Both widths change on every turn, so every turn writes both directives and the turns
; are alike: the directives go inside the `.repeat`, where ca65 runs them once a turn.
.proc widths_alike: a16, i16 {
    .repeat 3 {
        lda #$1234
        sep #$20
        lda #$12
        rep #$20
    }
    rts
}

; Only the first iteration writes the `.a16` directive, because later ones find it already
; written, so the iterations differ and every one of them is written out.
.proc widths_differ: a8, i16 {
    rep #$20
    .repeat 3 {
        lda #$1234
        sta count
    }
    sep #$20
    rts
}

; Folding composes: the inner repetition folds first, and the outer one then sees three
; turns that are alike.
.proc nested: a16, i16 {
    .repeat 3 {
        .repeat 4 {
            asl a
        }
        clc
    }
    rts
}

; Two turns read no better as a `.repeat` than as themselves, so they stay as they are.
.proc twice: a16, i16 {
    .repeat 2 {
        asl a
    }
    rts
}

; A name a body declares is the turn's own, and ca65 has no way to say that: the turns are
; written out in full, each with the name it declared.
.proc per_turn_label: a16, i8 {
    .repeat 3 {
    @spin:
        dex
        bne @spin
    }
    rts
}

; A branch out of the body reaches further on every turn, which is a distance ca65 works
; out for itself; what nt65 decided is the form, and that came out the same every time.
.proc branching: a16, i8 {
    .repeat 6 {
        dex
        bne @out
    }
@out:
    rts
}

; A row of one repeated byte is a fill, and `.res` already says a fill: the repetition
; stays gathered rather than becoming a `.repeat` around one `.byte`.
.segment RODATA
.data padding: .byte[8] {
    .repeat 8 {
        $ff
    }
}

; An `.each` walks a list or an enum, and what a turn is worth decides the line: these
; are always written out a turn at a time.
.data over_a_list: .addr[] {
    .each targets, t {
        t
    }
}

.data over_an_enum: .byte[] {
    .each Cmd, c {
        c
    }
}

; The showcase: 256 iterations, each its own line when unrolled, become three lines of
; output. ca65's counter starts at zero, as the binding did.
.data ramp: .byte[] {
    .repeat 256, i {
        i
    }
}

; A counter each, and the one inside is written the same way on every turn of the one
; around it, so the outer repetition sees three turns that are alike.
.data grid: .byte[] {
    .repeat 3, row {
        .repeat 4, col {
            (row * 4) + col
        }
    }
}

; The arithmetic is ca65's to do once the counter is in it, so it is done in the 32 bits
; ca65 has: this is the last turn that fits, and nt65 has already checked every one of them.
.data edge: .dword[] {
    .repeat 4, i {
        $7ffffffc + i
    }
}

; A condition on the binding is answered on each turn, and these turns were answered
; differently, so what each came out as is what is written.
.data chosen: .byte[] {
    .repeat 4, i {
        .if i < 2 {
            $11
        } .else {
            $22
        }
    }
}

; Each iteration takes one branch of the chain, so both branches may declare `@wait`, and each
; branch's `bne` waits on its own.
.proc waits: a8, i8 {
    .repeat 2, i {
        .if i == 0 {
            ldx #1
        @wait:
            dex
            bne @wait
        } .else {
            ldy #1
        @wait:
            dey
            bne @wait
        }
    }
    rts
}

; A byte of an address only the linker knows is no fill ca65 can take, so equal lines of one are
; written as they are.
.data low_bytes: .byte[] {
    .repeat 3 {
        <crossing
    }
}

; The third turn reaches past the zero page, so it is a different instruction from the two
; before it: no one line stands for all three.
.segment CODE
.proc crossing: a8, i8 {
    .repeat 3, i {
        lda $fe + i
    }
    rts
}
