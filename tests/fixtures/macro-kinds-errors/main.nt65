; What is wrong with a refined parameter kind, at the call that gives the argument or at the
; header that declares the kind.
.module main

.cpu 6502

.enum Instrument {
    kick
    snare
}

.macro volume(lvol: const(0..15)) {
    .byte lvol
}

.macro play(what: Instrument) {
    .byte what
}

.macro load(src: operand(imm, zp, abs, absx)) {
    lda src
}

.macro high(p: operand) {
    lda p + 1
}

.macro direct(at: operand(zp)) {
    lda at
}

; The header: a range is two constants, the lower first; a name is an enum; a mode is one
; an operand can be in.
.macro backwards(n: const(9..1)) {    ;! error[parameter-range-invalid]: `const(9..1)` is not a range: a `const` range is two constants, the lower first
    .byte n
}

.macro typed(n: SPEED) {    ;! error[parameter-kind-not-an-enum]: `SPEED` is a constant, not a parameter kind: use a kind word or an enum
    .byte n
}

.macro spc(p: operand(dp)) {    ;! error[operand-mode-unknown]: `dp` is not an addressing mode: use one of `imm`, `acc`, `abs`, `absx`, `absy`, `zp`, `zpx`, `zpy`, `ind`, `indx`, `indy`, `sr`, `sry`, `long`, `longy`
    lda p
}

; A condition that compares a parameter with a word the parameter can never be is warned about.
; `.mode` reports a `zp` operand as `abs`, so comparing with `abs` can hold.
.macro pick(src: operand(imm, zp), reg: one(x, y), regs: list(one(a, x))) {
    .if .mode(src) == imm {
        nop
    } .elseif .mode(src) == abs {
        nop
    } .elseif .mode(src) == imx {       ;! warning[comparison-never-holds]: `.mode(src)` is never `imx`, so this comparison never holds: `.mode` gives one of `imm`, `acc`, `abs`, `absx`, `absy`, `ind`, `indx`, `indy`, `sr`, `sry`, `long`, `longy`
        nop
    } .elseif .mode(src) == absx {      ;! warning[comparison-never-holds]: `.mode(src)` is never `absx`, so this comparison never holds: `src` takes only `imm` or `abs`
        nop
    }
    .if reg != z {                      ;! warning[comparison-never-holds]: `reg` is never `z`, so this comparison always holds: `reg` is one of `x`, `y`
        nop
    }
    .each regs, r {
        .if r == y {                    ;! warning[comparison-never-holds]: `r` is never `y`, so this comparison never holds: `r` is one of `a`, `x`
            nop
        }
    }
}

; An `operand` parameter stands as a whole operand, so the body may not give it an index, a
; prefix, parentheses or `#`, nor pass it on that way in braces. The line is wrong whatever a call
; passes, so it is reported once, in the body, and no call adds to it.
.macro inner(source: operand) {
    lda source
}

.macro wrongly(source: operand) {
    lda source,x                ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
    lda source+1,y              ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
    lda .byteof(source, 1),x    ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
    lda (source),y              ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
    lda (source,x)              ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
    lda (source)                ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
    lda a:source                ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
    lda z:source                ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
    lda #source                 ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
}

.macro passes_wrongly(source: operand) {
    inner!({source,x})          ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
    inner!({source+1,x})        ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
    inner!({(source),y})        ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
    inner!({#source})           ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
    inner!({a:source})          ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
}

; A bit branch is the 65C02's, so this macro is not called here; the body is checked all the same.
.macro branch_on_bit(source: operand) {
    bbr0 source, copy           ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
    bbr0 copy, source           ;! error[operand-parameter-not-whole]: `source` is an `operand` parameter, which stands as a whole operand and takes no index, prefix, parentheses or immediate of its own
}

.const SPEED = 3

.segment ZEROPAGE
.data ptr: .word

.segment BSS
.data buffer: .byte[4]

.segment RODATA
.data tune {
    volume!(16)             ;! error[const-argument-out-of-range]: `lvol` takes a constant from 0 to 15, and this is 16
    volume!(buffer)         ;! error[const-argument-out-of-range]: `lvol` takes a constant from 0 to 15, and this is not a constant
    play!(1)                ;! error[enum-argument-not-a-member]: `what` takes a member of `Instrument`, and `1` is not one
    play!(tom)              ;! error[enum-argument-not-a-member]: `what` takes a member of `Instrument`, and `tom` is not one
    play!(SPEED)            ;! error[enum-argument-not-a-member]: `what` takes a member of `Instrument`, and `SPEED` is not one
}

.segment CODE
.proc copy {
    load!({(ptr),y})        ;! error[operand-argument-mode]: `src` takes one of `imm`, `zp`, `abs`, `absx`, and this is `indy`
    direct!(buffer)         ;! error[operand-argument-mode]: `at` takes `zp`, and this is `abs`
    direct!({ptr,x})        ;! error[operand-argument-mode]: `at` takes `zp`, and this is `zpx`
    high!({(ptr),y})        ;! error[operand-has-no-next-byte]: `p + 1` in the macro needs a plain address, and this call gives `p` an indirect operand
    high!({#5})             ;! error[operand-has-no-next-byte]: `p + 1` in the macro needs a plain address, and this call gives `p` an immediate operand
    wrongly!(ptr)
    wrongly!({buffer,y})
    passes_wrongly!(ptr)
    passes_wrongly!({#5})
    rts
}
