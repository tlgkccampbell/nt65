; Labels, constants, macros and types that nothing names. What a file exports is used by
; the files that import it, and what a branch this build leaves out names is used by the
; build that takes it.
.module main

.cpu 65816

; A name brought in and never written is reported on the item that brought it, and one of
; several in braces is the one reported.
.use other::{work, SPARE}       ;! warning[unused-use-item]: `SPARE` is brought in and nothing names it: the `.use` item may go

LIMIT = 10                      ;! warning[unused-symbol]: `LIMIT` is never used: nothing names it, and it is not exported
WIDTH = 40
.export WIDTH

.if 0 {
    lda #DEPTH
}
DEPTH = 3

.macro twice(value) {           ;! warning[unused-symbol]: `twice` is never used: nothing names it, and it is not exported
    lda #value
}

.struct Pair {                  ;! warning[unused-symbol]: `Pair` is never used: nothing names it, and it is not exported
    first:  .byte
    second: .byte
}

; A member of a named enum is one of a set, and is not reported on its own.
.enum Mode {
    idle
    busy
}

.segment CODE
.export .proc main: a8, i8 {
    jsr work
    lda #Mode::busy
@unnamed:                       ;! warning[unused-symbol]: `@unnamed` is never used: nothing names it, and it is not exported
    ldx #0
    rts
    ; Never reached is said once, and says more.
@dead:                          ;! warning[label-unreachable]: `@dead` is never reached: nothing runs into it and nothing names it
    rts
    ; An entry point nt65 cannot see the callers of declares its state, and is not reported.
@hook:
    .state native, a8, i8
    rts
}

.segment RODATA
.data table: .byte[3]                ;! warning[unused-symbol]: `table` is never used: nothing names it, and it is not exported

; A routine is reported like anything else: nothing calls it, jumps to it or names it, and it
; is not exported, so nothing can reach it.
.segment CODE
.proc left_behind: a8, i8 {     ;! warning[unused-symbol]: `left_behind` is never used: nothing names it, and it is not exported
    rts
}

; A routine named as data is used: the table is what reaches it.
.proc dispatched: a8, i8 {
    rts
}

; The processor reaches a handler through a vector, which this program need not even hold, so
; an `interrupt` signature is what says the routine is entered from outside.
.proc nmi: interrupt {
    rti
}

.segment RODATA
.export .data vectors: .addr[1] { dispatched }

; Fall-through never enters a nested segment block, so code at its start with no label is
; somewhere nothing goes.
.segment CODE
.proc detour: a8, i8 {
    .segment RODATA {
        nop                     ;! warning[code-unreachable]: this code is never reached: fall-through does not enter a nested segment block, so code there starts at a label a `.next` names or a `.state` declares
        rts
    }
    rts
}
.export detour
