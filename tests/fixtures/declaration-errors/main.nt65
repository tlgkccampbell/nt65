; What a data declaration refuses, and what belongs in a declaration or a routine instead.
.module main

.cpu 6502

.struct Point {
    x: .byte
    y: .byte
}

.struct Palette {
    colors: .word[3]
    tiles:  .byte[]             ;! error[member-count-not-a-number]: `tiles` needs an element count: use `.byte[n]`
}

.segment RODATA
; An array's count must equal the number of values given, whether there are too few or too many.
.data short: .byte[4] { 1, 2, 3 }       ;! error[element-count-mismatch]: this array is declared with 4 elements, but 3 given
.data long:  .addr[2] {                  ;! error[element-count-mismatch]: this array is declared with 2 elements, but 3 given
    0, 0, 0
}
.data none:    .word[]                     ;! error[element-count-empty]: `[]` takes its count from the values given, and there are none: use `.word[n]` to reserve n elements
.data padding: .res 4                   ;! error[res-not-a-declaration]: a named declaration cannot use `.res`: declare it with a type such as `.byte[n]`, which fills with zeros where no values are given

; An element is a value, or a record for an array of records.
.data records: .type Point[] {
    { x = 1 }, 5                        ;! error[element-not-a-record]: each element of a `Point` array is a record, given as `{ member = value }`
}
.data bytes: .byte[] {
    1, { x = 1 }                        ;! error[element-not-a-value]: a `.byte` element is a single value, not a braced record or list
}
.data short_list: .type Palette { colors = { 1, 2 } }  ;! error[member-count-mismatch]: `colors` holds 3 elements, and this list gives 2
.data not_a_list: .type Palette { colors = 1 }         ;! error[member-needs-a-list]: `colors` is an array, which takes a braced list: `colors = { … }`

; Mixed data holds data, and names its members with `.data`.
.data mixed {
    .byte 1
    stray: .byte 2                      ;! error[label-in-data]: `stray` is a label in `.data`: a named member is `.data stray: ...`, and a position is `@stray:`
    lda #1                              ;! error[instruction-in-data]: an instruction belongs in a `.proc`, not in a `.data` declaration
}

; Outside a routine, bytes belong to a declaration and code to a routine.
.byte 3                             ;! error[padding-outside-a-routine]: `.byte` outside a `.proc` must be part of a `.data` declaration: `.data name: .byte ...`
label: .word 4                          ;! error[label-outside-a-routine]: `label` is a label outside a `.proc`: labels mark positions in code, and data is named by a declaration, `.data label: ...`
rts                                 ;! error[instruction-outside-a-routine]: an instruction belongs in a `.proc`: nt65 follows and checks code only inside routines
.res 2                              ; padding is fine

.segment CODE
.proc main {
@here:
    lda #.sizeof(@here)                 ;! error[not-measurable]: `@here` is a label, which is only a position: `.sizeof` measures a `.data` declaration, a routine or a type
    lda #.countof(mixed)                ;! error[countof-has-no-elements]: `mixed` is mixed data, which has bytes and no elements: `.sizeof(mixed)` is how many bytes it takes
    jmp (bytes)
    .next bytes                         ;! error[next-target-not-a-table]: `bytes` is not a table of addresses: `.next` can name data only when it is declared with `.addr` or `.faraddr`
}

; A `.segment NAME` region belongs at file level; inside a block, a segment is braced.
.scope place {
    .segment BSS                        ;! error[segment-region-misplaced]: a `.segment NAME` region belongs at file level, outside every block: inside one, `.segment NAME { }` places what it holds
}

; A 16-bit width cannot hold where the registers are eight bits, wherever it is written. The
; items about registers the 6502 does not have are inert instead, so a module shared with a
; 65816 program still builds here.
.signature wide = a16                   ;! error[signature-item-needs-65816]: `a16` describes 65816 state, which the 6502 does not have
.proc sixteen: i16 {                    ;! error[signature-item-needs-65816]: `i16` describes 65816 state, which the 6502 does not have
    .state a16                          ;! error[signature-item-needs-65816]: `a16` describes 65816 state, which the 6502 does not have
    .ensure i16                         ;! error[signature-item-needs-65816]: `i16` describes 65816 state, which the 6502 does not have
    rts
}

.proc inert: native, dp = 0, dbr = $80 {
    rts
}

; The same check applies to a routine with no body, an imported routine and a macro.
.proc WIDE = $FFD2: a16                 ;! error[signature-item-needs-65816]: `a16` describes 65816 state, which the 6502 does not have
.import wider: proc(i16)                ;! error[signature-item-needs-65816]: `i16` describes 65816 state, which the 6502 does not have

.macro widen(): a16 {                   ;! error[signature-item-needs-65816]: `a16` describes 65816 state, which the 6502 does not have
    nop
}
