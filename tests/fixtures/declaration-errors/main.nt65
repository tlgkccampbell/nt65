; What a data declaration refuses, and what belongs in a declaration or a routine instead.
.module main

.cpu 6502

.struct Point {
    x: .byte
    y: .byte
}

.struct Palette {
    colors: .word[3]
    tiles:  .byte[]             ;! error[member-count-not-a-number]: `tiles` is a member, whose count is a number: `.byte[n]`
}

.segment RODATA
; A count is exactly what the values come to, one way or the other.
.data short: .byte[4] { 1, 2, 3 }       ;! error[element-count-mismatch]: this array holds 4 elements, and its values come to 3
.data long:  .addr[2] {                  ;! error[element-count-mismatch]: this array holds 2 elements, and its values come to 3
    0, 0, 0
}
.data none:    .word[]                     ;! error[element-count-empty]: `[]` counts the values given, and there are none: `.word[n]` holds n
.data padding: .res 4                   ;! error[res-not-a-declaration]: `.res` is only padding: data is declared with its type, `.byte[n]`, and holds zeros where it gives no values

; An element is a value, or a record for an array of records.
.data records: .type Point[] {
    { x = 1 }, 5                        ;! error[element-not-a-record]: each element of a `Point` array is a record, written `{ member = value }`
}
.data bytes: .byte[] {
    1, { x = 1 }                        ;! error[element-not-a-value]: a `.byte` element is one value, and braces hold a record or a list
}
.data short_list: .type Palette { colors = { 1, 2 } }  ;! error[member-count-mismatch]: `colors` holds 3 elements, and this list gives 2
.data not_a_list: .type Palette { colors = 1 }         ;! error[member-needs-a-list]: `colors` is an array, which takes a braced list: `colors = { … }`

; Mixed data holds data, and names its members with `.data`.
.data mixed {
    .byte 1
    stray: .byte 2                      ;! error[label-in-data]: `stray` is a label in `.data`: a named member is `.data stray: ...`, and a position is `@stray:`
    lda #1                              ;! error[instruction-in-data]: an instruction belongs in a `.proc`, and `.data` holds only data
}

; Outside a routine, bytes belong to a declaration and code to a routine.
.byte 3                             ;! error[padding-outside-a-routine]: `.byte` outside a `.proc` belongs to a `.data` declaration: `.data name: .byte ...`
label: .word 4                          ;! error[label-outside-a-routine]: `label` is a label outside a `.proc`: a label is only a position in code, and data is named by a declaration, `.data label: ...`
rts                                 ;! error[instruction-outside-a-routine]: an instruction belongs in a `.proc`: code outside one is reached by nothing nt65 can follow
.res 2                              ; padding is fine

.segment CODE
.proc main {
@here:
    lda #.sizeof(@here)                 ;! error[not-measurable]: `@here` is a label, which is only a position: `.sizeof` measures a `.data` declaration, a routine or a type
    lda #.countof(mixed)                ;! error[countof-has-no-elements]: `mixed` is mixed data, which has bytes and no elements: `.sizeof(mixed)` is how many bytes it takes
    jmp (bytes)
    .next bytes                         ;! error[next-target-not-a-table]: `bytes` is not a table of addresses: `.next` reads the labels a table declared as `.addr` or `.faraddr` holds
}

; A `.segment NAME` region belongs at file level; inside a block, a segment is braced.
.scope place {
    .segment BSS                        ;! error[segment-region-misplaced]: a `.segment NAME` region belongs at file level, outside every block: inside one, `.segment NAME { }` places what it holds
}

; A 16-bit width cannot hold where the registers are eight bits, wherever it is written. The
; items about registers the 6502 does not have are inert instead, so a module shared with a
; 65816 program still builds here.
.signature wide = a16                   ;! error[signature-item-needs-65816]: `a16` cannot hold on the 6502, whose registers are eight bits
.proc sixteen: i16 {                    ;! error[signature-item-needs-65816]: `i16` cannot hold on the 6502, whose registers are eight bits
    .state a16                          ;! error[signature-item-needs-65816]: `a16` cannot hold on the 6502, whose registers are eight bits
    .ensure i16                         ;! error[signature-item-needs-65816]: `i16` cannot hold on the 6502, whose registers are eight bits
    rts
}

.proc inert: native, dp = 0, dbr = $80 {
    rts
}

; A routine with no body and a macro are held to it too.
.proc WIDE = $FFD2: a16                 ;! error[signature-item-needs-65816]: `a16` cannot hold on the 6502, whose registers are eight bits
.import wider: proc(i16)                ;! error[signature-item-needs-65816]: `i16` cannot hold on the 6502, whose registers are eight bits

.macro widen(): a16 {                   ;! error[signature-item-needs-65816]: `a16` cannot hold on the 6502, whose registers are eight bits
    nop
}
