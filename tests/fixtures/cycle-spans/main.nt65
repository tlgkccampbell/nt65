; `.mincycles` and `.maxcycles` give the cost in cycles of a pass from one position to another.
; A pass follows the code as it runs, so a branch may go either way and a jump goes to its
; target. `.mincycles` is the cheapest pass that arrives at the end, and `.maxcycles` the most
; expensive. Where every count is exact and there is one way through, both answers are the same.
.module main

.cpu 6502

.segment ZEROPAGE
.data color:  .byte
.data next:   .byte
.data vector: .word

.segment CODE

; A raster routine, whose whole point is that the line takes exactly as long as the beam does.
; Every instruction here is exact, so the two answers are one number and the assertion says it.
.export .proc raster {
    top:
    lda color
    sta $d020
    lda next
    sta color
    nop
    nop
    bottom:
    rts
}

; The exact count is what a raster routine is written against, and the two answers agree.
.assert .mincycles(raster::top, raster::bottom) == 17, "the raster line moved"
.assert .maxcycles(raster::top, raster::bottom) == 17, "the raster line moved"

; A branch takes 2 cycles not taken and 3 taken, and one more when a taken branch crosses a
; page. Taken, this branch skips the `nop`, so the pass costs 3 + 3 = 6 cycles, or 7 across a
; page. Not taken, it costs 3 + 2 + 2 = 7.
.export .proc either {
    start:
    lda color
    beq done
    nop
    done:
    rts
}

.assert .mincycles(either::start, either::done) == 6, "the short way changed"
.assert .maxcycles(either::start, either::done) == 7, "the long way changed"

; A jump goes to its target, so the instructions it skips are no part of the pass. Nothing else
; runs them, so nt65 warns that they are never reached.
.export .proc skipping {
    start:
    jmp over
    nop     ;! warning[code-unreachable]: this code is never reached: the statement above does not fall through, and nothing branches or jumps here
    nop
    nop
    over:
    rts
}

.assert .mincycles(skipping::start, skipping::over) == 3, "the jump changed"
.assert .maxcycles(skipping::start, skipping::over) == 3, "the jump changed"

; Two paths that cost the same are how a raster routine stays exact across a branch. Each way
; costs 13 cycles, and the taken branch costs one more where it crosses a page.
.export .proc balanced {
    start:
    lda color
    bmi high
    lda #1
    jmp join
    high:
    lda #2
    nop
    join:
    sta next
    finish:
    rts
}

.assert .mincycles(balanced::start, balanced::finish) == 13, "the balanced branch moved"
.assert .maxcycles(balanced::start, balanced::finish) == 14, "the balanced branch moved"

; A path that returns before it arrives at the end is not a pass, and costs nothing here, so the
; call on that path does not matter either. Only the taken branch arrives, at 3 + 3 + 2 = 8
; cycles, or 9 across a page.
.export .proc guarded {
    start:
    lda color
    bne busy
    jsr raster
    rts
    busy:
    nop
    done:
    rts
}

.assert .mincycles(guarded::start, guarded::done) == 8, "the guard changed"
.assert .maxcycles(guarded::start, guarded::done) == 9, "the guard changed"

; A branch past the end leaves the span and never arrives, so only the way that falls through
; is a pass, at 3 + 2 + 2 = 7 cycles.
.export .proc leaving {
    start:
    lda color
    beq past
    nop
    done:
    nop
    past:
    rts
}

.assert .mincycles(leaving::start, leaving::done) == 7, "the way through changed"
.assert .maxcycles(leaving::start, leaving::done) == 7, "the way through changed"

; A routine's own name is its first position, which is what a span from the top is written as.
.export .proc whole {
    nop
    nop
    end:
    rts
}

.assert .mincycles(whole, whole::end) == 4, "the routine's top moved"

; A `.next` under a jump says where it goes, in place of an operand nt65 cannot follow. The
; pass runs 3 cycles of `lda` and 5 of `jmp (vector)` to arrive at 8.
.export .proc vectored {
    start:
    lda color
    jmp (vector)
    .next done
    done:
    rts
}

.assert .mincycles(vectored::start, vectored::done) == 8, "the vectored jump changed"
.assert .maxcycles(vectored::start, vectored::done) == 8, "the vectored jump changed"

; A `.next .return` ends the path, as a return does, so the jump through the vector is not part
; of any pass. Only the taken branch arrives, at 3 + 3 = 6 cycles, or 7 across a page.
.export .proc handing {
    start:
    lda color
    bne done
    jmp (vector)
    .next .return
    done:
    rts
}

.assert .mincycles(handing::start, handing::done) == 6, "the hand-off changed"
.assert .maxcycles(handing::start, handing::done) == 7, "the hand-off changed"

; Control leaves data only where its `.next` says. This byte runs as `rts`, and its `.next
; .return` says so, so the path through it returns before it arrives and costs nothing here.
; Only the taken branch arrives, at 3 + 3 = 6 cycles, or 7 across a page.
.export .proc returning {
    start:
    lda color
    bne done
    .byte $60
    .next .return
    done:
    rts
}

.assert .mincycles(returning::start, returning::done) == 6, "the early return changed"
.assert .maxcycles(returning::start, returning::done) == 7, "the early return changed"

; A count is a number like any other, so it can be written into data the program reads.
.segment RODATA
.export .data budget: .byte .maxcycles(raster::top, raster::bottom)
