; Fill four pages of screen memory with spaces, forever.
.cpu 6502

.zeropage {
ptr:        .res 2          ; destination pointer
frame:      .res 1
}

SCREEN       = $0400
SCREEN_PAGES = 4

.export fill_page

; Fill 256 bytes at (ptr) with A.
.proc fill_page {
    ldy #0
@loop:
    sta (ptr),y
    iny
    bne @loop
    rts
}

; §13 writes the first four lines of `main` as the call `set16!(ptr, SCREEN)`. Macros
; arrive with Stage 9, so until then the lines that call expands to are written out.
.proc main {
    lda #<SCREEN
    sta ptr
    lda #>SCREEN
    sta ptr+1
    ldx #SCREEN_PAGES
@page:
    lda #' '
    jsr fill_page
    inc ptr+1
    dex
    bne @page
    inc frame
    jmp main
}
