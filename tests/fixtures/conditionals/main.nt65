; Conditions test the build configuration and never the program, so every one of them is
; answered before a declaration is read. None of this reaches the output: what is written
; is the program this configuration asks for.

; The same name under two conditions. Only the branch the build takes declares anything.
.if PLATFORM == 1 {
LINES = 262
}
.if PLATFORM == 2 {
LINES = 312
}

; A chain takes the first branch that holds.
.if DEBUG {
TRACE = 1
} .elseif .defined(VERBOSE) {
TRACE = 2
} .else {
TRACE = 0
}

; The right operand is neither evaluated nor looked up once the left decides the result,
; so `VERBOSE` is a question rather than a name that is not declared.
.if .defined(VERBOSE) && VERBOSE > 3 {
    .error "this configuration is not supported"
}

; nt65 knows what these are worth whichever way the build goes, so neither reaches ca65.
    .assert LINES > 200, error, "a platform has more than 200 lines"
    .assert TRACE <= 2, error, "the trace level is 0, 1 or 2"

.proc main {
    ; A branch belongs to the scope around it: `@again` is `main`'s cheap local.
.if DEBUG {
@again:
    jsr trace
    bne @again
}
    lda #<LINES
    ldx #>LINES
    rts
}

; The CPU is configuration, like a define.
.proc trace {
.if .target(65c02) {
    phx
    plx
} .else {
    txa
    pha
    pla
    tax
}
    rts
}

; Where main lands is the linker's to say, so this one is written out for ld65.
    .assert main >= $0200, lderror, "main must be past the zero page"

; A repetition is unrolled by nt65, so none of it reaches ca65 either.
.list handlers {
    main, trace
}

.enum Cmd {
move
fire
wait
}

.rodata {
bits:
.repeat 8, i {
    .byte 1 << i
}

dispatch:
.each handlers, h {
    .addr h - 1                 ; an RTS dispatch table
}

commands:
.each Cmd, c {
    .byte c
}

grid:
.repeat 2, row {
.repeat 3, col {
    .byte row * 3 + col
}
}
}

; Indentation means nothing: an indented chain is answered exactly as one at the margin,
; at file level and in a proc.
    .if PLATFORM == 1 {
    COLUMNS = 40
    } .else {
    COLUMNS = 80
    }

.proc indented {
    .if DEBUG {
        lda #COLUMNS
    } .elseif PLATFORM == 1 {
        lda #1
    } .else {
        lda #2
    }
    rts
}
