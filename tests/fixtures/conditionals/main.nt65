; Conditions test the build configuration and never the program, so every one of them is
; answered before a declaration is read. None of this reaches the output: what is written
; is the program this configuration asks for.

; The same name under two conditions. Only the branch the build takes declares anything.
.module main

; The settings the build gives.
.const PLATFORM ?= 1
.const DEBUG    ?= 0
.const VERBOSE  ?= 0

.if PLATFORM == 1 {
    .const LINES = 262
}
.if PLATFORM == 2 {
    .const LINES = 312
}

; A chain takes the first branch that holds.
.if DEBUG {
    .const TRACE = 1
} .elseif VERBOSE {
    .const TRACE = 2
} .else {
    .const TRACE = 0
}

; The right operand is neither evaluated nor looked up once the left decides the result, so
; `NOWHERE` is not reported although nothing declares it.
.if 0 && NOWHERE > 3 {
    .error "this configuration is not supported"
}

; nt65 knows what these are worth whichever way the build goes, so neither reaches ca65.
.assert LINES > 200, "a platform has more than 200 lines"
.assert TRACE <= 2, "the trace level is 0, 1 or 2"

.segment CODE
.proc main {
    ; A branch belongs to the scope around it: `@again` is `main`'s cheap local.
    .if DEBUG {
    @again:
        jsr trace
        bne @again
    }
    ldy #.countof(Cmd)          ; an enum counts its members
    lda #<LINES
    ldx #>LINES
    rts
}

; The CPU is configuration, like a setting.
.proc trace {
    .if .target(65c02) {
        phx
        plx
    } .else {
        txa
        pha
        pla
        tax
    }
    rts
}

; Where main lands is decided by the linker, so this assertion is written out for ld65.
.assert main >= $0200, "main must be past the zero page"
.assert main != trace && main == main, "ca65 spells these operators its own way"

; nt65 unrolls a repetition one iteration at a time, and what the iterations produce decides
; whether the output can write them once, as a single ca65 `.repeat`.
.list handlers {
    main, trace
}

; A list's items may stand under an `.if` too, and only the branch the build takes adds to it.
; With `DEBUG`, `steps` is `main`, `trace` and `main`, and without it `main` four times.
.list steps {
    main
    .if DEBUG {
        trace
    } .else {
        main, main
    }
    main
}

; A member may stand under an `.if` in the enum, so one set of names varies by configuration
; where the names are listed. The condition tests the configuration, as every `.if` outside a
; turn does, and a member with no value of its own is still the one before it taken plus one:
; `wait` is 3 with `dump` and 2 without.
.enum Cmd {
    move
    fire
    .if DEBUG {
        dump
    }
    wait
}

.segment RODATA
.data bits: .byte[] {
    .repeat 8, i {
        1 << i
    }
}

.data dispatch: .addr[] {
    .each handlers, h {
        h - 1                   ; an RTS dispatch table
    }
}

.data step_table: .addr steps

.data commands: .byte[] {
    .each Cmd, c {
        c
    }
}

; Over an enum, a path that ends in the binding names the member with the same name, so the
; table stays in step with the enum: `actions::move`, then `actions::fire`, then `actions::wait`.
.data actions_table: .addr[] {
    .each Cmd, c {
        actions::c
    }
}

.data grid: .byte[] {
    .repeat 2, row {
        .repeat 3, col {
            row * 3 + col
        }
    }
}

; A chain at file level and a chain inside a proc are read the same way, and indentation
; means nothing in either.
.if PLATFORM == 1 {
    .const COLUMNS = 40
} .else {
    .const COLUMNS = 80
}

.segment CODE
.export .proc indented {
    .if DEBUG {
        lda #COLUMNS
    } .elseif PLATFORM == 1 {
        lda #1
    } .else {
        lda #2
    }
    rts
}

.scope actions {
    .proc move {
        rts
    }
    .proc fire {
        jmp move
    }
    .if DEBUG {
        .proc dump {
            rts
        }
    }
    .proc wait {
        rts
    }
}

; What a repetition declares is its own on every turn, as a macro expansion's is: each turn
; has its own `@delay`, and `skip` is a different label each time.
.export .proc slow {
    .repeat 3, i {
        ldx #i + 1
    @delay:
        dex
        bne @delay
        bcc skip
        nop
        skip:
    }
    rts
}

; The same path as an operand, called once for each member in the enum's order.
.export .proc run_all {
    .each Cmd, c {
        jsr actions::c
    }
    rts
}

; A struct, union or enum declared at file level, outside every block, has a shape the
; configuration decides when every member is sized from literals and settings, so a condition
; may measure it. `Rec` is 3 bytes in 2 members, and `Cell` is as big as `wide`, 3 bytes, in 4.
; A setting sizes `Frame::lines`, so `Frame` is 7 bytes with `PLATFORM` 2 and 5 with 1, and
; `Cmd` has 4 members with `DEBUG` and 3 without.
.struct Rec {
    kind:  .byte
    where: .word
}

.union Cell {
    whole: .word
    .struct {
        lo: .byte
        hi: .byte
    }
    wide: .long
}

.struct Frame {
    head:  .type Rec
    lines: .byte[PLATFORM * 2]
}

.if .sizeof(Rec) == 3 && .countof(Rec) == 2 && .sizeof(Cell) == 3 && .countof(Cell) == 4 {
    .const SHAPED = 1
} .else {
    .const SHAPED = 0
}
.if .sizeof(Frame) > 6 {
    .const FRAME_BYTES = 7
} .else {
    .const FRAME_BYTES = 5
}
.if .countof(Cmd) == 4 {
    .const COMMANDS = 4
} .else {
    .const COMMANDS = 3
}

; The binder measures the same shapes once the declarations are read, and agrees.
.assert .sizeof(Frame) == FRAME_BYTES && .countof(Cmd) == COMMANDS, "the conditions measured the shapes"

.segment RODATA
.data shapes: .byte SHAPED, FRAME_BYTES, COMMANDS

; Exported, so that what the file only declares counts as used.
.export bits, dispatch, commands, actions_table, grid, shapes
