; What the text and number slots refuse.
.module main

.cpu 65816

.const TEXT = "AB"

.charmap screen {
    'A'..'Z' = $01
    '@'      = $00
}

.segment RODATA
.data two:     .strz "A", "B"       ;! error[strz-not-text]: `.strz` takes one text: a string, a string constant, a call that returns text, or a charmap applied to one
.data number:  .strz 5              ;! error[strz-not-text]: `.strz` takes one text: a string, a string constant, a call that returns text, or a charmap applied to one
.data letter:  .strz 'A'            ;! error[strz-not-text]: `.strz` takes one text: a string, a string constant, a call that returns text, or a charmap applied to one
.data early:   .strz screen("A@B")  ;! error[strz-zero-in-text]: `screen` maps `@` to $00, which would end the text early: `.strz` writes the zero that ends it
.data zero:    .strz "A\x00B"       ;! error[strz-zero-in-text]: the text holds a zero, which would end it early: `.strz` writes the zero that ends it
.data short:   .strz "A\0B"         ;! error[strz-zero-in-text]: the text holds a zero, which would end it early: `.strz` writes the zero that ends it
.data bytes:   .byte 256, -129      ;! error[value-too-wide]: $0100 does not fit in this directive;! error[value-too-wide]: -129 does not fit in this directive
.data longs:   .long $1000000       ;! error[value-too-wide]: $01000000 does not fit in this directive
.data address: .addr -1             ;! error[address-negative]: an address cannot be negative, but this one is -1
.data far:     .faraddr -2          ;! error[address-negative]: an address cannot be negative, but this one is -2
.data joined:  .byte TEXT + 1       ;! error[operator-on-text]: `+` cannot be used on a string
.data old:     .asciiz "hi"         ;! error[ca65-spelling]: ca65's `.asciiz` is `.strz` in nt65

.segment CODE
.proc main: a8 {
    lda #TEXT                           ;! error[operand-is-text]: `TEXT` is a string, and an instruction's operand must be a number or an address
    lda #-129                           ;! error[immediate-too-wide]: -129 does not fit: an immediate is one byte
    .assert 1 == 1, warning, "fine"     ;! error[assert-level]: nt65's `.assert` takes no level: remove `warning`, since a failed assertion is always an error
    rts
}

; The room data takes is counted in 64 bits and never wraps.
.segment BSS
.data big: .dword[$4000000000000000]  ;! error[arithmetic-overflow]: the room this data takes overflows nt65's 64-bit signed arithmetic
.data many {
    .repeat 4 { ;! error[arithmetic-overflow]: the room this data takes overflows nt65's 64-bit signed arithmetic
        .byte[$2000000000000000]
    }
}

; A fill is a byte ca65 knows when it reaches the line.
.segment CODE
.export .proc filled {
    rts
}
.segment RODATA
.data padding {
    .res 2, <filled ;! error[fill-not-constant]: the fill of a `.res` must be a constant
    .align 4, <filled ;! error[fill-not-constant]: the fill of an `.align` must be a constant
}
