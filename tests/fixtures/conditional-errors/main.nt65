; What a condition may not do, and what an assertion says when it does not hold.

.module main

.segment BSS
.data table: .byte[4]

.const SIZE = .sizeof(table)

.if SIZE > 2 {                  ;! error[condition-uses-a-measurement]: an `.if` cannot test `SIZE`, which measures a declaration; check it with `.assert`
    .const NOPE = 1
}

.if .sizeof(table) == 1 {       ;! error[condition-uses-a-measurement]: an `.if` cannot test `.sizeof(table)`, which measures a declaration; check it with `.assert`
    .const NOPE = 2
}

; A type has a shape the configuration decides only when every member is sized from what the
; configuration decides, and only when it is declared at file level, outside every `.if`. An
; enum has members but no size.
.struct Counted {
    items: .byte[.countof(table)]
}
.if .sizeof(Counted) == 4 {     ;! error[condition-uses-a-measurement]: an `.if` cannot test `.sizeof(Counted)`, which measures a declaration; check it with `.assert`
    .const NOPE = 6
}

.if 1 {
    .struct Maybe {
        x: .byte
    }
}
.if .countof(Maybe) == 1 {      ;! error[condition-uses-a-measurement]: an `.if` cannot test `.countof(Maybe)`, which measures a declaration; check it with `.assert`
    .const NOPE = 7
}

.enum Mode {
    off
    on
}
.if .sizeof(Mode) == 1 {        ;! error[condition-uses-a-measurement]: an `.if` cannot test `.sizeof(Mode)`, which measures a declaration; check it with `.assert`
    .const NOPE = 8
}

.if table {                     ;! error[condition-names-the-program]: an `.if` cannot test `table`, which is part of the program; check it with `.assert`
    .const NOPE = 4
}

.if 1 {
    .const LINES = 262
}
.if LINES > 200 {               ;! error[condition-uses-a-conditional-declaration]: an `.if` cannot test `LINES`, which is declared under another `.if`; declare `LINES` once, with `.select`
    .const NOPE = 5
}

.if "yes" {                     ;! error[condition-is-text]: an `.if` condition must be a number, not text
    .const NOPE = 3
}

.if 1 {
    .cpu 65c02                      ;! error[cpu-under-a-condition]: `.cpu` cannot be inside an `.if`: conditions can test the processor, so it must be set first
}
.if 1 {
    .if 1 {
        .cpu 65c02                  ;! error[cpu-under-a-condition]: `.cpu` cannot be inside an `.if`: conditions can test the processor, so it must be set first
    }
}

.segment CODE
.scope gfx {
} .else {                       ;! error[else-without-if]: `.else` has no `.if` before it
}

.assert SIZE == 8, "SIZE must be 8"      ;! error[assertion-failed]: SIZE must be 8
.assert SIZE == 8, error, "SIZE must be 8"  ;! error[assertion-failed]: SIZE must be 8;! error[assert-level]: `.assert` takes no level: remove `error`, since a failed assertion is always an error

.if 0 {
    .error "this branch is not taken, so nothing is said"
}
.error "this one is"        ;! error[config-refused]: this one is
