; What a value that depends on an address cannot do. ld65 works out operators on an address,
; and nothing else in a `.func` body can be left to it. The body is written into the calling
; file's output, so an address it names has to be declared there. A value that names an
; address and goes into a byte has to be one nt65 can show fits there, or be narrowed with `<`.
; ld65 works the value out in C's `long`, which is 32 bits on Windows, so `shifted` has no bound:
; a start above $7fff, shifted 16 places, leaves 32 bits before the `.mod` brings it back.
.module main

.use lib::offset

.export start, other, line, pair

.func biggest(n) = .max(n, 2)
.func inside(n) = n .in [1, 2]
.func outer(n) = 1 + biggest(n)
.func triple(n) = n * 3
.func digit(n) = '0' + n .mod 10
.func shifted(n) = (n << 16) .mod 10

.struct Pair {
    low:  .byte
    high: .byte
}

.macro emit(v) {
    .byte v
}

.segment CODE
.data line {
    .word biggest(start)    ;! error[func-not-linkable]: `biggest` is written for ld65 to work out, because its value depends on an address, and its body uses `.max(n, 2)`: ld65 works out only operators, `.lobyte`, `.hibyte` and `.bankbyte` on an address, so that part of the body needs a constant
    .word inside(start)     ;! error[func-not-linkable]: `inside` is written for ld65 to work out, because its value depends on an address, and its body uses `n .in [1, 2]`: ld65 works out only operators, `.lobyte`, `.hibyte` and `.bankbyte` on an address, so that part of the body needs a constant
    .word outer(start)      ;! error[func-not-linkable]: `outer` is written for ld65 to work out, because its value depends on an address, and its body uses `.max(n, 2)`: ld65 works out only operators, `.lobyte`, `.hibyte` and `.bankbyte` on an address, so that part of the body needs a constant
    .word offset(1)         ;! error[func-not-linkable]: `offset` is written for ld65 to work out, because its value depends on an address, and its body uses `table`: that address is declared in another file, which this file's output cannot name
    .byte triple(start)     ;! error[linked-value-may-not-fit]: `triple(start)` is worked out by the linker from an address, and `.byte` holds 8 bits, which nt65 cannot show it fits: use `<(triple(start))` for its low byte
    .byte digit(start) + 300 ;! error[linked-value-may-not-fit]: `digit(start) + 300` is worked out by the linker from an address, and `.byte` holds 8 bits, which nt65 cannot show it fits: use `<(digit(start) + 300)` for its low byte
    .byte start - other     ;! error[linked-value-may-not-fit]: `start - other` is worked out by the linker from an address, and `.byte` holds 8 bits, which nt65 cannot show it fits: use `<(start - other)` for its low byte
    .byte start * 2         ;! error[linked-value-may-not-fit]: `start * 2` is worked out by the linker from an address, and `.byte` holds 8 bits, which nt65 cannot show it fits: use `<(start * 2)` for its low byte
    .byte shifted(start)    ;! error[linked-value-may-not-fit]: `shifted(start)` is worked out by the linker from an address, and `.byte` holds 8 bits, which nt65 cannot show it fits: use `<(shifted(start))` for its low byte
    .byte start + 1         ;! error[address-does-not-fit]: `start` is an absolute address, and `.byte` holds 8 bits: use `<start` for its low byte
    emit!(start * 2)        ;! error[linked-value-may-not-fit]: `v` is worked out by the linker from an address, and `.byte` holds 8 bits, which nt65 cannot show it fits: use `<(v)` for its low byte
}
.data pair: .type Pair { low = start / 256, high = start / 2 }  ;! error[linked-value-may-not-fit]: `start / 2` is worked out by the linker from an address, and `high` holds 8 bits, which nt65 cannot show it fits: use `<(start / 2)` for its low byte

.proc start {
    lda #triple(start)      ;! error[linked-value-may-not-fit]: `triple(start)` is worked out by the linker from an address, and an immediate is one byte, which nt65 cannot show it fits: use `<(triple(start))` for its low byte
    rts
}

.proc other {
    rts
}
