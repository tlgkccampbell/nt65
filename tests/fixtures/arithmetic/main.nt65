; nt65 computes in 64 signed bits, and what the output carries has to fit ca65's 32.
; Nothing wraps: where an expression has no value, the reason is said here rather than
; left for ca65 to work out from the text.
.module main

; Division truncates toward zero and `.mod` takes the dividend's sign.
.assert -7 / 2 == -3, "a quotient truncates toward zero"
.assert 7 / -2 == -3, "whichever side the sign is on"
.assert -7 .mod 2 == -1, "a remainder takes the sign of the dividend"
.assert 7 .mod -2 == 1, "and not that of the divisor"
.assert -7 .mod -1 == 0, "a remainder by -1 is nothing at all"

; `>>` keeps the sign, and 63 places are there to shift through.
.assert -8 >> 1 == -4, "a shift right is arithmetic"
.assert (1 << 62) >> 62 == 1, "and a shift left reaches the top bit but one"

; An expression that leaves 64 bits has no value, and says so. None of these is declared,
; so what refuses them is the width nt65 computes in rather than the width ca65 holds.
.assert $7fffffffffffffff + 1 == 0, "no wrap" ;! error[arithmetic-overflow]: $7fffffffffffffff + 1 overflows nt65's 64-bit signed arithmetic
.assert (0 - $7fffffffffffffff) - 2 == 0, "nor down" ;! error[arithmetic-overflow]: -9223372036854775807 - 2 overflows nt65's 64-bit signed arithmetic
.assert $ffffffff * $ffffffff == 0, "nor a product" ;! error[arithmetic-overflow]: $ffffffff * $ffffffff overflows nt65's 64-bit signed arithmetic
.assert 1 << 63 == 0, "nor a shift"     ;! error[arithmetic-overflow]: 1 << 63 overflows nt65's 64-bit signed arithmetic
.assert -(0 - $7fffffffffffffff - 1) == 0, "no positive" ;! error[arithmetic-overflow]: negating -9223372036854775808 overflows nt65's 64-bit signed arithmetic
.assert (0 - $7fffffffffffffff - 1) / -1 == 0, "nor a quotient" ;! error[arithmetic-overflow]: -9223372036854775808 / -1 overflows nt65's 64-bit signed arithmetic

; A shift counts places, and only the places a 64-bit value has.
.assert 1 << 70 == 0, "no bit 70"       ;! error[shift-count-out-of-range]: shift count 70 is out of range: a shift moves 0 to 63 places
.assert 1 >> -1 == 0, "no count below 0" ;! error[shift-count-out-of-range]: shift count -1 is out of range: a shift moves 0 to 63 places

; What is declared reaches the output, and ca65 has 32 bits for it — for the value, and
; for every step of the expression it is written with, which ca65 works out again.
.const BIG    = $7fffffffffffffff    ;! error[number-too-wide]: $7fffffffffffffff does not fit in 32 bits: a value written to the ca65 output must be between -$80000000 and $ffffffff
.const SUM    = $ffffffff + 1        ;! error[number-too-wide]: $100000000 does not fit in 32 bits: a value written to the ca65 output must be between -$80000000 and $ffffffff
.const STEP   = ($ffffffff + 1) / 2  ;! error[number-too-wide]: $100000000 does not fit in 32 bits: a value written to the ca65 output must be between -$80000000 and $ffffffff
.const ROOM   = (1 << 40) >> 20      ;! error[number-too-wide]: $10000000000 does not fit in 32 bits: a value written to the ca65 output must be between -$80000000 and $ffffffff
.const LOWEST = 0 - $80000001        ;! error[number-too-wide]: -2147483649 does not fit in 32 bits: a value written to the ca65 output must be between -$80000000 and $ffffffff

; The edges of what ca65 holds are values like any other.
.const LIMIT = $ffffffff
.const FLOOR = 0 - $80000000

.enum Counted {
    near = $ffffffff
    far                             ;! error[number-too-wide]: $100000000 does not fit in 32 bits: a value written to the ca65 output must be between -$80000000 and $ffffffff
}

.export LIMIT, FLOOR, Counted

; An operand and a data value are written as they stand, too, so their steps are held to
; the same 32 bits.
.segment RODATA
.data shifted: .byte (1 << 40) >> 40  ;! error[number-too-wide]: $10000000000 does not fit in 32 bits: a value written to the ca65 output must be between -$80000000 and $ffffffff
.data within:  .byte (1 << 30) >> 30

.segment CODE
.export .proc wide {
    lda #((1 << 40) >> 38)           ;! error[number-too-wide]: $10000000000 does not fit in 32 bits: a value written to the ca65 output must be between -$80000000 and $ffffffff
    rts
}

; A setting is written as its value, which must fit, whether the build or the default gives it.
.const HUGE ?= $100000000           ;! error[number-too-wide]: $100000000 does not fit in 32 bits: a value written to the ca65 output must be between -$80000000 and $ffffffff

.export shifted, within, HUGE
