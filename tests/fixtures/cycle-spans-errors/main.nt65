; A sum of cycles along a run of instructions bounds one pass only when the run is straight-line
; code, so a span holding a call, a loop or an untraceable jump has no bound, and the error says
; which it found. Both ends must be positions in one routine, the start before the end.
.module main

.cpu 6502

.segment ZEROPAGE
.data count: .byte

.segment CODE
.export .proc work {
    rts
}

.export .proc calling {
    before:
    lda count
    jsr work
    after:
    rts
}

.export .proc looping {
    start:
    ldx #8
    again:
    dex
    bne again
    done:
    rts
}

.export .proc elsewhere {
    here:
    jmp (count)
    .next ?
    gone:
    rts
}

.export .proc other {
    far_off:
    rts
}

; A call takes as long as the routine it names, which is no part of this sum.
.assert .mincycles(calling::before, calling::after) == 0   ;! error[cycles-span-has-no-bound]: `.mincycles` cannot count the cycles between these positions: the span contains a call, `jsr`, whose time depends on the routine it calls

; A loop runs its body once per iteration, and the sum would count the body only once.
.assert .maxcycles(looping::start, looping::done) == 0     ;! error[cycles-span-has-no-bound]: `.maxcycles` cannot count the cycles between these positions: the span contains a loop: `bne` goes back to `again`

; A target nt65 cannot follow could be anywhere, this span included.
.assert .mincycles(elsewhere::here, elsewhere::gone) == 0  ;! error[cycles-span-has-no-bound]: `.mincycles` cannot count the cycles between these positions: the span contains `jmp`, whose target nt65 cannot follow

; Two positions in different routines are not a span at all.
.assert .mincycles(calling::before, other::far_off) == 0   ;! error[cycles-span-has-no-bound]: `.mincycles` cannot count the cycles between these positions: the two positions are in different routines

; The end position comes before the start, so the pass would run backwards.
.assert .mincycles(calling::after, calling::before) == 0   ;! error[cycles-span-has-no-bound]: `.mincycles` cannot count the cycles between these positions: `before` comes before `after`

; Neither end is a position in code.
.const LIMIT = 4
.assert .mincycles(LIMIT, calling::after) == 0             ;! error[cycles-needs-a-position]: `LIMIT` is a constant, not a position in code: a cycle count runs from one label or routine name to another

; A cycle count is known only once code is laid out, so it cannot size a declaration.
.segment BSS
.data room: .byte[.mincycles(calling::before, calling::after)]  ;! error[element-count-not-constant]: an array's element count must be a constant
