; Names in the output are flat. An export is its linker name, with its module's path in
; front; a top-level name that is not exported keeps its spelling, `outer::inner` becomes
; `outer__inner`, and cheap locals and names inside an anonymous scope get a name derived
; from the source and made unique.
.module main

.cpu 6502

.segment ZEROPAGE
; ca65 reads `z:` and `f:` at the start of a line as address-size prefixes, so a label
; named `z` or `f` is written as an assignment instead.
.data z:   .byte
.data f:   .byte
.data ptr: .word

.export top

.segment CODE
.proc top {
    rts
}

.scope outer {
    .proc inner {
        lda z
        lda f
        rts
    }
}

.proc draw {
    ldx #0
    .scope {
    @loop:                  ; draw__loop
        dex
        bne @loop
    }
    .scope {
    @loop:                  ; draw__loop_2, because the first one took the name
        dex
        bne @loop
    }
    .scope {
        reused:                 ; an anonymous scope's names are generated too
        jmp reused
    }
    jmp outer::inner
}

; Exported, so that what the file only declares counts as used.
.export ptr
