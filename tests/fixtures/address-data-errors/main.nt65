; An address slot holds an address of its width and nothing wider. ca65 would keep the low
; bits of what does not fit, so nt65 says so instead.
.module main

.cpu 65816

.segment FARDATA
.data sprite: .byte 1, 2, 3

.segment RODATA
.data table {
    .byte 0
    .addr sprite            ;! error[far-address-in-word]: `sprite` is a far address, and `.addr` holds 16 bits: `.faraddr` holds all of it, and `.loword(sprite)` the low 16 bits
    .addr sprite + 2        ;! error[far-address-in-word]: `sprite` is a far address, and `.addr` holds 16 bits: `.faraddr` holds all of it, and `.loword(sprite)` the low 16 bits
    .word sprite            ;! error[far-address-in-word]: `sprite` is a far address, and `.word` holds 16 bits: `.faraddr` holds all of it, and `.loword(sprite)` the low 16 bits
    .addr $12345            ;! error[value-too-wide]: $012345 does not fit in this directive
    .faraddr $1234567       ;! error[value-too-wide]: $01234567 does not fit in this directive
    .byte table             ;! error[address-does-not-fit]: `table` is an absolute address, and `.byte` holds 8 bits: `<table` is its low byte
    .byte table + 1         ;! error[address-does-not-fit]: `table` is an absolute address, and `.byte` holds 8 bits: `<table` is its low byte

    ; A form that says which bits it keeps is accepted.
    .addr .loword(sprite)
    .byte <table, table - table
    .faraddr sprite + 1
    .addr $ffff
    .faraddr $ffffff
}

.segment CODE
.proc main: a8, i8 {
    lda #table              ;! error[address-does-not-fit]: `table` is an absolute address, and an immediate is one byte: `<table` is its low byte
    lda #<table
    rep #$20
    lda #sprite             ;! error[address-does-not-fit]: `sprite` is a far address, and this immediate is two bytes: `.loword(sprite)` is its low 16 bits
    sep #$20

    ; `per` reaches its target the way `brl` does, so what it pushes is a near address.
    per sprite              ;! error[target-too-far]: `per` takes a near target, and this one is far
    pla
    pla
    rts
}

; An enum member is a constant number, so it cannot name an address.
.enum Handler {
    first = main            ;! error[enum-member-is-not-an-address]: `first` is an enum member, whose value is a constant, and this names an address
    second
}
