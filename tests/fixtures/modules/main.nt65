; Names from other modules are written with their module's path, or brought in with `.use`.
; The output imports an address and writes a constant out by value, because ca65 cannot use
; an imported symbol where it needs a value.
.module main

.cpu 6502

.use gfx::{SCREEN, ptr, clear}
.use snd::init as snd_init
.use hw::*
.use rt::host_tick

; A name an instruction is spelled like is a name here, and warned about wherever it is
; written: the same word reads as an instruction to whoever reads it next.
.segment ZEROPAGE
.data REP: .byte                ;! warning: `REP` is an instruction on the 65816; as a name it is legal and easy to misread
.data per: .byte                ;! warning: `per` is an instruction on the 65816; as a name it is legal and easy to misread

.segment CODE
.export .proc main {
    lda #<SCREEN            ; a constant from gfx
    sta ptr                 ; a zero-page label from gfx
    lda #>SCREEN
    sta ptr+1
    lda host_tick
    lda rt::ticks           ; exported as absolute, so used as absolute
    sta REP
    sta per
    jsr gfx::init           ; two modules' `init`, qualified and renamed
    jsr snd_init
    jsr clear
    jsr gfx::clear::again   ; an interior label, named through the routine it is in
    jsr rt::host_print
    lda #<rt::HOST_VERSION  ; the checked import, written out as the value nt65 used
    lda #gfx::Color::white  ; an enum member from another module
    ldx #gfx::Sprite::y     ; and a member offset from one
    lda #gfx::screen('A')   ; a charmap, a function and a list from gfx
    ldy #gfx::centred(10)
    lda #gfx::palette::ink  ; a constant in an exported scope
    lda gfx::tables::lo     ; a member of exported data
    lda #<BORDER            ; from the facade, which `hw::*` brought in
    jsr set_border
    sta sid_volume
    sta hw::sid_volume
    rts
}

.segment RODATA
.export .data shape:        .byte gfx::glyphs
; Where another module's routine ends, and how long it is: gfx exports the end with it.
.export .data clear_extent: .addr .endof(clear), .spanof(clear)

; The linker evaluates these, so ca65 has to read the operators as nt65 does: it spells `==`
; and `!=` its own way and has no `^^` at all.
.assert main == main && main != clear && !(main ^^ main), "an operator reached ld65 misspelled"
