; What another nt65 file exports is named as if it were declared here. The output
; imports an address and writes a constant out by value, because ca65 cannot use an imported
; symbol where it needs a value.
.cpu 6502

.export main

; Symbols that live outside nt65 are declared explicitly, with the size or signature nt65
; needs. A checked import gives nt65 the value and asserts at link time that the definition
; it is linked against agrees.
.import host_tick: zp
.import host_print: proc()
.import HOST_VERSION = $0102

.proc main {
    lda #<SCREEN            ; a constant from gfx.nt65
    sta ptr                 ; a zero-page label from gfx.nt65
    lda #>SCREEN
    sta ptr+1
    lda host_tick
    jsr clear
    jsr clear::again        ; an interior label, named through the routine it is in
    jsr host_print
    lda #<HOST_VERSION      ; the checked import, written out as the value nt65 used
    lda #Color::white       ; an enum member from another file
    ldx #Sprite::y          ; and a member offset from one
    lda #screen('A')        ; a charmap, a function and a list from gfx.nt65
    ldy #centred(10)
    rts
}

.rodata {
shape:  .byte glyphs
; Where another file's routine ends, and how long it is: gfx.nt65 exports the end with it.
clear_extent: .addr .endof(clear), .spanof(clear)
}

; Exported, so that what the file only declares counts as used.
.export shape, clear_extent

; The linker evaluates these, so ca65 has to read the operators as nt65 does: it spells `==`
; and `!=` its own way and has no `^^` at all.
.assert main == main && main != clear && !(main ^^ main), lderror, "an operator reached ld65 misspelled"
