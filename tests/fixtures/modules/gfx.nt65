; A module. Its symbols are private unless exported: `rows` and `palette` below are
; named nowhere else in this program, and naming them from `main.nt65` is an error.
.cpu 6502

.export clear, SCREEN, ptr, Color, Sprite, screen, centred, glyphs

.zeropage {
ptr:        .res 2
}

SCREEN = $0400
rows   = 25

; An exported type is not a symbol to the linker: each of its members crosses instead, as
; the flat constant it becomes.
.enum Color {
    black
    white
}

.struct Sprite {
x:      .byte
y:      .byte
}

; A charmap, a function and a list are used by value, so exporting one writes nothing for
; the linker: what crosses is what they come to, written where they are used.
.charmap screen {
    'A'..'Z' = $01
}

.func centred(width) = (40 - width) / 2

.list glyphs {
    $3c, $42, $3c
}

.scope palette {
    border = $0f
}

.proc clear {
    ; An interior label is exported from inside the routine it belongs to, and another file
    ; names it `clear::again`.
    .export again
    ldy #0
again:
    sta (ptr),y
    iny
    bne again
    rts
}
