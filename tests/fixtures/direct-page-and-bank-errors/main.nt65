; What is wrong with the direct page and the data bank, each where it can be fixed.
.cpu 65816

.segment "ZP2" {
ptr:    .res 2
}

.segment "WRAM" {
score:  .res 2
}

.struct Pair {
lo:     .byte
hi:     .byte
}

.segment "BANK1" {
pair:   .tag Pair
}

; A segment's `dp` and `bank` are constants in range, given once, and `dp` is for `zp`.
.segment "SLOW": abs, dp = $2100        ;! error: `dp` says which direct page a `zp` segment is reached through, and "SLOW" is not `zp`
.segment "WIDE": abs, bank = $100       ;! error: a bank is one byte
.segment "TWICE": zp, dp = 0, dp = 1    ;! error: segment "TWICE" already gives its `dp`
.segment "NAMED": abs, bank = score     ;! error: `bank` needs a constant

; Signature values are constants in range too.
.proc odd: a8, i8, dp = $12345 {        ;! error: `dp = $12345` is out of range: the direct page is a 16-bit address
    rts
}

; A direct operand reaches D plus its offset, and an absolute one bank B.
.proc wrong: a8, i8, dp = $0000, dbr = $00 {
    lda ptr                 ;! error: `ptr` is in "ZP2", which is reached through the direct page at $2100, and D is $0000 here
    sta score               ;! error: `score` is in "WRAM", which is in bank $7e, and B is $00 here
    lda pair::hi            ;! error: `pair` is in "BANK1", which is in bank $01, and B is $00 here
    rts
}

; The design's catch: a register mirrored only in some banks, reached from bank $7e.
.proc mirrored: a8, i8, dbr = $7e {
    sta $2100               ;! error: $2100 is reached only from banks $00-$3f, $80-$bf, and B is $7e here
    rts
}

; A symbol in a segment reached through a direct page other than 0 is only a direct operand.
.proc absolute: a8, i8 {
    lda a:ptr               ;! error: `ptr` is in "ZP2", reached through the direct page at $2100, and is only a direct operand: as an absolute operand it would reach its offset in the data bank
    lda ptr,y               ;! error: `ptr` is in "ZP2", reached through the direct page at $2100, and is only a direct operand: as an absolute operand it would reach its offset in the data bank
    rts
}

; `d:` needs D known, and an address in the page D starts.
.proc through: a8, i8 -> a8, i8, dp? {
    lda d:$2105             ;! error: `d:$2105` is reached through the direct page, and `through` says `dp*`, which assumes nothing about D
    pea $2100
    pld
    lda d:$2205             ;! error: `d:$2205` is reached through the direct page at $2100, which reaches only $2100 to $21ff
    lda d:ptr               ;! error: `d:` is for a constant address: a symbol reaches the direct page through a `zp` segment
    lda d:$2105,y           ;! error: `d:` makes a direct operand, and `lda` has no direct form of this operand
    tax
    tcd
    lda d:$2105             ;! error: `d:$2105` is reached through the direct page, and D is not known here: a `.state dp = ...` says what it is
    rts
}

; Calls and returns check D and B like the widths.
.proc needs: a8, i8, dp = $2100 {
    rts
}

.proc calls: a8, i8 -> a8, i8, dp? {
    jsr needs               ;! error: `jsr needs` needs `dp = $2100`, and D is not known here
    rts
}

.proc returns: a8, i8 -> a8, i8, dbr = $7e {
    rts                     ;! error: `rts`: `returns` returns with `dbr = $7e`, and B is not known here
}

.proc changes: a8, i8 {
    pea $2100
    pld
    rts                     ;! error: `rts`: `changes` says `dp*`, so D must be what it was on entry, and here it may not be
}

; A `.state` asserts as well as sets.
.proc asserts: a8, i8, dbr = $00 -> a8, i8, dp?, dbr? {
    .state dbr = $7e        ;! error: `.state dbr = $7e`, and B is $00 here
    .state dp = score       ;! error: `.state dp = score` needs a constant: the analysis follows D by value
    rts
}

; A near transfer stays in its bank.
.segment "BANK1" {
.proc low: a8, i8 {
    rts
}
}

.segment "BANK2" {
.proc high: a8, i8 {
    jsr low                 ;! error: `jsr` stays in bank $02, and `low` is in "BANK1", in bank $01: `jsl` reaches it
    rts
}
}

; Outside a routine there is no D to reach through.
    lda d:$2105             ;! error: `d:` is reached through the direct page, which only a `.proc` knows: outside one there is nothing to follow D through
