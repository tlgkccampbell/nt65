; What is wrong with the direct page and the data bank, each where it can be fixed.
.module main

.cpu 65816

.segment ZP2
.data ptr: .word

.segment WRAM
.data score: .word

.struct Pair {
    lo: .byte
    hi: .byte
}

.segment BANK1
.data pair: .type Pair

.segment ZEROPAGE: zp, dp = $2000

.segment ZEROPAGE
.data temp: .byte

.segment BSS
.data frames: .byte

.segment SHADOW
.data shadow: .byte

; A segment's `dp` and `bank` are constants in range, given once, and `dp` is for `zp`.
.segment SLOW: abs, dp = $2100        ;! error[segment-dp-not-zp]: segment `SLOW` is not `zp`, and only a `zp` segment takes a `dp`
.segment WIDE: abs, bank = $100       ;! error[segment-attribute-out-of-range]: `bank` must be $00 to $ff: a bank is one byte
.segment TWICE: zp, dp = 0, dp = 1    ;! error[segment-attribute-twice]: segment `TWICE` already has a `dp`
.segment NAMED: abs, bank = score     ;! error[segment-attribute-not-constant]: `bank` must be a constant

; Signature values are constants in range too.
.segment CODE
.proc odd: a8, i8, dp = $12345 {        ;! error[signature-value-out-of-range]: `dp = $12345` is out of range: the direct page is a 16-bit address
    rts
}

; A direct operand reaches D plus its offset, and an absolute one reaches its address in bank B.
.proc wrong: a8, i8, dp = $0000, dbr = $00 {
    lda ptr                 ;! error[direct-page-mismatch]: `ptr` is in segment `ZP2`, which expects the direct page at $2100, but D is $0000 here
    sta score               ;! error[bank-mismatch]: `score` is in segment `WRAM`, which is in bank $7e, but B is $00 here
    lda pair::hi            ;! error[bank-mismatch]: `pair` is in segment `BANK1`, which is in bank $01, but B is $00 here
    rts
}

; The design's motivating case: a register mirrored only in some banks, reached from bank $7e.
.proc mirrored: a8, i8, dbr = $7e {
    sta $2100               ;! error[range-bank-mismatch]: $2100 is reachable only from banks $00-$3f, $80-$bf, but B is $7e here
    rts
}

; A single bank is named as one bank, whether it is a mirror or all a range permits.
.proc single_banks: a8, i8, dbr = $7e {
    lda shadow              ;! error[bank-mismatch]: `shadow` is in segment `SHADOW`, which is in bank $00 and mirrored in bank $80, but B is $7e here
    sta $4300               ;! error[range-bank-mismatch]: $4300 is reachable only from bank $00, but B is $7e here
    rts
}

; Registers declared as data at their address are constant addresses too, through a field and
; an element as well as by name.
.struct Port {
    low:  .byte
    high: .byte
}

.data ports: .type Port[4] = $2104

.proc mirrored_record: a8, i8, dbr = $7e {
    sta ports[1]::high      ;! error[range-bank-mismatch]: $2107 is reachable only from banks $00-$3f, $80-$bf, but B is $7e here
    sta ports::low,x        ;! error[range-bank-mismatch]: $2104 is reachable only from banks $00-$3f, $80-$bf, but B is $7e here
    sta f:ports[1]::high
    rts
}

; A standard segment, once declared, is checked like any other.
.proc standard: a8, i8, dp = 0, dbr = $00 {
    lda temp                ;! error[direct-page-mismatch]: `temp` is in segment `ZEROPAGE`, which expects the direct page at $2000, but D is $0000 here
    sta frames              ;! error[bank-mismatch]: `frames` is in segment `BSS`, which is in bank $7e, but B is $00 here
    rts
}

; A set of banks is checked bank by bank: what each one reaches, and what each caller holds.
.proc anywhere: a8, i8, dbr = [$00..$3f, $80..$bf] {
    sta score               ;! error[bank-mismatch]: `score` is in segment `WRAM`, which is in bank $7e, but B is one of $00-$3f, $80-$bf here
    rts
}

.proc beside: a8, i8, dbr = [$00..$3f, $7e], native -> a8, i8, dbr = [$00..$3f] {
    sta $2100               ;! error[range-bank-mismatch]: $2100 is reachable only from banks $00-$3f, $80-$bf, but B is one of $00-$3f, $7e here
    jsr anywhere            ;! error[call-state-mismatch]: `jsr anywhere` needs `dbr = [$00..$3f, $80..$bf]`, but B is one of $00-$3f, $7e here
    rts                     ;! error[return-state-mismatch]: `rts`: `beside` declares it returns with `dbr = [$00..$3f]`, but B is one of $00-$3f, $7e here
}

.proc from_wram: a8, i8, dbr = $7e, native -> a8, i8, dbr? {
    jsr anywhere            ;! error[call-state-mismatch]: `jsr anywhere` needs `dbr = [$00..$3f, $80..$bf]`, but B is $7e here
    .state dbr = [$00..$3f] ;! error[state-value-mismatch]: `.state dbr = [$00..$3f]` does not match: B is $7e here
    rts
}

.proc sets_d: a8, i8, dp = [0, $2100] {    ;! error[state-banks-not-dbr]: `dp = [0, $2100]`: only `dbr` can be given a set of banks; `dp` takes one address
    rts
}

.proc backwards: a8, i8, dbr = [$3f..$00] {    ;! error[state-banks-invalid]: `dbr = [$3f..$00]` is not a valid set of banks: each item is a constant bank, or a range given low to high, such as `$00..$3f`
    rts
}

; A symbol in a segment reached through a direct page other than 0 is only a direct operand.
.proc absolute: a8, i8 {
    lda a:ptr               ;! error[direct-page-only]: `ptr` is in direct-page segment `ZP2`, so it must be a direct-page operand; as an absolute operand it would address the data bank
    lda ptr,y               ;! error[direct-page-only]: `ptr` is in direct-page segment `ZP2`, so it must be a direct-page operand; as an absolute operand it would address the data bank
    rts
}

; `d:` needs D to be known, and an address inside the 256-byte page that starts at D.
.proc through: a8, i8 -> a8, i8, dp? {
    lda d:$2105             ;! error[direct-page-unknown]: `d:$2105` is reached through the direct page, and `through` declares `dp*`, which assumes nothing about D
    pea $2100
    pld
    lda d:$2205             ;! error[direct-page-out-of-reach]: `d:$2205` is reached through the direct page at $2100, which covers only $2100 to $21ff
    lda d:ptr               ;! error[direct-page-prefix-on-symbol]: `d:` takes only a constant address: to reach a symbol through the direct page, declare it in a `zp` segment
    lda d:$2105,y           ;! error[direct-page-form-missing]: `lda` has no direct-page form of this operand, which `d:` asks for
    tax
    tcd
    lda d:$2105             ;! error[direct-page-unknown]: `d:$2105` is reached through the direct page, and D is not known here: a `.state dp = ...` declares what it is
    rts
}

; A direct operand on a symbol whose segment declares `dp` reaches the symbol only when D holds
; that value, so D must be known there too.
.proc assumes: a8, i8 -> a8, i8, dp? {
    lda ptr                 ;! error[direct-page-unknown]: `ptr` is in segment `ZP2`, which expects the direct page at $2100, and `assumes` declares `dp*`, which assumes nothing about D
    tax
    tcd
    lda ptr                 ;! error[direct-page-unknown]: `ptr` is in segment `ZP2`, which expects the direct page at $2100, and D is not known here: a `.state dp = ...` declares what it is
    .state dp = $2100
    lda ptr
    rts
}

; An interrupt handler is entered with whatever D the interrupted code held. Pulling the D it
; saved on entry gives that value back, which is no more known than it was then.
.proc handler: interrupt, native {
    rep #$30
    phd
    pea $2100
    pld
    lda ptr
    pld
    lda ptr                 ;! error[direct-page-unknown]: `ptr` is in segment `ZP2`, which expects the direct page at $2100, and D is not known here: a `.state dp = ...` declares what it is
    rti
}

; Calls and returns check D and B like the widths.
.proc needs: a8, i8, dp = $2100 {
    rts
}

.proc calls: a8, i8, native -> a8, i8, dp? {
    jsr needs               ;! error[call-state-mismatch]: `jsr needs` needs `dp = $2100`, but D is not known here
    rts
}

.proc returns: a8, i8 -> a8, i8, dbr = $7e {
    rts                     ;! error[return-state-mismatch]: `rts`: `returns` declares it returns with `dbr = $7e`, but B is not known here
}

.proc changes: a8, i8, dp* {
    pea $2100
    pld
    rts                     ;! error[asserted-item-not-restored]: `rts`: `changes` declares `dp*`, so D must be what it was on entry, but here it may not be
}

; A block move whose banks the program writes leaves B at a bank nothing knows, whatever the
; operands written here say.
.proc patched: a8, i16, dbr = $00 {
    sta @move+1
    .patch @move
@move:
    mvn #$00, #$00
    rts                     ;! error[return-state-mismatch]: `rts`: `patched` declares it returns with `dbr = $00`, but B is not known here
}

; A `.state` asserts as well as sets.
.proc asserts: a8, i8, dbr = $00 -> a8, i8, dp?, dbr? {
    .state dbr = $7e        ;! error[state-value-mismatch]: `.state dbr = $7e` does not match: B is $00 here
    .state dp = score       ;! error[state-value-not-constant]: `.state dp = score` needs a constant value for D
    rts
}

; A near transfer stays in its bank.
.segment BANK1
.proc low: a8, i8 {
    rts
}

.segment BANK2
.proc high: a8, i8, native {
    jsr low                 ;! error[jump-leaves-bank]: `low` is in bank $01, and `jsr` cannot leave bank $02: use `jsl`
    rts
}

; A conditional branch has no long form to suggest instead, so reaching the other bank takes
; a `jml`, skipped over by the opposite branch.
.proc branches: a8, i8, native {
    beq low                 ;! error[jump-leaves-bank]: `low` is in bank $01, and `beq` cannot leave bank $02: branch the other way around a `jml` to it
    rts
}

