; A label is inside the memory areas the linked config runs its segment in, so a label in bank
; $7e is $7e0000 or more, whatever its address size. A value worked out from it is bounded by
; that bank. A value in a two-byte slot that names a far address, or an address placed past
; $ffff, is written inside `.loword()` where it always fits 16 bits, which loses nothing. ca65
; keeps the low 16 bits of an absolute or `(abs,x)` operand on the 65816, but range-checks the
; pointer of `jmp (abs)` and `jml [abs]`, so that pointer is written inside `.loword()` too. The
; processor reads that pointer from bank $00, so it is placed in bank $00, or in a segment such as
; CODE, whose memory area the project mirrors in bank $00.
.module main

.export start, offsets, dispatch, dispatch_indexed, dispatch_far, dispatch_hook, dispatch_far_hook

.segment FARDATA
.data far_table: .byte 1, 2, 3

.segment LOWRAM
.data hook:     .addr[1]
.data far_hook: .faraddr[1]

.segment DATA7E
.data buffer: .byte[16]

.segment RODATA
.data offsets {
    .byte (buffer - $7e2000) / 256          ; $00 to $df, wherever buffer lands in WRAM
    .word buffer - $7e0000                  ; $2000 to $ffff
    .word .loadof(FARDATA) - $810000        ; $8000 to $ffff
    .word (far_table - $810000) / 2         ; $4000 to $7fff
    .word .loword(buffer)                   ; the low 16 bits, as the source says
    .addr buffer                            ; an address within its bank
}

.segment CODE
.proc start: a16, i16, native {
    ldx #buffer - $7e0000
    lda #.loadof(FARDATA) - $810000
    ldy #.loword(far_table)
    rts
}

.data vectors:    .addr start
.data far_vector: .faraddr start

.proc dispatch: a16, i16, native {
    ldx #0
    jsr (vectors,x)                         ; kept within the bank by ca65
    .next start
    jmp (vectors)                           ; read from bank $00 at the address within the bank
    .next ?
}

.proc dispatch_indexed: a16, i16, native {
    ldx #0
    jmp (vectors,x)
    .next ?
}

.proc dispatch_far: a16, i16, native {
    jml [far_vector]
    .next ?
}

.proc dispatch_hook: a16, i16, native {
    jmp (hook)                              ; placed in bank $00
    .next ?
}

.proc dispatch_far_hook: a16, i16, native {
    jml [far_hook]
    .next ?
}
