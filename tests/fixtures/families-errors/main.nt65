; Where a declaration named after a repetition's binding may not stand, and what a family
; collides with. Each of them is one message saying why.
.module main

.enum Channel {
    pulse1
    pulse2
}

.list handlers {
    1, 2
}

.segment CODE

; A family iterates over a named enum: a list's items have no names, and a `.repeat` only counts.
.each handlers, h {             ;! error[family-not-over-an-enum]: a family needs a named enum to walk, and `handlers` is a list
    .proc h {
        rts
    }
}
.multiproc handlers, h {        ;! error[family-not-over-an-enum]: a family needs a named enum to walk, and `handlers` is a list
    rts
}
.repeat 2, i {
    .proc i {                   ;! error[family-misplaced]: a family must be in an `.each` over a named enum, because each routine it declares is named after one of the enum's members; a `.repeat` only counts, so it gives no names
        rts
    }
}

; A scope or data block named after the binding would declare itself and everything inside it
; once per member, which a family may not do.
.each Channel, ch {
    .scope ch {                 ;! error[family-declares-too-much]: `ch` would declare one scope per member, repeating everything inside it: a family declares only routines and data, so declare one family per role, such as `note::ch` and `stop::ch`
        .const VALUE = 1
    }
}
.each Channel, ch {
    .data ch {                  ;! error[family-declares-too-much]: `ch` would declare one `.data` block per member, repeating everything inside it: a family declares only routines and data, so declare one family per role, such as `note::ch` and `stop::ch`
        .byte 1
    }
}

; A family declares into the scope around its repetition, so it belongs where a routine does.
.proc outer {
    .each Channel, c {
        .proc c {               ;! error[family-misplaced]: a family declares one routine or data declaration per member into the scope around its `.each`, and this one is inside a routine: a routine belongs at file level or in a `.scope`
            rts
        }
    }
    rts
}
.proc outer2 {
    .multiproc Channel, d {     ;! error[multiproc-misplaced]: `.multiproc` declares routines, and this one is inside a routine: a routine belongs at file level or in a `.scope`
        rts
    }
    rts
}
.macro m() {
    .multiproc Channel, e {     ;! error[declaration-in-a-macro-body]: `.multiproc` cannot be inside a macro body: a routine's name and signature are part of the file's interface, and a body declares nothing in its caller
        rts
    }
    .each Channel, f {
        .proc f {               ;! error[family-misplaced]: a family declares one routine or data declaration per member into the scope around its `.each`, and this one is inside a macro body: names declared there cannot reach the caller's scope
            rts
        }
    }
}
.each Channel, g {
    .multiproc Channel, k {     ;! error[declaration-in-a-repetition]: `.multiproc` cannot be inside a `.repeat` or `.each` body: it declares one routine per member of an enum, and this one would declare them again on every iteration
        rts
    }
}
.repeat 2 {
    .scope inner {
        .each Channel, n {
            .proc n {           ;! error[family-misplaced]: a family cannot be inside another `.repeat` or `.each`: it declares its routines into the scope around its `.each`, and inside a repetition that scope is a new one on every pass
                rts
            }
        }
        .multiproc Channel, q { ;! error[declaration-in-a-repetition]: `.multiproc` cannot be inside a `.repeat` or `.each` body: it declares one routine per member of an enum, and this one would declare them again on every iteration
            rts
        }
    }
}

; Only a routine or data declaration named after the binding declares a family. Anything else
; with that name is checked as it would be under any other name.
.each Channel, r {
    .macro r() {                ;! error[declaration-in-a-repetition]: a definition cannot be inside a `.repeat` or `.each` body: it would be a different one on every iteration, and nothing outside the body could name any of them;! error[name-already-declared]: `r` is already declared in this scope
    }
    .proc r = $1234             ;! error[declaration-in-a-repetition]: `.proc` cannot be inside a `.repeat` or `.each` body: a routine's name and signature are part of the file's interface, and this one would be a different routine on every iteration;! error[name-already-declared]: `r` is already declared in this scope
}

; One declaration per member in the scope around it, so it collides as any duplicate does.
.proc pulse1 {
    rts
}
.multiproc Channel, ch {        ;! error[family-member-collides]: `pulse1` is a member of `Channel` and is already declared in this scope: a family declares one name per member
    rts
}

; The name to bind is what the routines are named from, so it is not optional.
.multiproc Channel {            ;! error[expected-comma]: expected `,` and the name to bind: `.multiproc Channel, ch {`
    rts
}
