; What a routine that promises more than it hands back is told, and where `keeps` may not be
; written at all.
.module main

.cpu 6502

.export breaks_it, forgets_the_carry, says_nothing, jumps_in
.export hands_off, loses_a, branches_in, loses_x, hands_on, holds_a
.export branches_off, next_hands_off, loses_it, branches_on, holds_it

.segment BSS
.data slot:   .byte
.data vector: .addr

.segment CODE

; The promise is checked at every way out of the routine.
.proc breaks_it: keeps x {
    ldx #1
    rts                     ;! error[keeps-broken]: `breaks_it` promises `keeps x`, and X is not what the routine was entered with here: restore it before returning, or a `.state keeps x` where the value comes back says so
}

; A save that does not come back on every path is no save on the path it is missing from.
.proc forgets_the_carry: keeps a, c {
    php
    beq @quiet
    plp
    rts
@quiet:
    sec
    lda #0
    rts                     ;! error[keeps-broken]: `forgets_the_carry` promises `keeps a, c`, and A, C are not what the routine was entered with here: restore them before returning, or a `.state keeps a, c` where the value comes back says so
}

; A `.state keeps` where the register was never destroyed is one nobody needed.
.proc says_nothing {
    lda #1
    sta slot
    .state keeps x          ;! warning[keeps-redundant]: `keeps x` says nothing here: X is already what the routine was entered with
    rts
}

; `keeps` is about a routine from entry to exit, so it has no place after `->`, and a macro is
; expanded into the routine that calls it rather than called.
.proc after_the_arrow: a8 -> a8, keeps x {     ;! error[item-belongs-at-entry]: `keeps x` is about a routine from entry to exit, and belongs before `->`
    rts
}

.macro spill(): keeps a {   ;! error[macro-keeps]: `keeps a` is about a routine from entry to exit, and a macro is expanded into one: what its body keeps is part of what that routine keeps
    lda #0
}

.proc uses_it {
    spill!()
    rts
}

; A save does not span a label another routine may jump into: whoever jumps in has pushed
; nothing, so the `pla` below the label matches no `pha` above it.
.proc saves_across: keeps a {
    pha
    halfway:
    .state ?
    pla
    rts                     ;! error[keeps-broken]: `saves_across` promises `keeps a`, and A is not what the routine was entered with here, because `halfway` can be entered from outside `saves_across`, and a jump in has not pushed what the path above the label has: the pushes above `halfway` belong on the same side of it as what reads them, and `args n` on `saves_across` is how a second entry point says what its caller pushed
}

.proc jumps_in {
    jmp saves_across::halfway
}

; A jump into another routine's label is a way out of this one: control never comes back here,
; so what this routine hands its caller is what the routine the label is in hands back.
.proc hands_off: keeps a {
    jmp loses_a::partway    ;! error[keeps-broken]: `hands_off` promises `keeps a`, and A is not what the routine was entered with here: control does not come back from `partway`, and `loses_a` does not promise to keep a: a `keeps a` on `loses_a` says it hands it back, and a `.next ?` here ends the path with nothing checked
}

.proc loses_a {
    partway:
    .state ?
    lda #0
    rts
}

; A branch into one is the same way out, on the path where it is taken.
.proc branches_in: keeps x {
    beq loses_x::partway    ;! error[keeps-broken]: `branches_in` promises `keeps x`, and X is not what the routine was entered with here: control does not come back from `partway`, and `loses_x` does not promise to keep x: a `keeps x` on `loses_x` says it hands it back, and a `.next ?` here ends the path with nothing checked
    rts
}

.proc loses_x {
    partway:
    .state ?
    ldx #0
    rts
}

; And where the routine the label is in promises to keep the register, the jump is certified:
; whoever jumps in is handed it back with everyone else.
.proc hands_on: keeps a {
    jmp holds_a::partway
}

.proc holds_a: keeps a {
    partway:
    .state ?
    ldy #0
    rts
}

; A branch that names the routine itself is the same way out as one that names a label inside
; it: on the path it is taken, control goes there and comes back to this routine's caller.
.proc branches_off: keeps a {
    ldx #1
    bne loses_it            ;! error[keeps-broken]: `branches_off` promises `keeps a`, and A is not what the routine was entered with here: control does not come back from `loses_it`, which does not promise to keep a: a `keeps a` on `loses_it` says it hands it back, and a `.next ?` here ends the path with nothing checked
    rts
}

; And so is a `.next` naming one, which is how a jump through a pointer says where it goes.
.proc next_hands_off: keeps a {
    jmp (vector)            ;! error[keeps-broken]: `next_hands_off` promises `keeps a`, and A is not what the routine was entered with here: control does not come back from `loses_it`, which does not promise to keep a: a `keeps a` on `loses_it` says it hands it back, and a `.next ?` here ends the path with nothing checked
    .next loses_it
}

.proc loses_it {
    lda #0
    rts
}

; Where the routine handed to promises to keep the register, the branch is certified.
.proc branches_on: keeps a {
    ldx #1
    bne holds_it
    rts
}

.proc holds_it: keeps a {
    ldy #0
    rts
}
