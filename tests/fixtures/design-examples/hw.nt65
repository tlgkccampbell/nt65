; The design's examples of a setting a module exports, of exports, and the module the
; example of `.use` brings names in from.
.module hw
.export .const SOUND_CHANNELS ?= 3
.const PAL                    ?= 0

.if SOUND_CHANNELS > 2 {
    .const VOICES = 3
}

.cpu 65816

.export VOICES, set_border

.const K = $1234

.segment CODE
.export .const BORDER = $D020
.export .proc init {
    rts
}
.export .data vectors {
    .data native: .addr[8]
}
.export fill_page, clear::again, K: abs, init as "_init"

.proc fill_page: a8, i8 {
    rts
}

.proc clear: a8, i8 {
    rts
    again:
    .state a8, i8, native
    rts
}

.proc set_border: a8, i8 {
    sta BORDER
    rts
}
