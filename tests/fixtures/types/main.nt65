; The declarative constructs, as the design writes them: enumerations, structures, unions,
; lists, character mappings and functions. None of them generates anything by itself; what
; they mean shows up where they are used.
.module main

.cpu 6502

.enum Color {
    red                 ; 0
    green = 5
    blue                ; 6
}

; A member of a named enum is only ever named through it, so it may be named after a register.
.enum Reg {
    a
    x
    y
}

.struct Point {
    x: .word
    y: .word
}

.struct Player {
    pos:  .type Point
    hp:   .byte
    name: .res 8
}

.union Value {
    b: .byte
    w: .word
}

.charmap screen {
    'A'..'Z' = $01      ; a range maps to consecutive values
    '@'      = $00
    ' '      = $20
}

.func rgb15(r, g, b) = r | (g << 5) | (b << 10)

.list handlers {
    Color::red
    Color::green, Color::blue
}

.const MAX_ACTORS = 3

.segment BSS
.data player: .type Player
.data actors: .type Player[MAX_ACTORS]

.segment RODATA
; A member offset and a type size are numbers, with the path they came from in a comment.
.data sizes:  .byte .sizeof(Player), .sizeof(Point), .sizeof(Value)
.data counts: .byte .countof(actors), .countof(handlers)
.data offs:   .byte Player::pos::y, Player::hp, Point::y

; Text reaches the output as bytes whether a mapping is applied to it or not.
.data plain:  .byte "HI"
.data mapped: .byte screen("HI@")
.data one:    .byte screen('Z')

; A call is worth what its body is worth, and a list stands for its own items.
.data color: .word rgb15(31, 0, 0)
.data table: .byte handlers
.data lo:    .lobytes handlers

; An instance written out with values, on one line and over several.
.data boss: .type Player { pos = { x = 100, y = 40 }, hp = 99 }

.data hero: .type Player {
    hp = 3
    name = "ZIP"
}

; A binary file is read for its length, and its path is written relative to the output.
.data blob: .incbin "sprites.bin"
.data part: .incbin "sprites.bin", 6, 4

; An alignment generates however many bytes it takes, which only the assembler settles.
.align 16

.segment ZEROPAGE
.data cursor: .type Player

.segment CODE
.export .proc main {
    ; A field of an instance is that instance plus the offset of the field.
    lda player::hp
    ldx actors::pos::x
    ; ...and as wide an address as the instance: a field of one in zero page is zero page.
    lda cursor::hp
    sta cursor::pos::x+1
    lda #Color::green
    ldx #Reg::x
    lda #.sizeof(Player)
    rts
}

; A union is written as the one member it is given, and zeros to its size.
.segment RODATA
.data as_word:    .type Value { w = $1234 }
.data as_byte:    .type Value { b = 1 }
.data as_nothing: .type Value { }

; Exported, so that what the file only declares counts as used.
.export as_word, as_byte, as_nothing, sizes, counts, offs, plain, mapped, one, color, table, lo, blob, part
