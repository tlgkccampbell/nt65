; Assembly's tricks — computed jumps, data in the instruction stream, self-modifying code
; — are all allowed. Each has a syntactic fingerprint, so nt65 finds it in one pass and
; takes an annotation that tells the analysis what it cannot see for itself. The
; annotations are required on every CPU, because what each routine reads and keeps
; depends on where its paths go.
.module main

.cpu 65c02

.export dispatch

; A jump table inside a proc. Every item of `@table` is a code label, so `.next @table`
; says what listing them one by one says, and the targets need no declarations because
; the edges carry the state at the jump.
.segment CODE
.proc dispatch {
    lda cmd
    asl a
    tax
    jmp (@table,x)
    .next @table

@table: .addr @move, @fire

@move:
    lda #1
    rts
@fire:
    lda #2
    rts
}

; The `bit` skip trick: `$2c` is `bit abs`, which swallows the two bytes after it, so
; flow carries on past the instruction they spell rather than through it.
.export .proc set {
    beq @set_two
    lda #1
    .byte $2c           ; bit abs: swallows the next instruction
    .next @store
@set_two:
    lda #2
@store:
    sta value
    rts
}

; Self-modifying code: the store writes into the operand of the instruction at `@op`,
; which is what `.patch` acknowledges.
.export .proc patching {
    lda #$60
@op:
    sta $0400
    sta @op+1
    .patch @op
    rts
}

; A call may target a label inside a routine, its own or another's. Here there is no processor
; state for the label to declare, so the call needs nothing written, as it does on the 65816 once
; the label declares its state. Each call comes back with what the path from the label leaves.
.export .proc clear_screen {
    lda #0
    ldx #0
    again:
    sta $0400,x
    inx
    bne again
    rts
}

.export .proc clear_twice {
    jsr clear_screen::again
    jsr @tail
    rts
@tail:
    ldx #0
    jmp clear_screen::again
}

.segment BSS
.data cmd:   .byte
.data value: .byte
