; In-file defines: a `.config` is its module's own, and a condition may test it. The build
; sets one the module exports by its qualified name, which makes the value written here a
; default.
.module hw

.export .config PAL = 0
.export .config CHANNELS = .min(VOICES + EXTRA, 3)
.config EXTRA = 1

.if PAL {
    .export LINES = 312
} .else {
    .export LINES = 262
}
