; Settings: a setting is its module's own, and a condition anywhere may test it. The build sets
; one by its path, or by its name alone where no other module has a setting of that name, which
; makes the value written here a default.
.module hw

.export .const PAL      ?= 0
.const VOICES           ?= 1
.export .const CHANNELS ?= .min(VOICES + EXTRA, 3)
.const EXTRA            ?= 1

.if PAL {
    .export .const LINES = 312
} .else {
    .export .const LINES = 262
}
