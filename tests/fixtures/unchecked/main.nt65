; Assembly's tricks on the 65816, each with the annotation that tells the analysis what it
; cannot see for itself. Here the analysis consumes processor state, so the annotations
; that are optional on the 6502 are required, and every one below is needed.
.module main

.cpu 65816

.import print: proc(inline .strz)
.import beep: proc(inline 2)
.export dispatch, nmi, restore, set, table_jump, record_jump, relative, far_relative, first, second
.export patching, enter, jumper, caller

.segment BSS
.data cmd:      .byte
.data value:    .byte
.data nmi_flag: .byte
.data saved_p:  .byte

; A jump table inside a proc: the targets need no declarations, because the `.next` edges
; carry the state at the jump.
.segment CODE
.proc dispatch: a8, i16 {
    lda cmd
    asl a
    tax
    jmp (@table,x)
    .next @move, @fire

@table: .addr @move, @fire

@move:
    lda #1
    rts
@fire:
    lda #2
    rts
}

; An interrupt handler: nothing is known on entry, so the widths are set before any
; immediate needs them.
.proc nmi: interrupt {
    rep #$30
    pha
    sep #$20
    lda #1
    sta nmi_flag
    rep #$20
    pla
    rti
}

; A `plp` that restores a status byte saved elsewhere: the analysis stack holds no saved P
; for it, so a `.state` says what it holds.
.proc restore: a8, i8 -> a16 {
    lda saved_p
    pha
    plp
    .state a16, i8      ; the analyzer cannot know what was in saved_p
    rts
}

; The `bit` skip trick.
.proc set: a8, i8 {
    beq @set_two
    lda #1
    .byte $2c           ; bit abs: swallows the next instruction
    .next @store
@set_two:
    lda #2
@store:
    sta value
    rts
}

; `rts` used as a jump: the table holds each target less one, and the return goes where
; the pushed address says.
.proc table_jump: a16, i16 {
    lda cmd
    and #$00ff
    asl a
    tax
    lda targets,x
    pha
    rts
    .next targets

    .data targets: .addr @one - 1, @two - 1

@one:
    rts
@two:
    rts
}

; A table of records, each a target less one and the bank it is in, as a far call through a
; mapper reads one: `.next` follows the address members of every record, in mixed data, and
; passes over the rest.
.struct Entry {
    target: .addr
    bank:   .byte
}

.proc record_jump: a16, i16 {
    lda cmd
    and #$00ff
    tax
    lda entries,x
    pha
    rts
    .next entries

    .data entries {
        .data first: .type Entry { target = @one - 1, bank = 2 }
        .data rest:  .type Entry[] {
            { target = @two - 1, bank = 3 }
        }
        .data last: .type Entry {
            target = @three - 1
            bank   = 4
        }
    }

@one:
    rts
@two:
    rts
@three:
    rts
}

; A routine that returns past the data written after each call.
.proc talk: a8, i8 {
    jsr print
    .strz "hello"
    jsr beep
    .byte 10, 20
    rts
}

; Relative calls: `per` pushes the return address and a branch goes to the routine. With
; `phk` before them, the bank is pushed too, and the call is far.
.proc relative: a8, i8, native {
    per @back - 1
    brl talk
@back:
    rts
}

.proc far_relative: far, native {
    phk
    per @back - 1
    brl far_target
@back:
    rtl
}

.proc far_target: far {
    rtl
}

; One routine running into the next: the `.fallthrough` is checked as a tail call, and the two
; have to be written one after the other.
.proc first: a16, native -> a8 {
    lda #$1234
    sep #$20
    .fallthrough second
}
.proc second: a8 {
    lda #$12
    rts
}

; Self-modifying code: the store writes into the operand of the instruction at `@op`.
.proc patching: a8, i8 {
    lda #$60
@op:
    sta $0400
    sta @op+1
    .patch @op
    rts
}

; A second entry point, declared, which another routine jumps into. The declaration is all the
; label assumes, so it names the mode as well: a jump in is checked for the parts it gives, and
; `native` is one nothing else would say.
.proc enter: a16 -> a8 {
    lda #$1234
    sep #$20
    into:
    .state a8, native
    lda #$12
    rts
}

.proc jumper: a8, i8, native {
    jmp enter::into
}

; A call to the same label is checked against its declaration, and comes back with what `enter`
; returns with, so the immediate after it is 8-bit.
.proc caller: a8, i8, native {
    jsr enter::into
    lda #$34
    rts
}
