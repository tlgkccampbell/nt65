.module config

.cpu 6502

.export LINES, rgb15, VOICES, TRACE_LEVEL, COLUMNS

LINES = 25                          ; a constant
.func rgb15(r, g, b) = r | (g << 5) | (b << 10)
.config VOICES = 3                  ; a setting the build may change

.if .defined(DEBUG) && DEBUG {
    TRACE_LEVEL = 2
} .else {
    TRACE_LEVEL = 0
}

COLUMNS = .select(WIDE, 80, 40)
