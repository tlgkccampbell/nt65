; Every item the parser reads, in one file, built for the 65816.
.module main

.cpu 65816

.segment ZP2: zp
.segment WRAM: abs, bank = $7e
.segment HWREG: zp, dp = $2100

.export fill_page, SCREEN
.import zp_scratch: zp, far_table: far
.import _printf: proc(a8, i16)
.import tick: proc(-> a8)
.import reset: proc()
.import VIC_BORDER = $D020
.import raw

.proc CHROUT = $FFD2: a8, i8
.proc alias = fill_page

SCREEN       = $0400
SCREEN_PAGES = 4

.segment ZEROPAGE
.data ptr:        .word
.data frame:      .byte

.segment RODATA
.data table:      .byte 1, 2, $ff, 'A', "text"
.data words:      .word $1234, table
.data wide:       .dword $12345678
.data here:       .addr table
.data there:      .faraddr table
.data greeting:   .strz "hello"
.data padding:    .byte[16] {
    .repeat 16 {
        $ff
    }
}

.segment CODE
.proc fill_page: a8, i16 -> a8, i16 {
    ldy #0
@loop:
    sta (ptr),y
    iny
    bne @loop
    rts
}

; A nested segment block changes the segment of its contents, not their scope.
.proc render: a16, i8 -> a8, i8 {
    .scope {
        ldx #0
    @loop:
        stz $0200,x
        inx
        bne @loop
    }
    .segment RODATA {
    @shifts: .byte 1, 2, 4, 8
    }
    ldx @shifts
    sep #$20
    rts
}

.proc hud: a8, i16, dp = $2100, dbr = $7e {
    rts
}

.proc show: a*, i*, e*, near, inline .strz {
    rts
}

.proc skip2: far, inline 2 {
    rtl
}

; Procs do not nest, but a `.scope` may hold them.
.scope gfx {
    .proc init {
        rts
    }
}

; Exported, so that what the file only declares counts as used.
.export SCREEN_PAGES, frame, words, wide, here, there, greeting, padding
