; Which registers a routine hands back as it was entered with them. `keeps` is the promise,
; checked at every way out of a routine with a body and taken at its word for a routine
; without one. A save and its restore cancel through the stack, so the idiom needs nothing
; written; a restore through memory is not one the analysis can see, and `.state keeps` says
; it where the value comes back.
.module main

.cpu 6502

.export handler, draw_row, save_slot

; A routine with no body: nothing will ever contradict what it says, so what it says is all
; anyone can know. The C64 KERNAL documents that CHROUT hands X and Y back; `keeps` says so.
.proc CHROUT = $FFD2: keeps x, y

.segment BSS
.export .data save_slot: .byte

.segment CODE

; The 6502 has no `phx`, so X is saved through the accumulator: the value has to be followed
; across the transfers as well as the pushes for the save and the restore to cancel.
.proc keeps_by_saving: keeps a, x {
    pha
    txa
    pha

    lda #0
    ldx #7
    jsr CHROUT

    pla
    tax
    pla
    rts
}

; Ruling out every store that could have reached the byte would need addresses, which are the
; linker's, so a save through memory is one the analysis never sees come back.
.export .proc keeps_through_memory: keeps x {
    stx save_slot

    ldx #3
    jsr CHROUT

    ldx save_slot
    .state keeps x
    rts
}

; `php` and `plp` hand the carry back across a call, because the stack remembers what the
; push held.
.export .proc keeps_the_carry: keeps c {
    php
    sec
    jsr CHROUT
    plp
    rts
}

; An interrupt handler returns to whatever it broke into, which is where handing the
; registers back matters most. The processor pushes the flags and `rti` pulls them again, so
; the carry comes back however the handler used it.
.proc handler: interrupt, keeps a, c {
    pha
    lda #1
    sec
    sta save_slot
    pla
    rti
}

; A caller that hands nothing back promises nothing, and says so by writing no `keeps`.
.proc draw_row {
    ldy #0
@next:
    lda save_slot
    jsr keeps_by_saving
    iny
    cpy #40
    bne @next
    rts
}

; A routine that never returns hands nothing back to anyone, so a way out through one has
; nothing to keep: `expect_zero` keeps Y although `fail` does not, and `fail` and `restart`,
; which hand control to each other for ever, change it.
.proc fail: noreturn {
    ldy #0
    jmp restart
}

.proc restart: noreturn {
    lda #'?'
    jsr CHROUT
    jmp fail
}

.export .proc expect_zero: keeps y {
    lda save_slot
    bne @wrong
    rts
@wrong:
    jmp fail
}

; A routine that returns past the text after its call pulls its return address first. What that
; pull gets is its caller's, but Y's save and restore after it still cancel.
.segment ZEROPAGE
.data text: .addr

.segment CODE
.export .proc print: inline .strz, keeps y {
    pla
    sta text
    pla
    sta text+1
    tya
    pha
    ldy #0
@next:
    inc text
    bne @read
    inc text+1
@read:
    lda (text),y
    beq @done
    jsr CHROUT
    jmp @next
@done:
    pla
    tay
    lda text+1
    pha
    lda text
    pha
    rts
}
