; What one module keeps to itself, and what two modules may not both claim.
.module first

.export shared as "common", WIDE: abs
.export SMALL: zp       ;! error[export-narrows-address-size]: `SMALL` is `abs`, and an export may widen an address size but not narrow it: `SMALL: abs` or wider

; A segment the project file already declares.
.segment VRAM: abs    ;! error[segment-declared-twice]: segment "VRAM" is already declared

shared = 1
SMALL  = $1234
WIDE   = $12

hidden = 2

; `pal::ink` and `pal__ink` both become `first__pal__ink` for the linker.
.export .scope pal {
    ink = 1
}
pal__ink = 2
.export pal__ink        ;! error[export-name-taken]: `first::pal__ink` and `first::pal::ink` are both exported to the linker as `first__pal__ink`

; A file names its module first, and names it only once.
.module again           ;! error[module-declared-twice]: this file already has a `.module` line: a file is exactly one module

; An exported macro expands in the module that calls it, where it has to be able to reach
; everything it names.
.export .macro poke(value) {        ;! error[macro-names-unexported]: `poke!` is exported but uses `shadow`, which is not exported: the macro expands in the caller's module, where `shadow` cannot be reached
    lda #value
    sta shadow
}
.segment ZEROPAGE
.data shadow: .byte
