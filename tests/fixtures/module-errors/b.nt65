.export shared

; Two modules exporting the same name would be one symbol to the linker, so it is reported
; at the declaration that collides rather than at the `.export` that revealed it.
shared = 3              ;! error: `shared` is exported by two files
DEBUG  = 0              ;! error: `DEBUG` is a define, and a file may not declare one (§5.3)

.proc use {
    lda #hidden         ;! error: `hidden` is declared in `a.nt65` and is not exported
    lda #nowhere        ;! error: `nowhere` is not declared
    rts
}
