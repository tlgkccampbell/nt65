; What a push saves is kept as the routine sees it. In the body of a macro with a signature,
; a `*` item means the state at the call rather than at the routine's entry, so a pull on the
; other side of the body reads back what was pushed, not what `*` means there.
.module main

.cpu 65816

.macro savep(): a8 {
    php
}

.macro restorep(): a8 {
    plp
}

.macro saved(): a16 {
    phd
}

.macro saveb(): a8 {
    phb
}

.macro guarded(): a8 {
    php
    sep #$10
    plp
}

.macro restored(): a16 {
    pld
}

.macro restoreb(): a8 {
    plb
}

.macro widened(): a8 {
    php
    rep #$10
    plp
}

.macro kept_page(): a16 {
    phd
    lda #$2100
    tcd
    pld
}

.macro kept_bank(): a8 {
    phb
    lda #$7e
    pha
    plb
    plb
}

.macro outer(): a8, native {
    php
    phd
    phb
    restoreb!()
    rep #$20
    restored!()
    sep #$20
    restorep!()
}

; A status pushed in the body holds 16-bit X and Y, so the `plp` after it does not restore
; the width the routine was entered with.
.segment CODE
.proc wide_index: a8, i* {
    rep #$10
    savep!()
    plp
    rts                     ;! error[asserted-item-not-restored]: `rts`: `wide_index` declares `i*`, so X and Y must be as wide as they were on entry, but here it may not be
}

; A status pushed before the call holds the width at the routine's entry, which is not the
; 8-bit width at the call.
.proc narrow_index: a8, i* {
    php
    sep #$10
    restorep!()             ;! error[asserted-item-not-restored]: `restorep!` declares `i*`, so X and Y must be as wide as they were on entry, but at the end of its body it may not be
    rts                     ;! error[asserted-item-not-restored]: `rts`: `narrow_index` declares `i*`, so X and Y must be as wide as they were on entry, but here it may not be
}

; The direct page and the data bank pushed in the body are the ones set before the call.
.proc moved_page: a16, dp* {
    lda #$2100
    tcd
    saved!()
    pld
    rts                     ;! error[asserted-item-not-restored]: `rts`: `moved_page` declares `dp*`, so D must be what it was on entry, but here it may not be
}

.proc moved_bank: a8, dbr* {
    lda #$7e
    pha
    plb
    saveb!()
    plb
    rts                     ;! error[asserted-item-not-restored]: `rts`: `moved_bank` declares `dbr*`, so B must be what it was on entry, but here it may not be
}

; A push and a pull that both hold what `*` means are a save and a restore, inside a body or
; across one.
.proc kept_index: a8, i*, dp*, dbr* {
    guarded!()
    php
    restorep!()
    phd
    phb
    saveb!()
    plb
    plb
    pld
    rts
}

; A `plp` restores a 16-bit width only in native mode. Where the mode is not known, a saved 16
; comes back unknown, as it does after `rep`, while a saved 8 comes back as it was.
.proc lost_mode: a16, i16, native -> a?, i?, e? {
    php
    xce
    plp
    lda #$1234              ;! error[width-unknown]: `lda #` needs the width of A, and it is not known here, because `plp` restores a 16-bit width only in native mode, and the mode is not known: a `.state` before it declares which mode it is
    rts
}

.proc kept_eight: a8, i8, native -> a?, i?, e? {
    php
    xce
    plp
    lda #$12
    rts
}

; A push before the call holds what the routine was entered with. A pull in the body gets it
; back as the body's `*` item where the state at the call is still the routine's `*`, and not
; where the routine changed it first.
.proc kept_across: a8, dp*, dbr*, native {
    phd
    phb
    restoreb!()
    rep #$20
    restored!()
    sep #$20
    rts
}

.proc moved_across: a16, dp* {
    phd
    lda #$2100
    tcd
    restored!()             ;! error[asserted-item-not-restored]: `restored!` declares `dp*`, so D must be what it was on entry, but at the end of its body it may not be
    rts                     ;! error[asserted-item-not-restored]: `rts`: `moved_across` declares `dp*`, so D must be what it was on entry, but here it may not be
}

.proc banked_across: a8, dbr* {
    phb
    lda #$7e
    pha
    plb
    restoreb!()             ;! error[asserted-item-not-restored]: `restoreb!` declares `dbr*`, so B must be what it was on entry, but at the end of its body it may not be
    rts                     ;! error[asserted-item-not-restored]: `rts`: `banked_across` declares `dbr*`, so B must be what it was on entry, but here it may not be
}

; A body's `*` item is the state at its call even where the routine does not know that state,
; so a push and a pull in the body still save and restore it.
.proc unknown_at_call: a8, i?, dp?, dbr?, native {
    widened!()
    rep #$20
    kept_page!()
    sep #$20
    kept_bank!()
    rts
}

; A push in one body and a pull in a body called from it agree on what the outer body's `*`
; items mean.
.proc nested_bodies: a8, i?, dp?, dbr?, native {
    outer!()
    rts
}

; A data bank entered as one of a set of banks comes back as that same bank, at the routine's
; level and in a body whose signature declares the set.
.macro banked(): a8, dbr = [$00..$3f, $80..$bf] {
    phb
    phk
    plb
    plb
}

.proc kept_set: a8, dbr = [$00..$3f, $80..$bf] {
    banked!()
    phb
    phk
    plb
    plb
    rts
}
