; Each construct the 65816's analysis cannot follow, written without the annotation it
; needs, and the diagnostic that says which one.
.module main

.cpu 65816

.import print: proc(inline .strz)
.import beep: proc(inline 2)
.import far_away: proc(far)

.segment BSS
.data cmd: .byte

; An indirect jump and an indirect call.
.segment CODE
.proc indirect: a8, i8 {
    jmp (@table,x)          ;! error[indirect-jump-unchecked]: `jmp (@table,x)` is an indirect jump, which nt65 cannot follow: add a `.next` naming the labels it may reach, or `.next ?` where they cannot be named
@table: .addr @go                   ;! error[code-label-as-data]: taking the address of `@go` lets code jump to it unseen: add a `.state` after the label, or name it in a `.next` in `indirect`
@go:
    jsr (@table,x)          ;! error[indirect-call-unchecked]: `jsr (@table,x)` is an indirect call, which nt65 cannot follow: add a `.next` naming the routines it may call
    rts
}

; A table of anything but addresses names no code at all.
.segment RODATA
.data handlers: .word falls, off_the_end

.segment CODE
.proc dispatch: a8, i8 {
    jmp (handlers,x)
    .next handlers          ;! error[next-target-not-a-table]: `handlers` is not a table of addresses: `.next` can name data only when it holds `.addr` or `.faraddr` values
}

; A computed jump.
.proc computed: a8, i8 {
    jmp computed+3          ;! error[computed-jump-unchecked]: `jmp computed+3` jumps to a computed address, which nt65 cannot follow: add a `.next` naming the labels it may reach, or `.next ?` where they cannot be named
}

; `rts` used as a jump.
.proc pushed: a8, i8 {
    pea @there - 1          ;! error[code-label-as-data]: taking the address of `@there` lets code jump to it unseen: add a `.state` after the label, or name it in a `.next` in `pushed`
    rts                     ;! error[pushed-return-unchecked]: `rts` returns to an address pushed in this block, so it is really a jump: add a `.next` naming where it goes;! error[return-past-pushes]: `rts` returns through 2 bytes this routine pushed rather than through its return address: pull them first, or add a `.next` naming where it goes
@there:
    rts
}

; Inline data that does not match the declaration.
.proc talk: a8, i8, native {
    jsr print               ;! error[inline-data-missing]: `print` expects one `.strz` directly after each call, and none follows this one
    jsr beep                ;! error[inline-data-missing]: `beep` expects 2 bytes of data directly after each call, and 1 byte follows this one
    .byte 1
    rts
}

; Data reached by falling through.
.proc skip: a8, i8 {
    lda #1
    .byte $2c               ;! error[runs-into-data]: the instruction above falls into this data: add a `.next` after the data saying where flow goes
    lda #2
    rts
}

; A jump into another routine, to a label nothing declares.
.proc owner: a8, i8 {
    rts
    inner:
    rts
}

.proc intruder: a8, i8 {
    jmp owner::inner        ;! error[entry-not-declared]: `inner` is inside routine `owner`: mark it an entry point with a `.state` after the label
}

; A declared label, jumped into in the wrong state.
.proc declared: a8, i8, native {
    rts
    entry:
    .state a16, i8, native
    lda #$1234
    sep #$20
    rts
}

.proc wrong_state: a8, i8, native {
    jmp declared::entry     ;! error[call-state-mismatch]: `jmp entry` needs `a16`, but A is 8-bit here
}

; Control never comes back from a jump into another routine: that routine returns to this
; one's caller, so what it returns with is what this one hands back, exactly as a tail call to
; it would. An exit of this routine's own that says something else is told so.
.proc leaves_wrongly: a16, i8, native -> a16 {
    jmp declared::entry     ;! error[return-state-mismatch]: `jmp entry` leaves `leaves_wrongly`: `leaves_wrongly` declares it returns with `a16`, but A is 8-bit when `declared` returns
}

; A call to a label inside another routine is checked as a jump into it is: the label declares
; what it takes, and the call returns with what that routine returns with.
.proc calls_inner: a8, i8 {
    jsr owner::inner        ;! error[entry-not-declared]: `inner` is inside routine `owner`: mark it an entry point with a `.state` after the label
    rts
}

.proc calls_wrongly: a8, i8, native {
    jsr declared::entry     ;! error[call-state-mismatch]: `jsr entry` needs `a16`, but A is 8-bit here
    lda #$12
    rts
}

.proc far_owner: far, a8, i8, native {
    rtl
    inside:
    .state a8, i8, native
    rtl
}

.proc calls_far_label: a8, i8, native {
    jsr far_owner::inside   ;! error[call-distance-mismatch]: `inside` is far, so call it with `jsl`
    rts
}

; A label an indirect call's `.next` names is checked as a direct call to it is, and the call
; returns with what the label's routine returns with, merged over every place named.
.segment BSS
.data vectors: .addr

.segment CODE
.proc calls_through: a8, i8, native {
    ldx #0
    jsr (vectors,x)         ;! error[entry-not-declared]: `inner` is inside routine `owner`: mark it an entry point with a `.state` after the label;! error[call-state-mismatch]: `jsr entry` needs `a16`, but A is 8-bit here
    .next owner::inner, declared::entry
    rts
}

.proc widens: a8, i8, native -> a16 {
    rep #$20
    rts
    inside:
    .state a8, i8, native
    rep #$20
    rts
}

.proc calls_wide: a8, i8, native -> a16 {
    ldx #0
    jsr (vectors,x)
    .next widens::inside
    lda #$1234
    rts
}

; A declared label is checked against for the parts its `.state` gives, so those are the only
; parts it may assume: what the routine's own path leaves is no promise to whoever jumps in.
.proc partly: a8, i8 {
    rep #$30
    halfway:
    .state a16, native
    ldx #$1234              ;! error[width-unknown]: `ldx #` needs the width of X and Y, and it is not known here, because `halfway` can be entered from outside `partly`, and its `.state` does not declare the width of X and Y: the `.state` after `halfway` can declare `i8` or `i16`
    sep #$30
    rts
}

.proc from_elsewhere: a8, i8, native {
    rep #$20
    jmp partly::halfway
}

; A `.state` that gives the widths and no mode leaves the mode unknown below the label, and
; the code there that needs it is told that the label's `.state` is the reason, with the mode
; the routine is entered in as the one to declare.
.proc widths_only: a8, i8, native {
    rts
    resumed:
    .state a8, i8
    rep #$20
    lda #$1234              ;! error[width-unknown]: `lda #` needs the width of A, and it is not known here, because `rep #$20` widens nothing in emulation mode, and the mode is not known, as `resumed` can be entered from outside `widths_only`, and its `.state` does not declare the mode: the `.state` after `resumed` can declare `native`
    sep #$20
    rts                     ;! error[return-state-mismatch]: `rts`: `widths_only` declares it returns in native mode, but the mode is not known here, because `resumed` can be entered from outside `widths_only`, and its `.state` does not declare the mode: the `.state` after `resumed` can declare `native`
}

.proc calls_widths_only: a8, i8, native {
    jsr widths_only::resumed
    rts
}

.proc falls_from_widths: a8, i8, native {
    rts
    resumed:
    .state a8, i8
    lda #$12
    .fallthrough needs_native   ;! error[call-state-mismatch]: `.fallthrough needs_native` needs `native`, but the mode is not known here, because `resumed` can be entered from outside `falls_from_widths`, and its `.state` does not declare the mode: the `.state` after `resumed` can declare `native`
}

.proc needs_native: a8, i8, native {
    rts
}

.proc calls_falls_from_widths: a8, i8, native {
    jsr falls_from_widths::resumed
    rts
}

; The stack is the part a declaration cannot give. What the path above such a label pushed is
; not on the stack a jump in arrives with, so a `plp` below it finds no saved status.
.proc saved_across: a8, i8 {
    php
    rep #$30
    resumed:
    .state a16, i16, native
    plp
    lda #$12                ;! error[width-unknown]: `lda #` needs the width of A, and it is not known here, because `resumed` can be entered from outside `saved_across`, and a jump to it has not pushed what the path above the label pushes: move the pushes above `resumed` to the same side of it as the code that reads them; `args n` on `saved_across` declares what the caller of a second entry point pushed
    sep #$30
    rts
}

; A jump in leaves this routine for good, so it returns the way `saved_across` does.
.proc into_saved: a16, i16, native -> a8, i8 {
    jmp saved_across::resumed
}

; And a frame counts from a stack pointer that a jump in leaves somewhere else.
.struct Local {
    count: .word
}

.proc framed: a16, i16 {
    pea 0
    .frame local: Local
    laid_out:
    .state a16, i16, native
    lda local::count,s      ;! error[frame-depth-unknown]: `local::count` is an offset from the stack pointer, but how many bytes are pushed here is not known, because `laid_out` can be entered from outside `framed`, and a jump to it has not pushed what the path above the label pushes: move the pushes above `laid_out` to the same side of it as the code that reads them; `args n` on `framed` declares what the caller of a second entry point pushed
    pla
    rts
}

.proc into_framed: a16, i16, native {
    jmp framed::laid_out
}

; A jump to a label on data.
.proc onto_data: a8, i8 {
    beq @data               ;! error[jump-into-data]: `@data` labels data, and this jumps to it: add a `.state` after the label and a `.next` after the data stating where flow goes
    rts
@data:
    .byte $ea               ;! error[routine-runs-off-the-end]: `onto_data` runs off its end into whatever is emitted after it: add a `.fallthrough` naming the routine it runs into, or use `.next ?` where that cannot be named
}

; A jump into a segment block, whose code then runs off the end of the block.
.proc into_block: a8, i8 {
    jmp @inside
    .segment DATA {
    @inside:
        nop
    @after:
        nop                 ;! error[routine-runs-off-the-end]: `into_block` runs off the end of a segment block into whatever that segment holds next: add a `.next` saying where flow goes, or use `.next ?` where that cannot be named
    }
}

; Falling off the end, and a `.fallthrough` naming a routine that is not the next one written.
.proc falls: a8, i8 {
    nop
    .next ?
}

.proc off_the_end: a8, i8 {
    nop                     ;! error[routine-runs-off-the-end]: `off_the_end` runs off its end into whatever is emitted after it: add a `.fallthrough` naming the routine it runs into, or use `.next ?` where that cannot be named
}

.proc not_adjacent: a8, i8 {
    nop
    .fallthrough falls      ;! error[fallthrough-not-adjacent]: `falls` does not start where this routine ends: `.fallthrough` names the routine directly after it
}

; A `.next` on a return says the return is a jump to the routines it names, which is a tail
; call and is checked as a `jmp` to one of them would be.
.proc landed: a16, i16 {
    rts
}

.proc returns_into_it: a8, i8 {
    pea landed - 1
    rts                     ;! error[call-state-mismatch]: `.next landed` needs `a16`, but A is 8-bit here;! error[call-state-mismatch]: `.next landed` needs `i16`, but X and Y are 8-bit here;! error[return-state-mismatch]: `.next landed` is a tail call: `returns_into_it` declares it returns with `a8`, but A is 16-bit when `landed` returns;! error[return-state-mismatch]: `.next landed` is a tail call: `returns_into_it` declares it returns with `i8`, but X and Y are 16-bit when `landed` returns
    .next landed
}

; Self-modifying code without `.patch`.
.proc patching: a8, i8 {
@op:
    lda $0400
    sta @op+1               ;! error[self-modifying-unchecked]: `sta @op+1` modifies the instruction at `@op`: add `.patch @op` after it to mark the self-modifying code
    rts
}

; A relative call to a far routine that pushes no bank.
.proc relative: a8, i8, native {
    per @back - 1
    brl far_away            ;! error[relative-call-needs-phk]: `far_away` is far: push the bank with `phk` before the `per` of this relative call
@back:
    rts
}

; A jump to a constant address is a tail call to the code there. On the 6502 it needs nothing,
; and on the 65816 that code has to be a routine with a signature, as the target of a call has
; to be, so that what it hands back is known. An extern proc at the address says what it is.
.const ROM = $E000
.proc CHROUT = $FFD2: ?
.proc to_a_number: a8, i8 {
    jmp $FFD2               ;! error[call-target-unknown]: `jmp` must target a routine on the 65816: a `.proc`, an extern proc or a `proc(...)` import
}

.proc to_a_sum: a8, i8 {
    jmp ROM + 4             ;! error[call-target-unknown]: `jmp` must target a routine on the 65816: a `.proc`, an extern proc or a `proc(...)` import
}

.proc to_a_constant: a8, i8 {
    jmp ROM                 ;! error[call-target-not-a-routine]: `ROM` is not a routine: on the 65816, a call or a jump to an address must target a routine or a label inside one, so declare an extern proc at its address, `.proc name = ROM: ...`, which says what state it takes
}

.proc to_an_extern: a8, i8 -> ? {
    jmp CHROUT
}

; An exported label inside a routine is another way in.
.proc exported_inner: a8, i8 {
    rts
    .export inside              ;! error[exported-entry-not-declared]: `inside` is exported from inside routine `exported_inner`: mark it an entry point with a `.state` after the label
    inside:
    rts
}

; Data a macro body leaves in the instruction stream is wrong for the call that runs into it, so
; it is reported at that call. Where the data ends what the call expands to, the `.next` goes
; after the call; anywhere else in the body, it goes in the body.
.macro skip2() {
    .byte $2c
}

.macro skip_inside() {
    lda #1
    .byte $2c
    lda #2
}

.proc skips_at_the_end: a8, i8 {
    lda #1
    skip2!()                ;! error[runs-into-data]: execution falls into the data that the call to `skip2!` ends in: add a `.next` after the call saying where flow goes
}

.proc skips_inside: a8, i8 {
    skip_inside!()          ;! error[runs-into-data]: execution falls into data in the body of `skip_inside!`: add a `.next` after that data in the macro body saying where flow goes
    rts
}

; Any construct a macro body leaves unannotated is reported at the call that expanded it, with
; the body line as a note.
.macro dispatch_on_x() {
    jmp ($1234,x)
}

.proc dispatches: a8, i8 {
    dispatch_on_x!()        ;! error[indirect-jump-unchecked]: `jmp ($1234,x)` is an indirect jump, which nt65 cannot follow: add a `.next` naming the labels it may reach, or `.next ?` where they cannot be named
}
