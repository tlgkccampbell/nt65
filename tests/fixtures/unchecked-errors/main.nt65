; Each construct the 65816's analysis cannot follow, written without the annotation it
; needs, and the diagnostic that says which one.
.module main

.cpu 65816

.import print: proc(inline .strz)
.import beep: proc(inline 2)
.import far_away: proc(far)

.segment BSS
.data cmd: .byte

; An indirect jump and an indirect call.
.segment CODE
.proc indirect: a8, i8 {
    jmp (@table,x)          ;! error[indirect-jump-unchecked]: `jmp (@table,x)` is an indirect jump, which nt65 cannot follow: add a `.next` naming the labels it may reach, or `.next ?` to end the path
@table: .addr @go                   ;! error[code-label-as-data]: the address of code label `@go` is taken here, so it may be jumped to where nt65 cannot see: add a `.state` after the label, or name it in a `.next` in `indirect`
@go:
    jsr (@table,x)          ;! error[indirect-call-unchecked]: `jsr (@table,x)` is an indirect call, which nt65 cannot follow: add a `.next` naming the routines it may call
    rts
}

; A table of anything but addresses names no code at all.
.segment RODATA
.data handlers: .word falls, off_the_end

.segment CODE
.proc dispatch: a8, i8 {
    jmp (handlers,x)
    .next handlers          ;! error[next-target-not-a-table]: `handlers` is not a table of addresses: `.next` can name data only when it is declared with `.addr` or `.faraddr`
}

; A computed jump.
.proc computed: a8, i8 {
    jmp computed+3          ;! error[computed-jump-unchecked]: `jmp computed+3` jumps to a computed address, which nt65 cannot follow: add a `.next` naming the labels it may reach, or `.next ?` to end the path
}

; `rts` used as a jump.
.proc pushed: a8, i8 {
    pea @there - 1          ;! error[code-label-as-data]: the address of code label `@there` is taken here, so it may be jumped to where nt65 cannot see: add a `.state` after the label, or name it in a `.next` in `pushed`
    rts                     ;! error[pushed-return-unchecked]: `rts` returns to an address pushed in this block, so it is really a jump: add a `.next` naming where it goes
@there:
    rts
}

; Inline data that does not match the declaration.
.proc talk: a8, i8 {
    jsr print               ;! error[inline-data-missing]: `print` expects one `.strz` directly after each call, and none follows this one
    jsr beep                ;! error[inline-data-missing]: `beep` expects 2 bytes of data directly after each call, and 1 byte follows this one
    .byte 1
    rts
}

; Data reached by falling through.
.proc skip: a8, i8 {
    lda #1
    .byte $2c               ;! error[runs-into-data]: the instruction above falls through into this data: add a `.next` after the data stating where flow goes instead
    lda #2
    rts
}

; A jump into another routine, to a label nothing declares.
.proc owner: a8, i8 {
    rts
    inner:
    rts
}

.proc intruder: a8, i8 {
    jmp owner::inner        ;! error[entry-not-declared]: `inner` is inside routine `owner`: to jump into another routine, declare the label an entry point with a `.state` after it
}

; A declared label, jumped into in the wrong state.
.proc declared: a8, i8 {
    rts
    entry:
    .state a16, i8, native
    lda #$1234
    sep #$20
    rts
}

.proc wrong_state: a8, i8 {
    jmp declared::entry     ;! error[call-state-mismatch]: `jmp entry` needs `a16`, but A is 8-bit here
}

; Control never comes back from a jump into another routine: that routine returns to this
; one's caller, so what it returns with is what this one hands back, exactly as a tail call to
; it would. An exit of this routine's own that says something else is told so.
.proc leaves_wrongly: a16, i8 -> a16 {
    jmp declared::entry     ;! error[return-state-mismatch]: `jmp entry` leaves `leaves_wrongly`: `leaves_wrongly` declares it returns with `a16`, but A is 8-bit when `declared` returns
}

; A declared label is checked against for the parts its `.state` gives, so those are the only
; parts it may assume: what the routine's own path leaves is no promise to whoever jumps in.
.proc partly: a8, i8 {
    rep #$30
    halfway:
    .state a16, native
    ldx #$1234              ;! error[width-unknown]: `ldx #` needs the width of X and Y, and it is not known here, because `halfway` can be entered from outside `partly`, and its `.state` does not declare the width of X and Y: the `.state` after `halfway` can declare `i8` or `i16`
    sep #$30
    rts
}

.proc from_elsewhere: a8, i8 {
    rep #$20
    jmp partly::halfway
}

; The stack is the part a declaration cannot give. What the path above such a label pushed is
; not on the stack a jump in arrives with, so a `plp` below it finds no saved status.
.proc saved_across: a8, i8 {
    php
    rep #$30
    resumed:
    .state a16, i16, native
    plp
    lda #$12                ;! error[width-unknown]: `lda #` needs the width of A, and it is not known here, because `resumed` can be entered from outside `saved_across`, and a jump to it has not pushed what the path above the label pushes: move the pushes above `resumed` to the same side of it as the code that reads them; `args n` on `saved_across` declares what the caller of a second entry point pushed
    sep #$30
    rts
}

; A jump in leaves this routine for good, so it returns the way `saved_across` does.
.proc into_saved: a16, i16 -> a8, i8 {
    jmp saved_across::resumed
}

; And a frame counts from a stack pointer that a jump in leaves somewhere else.
.struct Local {
    count: .word
}

.proc framed: a16, i16 {
    pea 0
    .frame local: Local
    laid_out:
    .state a16, i16, native
    lda local::count,s      ;! error[frame-depth-unknown]: `local::count` is an offset from the stack pointer, but how many bytes are pushed here is not known, because `laid_out` can be entered from outside `framed`, and a jump to it has not pushed what the path above the label pushes: move the pushes above `laid_out` to the same side of it as the code that reads them; `args n` on `framed` declares what the caller of a second entry point pushed
    pla
    rts
}

.proc into_framed: a16, i16 {
    jmp framed::laid_out
}

; A jump to a label on data.
.proc onto_data: a8, i8 {
    beq @data               ;! error[jump-into-data]: `@data` labels data, and this jumps to it: add a `.state` after the label and a `.next` after the data stating where flow goes
    rts
@data:
    .byte $ea               ;! error[routine-runs-off-the-end]: `onto_data` runs off its end into whatever is emitted after it: add a `.fallthrough` naming the routine it runs into, or use `.next ?` to end the path
}

; Falling off the end, and a `.fallthrough` naming a routine that is not the next one written.
.proc falls: a8, i8 {
    nop
    .next ?
}

.proc off_the_end: a8, i8 {
    nop                     ;! error[routine-runs-off-the-end]: `off_the_end` runs off its end into whatever is emitted after it: add a `.fallthrough` naming the routine it runs into, or use `.next ?` to end the path
}

.proc not_adjacent: a8, i8 {
    nop
    .fallthrough falls      ;! error[fallthrough-not-adjacent]: `falls` does not start where this routine ends: `.fallthrough` can only name the routine that comes directly after it in the same segment
}

; A `.next` on a return says the return is a jump to the routines it names, which is a tail
; call and is checked as a `jmp` to one of them would be.
.proc landed: a16, i16 {
    rts
}

.proc returns_into_it: a8, i8 {
    pea landed - 1
    rts                     ;! error[call-state-mismatch]: `.next landed` needs `a16`, but A is 8-bit here;! error[call-state-mismatch]: `.next landed` needs `i16`, but X and Y are 8-bit here;! error[return-state-mismatch]: `.next landed` is a tail call: `returns_into_it` declares it returns with `a8`, but A is 16-bit when `landed` returns;! error[return-state-mismatch]: `.next landed` is a tail call: `returns_into_it` declares it returns with `i8`, but X and Y are 16-bit when `landed` returns
    .next landed
}

; Self-modifying code without `.patch`.
.proc patching: a8, i8 {
@op:
    lda $0400
    sta @op+1               ;! error[self-modifying-unchecked]: `sta @op+1` modifies the instruction at `@op`: add `.patch @op` after it to mark the self-modifying code
    rts
}

; A relative call to a far routine that pushes no bank.
.proc relative: a8, i8 {
    per @back - 1
    brl far_away            ;! error[relative-call-needs-phk]: `far_away` is far: push the bank with `phk` before the `per` of this relative call
@back:
    rts
}

; An exported label inside a routine is another way in.
.proc exported_inner: a8, i8 {
    rts
    .export inside              ;! error[exported-entry-not-declared]: `inside` is inside routine `exported_inner`, and exporting it lets other modules jump into it: declare it an entry point with a `.state` after the label
    inside:
    rts
}
