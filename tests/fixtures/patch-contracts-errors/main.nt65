; Stores into code and calls nt65 cannot follow, under declared contracts. Each store has to
; say what it writes, and each contract has to hold whatever that turns out to be.
.module main

.cpu 6502

.export variant_in_operand, opcode_unknown, operand_only, reads_opcode, calls_out
.export jumps_out, calls_out_cleanly, listed_variant, calls_declared, indexed_listed
.export through_name, through_name_listed, two_stores, past_into_next, past_into_data
.export before_into_previous, patches_next, patches_nothing, into_expansion_label
.export into_next_routine, after_next_routine

.proc EXT = $FFD2
.proc DECLARED = $FFE4: reads a

.segment ZEROPAGE
.data pointer: .addr

.segment BSS
.data vector: .addr

.segment CODE

; A variant replaces the opcode, so a store into the operand alone has none to list.
.proc variant_in_operand {
    sta @op+1
    .patch @op as and       ;! error[patch-variant-rejected]: `.patch` cannot list `and` for `lda`: the store writes only the operand, so there is no variant to list
@op:
    lda #0
    bne @skip
    inx
@skip:
    rts
}

; A store into the opcode has to list what the instruction can become. Without `as` the
; instruction may be anything, so the register analysis takes it to change every register.
.proc opcode_unknown: keeps x {
    lda #.opcode(ldx, imm)
    sta @op
    .patch @op              ;! error[patch-variants-required]: `sta @op` may write the opcode of `@op`, so the `.patch` must list what the instruction can become with `as`
@op:
    lda #5
    rts                     ;! error[keeps-broken]: `opcode_unknown` promises `keeps x`, but X is not the same as on entry here: restore it before returning, or add `.state keeps x` at the point where the entry value is restored
}

; A store into the operand alone leaves the instruction what it is.
.proc operand_only: keeps x {
    sta @op+1
    .patch @op
@op:
    lda #5
    rts
}

; An instruction a store may rewrite into anything may use any register.
.proc reads_opcode: reads none {
    lda #.opcode(adc, imm)
    sta @op
    .patch @op              ;! error[patch-variants-required]: `sta @op` may write the opcode of `@op`, so the `.patch` must list what the instruction can become with `as`
    ldx #0
    ldy #0
    clv
@op:
    lda #5                  ;! error[reads-undeclared]: `reads_opcode` declares `reads none`, but uses the value its caller left in C: add `c` to `reads`, or set the carry with `clc` or `sec` first
    rts
}

; Listing what the store writes keeps the contract checkable.
.proc listed_variant: keeps x, reads none {
    lda #.opcode(ora, imm)
    sta @op
    .patch @op as ora
@op:
    lda #5
    rts
}

; An indexed store may write any byte of the instruction, the opcode among them, so it lists
; what the instruction can become. The registers follow the variant. The operand is unknown, so
; the flags no longer show that `beq` is always taken.
.proc indexed_listed: keeps x, y {
    lda #.opcode(ora, imm)
    sta @op,x
    .patch @op as ora
@op:
    lda #0
    beq @skip
    .byte 1                 ;! error[runs-into-data]: the instruction above falls into this data: add a `.next` after the data saying where flow goes
@skip:
    rts
}

; A store through another name, here a pointer, may write any byte of the instruction too.
.proc through_name {
    ldy #0
    lda #.opcode(ora, imm)
    sta (pointer),y
    .patch @op              ;! error[patch-variants-required]: `sta (pointer),y` may write the opcode of `@op`, so the `.patch` must list what the instruction can become with `as`
@op:
    lda #5
    rts
}

; Listing the variant makes it as checkable as a store that names the label.
.proc through_name_listed: keeps x {
    lda #.opcode(ora, imm)
    ldy #0
    sta (pointer),y
    .patch @op as ora
@op:
    lda #5
    rts
}

; Each store into the opcode needs its variants, and a store into the operand alone does not.
.proc two_stores {
    lda #.opcode(ora, imm)
    sta @op
    .patch @op              ;! error[patch-variants-required]: `sta @op` may write the opcode of `@op`, so the `.patch` must list what the instruction can become with `as`
    lda #7
    sta @op+1
    .patch @op
    ldy #0
    sta @op,y
    .patch @op              ;! error[patch-variants-required]: `sta @op,y` may write the opcode of `@op`, so the `.patch` must list what the instruction can become with `as`
@op:
    lda #5
    rts
}

; A store's bytes must lie inside the instruction its `.patch` names. Two bytes past a two-byte
; instruction is the opcode of the one after it, which the fix names in the `.patch` instead.
.proc past_into_next {
    sta @op+2
    .patch @op              ;! error[patch-misses-store]: `sta @op+2` writes past `@op`, which is 2 bytes, into `inx` at `@next` after it: name `@next` with a `.patch`
@op:
    lda #0
@next:
    inx
    rts
}

; Bytes past the instruction may land in data, which needs no `.patch`. Naming the branch makes
; its flags unknown, so the `.next` says where it goes.
.proc past_into_data {
    sec
    sta @op+2
    .patch @op              ;! error[patch-misses-store]: `sta @op+2` writes past `@op`, which is 2 bytes, into the data `.byte 1` after it; a `.patch` names an instruction, and a store into data needs none
@op:
    bcs @skip
    .next @skip
    .byte 1
@skip:
    rts
}

; Bytes before the instruction land in the one before it, here in its operand.
.proc before_into_previous {
    sta @op-1
    .patch @op              ;! error[patch-misses-store]: `sta @op-1` writes before `@op`, which is 1 byte, into `ldx #0` before it: label that instruction and name it with a `.patch`
    ldx #0
@op:
    inx
    rts
}

; The bytes are placed from where the label the store names stands. This store writes the
; operand of `@next`, which its `.patch` names, so it needs no variants and no `.patch @op`.
.proc patches_next {
    sta @op+3
    .patch @next
@op:
    lda #0
@next:
    lda #0
    rts
}

; Every `.patch` under a store names an instruction the store writes. This store misses `@op`
; entirely, so `.patch @op` names nothing and the fix removes it.
.proc patches_nothing {
    sta @op+3
    .patch @op              ;! error[patch-misses-store]: `sta @op+3` writes past `@op`, which is 2 bytes, into `lda #0` at `@next` after it, which `.patch @next` already names: remove this `.patch`
    .patch @next
@op:
    lda #0
@next:
    lda #0
    rts
}

; A label inside a macro's expansion is not one the routine's `.patch` can name, even where it
; is spelled the same as one of the routine's own labels.
.macro patched_load() {
@op:
    lda #0
}

.proc into_expansion_label {
    sta @op+2
    .patch @op              ;! error[patch-misses-store]: `sta @op+2` writes past `@op`, which is 2 bytes, into `lda #0` after it: label that instruction and name it with a `.patch`
@op:
    lda #0
    patched_load!()
    rts
}

; Bytes past the end of a routine land in the next routine's code, which a `.patch` here cannot
; name.
.proc into_next_routine {
    sta @op+3
    .patch @op              ;! error[patch-misses-store]: `sta @op+3` writes past `@op`, which is 2 bytes, into `lda pointer`, the first instruction of routine `after_next_routine`, after it: a store into another routine's code is declared there
@op:
    lda #0
    rts
}

.proc after_next_routine {
    lda pointer
    rts
}

; A routine with no body in the program may use any register its caller left a value in.
.proc calls_out: reads none {
    jsr EXT                 ;! error[reads-undeclared]: `calls_out` declares `reads none`, but uses the value its caller left in A, X, Y, C, Z, N, V through `EXT`, which nt65 cannot follow: add them to `reads`, give them values first, or declare what `EXT` reads
    rts
}

; So may code an indirect jump reaches.
.proc jumps_out: reads none {
    jmp (vector)            ;! error[reads-undeclared]: `jumps_out` declares `reads none`, but uses the value its caller left in A, X, Y, C, Z, N, V where control passes to code nt65 cannot follow: add them to `reads`, or give them values first
    .next ?
}

; Where nothing the caller left is still in a register, such a call can read none of it.
.proc calls_out_cleanly: reads none {
    lda #0
    ldx #0
    ldy #0
    clc
    clv
    jsr EXT
    rts
}

; A routine with no body that declares what it reads is taken at its word.
.proc calls_declared: reads a {
    jsr DECLARED
    rts
}
