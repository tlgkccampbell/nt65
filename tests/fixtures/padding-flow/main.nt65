; Padding inside a routine that flow runs through. A `.res` or `.align` with a constant fill byte
; holds that byte, and `$ea` is `nop` on every CPU, a one-byte instruction that does nothing, so a
; `.next` after it may say that flow runs on through it. A `jmp` over padding whose fill nt65
; cannot work out needs nothing.
.module main

.export filled_align, filled_res, jumped_over

.segment CODE
.proc filled_align {
    ldx #0
    .align 256, $ea
    .next @loop
@loop:
    dex
    bne @loop
    rts
}

.proc filled_res {
    ldx #0
    .res 3, $ea
    .next @loop
@loop:
    dex
    bne @loop
    rts
}

.proc jumped_over {
    ldx #0
    jmp @loop
    .align 256
@loop:
    dex
    bne @loop
    rts
}
