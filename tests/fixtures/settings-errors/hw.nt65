; What a setting, `.select` and `.has` refuse.
.module hw

.const HIDDEN   ?= 1
.const LOOP     ?= LOOP_TOO         ;! error[defined-in-terms-of-itself]: `LOOP` is defined in terms of itself
.const LOOP_TOO ?= LOOP
.const WORDS    ?= "text"           ;! error[setting-is-text]: a setting must be a number, not text
.const SIZE     ?= LIMIT
.const LIMIT     = 4
.const MEASURED ?= .sizeof(here)    ;! error[setting-default-undecided]: the default of `MEASURED` uses a value the configuration does not decide

.if HIDDEN {
    .const NESTED ?= 1              ;! error[setting-misplaced]: a setting must be at file level, outside every block
}

.if .has(LIMIT) {                   ;! error[has-argument]: `.has` takes a mnemonic, such as `.has(phx)`
}

.const TWO     = .select(1, 2)                ;! error[select-arguments]: `.select` takes a condition and the two values it chooses between: `.select(c, a, b)`
.const UNKNOWN = .select(1, MISSING_NAME, 0)  ;! error[not-declared]: `MISSING_NAME` is not declared
.const ADDRESS = .select(here, 1, 0)          ;! error[select-condition-not-constant]: a `.select` condition must be a constant
.export TWO, UNKNOWN, ADDRESS, WORDS, SIZE, LOOP, MEASURED

.segment CODE
.proc here {
    rts
}
