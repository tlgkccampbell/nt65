; What a `.config`, `.select` and `.has` refuse.
.module hw

.config HIDDEN = 1
.config LOOP = LOOP_TOO             ;! error[defined-in-terms-of-itself]: `LOOP` is defined in terms of itself
.config LOOP_TOO = LOOP
.config WORDS = "text"              ;! error[config-is-text]: a `.config` value must be a number, not text
.config SIZE = LIMIT                ;! error[condition-names-the-program]: `LIMIT` is not a define or a `.config` setting: an `.if` condition can only test the build configuration; use `.assert` to check the program
LIMIT = 4

.if HIDDEN {
    .config NESTED = 1              ;! error[config-misplaced]: `.config` must be at file level, outside every block
}

.if .has(LIMIT) {                   ;! error[has-argument]: `.has` takes a mnemonic, such as `.has(phx)`
}

TWO = .select(1, 2)                 ;! error[select-arguments]: `.select` takes a condition and the two values it chooses between: `.select(c, a, b)`
UNKNOWN = .select(1, MISSING_NAME, 0) ;! error[not-declared]: `MISSING_NAME` is not declared
ADDRESS = .select(here, 1, 0)       ;! error[select-condition-not-constant]: a `.select` condition must be a constant
.export TWO, UNKNOWN, ADDRESS, WORDS, SIZE, LOOP

.segment CODE
.proc here {
    rts
}
