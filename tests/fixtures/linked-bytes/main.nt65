; A value that names an address has no value nt65 knows, so the output writes it for ld65 to
; work out once the address is known. A `.func` given an address is written as its body, with
; the argument in place of the parameter. ca65 refuses an absolute address in a one-byte slot
; whatever the value comes to, so a value there that always fits a byte is written as its low
; byte, which loses nothing.
.module main

.export main, basic, more, parts, shifted

.func digit(n, place) = '0' + (n / place) .mod 10
.func after(n) = n + 1
.func triple(n) = n * 3
.func entry(n) = after(n) - 1
.func scaled(n) = (n << 15) .mod 10

.segment CODE

; The digits of the entry point, as a C64 BASIC `SYS` line spells them.
.data basic {
    .byte digit(main, 1000), digit(main, 100), digit(main, 10), digit(main, 1)
}

; A call nested in another, a call in a word, and a call narrowed with `<`.
.data more {
    .word after(main), entry(main)
    .byte <triple(main), digit(main, 1) - '0'
}

; ld65 works a value out in C's `long`, which is 32 bits on Windows. Shifted 15 places, an
; absolute address stays below $7fff8000, inside those 32 bits, so the `.mod` bounds it to a digit.
.data shifted: .byte scaled(main)

; Operators on an address with no function involved, and a byte operator, which needs nothing.
.data parts {
    .byte main / 256, main .mod 10, (main >> 8) & $0f, (<main) + 1
}

.proc main {
    lda #digit(after(main), 1)
    ldx #<triple(main)
    lda #<entry(main)
    ldy #main / 256
    rts
}
