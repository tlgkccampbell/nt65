; What the processor-state analysis reports, each where the problem is used rather than
; where two paths happen to disagree.
.module main

.cpu 65816

.import printf: proc(a8, i16)
.import far_away: proc(far)
.import plain

.segment BSS
.data value: .word

; An immediate needs a known width.
.segment CODE
.proc unknown_width: a? {
    lda #1                  ;! error[width-unknown]: `lda #` needs the width of A, and it is not known here, because `unknown_width` declares `a?` at entry: an `.ensure` sets it
    rts
}

; `i*` assumes nothing, so the width it keeps is not known inside the routine.
.proc kept: i* {
    ldx #1                  ;! error[width-unknown]: `ldx #` needs the width of X and Y, and `kept` declares `i*`, which assumes nothing about it
    rts
}

; Two paths that disagree meet at a label, and the use after it is what is reported.
.proc merged: a8, i8, native {
    lda value
    beq @done
    rep #$20
@done:
    cmp #1                  ;! error[width-unknown]: `cmp #` needs the width of A, and it is not known here, because the paths that reach here leave A 8-bit on one and 16-bit on another: an `.ensure` sets it whichever path was taken
    sep #$20
    rts
}

; A return has to reach the state the signature declares, and leave the way it is called.
.proc wrong_exit: a8 -> a16 {
    rts                     ;! error[return-state-mismatch]: `rts`: `wrong_exit` declares it returns with `a16`, but A is 8-bit here
}

.proc wrong_return: far {
    rts                     ;! error[return-distance-mismatch]: `wrong_return` is far, so it returns with `rtl`
}

.proc changed: a* {
    rep #$20
    rts                     ;! error[asserted-item-not-restored]: `rts`: `changed` declares `a*`, so A must be as wide as it was on entry, but here it may not be
}

; A call has to meet the routine's entry, and use the instruction its distance calls for.
.proc wrong_entry: a16, i8 -> a8, i16 {
    jsr printf              ;! error[call-state-mismatch]: `jsr printf` needs `a8`, but A is 16-bit here;! error[call-state-mismatch]: `jsr printf` needs `i16`, but X and Y are 8-bit here
    rts
}

.proc calls: a8, i8 {
    jsr far_away            ;! error[call-distance-mismatch]: `far_away` is far, so call it with `jsl`
    jsl calls               ;! error[call-distance-mismatch]: `calls` is near, so call it with `jsr`
    jsr plain               ;! error[call-target-not-a-routine]: `plain` is not a routine: on the 65816, a call or a jump to an address must target a routine or a label inside one, so import `plain` with `proc(...)`, which says what state it takes
    jsr value               ;! error[call-target-not-a-routine]: `value` is not a routine: on the 65816, a call or a jump to an address must target a routine or a label inside one, so declare an extern proc at its address, `.proc name = value: ...`, which says what state it takes
    jsr @inside             ;! error[entry-not-declared]: `@inside` is inside routine `calls`: mark it an entry point with a `.state` after the label
    rts
@inside:
    rts
}

; A call to a label in its own routine enters it as a call from anywhere would, so the label
; declares what it takes and the call returns with what the routine returns with.
.proc calls_itself: a8, i8, native -> a8, i8 {
    rep #$20
    jsr @half               ;! error[call-state-mismatch]: `jsr @half` needs `a8`, but A is 16-bit here
    lda #$12
    rts
@half:
    .state a8, i8, native
    lda #$34
    rts
}

; A tail call's return is this routine's return, so it must reach this routine's exit state.
.proc tail: a16, i8, native -> a8 {
    jmp wrong_entry         ;! error[return-state-mismatch]: `jmp wrong_entry` is a tail call: `tail` declares it returns with `i8`, but X and Y are 16-bit when `wrong_entry` returns
}

; An assertion that disagrees with what is known.
.proc asserted: a8 {
    .state a16              ;! error[state-width-mismatch]: `.state a16` does not match: A is 8-bit here
    .state near             ;! error[state-item-not-a-point]: `near` describes a whole routine, not one point in it: put it in the routine's signature, not in `.state`
    rts                     ;! error[return-state-mismatch]: `rts`: `asserted` declares it returns with `a8`, but A is 16-bit here
}

; A label nothing reaches has no state to size an immediate with.
.proc orphan: a8, i8 {
    rts
@lost:                      ;! warning[label-unreachable]: `@lost` is never reached: no code falls into it and nothing refers to it; if it is an entry point nt65 cannot see, add a `.state` after it, and otherwise remove it
    lda #1                  ;! error[width-unknown]: `lda #` needs the width of A, and no path from `orphan`'s entry reaches it. A `.state` after its label declares what the state is there
    rts
}

; Signatures that contradict themselves.
.proc twice: a8, a16 {      ;! error[signature-item-twice]: `a8` and `a16` both describe the same part of the state
    rts
}

.proc handed_back: a8 -> a* {   ;! error[unchanged-needs-entry]: `a*` after `->` needs `a*` before it too: a routine can promise to return a part unchanged only if it assumes nothing about it on entry
    rts
}

.proc pinned: emu, a16 {    ;! error[width-in-emulation]: `a16` is impossible in emulation mode, where A, X and Y are always 8-bit
    rts
}

; Outside a routine there is no processor state.
.state a8               ;! error[state-outside-a-routine]: `.state` must be inside a `.proc`

; A long call or jump reaches a far target; a near label is reached by the near form.
.proc long_to_near: a8, i8 {
    jml @near               ;! error[target-too-near]: `jml` is for a far target, and this one is absolute: use `jmp`
@near:
    jml $008000
    .next ?                 ; a constant address is somewhere the analysis does not follow
}

; Another name for a routine declares what the routine does, or every call through it is
; checked against a routine that does not exist.
.proc worker: a8, i16 {
    rts
}

.proc worker_long = worker: a8, i16, far        ;! error[alias-distance-mismatch]: `worker_long` is declared far, but `worker`, the routine it names, is near
.proc worker_wide = worker: a16, i16            ;! error[alias-signature-mismatch]: `worker_wide` is declared `a16, i16, native, near`, but `worker`, the routine it names, is `a8, i16, native, near`: another name for a routine must declare the same signature
.proc worker_same = worker: a8, i16

; What made a width unknown is named where the width is needed.
.proc pulled: a8, i8 {
    plp
    lda #1                  ;! error[width-unknown]: `lda #` needs the width of A, and it is not known here, because `plp` pulls a status that no `php` in this routine pushed: an `.ensure` after it sets it
    sep #$30
    rts
}

.proc swapped: a8, i8 {
    xce
    ldx #1                  ;! error[width-unknown]: `ldx #` needs the width of X and Y, and it is not known here, because `xce` follows neither `clc` nor `sec`: a `.state` after it declares what it is
    .next ?
}

; A `clc` before `xce` enters native mode from either mode. Where the mode before it is not
; known, an 8-bit width stays 8, which it is in either, and only a 16-bit width is lost.
.proc either_mode: a8, i16, native {
    .state e?
    clc
    xce
    lda #1
    ldx #1                  ;! error[width-unknown]: `ldx #` needs the width of X and Y, and it is not known here, because `xce` enters native mode from a mode that is not known, and a 16-bit width is 8 bits if that was emulation mode: a `.state` before it declares which mode it is
    rep #$10
    rts
}

; A `*` a routine writes is what it declares, and one it leaves out is a default it takes.
.proc by_default {
    lda #1                  ;! error[width-unknown]: `lda #` needs the width of A, and `by_default` takes the default `a*`, which assumes nothing about it
    lda d:$10               ;! error[direct-page-unknown]: `d:$0010` is reached through the direct page, and `by_default` takes the default `dp*`, which assumes nothing about D
    rts
}

.proc declared_star: dp* {
    lda d:$10               ;! error[direct-page-unknown]: `d:$0010` is reached through the direct page, and `declared_star` declares `dp*`, which assumes nothing about D
    rts
}

.segment RODATA
.data defaults: .addr by_default, declared_star

; A routine that declares nothing about the mode is entered in native mode by default where
; a caller's mode is not known, and the message says it is a default.
.segment CODE
.proc native_by_default {
    rts
}

.export .proc unknown_mode: a8, i8, e? {
    jsr native_by_default   ;! error[call-state-mismatch]: `jsr native_by_default` needs `native`, which `native_by_default` takes by default, but the mode is not known here
    .next ?
}

; A recursive call is one of a routine's callers, so a call to itself in another width
; disagrees with the others where the body depends on the width.
.proc recurse {             ;! error[callers-disagree]: `recurse` is called with `a16` by some callers and `a8` by others, and `lda #` depends on the width of A
    lda #1
    cmp value
    bcs @done
    rep #$20
    jsr recurse
@done:
    sep #$20
    rts
}

.export .proc recurse_caller: a8, native {
    jsr recurse
    sep #$20
    rts
}

; Callers that disagree on the mode leave it `*`, which a body that needs native mode says.
.proc needs_native {
    .ensure a16             ;! error[ensure-needs-native]: `.ensure a16` needs native mode, and the mode is not known here, because `needs_native` is called with `emu` and `native`
    sep #$20
    rts
}

.export .proc from_native: a8, i8, native {
    jsr needs_native
    rts
}

.export .proc from_emulation: emu {
    jsr needs_native
    rts
}
