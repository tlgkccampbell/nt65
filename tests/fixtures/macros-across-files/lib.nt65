; A macro is no symbol to the linker: what crosses a module boundary is its expansion,
; written into whichever module called it, with whatever it uses brought in there.
.module lib

.export set16, delay, measure, SCREEN, tiles

.const SCREEN = $0400

.segment RODATA
.data tiles: .byte 0, 1, 2, 3

.macro set16(dest: operand, value) {
    lda #<value
    sta dest
    lda #>value
    sta dest+1
}

; A body that uses a name it was not given. `tiles` is exported, so an expansion can
; reach it wherever it lands.
.macro delay(count) {
    ldx #count
@loop:
    lda tiles
    dex
    bne @loop
}

; A body that measures the declaration it is given. The end each call writes is that of the
; declaration the call names, which the module that declares it labels and exports.
.macro measure(item: ident) {
    lda #<.endof(item)
    ldx #<.spanof(item)
}
