.module main

; A macro another module exports is brought in to be called; what its body names is the
; other module's, and needs nothing brought in here.
.use lib::{set16, delay}

.segment ZEROPAGE
.data ptr: .word

; A name of the file's own that an expansion's label would otherwise become: the
; expansion's gives way, since only fixed spellings are kept.
.segment CODE
.proc delay__loop {
    rts
}

.proc main {
    set16!(ptr, lib::SCREEN)
    delay!(4)
    delay!(8)
    rts
}
