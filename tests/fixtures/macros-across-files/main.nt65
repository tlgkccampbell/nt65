.module main

; A macro another module exports is brought in to be called; what its body names is the
; other module's, and needs nothing brought in here.
.use lib::{set16, delay}

.segment ZEROPAGE
.data ptr: .word

; A name of this file's own that an expansion's generated label would also take: the generated
; label is renamed, since names written in the source keep their spelling.
.segment CODE
.export .proc delay__loop {
    rts
}

.export .proc main {
    set16!(ptr, lib::SCREEN)
    delay!(4)
    delay!(8)
    rts
}
