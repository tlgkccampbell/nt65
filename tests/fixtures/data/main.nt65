; Every data directive nt65 sizes, text written out as byte values with the
; source spelling kept in a comment, and expressions parenthesized so that nothing in the
; output depends on ca65's precedence table.
.module main

.cpu 6502

SCREEN = $0400

.segment RODATA
.data table:    .byte 1, 2, $ff, 'A', "text"
.data words:    .word $1234, table
.data wide:     .dword $12345678
.data here:     .addr table
.data there:    .faraddr table
.data greeting: .strz "hello"
.data padding:  .byte[16] {
    .repeat 16 {
        $ff
    }
}
.data escaped: .byte "a\nb", '\x7f'
.data bytes:   .byte <SCREEN, >SCREEN, SCREEN .mod 256
.data sums:    .byte 1 + 2 * 3, (1 + 2) * 3, 1 + 2 + 3

.segment CODE
.proc use {
    lda #' '
    lda table+1
    rts
}

; Exported, so that what the file only declares counts as used.
.export words, wide, here, there, greeting, padding, escaped, bytes, sums
