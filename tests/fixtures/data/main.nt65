; Every data directive Stage 5 sizes, text written out as byte values with the
; source spelling kept in a comment, and expressions parenthesized so that nothing in the
; output depends on ca65's precedence table.
.cpu 6502

SCREEN = $0400

.rodata {
table:      .byte 1, 2, $ff, 'A', "text"
words:      .word $1234, table
wide:       .dword $12345678
here:       .addr table
there:      .faraddr table
greeting:   .asciiz "hello"
padding:    .res 16, $ff
escaped:    .byte "a\nb", '\x7f'
bytes:      .byte <SCREEN, >SCREEN, SCREEN .mod 256
sums:       .byte 1 + 2 * 3, (1 + 2) * 3, 1 + 2 + 3
}

.proc use {
    lda #' '
    lda table+1
    rts
}
