; What ca65 would refuse, reported by nt65 where it was written.
.module main

.cpu 65816

; A value ca65 takes only unsigned.
TEXT = "hello"

.segment CODE
.scope things {
    VALUE = 1
}

.segment BSS
.data buffer: .word

.segment RODATA
.data values {
    .byte -1                ;! error: -1 is negative, and ca65 takes no negative value here: its two's complement is $ff
    .word -2                ;! error: -2 is negative, and ca65 takes no negative value here: its two's complement is $fffe
    .res 2, -1              ;! error: -1 is negative, and ca65 takes no negative value here: its two's complement is $ff
    .byte TEXT              ;! error: `TEXT` is text, which is written out only as a literal: a text constant is used through `.strlen` and `.strat`
    .byte .strlen(TEXT)
    .addr things            ;! error: `things` is a scope, which has no address: a routine or data inside it does
}

.segment CODE
.proc main: a8, i16 {
    lda #-1                 ;! error: -1 is negative, and ca65 takes no negative value here: its two's complement is $ff
    lda things              ;! error: `things` is a scope, which has no address: a routine or data inside it does
    pei (buffer)            ;! error: `pei` has only a direct-page form of this operand, and `buffer` is absolute
    lda (buffer),y          ;! error: `lda` has only a direct-page form of this operand, and `buffer` is absolute
    ldx #.sizeof(@table)    ;! error: `@table` is a label, which is only a position: `.sizeof` measures a `.data` declaration, a routine or a type
    ldx #.countof(@table)   ;! error: `@table` is a label, which is only a position: `.countof` measures a `.data` declaration, a routine or a type
    rts
@table: .byte 1, 2
}

; A nested segment block naming the segment it is already in would leave its contents inline.
.proc hold: a8, i8 {
    .segment CODE {                     ;! error: this block names "CODE", the segment it is already in, so its contents would stay inline where fall-through reaches them
    @inline:
        .state native, a8, i8
        rts
    }
    rts
}
