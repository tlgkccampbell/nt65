; What ca65 would refuse, reported by nt65 where it was written.
.module main

.cpu 65816

.const TEXT = "hello"

.segment CODE
.scope things {
    .const VALUE = 1
}

.segment BSS
.data buffer: .word

.segment RODATA
.data values {
    .byte TEXT
    .byte .strlen(TEXT)
    .addr things            ;! error[scope-has-no-address]: `things` is a scope and has no address: name a routine or data inside it instead
}

.segment CODE
.proc main: a8, i16 {
    lda things              ;! error[scope-has-no-address]: `things` is a scope and has no address: name a routine or data inside it instead
    pei (buffer)            ;! error[addressing-mode-too-narrow]: `pei` has only a direct-page form of this operand, and `buffer` is absolute
    lda (buffer),y          ;! error[addressing-mode-too-narrow]: `lda` has only a direct-page form of this operand, and `buffer` is absolute
    ldx #.sizeof(@table)    ;! error[not-measurable]: `.sizeof` cannot measure `@table`, a label: it measures data, routines and types
    ldx #.countof(@table)   ;! error[not-measurable]: `.countof` cannot measure `@table`, a label: it measures data, routines and types
    plx
    rts
@table: .byte 1, 2
}

; A nested segment block naming the segment it is already in would leave its contents inline.
.proc hold: a8, i8 {
    .segment CODE {                     ;! error[segment-block-redundant]: this block is already in segment `CODE`, so it moves nothing, and execution falls into it
    @inline:
        .state native, a8, i8
        rts
    }
    rts
}
