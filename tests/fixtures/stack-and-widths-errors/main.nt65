; What is wrong with `.ensure`, `.frame` and macro state signatures, each where it can be
; fixed.
.module main

.cpu 65816

.struct Locals {
    count: .word
    src:   .addr
}

; A 16-bit width needs native mode, and `.ensure` takes widths only.
.segment CODE
.proc pinned: emu -> emu {
    .ensure a16             ;! error[ensure-needs-native]: `.ensure a16` needs native mode, and the processor is in emulation mode here, where both widths are 8 bits
    .ensure native          ;! error[ensure-item-not-a-width]: `.ensure` takes only `a8`, `a16`, `i8` and `i16`, not `native`
    rts
}

; A frame bigger than what is pushed, and slots where they cannot be counted.
.proc frames: a16, i16 {
    pea 0
    .frame short: Locals    ;! error[frame-past-the-stack]: frame `short` is 4 bytes, but only 2 bytes are pushed here
    pea 0
    .frame locals: Locals
    lda #locals::count      ;! error[frame-member-not-stack-relative]: `locals::count` is a stack slot, usable only on its own as a stack-relative operand: `locals::count,s`
    pla
    pla
    lda locals::src,s       ;! error[frame-gone]: `locals::src` is in frame `locals`, which has been pulled off the stack here
    txs
    lda short::src,s        ;! error[frame-gone]: `short::src` is in frame `short`, which has been pulled off the stack here
    rts
}

; A macro with a signature is called in the state it declares, leaves the one it declares,
; and assumes nothing about what it does not declare.
.macro load8(value): a8 {
    lda #value
}

.macro widen(): a8 -> a16 {
    nop
}

.macro index(value): a8 {
    ldx #value
}

.macro keep(body: block): a8, native {
    body
}

.proc macros: a16 {
    load8!(1)               ;! error[call-state-mismatch]: `load8!` needs `a8`, but A is 16-bit here
    sep #$20
    widen!()                ;! error[return-state-mismatch]: `widen!` declares it returns with `a16`, but A is 8-bit at the end of its body
    rep #$20
    sep #$20
    index!(1)               ;! error[width-unknown]: `ldx #` needs the width of X and Y, and `index!` declares `i*`, which assumes nothing about it
    keep!() {               ;! error[block-changes-state]: the block given to `keep!` must leave the processor state as it found it: it starts with `a8, i*, native` and ends with `a16, i*, native`;! error[return-state-mismatch]: `keep!` declares it returns with `a8`, but A is 16-bit at the end of its body
        rep #$20
    }
    rep #$20
    rts
}

; Outside a routine there is no stack and no widths to set.
.ensure a8              ;! error[state-outside-a-routine]: `.ensure` is only allowed inside a `.proc`: it describes a point in a routine's code
