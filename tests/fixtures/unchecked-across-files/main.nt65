; Jumps into a routine another module declares: checked against the declaration there, as a
; jump within one file is.
.module main

.cpu 65816

.segment CODE
.proc right: a8, i8 {
    jmp owner::owner::entry
}

.proc wrong: a16, i8 -> a8 {
    jmp owner::owner::entry     ;! error[call-state-mismatch]: `jmp entry` needs `a8`, but A is 16-bit here
}

.proc undeclared: a8, i8 {
    jmp owner::owner::plain     ;! error[entry-not-declared]: `plain` is inside routine `owner`: to jump into another routine, declare the label an entry point with a `.state` after it
}
