; Jumps into a routine another module declares: checked against the declaration there, as a
; jump within one file is.
.module main

.cpu 65816

.segment CODE
.proc right: a8, i8 {
    jmp owner::owner::entry
}

.proc wrong: a16, i8 {
    jmp owner::owner::entry     ;! error: `jmp entry` needs `a8`, and A is 16-bit here
}

.proc undeclared: a8, i8 {
    jmp owner::owner::plain     ;! error: `plain` is inside `owner`, and a jump into another routine needs the label declared: a `.state` after it says what the state is there
}
