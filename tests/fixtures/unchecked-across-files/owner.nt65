; A routine whose interior other modules jump into. Each label they reach is exported, and
; its `.state` is what a jump from anywhere is checked against.
.module owner

.cpu 65816

.segment CODE
.proc owner: a16, i8 -> a8 {
    lda #$1234
    sep #$20
.export entry
entry:
    .state a8, i8, native
    lda #$12
    rts
.export plain                   ;! error: `plain` is inside `owner`, and exporting it lets other modules jump into the routine: a `.state` after the label says what the state is there
plain:
    rts
}
