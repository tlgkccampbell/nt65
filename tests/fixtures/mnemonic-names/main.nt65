; No mnemonic is reserved, so a routine, a constant, a label and a data declaration may be
; named after one. What the output does about it is ca65's business: a name ca65 would read
; as an instruction where the output defines it is written with its module in front.
;
; The names here are chosen so that what is said about them is the same on every CPU this
; fixture is built for. `swa`, `tad`, `ina` and `dea` are spellings ca65 has and nt65 does
; not, so nothing is said about them at all and only the output moves; `per` and `xba` are
; instructions of the 65816 alone, so the warning names that CPU whichever build this is.
.module main

.use other

; A constant, which the output writes where it stands.
.const swa = $12
.const per = $34                    ;! warning[mnemonic-name]: `per` is legal as a name but reads as the 65816 instruction

; A word only the 6502x has an instruction by. The rule is the same in every project, so the
; warning is here whichever of these CPUs the build is for.
.const arr = $56                    ;! warning[mnemonic-name]: `arr` is legal as a name but reads as the 6502x instruction

.segment ZEROPAGE
.data tad: .byte                    ; data named for an alias ca65 has on the 65816
.data ina: .byte                    ; and for one it has on every CMOS part

.segment RODATA
.data pair: .byte swa, per, arr     ; the constants, written where they are used

.segment CODE

; A routine ca65 would read as an instruction on the 65816, called from this module and
; from another one.
.export .proc dea {
    lda tad
    rts
}

.proc xba {                     ;! warning[mnemonic-name]: `xba` is legal as a name but reads as the 65816 instruction
@dea:
    ldx ina
    bne @dea
    rts
}

.proc main: native {
    jsr dea
    jsr xba
    jsr other::tsa
    lda pair
    rts
}

.export main
