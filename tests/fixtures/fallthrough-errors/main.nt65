; What `.fallthrough` and `.next` refuse. `.fallthrough` stands last in a routine's body and
; names the routine written directly after it in the same segment; `.next` names successors
; only where the statement above it has none nt65 can read.
.module main

.cpu 65816

.export misplaced, under_an_if, not_adjacent, first, second, other_segment, not_a_routine
.export after_lda, after_call, in_the_middle, narrows, wants_wide

.segment BANKED: abs

.segment ZEROPAGE
.data value: .byte

.segment CODE
.proc misplaced: a8 {
    .fallthrough first  ;! error[fallthrough-misplaced]: `.fallthrough` must be the last line of a `.proc` body, once `.if` conditions are resolved
    rts
}

.proc under_an_if: a8 {
    lda #0
    .if 1 {
        .fallthrough first  ;! error[fallthrough-misplaced]: `.fallthrough` must be the last line of a `.proc` body, once `.if` conditions are resolved
    }
    rts
}

.proc not_adjacent: a8 {
    lda #1
    .fallthrough second ;! error[fallthrough-not-adjacent]: `second` does not start where this routine ends: `.fallthrough` can only name the routine that comes directly after it in the same segment
}

.proc first: a8 {
    rts
}

.proc second: a8 {
    lda #2
    .fallthrough other_segment  ;! error[fallthrough-other-segment]: `other_segment` is in segment "BANKED", and this routine ends in "CODE": a routine can only run into what comes next in its own segment
}

.segment BANKED
.proc other_segment: a8 {
    rts
}

.segment CODE
.proc not_a_routine: a8 {
    lda #3
    .fallthrough value  ;! error[fallthrough-not-a-routine]: `value` is a data declaration, not a routine: `.fallthrough` names the routine execution runs into
}

; A macro body is not a routine's body, whichever routine calls the macro.
.macro runs_on() {
    .fallthrough first  ;! error[fallthrough-misplaced]: `.fallthrough` must be the last line of a `.proc` body, once `.if` conditions are resolved
}

; A `.next` ending the body where nt65 already knows where flow goes: after an ordinary
; instruction or a direct call, the error says to write `.fallthrough` instead.
.proc after_lda: a8 {
    lda #4
    .next after_call    ;! error[next-successors-known]: `.next` is not allowed here: nt65 already knows that `lda #4` continues with the next statement; if this routine runs into the one after it, use `.fallthrough`
}

.proc after_call: a8 {
    jsr first
    .next in_the_middle ;! error[next-successors-known]: `.next` is not allowed here: nt65 already knows that `jsr first` calls `first` and comes back; if this routine runs into the one after it, use `.fallthrough`
}

; A `.next` in the middle of a body says nothing that is not already known either.
.proc in_the_middle: a8 {
    jmp @out
    .next @out          ;! error[next-successors-known]: `.next` is not allowed here: nt65 already knows that `jmp @out` goes to `@out`
@out:
    rts
}

; A fall-through is a tail call: the next routine is entered with A 8 bits wide where it wants 16.
.proc narrows: a8 {
    lda #5
    .fallthrough wants_wide ;! error[call-state-mismatch]: `.fallthrough wants_wide` needs `a16`, but A is 8-bit here;! error[return-state-mismatch]: `.fallthrough wants_wide` is a tail call: `narrows` declares it returns with `a8`, but A is 16-bit when `wants_wide` returns
}

.proc wants_wide: a16 {
    rts
}

; A `.fallthrough` in a branch ends the body only when its `.if` chain is the last thing in the
; body and the `.fallthrough` is the branch's own last line.
.proc chain_then_more: a8 {
    .if 1 {
        .fallthrough wants_wide ;! error[fallthrough-misplaced]: `.fallthrough` must be the last line of a `.proc` body, once `.if` conditions are resolved
    } .else {
        rts
    }
    .if 1 {
        rts
    }
}

.proc not_last_in_branch: a8 {
    .if 1 {
        .fallthrough wants_wide ;! error[fallthrough-misplaced]: `.fallthrough` must be the last line of a `.proc` body, once `.if` conditions are resolved
        lda #6
    }
    rts
}

.proc in_a_repetition: a8 {
    .repeat 1 {
        .fallthrough wants_wide ;! error[fallthrough-misplaced]: `.fallthrough` must be the last line of a `.proc` body, once `.if` conditions are resolved
    }
    rts
}

; What a branch the build takes names is checked as any `.fallthrough` is; the one it does not
; take is not read.
.proc taken_not_adjacent: a8 {
    lda #7
    .if 1 {
        .fallthrough narrows    ;! error[fallthrough-not-adjacent]: `narrows` does not start where this routine ends: `.fallthrough` can only name the routine that comes directly after it in the same segment
    } .else {
        .fallthrough no_such_routine
    }
}

.proc after_taken: a8 {
    rts
}
