.cache/
.vs/
bin/
obj/

# The syntax classes the source generator writes from Syntax/Syntax.xml, kept on disk to be read.
src/Norristown.Core/Generated/
node_modules/

# scripts/package.ps1: the packages, and the server it publishes into the extension.
artifacts/
editors/vscode/server/

# `nt65 build` in a fixture writes its output, named by module, into the fixture; snapshots live in expected/.
tests/fixtures/*/*.s
tests/fixtures/*/.nt65-outputs

# Corpus and example build outputs.
tests/corpus/*/build/
examples/*/build/
