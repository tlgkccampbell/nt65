# LF everywhere, whatever core.autocrlf says. Fixture snapshots are compared byte for
# byte, and `.dbg file` records source sizes, so line endings must not depend on the
# machine that checked the repository out. (The compiler still accepts CRLF in source.)
* text=auto eol=lf

# The scripts, said again for themselves: a `sh` on Linux refuses a CRLF shebang, and pwsh
# and the workflows are read on both systems from the same checkout.
*.sh text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf

# Binary inputs for .incbin and similar fixtures.
*.bin binary
*.chr binary
*.png binary

# Sources that are deliberately not LF-only: what an editor on another machine writes.
tests/encodings/* -text
