{
  "version": "0.2.0",
  "configurations": [
    {
      // Opens this repository in an Extension Development Host with the nt65 client
      // loaded. The client starts the Debug build of the server, which the pre-launch
      // task has just rebuilt.
      //
      // --new-window is required, not a preference. This repository is already open in
      // the window you press F5 in, and asking VS Code to open a folder it already has
      // open makes it hand the request to that window and kill the one it just started
      // ("Sent env to running instance. Terminating..."), so the development host closes
      // the moment it appears.
      "name": "nt65 extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--new-window",
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "${workspaceFolder}"
      ],
      "preLaunchTask": "build",
      // The client starts the language server, which is a .NET process and not something
      // the JavaScript debugger should follow into.
      "autoAttachChildProcesses": false
    },
    {
      // The server runs as a child of the Extension Development Host, so it is attached
      // to rather than launched: pick Norristown.LanguageServer from the list. Needs the
      // C# extension.
      "name": "Attach to the language server",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
