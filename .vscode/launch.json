{
  "version": "0.2.0",
  "configurations": [
    {
      // Starts an Extension Development Host with the nt65 client loaded, and no folder:
      // open the repository or any example in it from there. The client starts the Debug
      // build of the server, which the pre-launch task has just rebuilt.
      //
      // It opens no folder because the folder worth opening is usually this repository,
      // which the window you press F5 in already has open, and VS Code hands a request to
      // open a folder it already has to the window that has it.
      "name": "nt65 extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/editors/vscode"],
      "preLaunchTask": "build",
      // The client is plain JavaScript beside its package.json. Without these, the debugger
      // looks for scripts and source maps across the whole repository, which holds the
      // extension's node_modules, the published server and the packages.
      "outFiles": ["${workspaceFolder}/editors/vscode/*.js"],
      "resolveSourceMapLocations": ["${workspaceFolder}/editors/vscode/*.js"]
    },
    {
      // The server runs as a child of the Extension Development Host, so it is attached
      // to rather than launched: pick Norristown.LanguageServer from the list. Needs the
      // C# extension.
      "name": "Attach to the language server",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
