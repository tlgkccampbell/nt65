<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A Roslyn component runs inside the compiler, which is netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Norristown.SyntaxGenerator</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008 asks for analyzer release tracking, which matters for a published package with
         users; this generator is built beside the code it generates and has one diagnostic. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pinned no newer than the compiler the SDK ships, since that compiler has to load this. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
