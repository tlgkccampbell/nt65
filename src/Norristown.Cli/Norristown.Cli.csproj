<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>nt65</AssemblyName>
    <RootNamespace>Norristown.Cli</RootNamespace>
    <!-- Packaged as a .NET tool by scripts/package.ps1, which says how to install it. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nt65</ToolCommandName>
    <PackageId>nt65</PackageId>
    <Description>The Norristown Assembler: transpiles nt65, an assembly language for the 6502 family and the 65816, to ca65.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Norristown.Core\Norristown.Core.csproj" />
    <!-- `nt65 lsp` serves the language server, so the tool carries it. -->
    <ProjectReference Include="..\Norristown.LanguageServer\Norristown.LanguageServer.csproj" />
  </ItemGroup>
</Project>
