; Bodies of routines for multiplication, division and decimal numbers.
;
; These routines are too large to expand at every call, and nt65 writes no library code of its
; own. Each macro therefore writes the instructions of one routine, and the program declares
; the routine around it, with its own name, segment and `rts`:
;
;     .proc multiply {
;         mul16_body!(factor1, factor2, product)
;         rts
;     }
;
; The values are unsigned and stored low byte first. Each body destroys A, X and the flags, and
; `div16_body!` and `decimal16_body!` destroy Y as well. On the 65816 each needs 8-bit registers.
.module nt65::math

.export mul16_body, div16_body, decimal16_body

; Multiplies the 2-byte multiplicand and multiplier and stores the 4-byte result in product.
; The inputs keep their values. Product must not overlap either input.
.macro mul16_body(multiplicand: operand(zp, abs), multiplier: operand(zp, abs),
                  product: operand(zp, abs)): a8, i8 {
    ; The multiplier starts in the low half of product, which shifts right by one bit for each
    ; bit of it. The bit that falls out of the bottom says whether the multiplicand is added
    ; to the high half before the next shift.
    lda #0
    sta product+2
    sta product+3
    lda multiplier
    sta product
    lda multiplier+1
    lsr a
    sta product+1
    ror product
    ldx #16
@bit:
    bcc @shift
    lda product+2
    clc
    adc multiplicand
    sta product+2
    lda product+3
    adc multiplicand+1
    sta product+3
@shift:
    ror product+3
    ror product+2
    ror product+1
    ror product
    dex
    bne @bit
}

; Divides the 2-byte dividend by the 2-byte divisor. It replaces dividend with the quotient and
; stores the remainder in the 2-byte remainder. Division by 0 gives a quotient of $ffff and
; leaves the dividend as the remainder.
.macro div16_body(dividend: operand(zp, abs), divisor: operand(zp, abs),
                  remainder: operand(zp, abs)): a8, i8 {
    ; Each bit of the dividend shifts into the remainder, from the top. When the remainder is then
    ; at least the divisor, the divisor is subtracted and the quotient gets a 1 bit, which goes
    ; into the bottom of the dividend as it shifts out.
    lda #0
    sta remainder
    sta remainder+1
    ldx #16
@bit:
    asl dividend
    rol dividend+1
    rol remainder
    rol remainder+1
    lda remainder
    sec
    sbc divisor
    tay
    lda remainder+1
    sbc divisor+1
    bcc @next
    sta remainder+1
    sty remainder
    inc dividend
@next:
    dex
    bne @bit
}

; Writes the 2-byte value as five decimal digits, with leading zeros, in the five bytes at
; digits. Each digit is written as zero plus its value, and the `$30` default suits ASCII and
; PETSCII. The macro destroys value, which is 0 afterwards.
.macro decimal16_body(value: operand(zp, abs), digits, zero: const(0..$f6) = $30): a8, i8 {
    ; Each pass divides value by 10. The remainder is the next digit, from the right.
    ldy #4
@digit:
    lda #0
    ldx #16
@bit:
    asl value
    rol value+1
    rol a
    cmp #10
    bcc @next
    sbc #10
    inc value
@next:
    dex
    bne @bit
    clc
    adc #zero
    sta digits,y
    dey
    bpl @digit
}
