# The node table: one description of every class in the red tree, and the only place a new kind
# of node is written down. `pwsh scripts/generate-syntax.ps1` turns it into the classes under
# Syntax/Nodes/Generated/, the kind-to-class switch in Syntax/InternalSyntax/Generated/, and the
# visitors in Syntax/Generated/. A test fails when what is checked in no longer matches.
#
# A block per node, in the order the files list, so two people adding kinds touch two places:
#
#   node <Class> : <Base>            the class and what it derives from
#     kind <Kind>...                 the SyntaxKind (or kinds) whose nodes are of this class
#     summary <text>                 the class's summary; repeat the key for a summary of several lines
#     abstract                       the class is abstract: no kind, no Accept, no visitor method
#     internal                       the class is internal: it gets an Accept, but no visitor method
#     handwritten                    the class is written by hand; only its Accept is generated
#     partial                        a hand-written half holds members the table cannot say
#     slot <Name> : <Type>           a piece of the node, as the property that reads it
#       summary <text>               the property's summary; repeatable as above
#       read <expression>            what the property returns
#       nodes                        every child node of the item type, made once and kept
#       cache <expression>           the expression, worked out once and kept
#     member <Name> : <Type>         a property that is not a piece of the node
#
# A slot's type is the property's type, so a trailing `?` is the whole of what optional means
# today: the parser never invents a piece, and a piece it did not find is absent and reads as
# null. The `read` of every slot is a search among the children for that reason; when the slots
# become fixed, the reads go and the type stays.

node AbsoluteOperandSyntax : OperandSyntax
  kind AbsoluteOperand
  summary <c>expr</c>, <c>expr,x</c>, <c>z:expr</c>, or the <c>expr, expr</c> of a bit branch.
  slot Prefix : AddressPrefixSyntax?
    summary The <c>z:</c>, <c>a:</c>, <c>f:</c> or <c>d:</c>, or null.
    read FirstNode<AddressPrefixSyntax>()
  slot Address : ExpressionSyntax
    summary The address.
    read FirstNode<ExpressionSyntax>()!
  slot CommaToken : SyntaxToken?
    summary The <c>,</c>, or null.
    read FirstToken(SyntaxKind.Comma)
  slot IndexRegister : SyntaxToken?
    summary The <c>x</c>, <c>y</c> or <c>s</c> after the <c>,</c>, or null.
    read FirstToken(SyntaxKind.Register)
  slot Second : ExpressionSyntax?
    summary The second expression of a bit branch, or null.
    read NodeAfter(CommaToken) as ExpressionSyntax

node AccumulatorOperandSyntax : OperandSyntax
  kind AccumulatorOperand
  summary The <c>a</c> of <c>asl a</c>.
  slot Register : SyntaxToken
    summary The <c>a</c>.
    read ChildTokens[0]

node AddressPrefixSyntax : SyntaxNode
  kind AddressPrefix
  summary <c>z:</c>, <c>a:</c>, <c>f:</c> or <c>d:</c> before an address.
  slot Name : SyntaxToken
    summary The letter.
    read ChildTokens[0]
  slot ColonToken : SyntaxToken
    summary The <c>:</c>.
    read ChildTokens[1]

node ArgumentListSyntax : SyntaxNode
  kind ArgumentList
  summary <c>(a, b)</c>: the arguments of a call or of a macro call.
  slot OpenParenToken : SyntaxToken
    summary The <c>(</c>.
    read ChildTokens[0]
  slot Arguments : ImmutableArray<SyntaxNode>
    summary The arguments. A call's are expressions; a macro call's may also be braced operands and named arguments.
    read ChildNodes
  slot CloseParenToken : SyntaxToken?
    summary The <c>)</c>, or null.
    read FirstToken(SyntaxKind.CloseParen)

node AssertDirectiveSyntax : StatementSyntax
  kind AssertDirective
  summary <c>.assert expr, "message"</c>, whose message may be left out.
  slot Keyword : SyntaxToken
    summary The <c>.assert</c> that starts the line.
    read ChildTokens[0]
  slot Condition : ExpressionSyntax
    summary What is asserted.
    read FirstNode<ExpressionSyntax>()!
  slot Level : SyntaxToken?
    summary ca65's level, which nt65 reports, or null.
    read FirstToken(SyntaxKind.Identifier) ?? FirstToken(SyntaxKind.Register) ?? FirstToken(SyntaxKind.Mnemonic)
  slot Message : SyntaxToken?
    summary The quoted message, or null.
    read FirstToken(SyntaxKind.StringLiteral)

node BankRangeSyntax : SyntaxNode
  kind BankRange
  summary <c>$80</c> or <c>$00..$3f</c>: one bank or a range of them.
  slot First : ExpressionSyntax
    summary The bank, or the first of the range.
    read (ExpressionSyntax)ChildNodes[0]
  slot DotDotToken : SyntaxToken?
    summary The <c>..</c>, or null.
    read FirstToken(SyntaxKind.DotDot)
  slot Last : ExpressionSyntax?
    summary The last bank of the range, or null.
    read ChildNodes.Length > 1 ? (ExpressionSyntax)ChildNodes[1] : null

node BinaryExpressionSyntax : ExpressionSyntax
  kind BinaryExpression
  summary <c>left op right</c>.
  slot Left : ExpressionSyntax
    summary The left operand.
    read (ExpressionSyntax)ChildNodes[0]
  slot OperatorToken : SyntaxToken
    summary The operator.
    read ChildTokens[0]
  slot Right : ExpressionSyntax
    summary The right operand.
    read (ExpressionSyntax)ChildNodes[1]

node BlankLineSyntax : StatementSyntax
  kind BlankLine
  summary A line holding nothing, or nothing but a comment.

node BlockCloseLineSyntax : StatementSyntax
  kind BlockCloseLine
  summary A <c>}</c> on its own line.
  slot CloseBraceToken : SyntaxToken
    summary The <c>}</c>.
    read ChildTokens[0]

node BlockContinuationSyntax : StatementSyntax
  kind BlockContinuation
  summary <c>} name {</c>: the line that closes one block argument of a macro call and opens the next.
  slot CloseBraceToken : SyntaxToken
    summary The <c>}</c>.
    read ChildTokens[0]
  slot Name : SyntaxToken
    summary The parameter the next block is given to.
    read ChildTokens[1]
  slot OpenBraceToken : SyntaxToken
    summary The <c>{</c>.
    read ChildTokens[2]

node BlockSpliceSyntax : StatementSyntax
  kind BlockSplice
  summary A name on its own line, which splices a <c>block</c> parameter.
  slot Name : SyntaxToken
    summary The parameter spliced.
    read ChildTokens[0]

node BlockSyntax : SyntaxNode
  kind Block
  handwritten

node BracedOperandSyntax : SyntaxNode
  kind BracedOperand
  summary <c>{buf,x}</c>: a whole operand as a macro argument.
  slot OpenBraceToken : SyntaxToken
    summary The <c>{</c>.
    read ChildTokens[0]
  slot Operand : OperandSyntax
    summary The operand.
    read (OperandSyntax)ChildNodes[0]
  slot CloseBraceToken : SyntaxToken?
    summary The <c>}</c>, or null.
    read FirstToken(SyntaxKind.CloseBrace)

node CallExpressionSyntax : ExpressionSyntax
  kind CallExpression
  summary <c>name(args)</c> or <c>.function(args)</c>.
  slot Callee : NameExpressionSyntax?
    summary The <c>.func</c> called, or null for a built-in function.
    read ChildNodes[0] as NameExpressionSyntax
  slot Function : SyntaxToken?
    summary The built-in function called, or null for a <c>.func</c>.
    read TokenAt(0) is { Kind: SyntaxKind.Directive } function ? function : null
  slot Arguments : ArgumentListSyntax
    summary The arguments.
    read FirstNode<ArgumentListSyntax>()!

node CharacterExpressionSyntax : LiteralExpressionSyntax
  kind CharacterExpression
  summary A character in single quotes.

node CharmapDeclarationSyntax : TypeDeclarationSyntax
  kind CharmapDeclaration
  summary <c>.charmap name {</c>.

node CharmapEntrySyntax : StatementSyntax
  kind CharmapEntry
  summary One entry of a <c>.charmap</c>: a character, or a range of them, and a value.
  slot First : ExpressionSyntax
    summary The character, or the first of the range.
    read (ExpressionSyntax)ChildNodes[0]
  slot DotDotToken : SyntaxToken?
    summary The <c>..</c>, or null.
    read FirstToken(SyntaxKind.DotDot)
  slot Last : ExpressionSyntax?
    summary The last character of the range, or null.
    read DotDotToken is null ? null : (ExpressionSyntax)ChildNodes[1]
  slot EqualsToken : SyntaxToken?
    summary The <c>=</c>, or null.
    read FirstToken(SyntaxKind.Equals)
  slot Value : ExpressionSyntax
    summary The value the first character maps to.
    read (ExpressionSyntax)ChildNodes[DotDotToken is null ? 1 : 2]

node ConditionalDirectiveSyntax : StatementSyntax
  abstract
  summary A line that opens a branch with a condition: <c>.if expr {</c> or <c>} .elseif expr {</c>.
  slot Keyword : SyntaxToken
    summary The <c>.if</c> or <c>.elseif</c>.
    read FirstToken(SyntaxKind.Directive)!.Value
  slot Condition : ExpressionSyntax
    summary The condition the branch is taken on.
    read FirstNode<ExpressionSyntax>()!
  slot OpenBraceToken : SyntaxToken?
    summary The <c>{</c> that opens the block, or null when it is not written.
    read FirstToken(SyntaxKind.OpenBrace)

node ConfigDeclarationSyntax : StatementSyntax
  kind ConfigDeclaration
  summary <c>.config NAME = value</c>: a setting, whose value the build may give instead.
  slot Keyword : SyntaxToken
    summary The <c>.config</c> that starts the line.
    read ChildTokens[0]
  slot Name : SyntaxToken?
    summary The setting's name, or null.
    read TokenAt(1) is { Kind: SyntaxKind.Identifier } name ? name : null
  slot EqualsToken : SyntaxToken?
    summary The <c>=</c>, or null.
    read FirstToken(SyntaxKind.Equals)
  slot Value : ExpressionSyntax?
    summary The setting's value, or null.
    read FirstNode<ExpressionSyntax>()

node ConstantDeclarationSyntax : StatementSyntax
  kind ConstantDeclaration
  summary <c>name = expr</c>.
  slot Name : SyntaxToken
    summary The constant's name.
    read ChildTokens[0]
  slot EqualsToken : SyntaxToken
    summary The <c>=</c>.
    read ChildTokens[1]
  slot Value : ExpressionSyntax
    summary The constant's value.
    read FirstNode<ExpressionSyntax>()!

node CpuDirectiveSyntax : StatementSyntax
  kind CpuDirective
  summary <c>.cpu name</c>.
  slot Keyword : SyntaxToken
    summary The <c>.cpu</c> that starts the line.
    read ChildTokens[0]
  slot Cpu : SyntaxToken?
    summary The CPU's name, or null.
    read TokenAt(1)

node CpuNameExpressionSyntax : LiteralExpressionSyntax
  kind CpuNameExpression
  summary A CPU's name, where an expression is read.

node CurrentAddressExpressionSyntax : ExpressionSyntax
  kind CurrentAddressExpression
  summary <c>*</c>: the address of the statement it is written in.
  slot StarToken : SyntaxToken
    summary The <c>*</c>.
    read ChildTokens[0]

node DataDeclarationSyntax : StatementSyntax
  kind DataDeclaration
  summary <c>.data name: element</c>, or <c>.data name {</c> for mixed data.
  slot Keyword : SyntaxToken
    summary The <c>.data</c> that starts the line.
    read ChildTokens[0]
  slot Name : SyntaxToken?
    summary The declared name, or null.
    read NameAt(1)
  slot ColonToken : SyntaxToken?
    summary The <c>:</c> before what the data is, or null.
    read FirstToken(SyntaxKind.Colon)
  slot Directive : DataDirectiveSyntax?
    summary What the data is, or null.
    read FirstNode<DataDirectiveSyntax>()
  slot OpenBraceToken : SyntaxToken?
    summary The <c>{</c> that opens the block, or null when it is not written.
    read FirstToken(SyntaxKind.OpenBrace)

node DataDirectiveSyntax : StatementSyntax
  kind DataDirective
  summary A data directive: <c>.byte 1, 2</c>, <c>.word[4] { … }</c>, <c>.type T { x = 1 }</c>, <c>.incbin "f"</c>.
  slot Directive : SyntaxToken
    summary The directive.
    read ChildTokens[0]
  member IsRecord : bool
    summary Whether the directive is <c>.type</c>, whose element is a named type.
    read Directive.Text.Equals(".type", StringComparison.OrdinalIgnoreCase)
  slot Type : NameExpressionSyntax?
    summary The <c>T</c> of <c>.type T</c>, or null.
    read IsRecord && ChildNodes.Length > 0 ? ChildNodes[0] as NameExpressionSyntax : null
  slot Count : ElementCountSyntax?
    summary The <c>[n]</c> or <c>[]</c> after the element type, or null.
    read FirstNode<ElementCountSyntax>()
  slot OpenBraceToken : SyntaxToken?
    summary The <c>{</c> that opens a body holding the values, or null.
    read FirstToken(SyntaxKind.OpenBrace)
  slot Values : ImmutableArray<SyntaxNode>
    summary What is written after the element type and its count: expressions, or one braced list or record.
    cache [.. ChildNodes.Where(node => node != Type && node is not ElementCountSyntax)]

node DataValuesSyntax : StatementSyntax
  kind DataValues
  summary One line of a data body: values separated by commas, one element each.
  slot Values : ImmutableArray<SyntaxNode>
    summary The values: expressions and braced lists or records.
    read ChildNodes

node EachDirectiveSyntax : RepetitionDirectiveSyntax
  kind EachDirective
  summary <c>.each what, name {</c>.

node ElementCountSyntax : SyntaxNode
  kind ElementCount
  summary <c>[n]</c>, or <c>[]</c> for as many elements as the values given.
  slot OpenBracketToken : SyntaxToken
    summary The <c>[</c>.
    read ChildTokens[0]
  slot Count : ExpressionSyntax?
    summary The count, or null for <c>[]</c>.
    read FirstNode<ExpressionSyntax>()
  slot CloseBracketToken : SyntaxToken?
    summary The <c>]</c>, or null.
    read FirstToken(SyntaxKind.CloseBracket)

node ElementIndexSyntax : SyntaxNode
  kind ElementIndex
  summary <c>[i]</c> after a name: which element of a counted declaration it stands for.
  slot OpenBracketToken : SyntaxToken
    summary The <c>[</c>.
    read ChildTokens[0]
  slot Index : ExpressionSyntax?
    summary The element, or null.
    read FirstNode<ExpressionSyntax>()
  slot CloseBracketToken : SyntaxToken?
    summary The <c>]</c>, or null.
    read FirstToken(SyntaxKind.CloseBracket)

node ElseDirectiveSyntax : StatementSyntax
  kind ElseDirective
  summary <c>} .else {</c>.
  slot CloseBraceToken : SyntaxToken
    summary The <c>}</c> that closes the branch before.
    read ChildTokens[0]
  slot Keyword : SyntaxToken
    summary The <c>.else</c>.
    read ChildTokens[1]
  slot OpenBraceToken : SyntaxToken?
    summary The <c>{</c> that opens the block, or null when it is not written.
    read FirstToken(SyntaxKind.OpenBrace)

node ElseIfDirectiveSyntax : ConditionalDirectiveSyntax
  kind ElseIfDirective
  summary <c>} .elseif expr {</c>.
  slot CloseBraceToken : SyntaxToken
    summary The <c>}</c> that closes the branch before.
    read ChildTokens[0]

node EmptyBlockSyntax : SyntaxNode
  kind EmptyBlock
  summary <c>{}</c>: the default of a block parameter a call may leave out.
  slot OpenBraceToken : SyntaxToken
    summary The <c>{</c>.
    read ChildTokens[0]
  slot CloseBraceToken : SyntaxToken
    summary The <c>}</c>.
    read ChildTokens[1]

node EnsureDirectiveSyntax : StateListDirectiveSyntax
  kind EnsureDirective
  summary <c>.ensure a16, i8</c>: the widths to make hold.

node EnumDeclarationSyntax : TypeDeclarationSyntax
  kind EnumDeclaration
  summary <c>.enum name {</c>.

node EnumMemberSyntax : StatementSyntax
  kind EnumMember
  summary One member of an <c>.enum</c>: a name, or a name and the value it is given.
  slot Name : SyntaxToken
    summary The member's name.
    read ChildTokens[0]
  slot EqualsToken : SyntaxToken?
    summary The <c>=</c>, or null.
    read FirstToken(SyntaxKind.Equals)
  slot Value : ExpressionSyntax?
    summary The value the member is given, or null.
    read FirstNode<ExpressionSyntax>()

node ErrorDirectiveSyntax : StatementSyntax
  kind ErrorDirective
  summary <c>.error "message"</c> or <c>.warning "message"</c>.
  slot Keyword : SyntaxToken
    summary The <c>.error</c> or <c>.warning</c> that starts the line.
    read ChildTokens[0]
  slot Message : SyntaxToken?
    summary The quoted message, or null.
    read FirstToken(SyntaxKind.StringLiteral)

node ErrorExpressionSyntax : ExpressionSyntax
  kind ErrorExpression
  summary Where an expression was expected and none could be read.
  slot Token : SyntaxToken?
    summary The directive that was read as far as it went, or null.
    read TokenAt(0)

node ErrorLineSyntax : StatementSyntax
  kind ErrorLine
  summary A line the parser could not read as any statement: its tokens, as they are.

node ExportDirectiveSyntax : StatementSyntax
  kind ExportDirective
  summary <c>.export a, outer::inner, K: abs, init as "_init"</c>: a list of names to export.
  slot Keyword : SyntaxToken
    summary The <c>.export</c> that starts the line.
    read ChildTokens[0]
  slot Items : ImmutableArray<ExportItemSyntax>
    summary The names exported.
    nodes

node ExportItemSyntax : SyntaxNode
  kind ExportItem
  summary <c>name</c> or <c>outer::inner</c>, then <c>: size</c> or <c>as "linker_name"</c>.
  slot Name : NameExpressionSyntax
    summary The name exported.
    read (NameExpressionSyntax)ChildNodes[0]
  slot ColonToken : SyntaxToken?
    summary The <c>:</c> before the address size, or null.
    read FirstToken(SyntaxKind.Colon)
  slot AddressSize : SyntaxToken?
    summary The <c>zp</c>, <c>abs</c> or <c>far</c> after the <c>:</c>, or null.
    read TokenAfter(ColonToken) is { Kind: SyntaxKind.Identifier } size && SyntaxFacts.IsAddressSize(size.Text) ? size : null
  slot AsKeyword : SyntaxToken?
    summary The <c>as</c> before the linker name, or null.
    read FirstWord("as")
  slot LinkerName : SyntaxToken?
    summary The quoted name the linker sees, or null.
    read FirstToken(SyntaxKind.StringLiteral)

node ExpressionSyntax : SyntaxNode
  abstract
  summary An expression.

node ExternProcDeclarationSyntax : StatementSyntax
  kind ExternProcDeclaration
  summary <c>.proc name = address: entry -&gt; exit</c>: a routine with no body.
  slot Keyword : SyntaxToken
    summary The <c>.proc</c> that starts the line.
    read ChildTokens[0]
  slot Name : SyntaxToken
    summary The routine's name.
    read ChildTokens[1]
  slot EqualsToken : SyntaxToken
    summary The <c>=</c>.
    read ChildTokens[2]
  slot Address : ExpressionSyntax
    summary Where the routine is.
    read FirstNode<ExpressionSyntax>()!
  slot Signature : ProcSignatureSyntax?
    summary The signature, or null.
    read FirstNode<ProcSignatureSyntax>()

node FileSyntax : SyntaxNode
  kind File
  handwritten

node FrameDirectiveSyntax : StatementSyntax
  kind FrameDirective
  summary <c>.frame locals: Locals</c>: a name, and the struct the top of the stack is laid out as.
  slot Keyword : SyntaxToken
    summary The <c>.frame</c> that starts the line.
    read ChildTokens[0]
  slot Name : SyntaxToken?
    summary The frame's name, or null.
    read TokenAt(1) is { Kind: SyntaxKind.Identifier } name ? name : null
  slot ColonToken : SyntaxToken?
    summary The <c>:</c>, or null.
    read FirstToken(SyntaxKind.Colon)
  slot Type : ExpressionSyntax?
    summary The struct the frame is laid out as, or null.
    read FirstNode<ExpressionSyntax>()

node FuncDeclarationSyntax : StatementSyntax
  kind FuncDeclaration
  summary <c>.func name(a, b) = expr</c>: a pure expression function.
  slot Keyword : SyntaxToken
    summary The <c>.func</c> that starts the line.
    read ChildTokens[0]
  slot Name : SyntaxToken?
    summary The function's name, or null.
    read NameAt(1)
  slot Parameters : ParameterListSyntax?
    summary The parameters, or null.
    read FirstNode<ParameterListSyntax>()
  slot EqualsToken : SyntaxToken?
    summary The <c>=</c>, or null.
    read FirstToken(SyntaxKind.Equals)
  slot Body : ExpressionSyntax
    summary The expression the function stands for.
    read FirstNode<ExpressionSyntax>()!

node IfDirectiveSyntax : ConditionalDirectiveSyntax
  kind IfDirective
  summary <c>.if expr {</c>.

node ImmediateOperandSyntax : OperandSyntax
  kind ImmediateOperand
  summary <c>#expr</c>, or the <c>#src, #dst</c> of a block move.
  slot HashToken : SyntaxToken
    summary The <c>#</c>.
    read ChildTokens[0]
  slot Value : ExpressionSyntax
    summary The value.
    read (ExpressionSyntax)ChildNodes[0]
  slot CommaToken : SyntaxToken?
    summary The <c>,</c> before a second value, or null.
    read FirstToken(SyntaxKind.Comma)
  slot SecondHashToken : SyntaxToken?
    summary The <c>#</c> of a second value, or null.
    read TokenAt(2)
  slot SecondValue : ExpressionSyntax?
    summary The second bank of a block move, or null.
    read ChildNodes.Length > 1 ? (ExpressionSyntax)ChildNodes[1] : null

node ImportDirectiveSyntax : StatementSyntax
  kind ImportDirective
  summary <c>.import a, b: far, c: proc(a8 -&gt; a8)</c>.
  slot Keyword : SyntaxToken
    summary The <c>.import</c> that starts the line.
    read ChildTokens[0]
  slot Items : ImmutableArray<ImportItemSyntax>
    summary The names imported.
    nodes

node ImportItemSyntax : SyntaxNode
  kind ImportItem
  summary <c>name</c>, <c>name: size</c>, <c>name: proc(...)</c> or a checked <c>name = expr</c>.
  slot Name : SyntaxToken
    summary The name imported.
    read ChildTokens[0]
  slot EqualsToken : SyntaxToken?
    summary The <c>=</c> before a checked value, or null.
    read FirstToken(SyntaxKind.Equals)
  slot Value : ExpressionSyntax?
    summary The value the import is checked against, or null.
    read FirstNode<ExpressionSyntax>()
  slot ColonToken : SyntaxToken?
    summary The <c>:</c> before a size or a signature, or null.
    read FirstToken(SyntaxKind.Colon)
  slot AddressSize : SyntaxToken?
    summary The <c>zp</c>, <c>abs</c> or <c>far</c> after the <c>:</c>, or null.
    read TokenAfter(ColonToken) is { Kind: SyntaxKind.Identifier } size && SyntaxFacts.IsAddressSize(size.Text) ? size : null
  slot Signature : ImportSignatureSyntax?
    summary The <c>proc(...)</c> after the <c>:</c>, or null.
    read FirstNode<ImportSignatureSyntax>()

node ImportSignatureSyntax : SyntaxNode
  kind ImportSignature
  summary <c>proc(entry -&gt; exit)</c>: the signature of an imported routine.
  slot ProcKeyword : SyntaxToken
    summary The <c>proc</c>.
    read ChildTokens[0]
  slot OpenParenToken : SyntaxToken?
    summary The <c>(</c>, or null.
    read FirstToken(SyntaxKind.OpenParen)
  slot Entry : StateListSyntax?
    summary The state on entry, or null when it is left out.
    read ArrowToken is { } arrow ? NodeBefore(arrow) as StateListSyntax : FirstNode<StateListSyntax>()
  slot ArrowToken : SyntaxToken?
    summary The <c>-&gt;</c>, or null.
    read FirstToken(SyntaxKind.Arrow)
  slot Exit : StateListSyntax?
    summary The state on exit, or null when it is left out.
    read NodeAfter(ArrowToken) as StateListSyntax
  slot CloseParenToken : SyntaxToken?
    summary The <c>)</c>, or null.
    read FirstToken(SyntaxKind.CloseParen)

node IndexedIndirectOperandSyntax : OperandSyntax
  kind IndexedIndirectOperand
  summary <c>(expr,x)</c> or <c>(expr,s),y</c>.
  slot OpenParenToken : SyntaxToken
    summary The <c>(</c>.
    read ChildTokens[0]
  slot Address : ExpressionSyntax
    summary The address of the pointer.
    read (ExpressionSyntax)ChildNodes[0]
  slot InnerRegister : SyntaxToken
    summary The <c>x</c> or <c>s</c> inside the parentheses.
    read ChildTokens[2]
  slot CloseParenToken : SyntaxToken
    summary The <c>)</c>.
    read ChildTokens[3]
  slot OuterRegister : SyntaxToken?
    summary The <c>y</c> after the parentheses, or null.
    read TokenAt(5)

node IndirectOperandSyntax : OperandSyntax
  kind IndirectOperand
  summary <c>(expr)</c> or <c>(expr),y</c>.
  slot OpenParenToken : SyntaxToken
    summary The <c>(</c>.
    read ChildTokens[0]
  slot Address : ExpressionSyntax
    summary The address of the pointer.
    read (ExpressionSyntax)ChildNodes[0]
  slot CloseParenToken : SyntaxToken
    summary The <c>)</c>.
    read ChildTokens[1]
  slot IndexRegister : SyntaxToken?
    summary The <c>y</c> after the parentheses, or null.
    read FirstToken(SyntaxKind.Register)

node InstructionStatementSyntax : StatementSyntax
  kind InstructionStatement
  summary A mnemonic and its operand, if it takes one.
  slot Mnemonic : SyntaxToken
    summary The mnemonic.
    read ChildTokens[0]
  slot Operand : OperandSyntax?
    summary The operand, or null for an instruction written without one.
    read FirstNode<OperandSyntax>()

node LabelSyntax : SyntaxNode
  kind Label
  summary <c>name:</c> at the start of a line.
  slot Name : SyntaxToken
    summary The label's name.
    read ChildTokens[0]
  slot ColonToken : SyntaxToken
    summary The <c>:</c>.
    read ChildTokens[1]

node LabeledLineSyntax : StatementSyntax
  kind LabeledLine
  summary A label, and the instruction, data directive or macro call written after it, if any.
  slot Label : LabelSyntax
    summary The label.
    read (LabelSyntax)ChildNodes[0]
  slot Statement : StatementSyntax?
    summary What is written after the label, or null.
    read ChildNodes.Length > 1 ? ChildNodes[1] as StatementSyntax : null

node LineSyntax : SyntaxNode
  kind Line
  handwritten

node ListDeclarationSyntax : TypeDeclarationSyntax
  kind ListDeclaration
  summary <c>.list name {</c>.

node ListItemsSyntax : StatementSyntax
  kind ListItems
  summary One line of a <c>.list</c>, which holds one or more comma-separated items.
  slot Items : ImmutableArray<ExpressionSyntax>
    summary The items.
    nodes

node LiteralExpressionSyntax : ExpressionSyntax
  abstract
  summary An expression that is one token.
  slot Token : SyntaxToken
    summary The token the expression is.
    read ChildTokens[0]

node LongIndirectOperandSyntax : OperandSyntax
  kind LongIndirectOperand
  summary <c>[expr]</c> or <c>[expr],y</c>.
  slot OpenBracketToken : SyntaxToken
    summary The <c>[</c>.
    read ChildTokens[0]
  slot Address : ExpressionSyntax
    summary The address of the pointer.
    read (ExpressionSyntax)ChildNodes[0]
  slot CloseBracketToken : SyntaxToken?
    summary The <c>]</c>, or null.
    read FirstToken(SyntaxKind.CloseBracket)
  slot IndexRegister : SyntaxToken?
    summary The <c>y</c> after the brackets, or null.
    read FirstToken(SyntaxKind.Register)

node MacroCallSyntax : StatementSyntax
  kind MacroCall
  summary <c>name!(args)</c>, with the <c>{</c> of a trailing block argument when one follows.
  slot Name : SyntaxToken
    summary The macro's name.
    read ChildTokens[0]
  slot BangToken : SyntaxToken
    summary The <c>!</c>.
    read ChildTokens[1]
  slot Arguments : ArgumentListSyntax?
    summary The arguments, or null.
    read FirstNode<ArgumentListSyntax>()
  slot OpenBraceToken : SyntaxToken?
    summary The <c>{</c> that opens the block, or null when it is not written.
    read FirstToken(SyntaxKind.OpenBrace)

node MacroDeclarationSyntax : StatementSyntax
  kind MacroDeclaration
  summary <c>.macro name(params): entry -&gt; exit {</c>.
  slot Keyword : SyntaxToken
    summary The <c>.macro</c> that starts the line.
    read ChildTokens[0]
  slot Name : SyntaxToken?
    summary The macro's name, or null.
    read NameAt(1)
  slot Parameters : MacroParameterListSyntax?
    summary The parameters, or null.
    read FirstNode<MacroParameterListSyntax>()
  slot Signature : ProcSignatureSyntax?
    summary The processor state the macro expects and leaves, or null.
    read FirstNode<ProcSignatureSyntax>()
  slot OpenBraceToken : SyntaxToken?
    summary The <c>{</c> that opens the block, or null when it is not written.
    read FirstToken(SyntaxKind.OpenBrace)

node MacroParameterListSyntax : SyntaxNode
  kind MacroParameterList
  summary <c>(a, b: expr, c = 1)</c>: the parameters of a macro.
  slot OpenParenToken : SyntaxToken
    summary The <c>(</c>.
    read ChildTokens[0]
  slot Parameters : ImmutableArray<MacroParameterSyntax>
    summary The parameters.
    nodes
  slot CloseParenToken : SyntaxToken?
    summary The <c>)</c>, or null.
    read FirstToken(SyntaxKind.CloseParen)

node MacroParameterSyntax : SyntaxNode
  kind MacroParameter
  summary <c>name</c>, <c>name: kind</c>, <c>name = default</c> or all three.
  slot Name : SyntaxToken
    summary The parameter's name.
    read ChildTokens[0]
  slot ColonToken : SyntaxToken?
    summary The <c>:</c> before the kind, or null.
    read FirstToken(SyntaxKind.Colon)
  slot ParameterKind : ParameterKindSyntax?
    summary What the parameter takes, or null.
    read FirstNode<ParameterKindSyntax>()
  slot EqualsToken : SyntaxToken?
    summary The <c>=</c> before the default, or null.
    read FirstToken(SyntaxKind.Equals)
  slot Default : SyntaxNode?
    summary The default: an expression, or the <c>{}</c> of a block parameter. Null when there is none.
    read NodeAfter(EqualsToken)

node MemberValueSyntax : StatementSyntax
  kind MemberValue
  summary <c>member = value</c>, in a braced record or on a line of its own in a multi-line initializer.
  slot Name : SyntaxToken
    summary The member's name.
    read ChildTokens[0]
  slot EqualsToken : SyntaxToken?
    summary The <c>=</c>, or null.
    read FirstToken(SyntaxKind.Equals)
  slot Value : SyntaxNode
    summary The value: an expression, or a braced list or record.
    read ChildNodes[0]

node ModuleDirectiveSyntax : StatementSyntax
  kind ModuleDirective
  summary <c>.module name</c> or <c>.module outer::inner</c>.
  slot Keyword : SyntaxToken
    summary The <c>.module</c> that starts the line.
    read ChildTokens[0]
  slot Names : ImmutableArray<SyntaxToken>
    summary The names of the module's path, outermost first.
    cache [.. ChildTokens.Skip(1).Where(token => token.Kind is SyntaxKind.Identifier or SyntaxKind.Register or SyntaxKind.Mnemonic)]

node MultiProcDeclarationSyntax : StatementSyntax
  kind MultiProcDeclaration
  summary <c>.multiproc E, b: signature {</c>: one routine per member of the enum <c>E</c>.
  slot Keyword : SyntaxToken
    summary The <c>.multiproc</c> that starts the line.
    read ChildTokens[0]
  slot Expression : ExpressionSyntax
    summary The enum whose members the routines are named from.
    read FirstNode<ExpressionSyntax>()!
  slot CommaToken : SyntaxToken?
    summary The <c>,</c> before the name, or null.
    read FirstToken(SyntaxKind.Comma)
  slot Name : SyntaxToken?
    summary The name bound to the member, or null.
    read TokenAfter(CommaToken) is { Kind: SyntaxKind.Identifier or SyntaxKind.Register or SyntaxKind.Mnemonic } name ? name : null
  slot Signature : ProcSignatureSyntax?
    summary The signature, or null.
    read FirstNode<ProcSignatureSyntax>()
  slot OpenBraceToken : SyntaxToken?
    summary The <c>{</c> that opens the block, or null when it is not written.
    read FirstToken(SyntaxKind.OpenBrace)

node NameExpressionSyntax : ExpressionSyntax
  kind NameExpression
  partial
  summary A name: <c>label</c>, <c>@local</c>, <c>gfx::init</c>, <c>::top_level</c>, <c>table[2]::x</c>.
  slot GlobalToken : SyntaxToken?
    summary The leading <c>::</c> of a name written from the top level, or null.
    read TokenAt(0) is { Kind: SyntaxKind.ColonColon } global ? global : null
  slot Names : ImmutableArray<SyntaxToken>
    summary The names between the <c>::</c>, outermost first. Empty when not even the first name was written.
    cache [.. ChildTokens.Where(token => token.Kind != SyntaxKind.ColonColon)]
  slot Indexes : ImmutableArray<ElementIndexSyntax>
    summary Every <c>[i]</c> written in the name.
    nodes

node NamedArgumentSyntax : SyntaxNode
  kind NamedArgument
  summary <c>name = argument</c>: a macro argument given by name.
  slot Name : SyntaxToken
    summary The parameter's name.
    read ChildTokens[0]
  slot EqualsToken : SyntaxToken
    summary The <c>=</c>.
    read ChildTokens[1]
  slot Value : SyntaxNode?
    summary What the parameter is given, or null.
    read ChildNodes.Length > 0 ? ChildNodes[0] : null

node NextDirectiveSyntax : StatementSyntax
  kind NextDirective
  summary <c>.next @a, gfx::init</c>, or <c>.next ?</c>.
  slot Keyword : SyntaxToken
    summary The <c>.next</c> that starts the line.
    read ChildTokens[0]
  slot QuestionToken : SyntaxToken?
    summary The <c>?</c> of <c>.next ?</c>, or null.
    read FirstToken(SyntaxKind.Question)
  slot Targets : ImmutableArray<NameExpressionSyntax>
    summary The labels flow continues at.
    nodes

node NumberExpressionSyntax : LiteralExpressionSyntax
  kind NumberExpression
  summary A number.

node OperandSyntax : SyntaxNode
  abstract
  summary An instruction's operand. Which forms an instruction and a CPU allow is decided in layout.

node ParameterKindSyntax : SyntaxNode
  kind ParameterKind
  summary What a macro parameter takes: a fixed word, a <c>one(...)</c> of listed words, or a <c>list(...)</c> of one of those.
  slot Keyword : SyntaxToken?
    summary The kind's word, or null when none was written.
    read TokenAt(0)
  slot OpenParenToken : SyntaxToken?
    summary The <c>(</c> of a <c>one</c> or a <c>list</c>, or null.
    read FirstToken(SyntaxKind.OpenParen)
  slot Words : ImmutableArray<SyntaxToken>
    summary The words a <c>one(...)</c> accepts.
    cache [.. ChildTokens.Skip(2).Where(token => token.Kind is SyntaxKind.Identifier or SyntaxKind.Register or SyntaxKind.Mnemonic)]
  slot Element : ParameterKindSyntax?
    summary What each item of a <c>list(...)</c> is, or null.
    read FirstNode<ParameterKindSyntax>()
  slot CloseParenToken : SyntaxToken?
    summary The <c>)</c>, or null.
    read FirstToken(SyntaxKind.CloseParen)

node ParameterListSyntax : SyntaxNode
  kind ParameterList
  summary <c>(a, b)</c>: the parameters of a <c>.func</c>.
  slot OpenParenToken : SyntaxToken
    summary The <c>(</c>.
    read ChildTokens[0]
  slot Parameters : ImmutableArray<SyntaxToken>
    summary The parameters' names.
    cache [.. ChildTokens.Where(token => token.Kind is SyntaxKind.Identifier or SyntaxKind.Register or SyntaxKind.Mnemonic)]
  slot CloseParenToken : SyntaxToken?
    summary The <c>)</c>, or null.
    read FirstToken(SyntaxKind.CloseParen)

node ParenthesizedExpressionSyntax : ExpressionSyntax
  kind ParenthesizedExpression
  summary <c>(expr)</c>.
  slot OpenParenToken : SyntaxToken
    summary The <c>(</c>.
    read ChildTokens[0]
  slot Expression : ExpressionSyntax
    summary The expression in the parentheses.
    read (ExpressionSyntax)ChildNodes[0]
  slot CloseParenToken : SyntaxToken?
    summary The <c>)</c>, or null.
    read FirstToken(SyntaxKind.CloseParen)

node PatchDirectiveSyntax : StatementSyntax
  kind PatchDirective
  summary <c>.patch @op</c>: the one instruction the store above writes into.
  slot Keyword : SyntaxToken
    summary The <c>.patch</c> that starts the line.
    read ChildTokens[0]
  slot Target : NameExpressionSyntax?
    summary The label of the instruction written to, or null.
    read FirstNode<NameExpressionSyntax>()

node ProcDeclarationSyntax : StatementSyntax
  kind ProcDeclaration
  summary <c>.proc name: entry -&gt; exit {</c>.
  slot Keyword : SyntaxToken
    summary The <c>.proc</c> that starts the line.
    read ChildTokens[0]
  slot Name : SyntaxToken?
    summary The routine's name, or null.
    read NameAt(1)
  slot Signature : ProcSignatureSyntax?
    summary The signature, or null.
    read FirstNode<ProcSignatureSyntax>()
  slot OpenBraceToken : SyntaxToken?
    summary The <c>{</c> that opens the block, or null when it is not written.
    read FirstToken(SyntaxKind.OpenBrace)

node ProcSignatureSyntax : SyntaxNode
  kind ProcSignature
  summary The <c>: entry -&gt; exit</c> of a proc, an extern proc or a macro.
  slot ColonToken : SyntaxToken
    summary The <c>:</c>.
    read ChildTokens[0]
  slot Entry : StateListSyntax
    summary The state on entry.
    read (StateListSyntax)ChildNodes[0]
  slot ArrowToken : SyntaxToken?
    summary The <c>-&gt;</c>, or null.
    read FirstToken(SyntaxKind.Arrow)
  slot Exit : StateListSyntax?
    summary The state on exit, or null.
    read ChildNodes.Length > 1 ? (StateListSyntax)ChildNodes[1] : null

node RecordValuesSyntax : SyntaxNode
  kind RecordValues
  summary <c>{ member = value, … }</c>: a record's values.
  slot OpenBraceToken : SyntaxToken
    summary The <c>{</c>.
    read ChildTokens[0]
  slot Members : ImmutableArray<MemberValueSyntax>
    summary The members given a value.
    nodes
  slot CloseBraceToken : SyntaxToken?
    summary The <c>}</c>, or null.
    read FirstToken(SyntaxKind.CloseBrace)

node RepeatDirectiveSyntax : RepetitionDirectiveSyntax
  kind RepeatDirective
  summary <c>.repeat count, name {</c>.

node RepetitionDirectiveSyntax : StatementSyntax
  abstract
  summary The line that opens a repetition: <c>.repeat count, name {</c> or <c>.each what, name {</c>.
  slot Keyword : SyntaxToken
    summary The <c>.repeat</c> or <c>.each</c> that starts the line.
    read ChildTokens[0]
  slot Expression : ExpressionSyntax
    summary The count of a <c>.repeat</c>, or what an <c>.each</c> goes through.
    read FirstNode<ExpressionSyntax>()!
  slot CommaToken : SyntaxToken?
    summary The <c>,</c> before the name, or null.
    read FirstToken(SyntaxKind.Comma)
  slot Name : SyntaxToken?
    summary The name bound to the index or the item, or null when it is left out.
    read TokenAfter(CommaToken) is { Kind: SyntaxKind.Identifier or SyntaxKind.Register or SyntaxKind.Mnemonic } name ? name : null
  slot OpenBraceToken : SyntaxToken?
    summary The <c>{</c> that opens the block, or null when it is not written.
    read FirstToken(SyntaxKind.OpenBrace)

node ScopeDeclarationSyntax : StatementSyntax
  kind ScopeDeclaration
  summary <c>.scope name {</c>.
  slot Keyword : SyntaxToken
    summary The <c>.scope</c> that starts the line.
    read ChildTokens[0]
  slot Name : SyntaxToken?
    summary The scope's name, or null for an anonymous scope.
    read NameAt(1)
  slot OpenBraceToken : SyntaxToken?
    summary The <c>{</c> that opens the block, or null when it is not written.
    read FirstToken(SyntaxKind.OpenBrace)

node SegmentAttributeSyntax : SyntaxNode
  kind SegmentAttribute
  summary <c>dp = expr</c>, <c>bank = expr</c> or <c>mirrors = [$00..$3f, $80..$bf]</c>.
  slot Name : SyntaxToken?
    summary The <c>dp</c>, <c>bank</c> or <c>mirrors</c>, or null.
    read TokenAt(0)
  slot EqualsToken : SyntaxToken?
    summary The <c>=</c>, or null.
    read FirstToken(SyntaxKind.Equals)
  slot Value : ExpressionSyntax?
    summary The value of a <c>dp</c> or a <c>bank</c>, or null.
    read FirstNode<ExpressionSyntax>()
  slot OpenBracketToken : SyntaxToken?
    summary The <c>[</c> of a <c>mirrors</c>, or null.
    read FirstToken(SyntaxKind.OpenBracket)
  slot Ranges : ImmutableArray<BankRangeSyntax>
    summary The banks of a <c>mirrors</c>.
    nodes
  slot CloseBracketToken : SyntaxToken?
    summary The <c>]</c> of a <c>mirrors</c>, or null.
    read FirstToken(SyntaxKind.CloseBracket)

node SegmentBlockSyntax : SegmentStatementSyntax
  kind SegmentBlock
  summary <c>.segment NAME {</c>: the line that opens a segment block.
  slot OpenBraceToken : SyntaxToken?
    summary The <c>{</c> that opens the block, or null when it is not written.
    read FirstToken(SyntaxKind.OpenBrace)

node SegmentDeclarationSyntax : SegmentStatementSyntax
  kind SegmentDeclaration
  summary <c>.segment NAME: size</c>, with its attributes.
  slot ColonToken : SyntaxToken?
    summary The <c>:</c> before the address size, or null.
    read FirstToken(SyntaxKind.Colon)
  slot AddressSize : SyntaxToken?
    summary The <c>zp</c>, <c>abs</c> or <c>far</c>, or null.
    read TokenAfter(ColonToken) is { Kind: SyntaxKind.Identifier } size ? size : null
  slot Attributes : ImmutableArray<SegmentAttributeSyntax>
    summary The attributes after the address size.
    nodes

node SegmentRegionSyntax : SegmentStatementSyntax
  kind SegmentRegion
  summary <c>.segment NAME</c>: a region line, which puts what follows it in the segment.

node SegmentStatementSyntax : StatementSyntax
  abstract
  summary A line that starts with <c>.segment</c>: a declaration, a block's opener or a region line.
  slot Keyword : SyntaxToken
    summary The <c>.segment</c> that starts the line.
    read ChildTokens[0]
  slot Name : SyntaxToken?
    summary The segment's name, or null. A quoted name is an error, and is still the name.
    read TokenAt(1) is { Kind: SyntaxKind.Identifier or SyntaxKind.Register or SyntaxKind.Mnemonic or SyntaxKind.StringLiteral } name ? name : null

node SignatureDeclarationSyntax : StatementSyntax
  kind SignatureDeclaration
  summary <c>.signature std = a8, i16, dp = 0</c>: a name for items a signature uses.
  slot Keyword : SyntaxToken
    summary The <c>.signature</c> that starts the line.
    read ChildTokens[0]
  slot Name : SyntaxToken?
    summary The set's name, or null.
    read NameAt(1)
  slot EqualsToken : SyntaxToken?
    summary The <c>=</c>, or null.
    read FirstToken(SyntaxKind.Equals)
  slot Items : StateListSyntax?
    summary The items the name stands for, or null.
    read FirstNode<StateListSyntax>()

node SkippedTokensSyntax : SyntaxNode
  kind SkippedTokens
  summary What was left on a line after its statement: tokens the parser walked past.

node StateDirectiveSyntax : StateListDirectiveSyntax
  kind StateDirective
  summary <c>.state a16, i8</c>: the items of a signature, asserted and set at one point.

node StateItemSyntax : SyntaxNode
  kind StateItem
  summary One processor-state item: <c>a16</c>, <c>i*</c>, <c>dp = 0</c>, <c>args 2</c>, <c>inline .strz</c>, <c>keeps a, x</c>,
  summary <c>?</c> on its own, or the name of a signature set.
  slot SetName : NameExpressionSyntax?
    summary The signature set the item names, or null for an item that is a word of its own.
    read ChildTokens.Length == 0 ? FirstNode<NameExpressionSyntax>() : null
  slot Name : SyntaxToken?
    summary The item's word, or null for a set's name or a <c>?</c> on its own.
    read TokenAt(0) is { Kind: not SyntaxKind.Question } name ? name : null
  slot AllUnknownToken : SyntaxToken?
    summary The <c>?</c> that is the whole item, or null.
    read TokenAt(0) is { Kind: SyntaxKind.Question } question ? question : null
  slot Suffix : SyntaxToken?
    summary The <c>*</c>, <c>?</c> or <c>=</c> after the word, or null.
    read Name is not null && TokenAt(1) is { Kind: SyntaxKind.Star or SyntaxKind.Question or SyntaxKind.Equals } suffix ? suffix : null
  slot Value : ExpressionSyntax?
    summary The expression after the word: the <c>n</c> of <c>inline n</c>, the <c>e</c> of <c>dp = e</c>. Null when there is none.
    read FirstNode<ExpressionSyntax>()
  slot StrzToken : SyntaxToken?
    summary The <c>.strz</c> of <c>inline .strz</c>, or null.
    read FirstToken(SyntaxKind.Directive)
  slot Registers : ImmutableArray<SyntaxToken>
    summary The registers a <c>keeps</c> names.
    cache [.. ChildTokens.Skip(1).Where(token => token.Kind is SyntaxKind.Identifier or SyntaxKind.Register)]

node StateListDirectiveSyntax : StatementSyntax
  abstract
  summary A directive that takes the items of a signature: <c>.state</c> or <c>.ensure</c>.
  slot Keyword : SyntaxToken
    summary The <c>.state</c> or <c>.ensure</c> that starts the line.
    read ChildTokens[0]
  slot Items : StateListSyntax
    summary The items.
    read FirstNode<StateListSyntax>()!

node StateListSyntax : SyntaxNode
  kind StateList
  summary Processor-state items separated by commas.
  slot Items : ImmutableArray<StateItemSyntax>
    summary The items.
    nodes

node StatementSyntax : SyntaxNode
  abstract
  summary What a line's tokens parse to: a declaration, a directive, an instruction, a member of a body.
  summary A few of them are also written inside another statement, as an instruction is after a label
  summary and a data directive after <c>.data name:</c>. A statement is only its own tokens wherever it
  summary is written: the line break, whatever the statement could not take and the <c>.export</c>
  summary before a declaration all belong to the line (<see cref="LineSyntax"/>).
  member IsExported : bool
    summary Whether this is a declaration written after <c>.export</c>.
    read ExportToken is not null
  member ExportToken : SyntaxToken?
    summary The <c>.export</c> the line writes before this declaration, or null.
    read (Parent as LineSyntax)?.ExportKeyword

node StringExpressionSyntax : LiteralExpressionSyntax
  kind StringExpression
  summary A string in double quotes.

node StructDeclarationSyntax : TypeDeclarationSyntax
  kind StructDeclaration
  summary <c>.struct name {</c>.

node SyntaxListNode : SyntaxNode
  kind List SeparatedList
  internal
  handwritten

node TypeDeclarationSyntax : StatementSyntax
  abstract
  summary The line that opens an <c>.enum</c>, <c>.struct</c>, <c>.union</c>, <c>.charmap</c> or <c>.list</c>.
  slot Keyword : SyntaxToken
    summary The <c>.enum</c>, <c>.struct</c> or the like that starts the line.
    read ChildTokens[0]
  slot Name : SyntaxToken?
    summary The declared name, or null for an anonymous declaration.
    read NameAt(1)
  slot OpenBraceToken : SyntaxToken?
    summary The <c>{</c> that opens the block, or null when it is not written.
    read FirstToken(SyntaxKind.OpenBrace)

node UnaryExpressionSyntax : ExpressionSyntax
  kind UnaryExpression
  summary <c>op operand</c>.
  slot OperatorToken : SyntaxToken
    summary The operator.
    read ChildTokens[0]
  slot Operand : ExpressionSyntax
    summary What the operator applies to.
    read (ExpressionSyntax)ChildNodes[0]

node UnionDeclarationSyntax : TypeDeclarationSyntax
  kind UnionDeclaration
  summary <c>.union name {</c>.

node UseDirectiveSyntax : StatementSyntax
  kind UseDirective
  partial
  summary <c>.use a::b</c>, <c>.use a::{b, c as d}</c>, <c>.use a::*</c> or <c>.use a::b as c</c>.
  slot Keyword : SyntaxToken
    summary The <c>.use</c> that starts the line.
    read ChildTokens[0]
  slot Path : ImmutableArray<SyntaxToken>
    summary The names of the path, outermost first: everything before a <c>::*</c>, a <c>::{</c> or an <c>as</c>.
    cache ReadPath()
  slot StarToken : SyntaxToken?
    summary The <c>*</c> of <c>a::*</c>, or null.
    read FirstToken(SyntaxKind.Star)
  slot OpenBraceToken : SyntaxToken?
    summary The <c>{</c> of <c>a::{b, c}</c>, or null.
    read FirstToken(SyntaxKind.OpenBrace)
  slot Items : ImmutableArray<UseItemSyntax>
    summary The names in the braces of <c>a::{b, c}</c>.
    nodes
  slot CloseBraceToken : SyntaxToken?
    summary The <c>}</c> of <c>a::{b, c}</c>, or null.
    read FirstToken(SyntaxKind.CloseBrace)
  slot AsKeyword : SyntaxToken?
    summary The <c>as</c> of <c>a::b as c</c>, or null.
    read Path.Length > 0 && TokenAfter(Path[^1]) is { Kind: SyntaxKind.Identifier } word && word.Text.Equals("as", StringComparison.OrdinalIgnoreCase) ? word : null
  slot Alias : SyntaxToken?
    summary The name the path's last name is brought in as, or null.
    read TokenAfter(AsKeyword)

node UseItemSyntax : SyntaxNode
  kind UseItem
  summary One name in the braces of a <c>.use</c>, and the name it is brought in as.
  slot Name : SyntaxToken
    summary The name used.
    read ChildTokens[0]
  slot AsKeyword : SyntaxToken?
    summary The <c>as</c>, or null.
    read TokenAt(1)
  slot Alias : SyntaxToken?
    summary The name it is brought in as, or null.
    read TokenAt(2)

node ValueListSyntax : SyntaxNode
  kind ValueList
  summary <c>{ value, … }</c>: a list of elements.
  slot OpenBraceToken : SyntaxToken
    summary The <c>{</c>.
    read ChildTokens[0]
  slot Values : ImmutableArray<SyntaxNode>
    summary The values: expressions and braced lists or records.
    read ChildNodes
  slot CloseBraceToken : SyntaxToken?
    summary The <c>}</c>, or null.
    read FirstToken(SyntaxKind.CloseBrace)
